      <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-247-279"><seg source="#source-247-279">たあんき、ぽーんき</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)" source="#source-279-305"><seg source="#source-279-305">たんころりん</seg></p>
      <p source="#source-305-355"><seg source="#source-305-329">たにしをつツつく</seg><ruby type="furigana" rend="right" source="#source-329-347"><rb>鴉</rb><rt>からす</rt></ruby><seg source="#source-347-355">どん</seg></p>
      <p source="#source-355-395"><seg source="#source-355-395">はるのひながのたんぼなか</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-395-427"><seg source="#source-395-427">たあんき、ぽーんき</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)" source="#source-427-453"><seg source="#source-427-453">たんころりん</seg></p>
      <p source="#source-453-488"><seg source="#source-453-488">われもひとも生きもんだ</seg></p>
      <p source="#source-488-528"><seg source="#source-488-528">あんまりひどくしなさんな</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-528-560"><seg source="#source-528-560">たあんき、ぽーんき</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)" source="#source-560-586"><seg source="#source-560-586">たんころりん</seg></p>
      <p source="#source-586-618"><seg source="#source-586-618">鴉はきいても知らぬ顔</seg></p>
      <p source="#source-618-654"><seg source="#source-618-654">はるのひながのたんぼなか</seg></p>
    </body>
