        <p><seg source="#source-3369-3383">三慎大兄</seg></p>
      </div>
      <div type="layout" source="#source-3383-3421" style="padding-inline-start: 3em">
        <p><seg source="#source-3404-3421">三吉慎蔵様</seg></p>
      </div>
      <div type="layout" source="#source-3421-3472" style="padding-inline-start: 7em">
        <p><seg source="#source-3442-3448">左右</seg><seg type="layout" source="#source-3448-3472" rend="chitsuki align(right) offset-from-end(0)" snh:layout-kind="chitsuki" snh:layout-params="align=right;offset-from-end=0"><seg source="#source-3466-3472">直柔</seg></seg></p>
