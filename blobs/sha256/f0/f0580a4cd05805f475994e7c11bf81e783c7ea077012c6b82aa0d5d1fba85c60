      <div>
        <head n="2" source="#source-537-573"><seg source="#source-537-540">１</seg></head>
        <p source="#source-577-597"><seg source="#source-577-597">Kiosque au Rimbaud</seg></p>
        <p source="#source-597-674"><hi rend="yokogumi horizontal" snh:layout-kind="yokogumi" snh:layout-params="direction=horizontal" source="#source-597-654" corresp="#source-597-615 #source-627-654"><seg source="#source-615-627">“Marila”</seg></hi><seg source="#source-654-655"> </seg><hi rend="accent" snh:accent-code="1-09-54" snh:source-marker="a`" source="#source-658-660" corresp="#source-655-658 #source-660-663">à</hi><seg source="#source-663-674"> la main,</seg></p>
        <p source="#source-674-693"><seg source="#source-674-693">Le ciel est beau,</seg></p>
        <p source="#source-693-724"><seg source="#source-693-724">Eh ! tout le sang est Pain.</seg></p>
      </div>
      <div>
        <head n="2" source="#source-724-760"><seg source="#source-724-727">２</seg></head>
        <p source="#source-764-791"><seg source="#source-764-776">Ne voici le </seg><seg source="#source-779-781">po</seg><hi rend="accent" snh:accent-code="1-09-62" snh:source-marker="e`" source="#source-781-783" corresp="#source-776-779 #source-785-788">è</hi><seg source="#source-783-785">te</seg><seg source="#source-788-791">,</seg></p>
        <p source="#source-791-832"><seg source="#source-791-814">Mille familles dans le </seg><seg source="#source-817-818">m</seg><hi rend="accent" snh:accent-code="1-09-64" snh:source-marker="e^" source="#source-818-820" corresp="#source-814-817 #source-822-825">ê</hi><seg source="#source-820-822">me</seg><seg source="#source-825-832"> toit</seg></p>
        <p source="#source-832-859"><seg source="#source-832-843">Revoici le </seg><seg source="#source-846-848">po</seg><hi rend="accent" snh:accent-code="1-09-62" snh:source-marker="e`" source="#source-848-850" corresp="#source-843-846 #source-852-855">è</hi><seg source="#source-850-852">te</seg><seg source="#source-855-859"> :</seg></p>
        <p source="#source-859-887"><seg source="#source-859-887">On ne fait que le droit.</seg></p>
      </div>
      <div>
        <head n="2" source="#source-887-923"><seg source="#source-887-890">３</seg></head>
        <p source="#source-927-959"><seg source="#source-927-959">Que Dieu le luise et le pose !</seg></p>
        <p source="#source-959-985"><seg source="#source-959-985">Qu'il ne voie pas ouvrir</seg></p>
        <p source="#source-985-1013"><seg source="#source-985-1013">Les parasols bleus et rose</seg></p>
        <p source="#source-1013-1044"><seg source="#source-1013-1044">Parmi les flots : les martyrs !</seg></p>
      </div>
    </body>
