      <p style="text-indent: 7em" rend="first-line-indent(7)"><seg source="#source-711-761">一　ばけものの起源</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)"><ruby type="furigana" rend="right" source="#source-764-791"><rb>妖怪</rb><rt>えうくわい</rt></ruby><seg source="#source-791-794">の</seg><ruby type="furigana" rend="right" source="#source-794-818"><rb>研究</rb><rt>けんきう</rt></ruby><seg source="#source-818-821">と</seg><ruby type="furigana" rend="right" source="#source-821-833"><rb>云</rb><rt>い</rt></ruby><seg source="#source-833-845">つても、</seg><ruby type="furigana" rend="right" source="#source-845-860"><rb>別</rb><rt>べつ</rt></ruby><seg source="#source-860-863">に</seg><ruby type="furigana" rend="right" source="#source-863-887"><rb>專門</rb><rt>せんもん</rt></ruby><seg source="#source-887-890">に</seg><ruby type="furigana" rend="right" source="#source-890-905"><rb>調</rb><rt>しら</rt></ruby><seg source="#source-905-911">べた</seg><ruby type="furigana" rend="right" source="#source-911-926"><rb>譯</rb><rt>わけ</rt></ruby><seg source="#source-926-941">でもなく、</seg><ruby type="furigana" rend="right" source="#source-941-956"><rb>又</rb><rt>また</rt></ruby><seg source="#source-956-968">さういふ</seg><ruby type="furigana" rend="right" source="#source-968-992"><rb>專門</rb><rt>せんもん</rt></ruby><seg source="#source-992-1004">があるや</seg><ruby type="furigana" rend="right" source="#source-1004-1019"><rb>否</rb><rt>いな</rt></ruby><seg source="#source-1019-1028">やをも</seg><ruby type="furigana" rend="right" source="#source-1028-1040"><rb>知</rb><rt>し</rt></ruby><seg source="#source-1040-1049">らぬ。</seg><ruby type="furigana" rend="right" source="#source-1049-1061"><rb>兎</rb><rt>と</rt></ruby><seg source="#source-1061-1064">に</seg><ruby type="furigana" rend="right" source="#source-1064-1079"><rb>角</rb><rt>かく</rt></ruby><ruby type="furigana" rend="right" source="#source-1079-1097"><rb>私</rb><rt>わたし</rt></ruby><seg source="#source-1097-1130">はばけものといふものは</seg><ruby type="furigana" rend="right" source="#source-1130-1151"><rb>非常</rb><rt>ひぜう</rt></ruby><seg source="#source-1151-1154">に</seg><ruby type="furigana" rend="right" s