        <div>
          <head n="1" source="#source-509580-509700"><ruby type="furigana" rend="right" source="#source-509580-509604"><rb>伯林</rb><rt>ベルリン</rt></ruby><seg source="#source-509604-509610">停車</seg><ruby type="furigana" rend="right" source="#source-509610-509631"><rb>場</rb><rt>ぢやう</rt></ruby><seg source="#source-509631-509643">（晶子）</seg></head>
