"><rb>眠</rb><rt>ね</rt></ruby><seg source="#source-9411-9435">むくなつた。われ</seg><ruby type="furigana" rend="right" source="#source-9435-9453"><rb>真</rb><rt>まこと</rt></ruby><seg source="#source-9453-9462">にかく</seg><ruby type="furigana" rend="right" source="#source-9462-9477"><rb>願</rb><rt>ねが</rt></ruby><seg source="#source-9477-9480">ひ</seg><ruby type="furigana" rend="right" source="#source-9480-9501"><rb>奉</rb><rt>たてまつ</rt></ruby><seg source="#source-9501-9507">る。</seg><ruby type="furigana" rend="right" source="#source-9507-9522"><rb>事</rb><rt>こと</rt></ruby><seg source="#source-9522-9525">に</seg><ruby type="furigana" rend="right" source="#source-9525-9537"><rb>依</rb><rt>よ</rt></ruby><seg source="#source-9537-9546">つたら</seg><ruby type="furigana" rend="right" source="#source-9546-9567"><rb>御覧</rb><rt>ごらん</rt></ruby><seg source="#source-9567-9585">になつたかも</seg><ruby type="furigana" rend="right" source="#source-9585-9597"><rb>知</rb><rt>し</rt></ruby><seg source="#source-9597-9612">れないが、</seg><ruby type="furigana" rend="right" source="#source-9612-9636"><rb>幼児</rb><rt>をさなご</rt></ruby><seg source="#source-9636-9654">のことゆゑ、</seg><ruby type="furigana" rend="right" source="#source-9654-9666"><rb>気</rb><rt>き</rt></ruby><seg source="#source-9666-9669">を</seg><ruby type="furigana" rend="right" source="#source-9669-9681"><rb>付</rb><rt>つ</rt></ruby><seg source="#source-9681-9714">けてやらねばなるまい。</seg><ruby type="furigana" rend="right" source="#source-9714-9744"><rb>真昼時</rb><rt>まひるどき</rt></ruby><seg source="#source-9744-9747">で</seg><ruby type="furigana" rend="right" source="#source-9747-9759"><rb>気</rb><rt>き</rt></ruby><seg source="#source-9759-9762">が</seg><ruby type="furigana" rend="right" source="#source-9762-9777"><rb>重</rb><rt>おも</rt></ruby><seg source="#source-9777-9789">くなる。</seg><ruby type="furigana" rend="right" source="#source-9789-9804"><rb>物</rb><rt>もの</rt></ruby><ruby type="furigana" rend="right" source="#source-9804-9819"><rb>皆</rb><rt>みな</rt></ruby><ruby type="furigana" rend="right" source="#source-9819-9843"><rb>悉</rb><rt><seg source="#source-9825-9831">こと</seg><choice source="#source-9831-9840"><orig>／″＼</orig><reg>〲</reg></choice></rt></ruby><seg source="#source-9843-9846">く</seg><ruby type="furigana" rend="right" source="#source-9846-9861"><rb>白</rb><rt>しろ</rt></ruby><seg source="#source-9861-9894">つぽい。しかあれかし、</seg><ruby type="furigana" rend="right" source="#source-9894-9915"><rb>亜孟</rb><rt>アメン</rt></ruby><seg source="#source-9915-9918">。</seg></p>
