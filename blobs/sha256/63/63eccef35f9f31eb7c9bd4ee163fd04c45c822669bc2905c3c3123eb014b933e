        <div>
          <head n="1" source="#source-1193993-1194059"><ruby type="furigana" rend="right" source="#source-1193993-1194017"><rb>仲直</rb><rt>なかなお</rt></ruby><seg source="#source-1194017-1194020">り</seg></head>
        </div>
