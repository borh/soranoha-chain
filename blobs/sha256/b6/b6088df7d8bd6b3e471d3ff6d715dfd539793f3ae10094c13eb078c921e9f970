        <p><seg source="#source-412311-412317">同　</seg><ruby type="furigana" rend="right" source="#source-412317-412338"><rb>八束</rb><rt>やつか</rt></ruby><seg source="#source-412338-412341">郡</seg><ruby type="furigana" rend="right" source="#source-412341-412365"><rb>意東</rb><rt>いとう</rt></ruby><seg source="#source-412365-412368">村</seg><hi rend="font-size small(1)" snh:layout-kind="font-size" snh:layout-params="size-type=small;level=1" source="#source-412368-412422"><seg source="#source-412368-412374">大字</seg></hi><seg source="#source-412422-412431">上意東</seg><hi rend="font-size small(1)" snh:layout-kind="font-size" snh:layout-params="size-type=small;level=1" source="#source-412431-412485"><seg source="#source-412431-412437">小字</seg></hi><seg source="#source-412485-412496">京羅木</seg></p>
        <p><seg source="#source-412496-412502">同　</seg><ruby type="furigana" rend="right" source="#source-412502-412520"><rb>能義</rb><rt>のぎ</rt></ruby><seg source="#source-412520-412523">郡</seg><ruby type="furigana" rend="right" source="#source-412523-412550"><rb>飯梨</rb><rt>いいなし</rt></ruby><seg source="#source-412550-412553">村</seg><hi rend="font-size small(1)" snh:layout-kind="font-size" snh:layout-params="size-type=small;level=1" source="#source-412553-412607"><seg source="#source-412553-412559">大字</seg></hi><seg source="#source-412607-412613">石原</seg><hi rend="font-size small(1)" snh:layout-kind="font-size" snh:layout-params="size-type=small;level=1" source="#source-412613-412661"><seg source="#source-412613-412616">字</seg></hi><seg source="#source-412661-412672">京羅木</seg></p>
        <p><seg source="#source-412672-412696">同　同　　山佐村</seg><hi rend="font-size small(1)" snh:layout-kind="font-size" snh:layout-params="size-type=small;level=1" source="#source-412696-412750"><seg source="#source-412696-412702">大字</seg></hi><seg source="#source-412750-412759">奥田原</seg><hi rend="font-size small(1)" snh:layout-kind="font-size" snh:layout-params="size-type=small;level=1" source="#source-412759-412807"><seg source="#source-412759-412762">字</seg></hi><seg source="#source-412807-412813">新田</seg><hi rend="font-size small(1)" snh:layout-kind="font-size" snh:layout-params="size-type=small;level=1" source="#source-412813-412867"><seg source="#source-412813-412819">小字</seg></hi><seg source="#source-412867-412878">京蘭木</seg></p>
