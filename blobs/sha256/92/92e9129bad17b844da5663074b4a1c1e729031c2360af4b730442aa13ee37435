      <div type="layout" source="#source-692-1151" style="padding-inline-start: 6em">
        <div type="layout" source="#source-727-1113" rend="font-size small(1)">
          <div type="layout" source="#source-774-1069" style="inline-size: 28em">
            <p><seg source="#source-812-830">――　　ひ？</seg><note type="sic" source="#source-830-866">「　　ひ？」はママ</note><seg source="#source-866-938">――燒土層を成す――土器製造所か――土器の葢――</seg><app type="base-text-variant" source="#source-953-1019"><lem><seg source="#source-938-953">貝塚曲玉の</seg></lem><rdg type="base-text"><seg source="#source-998-1013">貝　曲玉の</seg></rdg></app><seg source="#source-1019-1033">一種――</seg></p>
          </div>
        </div>
