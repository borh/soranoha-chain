end="right" source="#source-5622-5637"><rb>年</rb><rt>とし</rt></ruby><seg source="#source-5637-5646">ごろの</seg><ruby type="furigana" rend="right" source="#source-5646-5664"><rb>娘</rb><rt>むすめ</rt></ruby><seg source="#source-5664-5667">を</seg><ruby type="furigana" rend="right" source="#source-5667-5679"><rb>持</rb><rt>も</rt></ruby><seg source="#source-5679-5685">った</seg><ruby type="furigana" rend="right" source="#source-5685-5700"><rb>家</rb><rt>いえ</rt></ruby><seg source="#source-5700-5706">は、</seg><ruby type="furigana" rend="right" source="#source-5706-5730"><rb>毎年</rb><rt>まいねん</rt></ruby><seg source="#source-5730-5736">その</seg><ruby type="furigana" rend="right" source="#source-5736-5757"><rb>時分</rb><rt>じぶん</rt></ruby><seg source="#source-5757-5772">になると、</seg><ruby type="furigana" rend="right" source="#source-5772-5793"><rb>今年</rb><rt>ことし</rt></ruby><seg source="#source-5793-5796">は</seg><ruby type="furigana" rend="right" source="#source-5796-5817"><rb>白羽</rb><rt>しらは</rt></ruby><seg source="#source-5817-5820">の</seg><ruby type="furigana" rend="right" source="#source-5820-5832"><rb>矢</rb><rt>や</rt></ruby><seg source="#source-5832-5835">が</seg><ruby type="furigana" rend="right" source="#source-5835-5847"><rb>立</rb><rt>た</rt></ruby><seg source="#source-5847-5871">つのではないかと</seg><ruby type="furigana" rend="right" source="#source-5871-5886"><rb>思</rb><rt>おも</rt></ruby><seg source="#source-5886-5970">って、びくびくふるえておりますが、いよいよどこかのうちに</seg><ruby type="furigana" rend="right" source="#source-5970-5982"><rb>矢</rb><rt>や</rt></ruby><seg source="#source-5982-5985">が</seg><ruby type="furigana" rend="right" source="#source-5985-5997"><rb>立</rb><rt>た</rt></ruby><seg source="#source-5997-6048">ったときまると、まあまあよかった、</seg><ruby type="furigana" rend="right" source="#source-6048-6069"><rb>今年</rb><rt>ことし</rt></ruby><seg source="#source-6069-6123">ものがれたといって、おもちをついてお</seg><ruby type="furigana" rend="right" source="#source-6123-6138"><rb>祝</rb><rt>いわ</rt></ruby><seg source="#source-6138-6165">いをいたしますが、</s