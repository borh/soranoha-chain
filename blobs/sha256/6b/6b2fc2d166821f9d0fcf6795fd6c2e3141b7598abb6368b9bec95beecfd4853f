        <p source="#source-13189-13254"><seg source="#source-13189-13201">しっぺい</seg><ruby type="furigana" rend="right" source="#source-13201-13222"><rb>太郎</rb><rt>たろう</rt></ruby><seg source="#source-13222-13225">に</seg><ruby type="furigana" rend="right" source="#source-13225-13237"><rb>聞</rb><rt>き</rt></ruby><seg source="#source-13237-13254">かせるな。</seg></p>
        <p source="#source-13254-13331"><ruby type="furigana" rend="right" source="#source-13254-13275"><rb>丹波</rb><rt>たんば</rt></ruby><seg source="#source-13275-13278">の</seg><ruby type="furigana" rend="right" source="#source-13278-13299"><rb>太郎</rb><rt>たろう</rt></ruby><seg source="#source-13299-13302">に</seg><ruby type="furigana" rend="right" source="#source-13302-13314"><rb>聞</rb><rt>き</rt></ruby><seg source="#source-13314-13331">かせるな。</seg></p>
