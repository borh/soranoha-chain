    <body>
      <p><seg source="#source-319-337">ポストにカチ</seg><choice source="#source-337-343"><orig>／＼</orig><reg>〱</reg></choice><seg source="#source-343-360">かぎはめて</seg></p>
      <p><seg source="#source-360-389">郵便物をとり出して</seg></p>
      <p><seg source="#source-389-430">スタンプをしたらエッサッサ</seg></p>
      <p><seg source="#source-430-462">隣の村へとエッサッサ</seg></p>
      <p><seg source="#source-462-500">お腰でカバンがガッタガタ</seg></p>
      <p><seg source="#source-500-538">お腰でわらぢがブーラブラ</seg></p>
      <p><seg source="#source-538-550">早く行け</seg><choice source="#source-550-556"><orig>／＼</orig><reg>〱</reg></choice><seg source="#source-556-573">エッサッサ</seg></p>
      <p><seg source="#source-573-585">早く行け</seg><choice source="#source-585-591"><orig>／＼</orig><reg>〱</reg></choice><seg source="#source-591-608">ガッタガタ</seg></p>
      <p><seg source="#source-608-620">早く行け</seg><choice source="#source-620-626"><orig>／＼</orig><reg>〱</reg></choice><seg source="#source-626-641">ブーラブラ</seg></p>
    </body>
