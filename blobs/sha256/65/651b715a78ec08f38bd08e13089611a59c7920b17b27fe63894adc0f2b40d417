          <div>
            <head n="2" source="#source-48588-48701"><seg source="#source-48609-48615">○　</seg><ruby type="furigana" rend="right" source="#source-48615-48671"><rb><g ref="#gaiji-U-8F34-192-6" source="#source-48615-48659">輴</g></rb><rt>そり</rt></ruby></head>
          </div>
