/ruby><seg source="#source-159649-159652">を</seg><ruby type="furigana" rend="right" source="#source-159652-159667"><rb>取</rb><rt>とり</rt></ruby><ruby type="furigana" rend="right" source="#source-159667-159691"><rb>香花</rb><rt>かうくわ</rt></ruby><ruby type="furigana" rend="right" source="#source-159691-159715"><rb>神前</rb><rt>しんぜん</rt></ruby><seg source="#source-159715-159718">に</seg><ruby type="furigana" rend="right" source="#source-159718-159742"><rb>挿</rb><rt>さしはさみ</rt></ruby><ruby type="furigana" rend="right" source="#source-159742-159760"><rb>供</rb><rt>くうず</rt></ruby><seg source="#source-159760-159769">。次に</seg><ruby type="furigana" rend="right" source="#source-159769-159787"><rb>集</rb><rt>あつま</rt></ruby><seg source="#source-159787-159790">る</seg><ruby type="furigana" rend="right" source="#source-159790-159817"><rb>各童</rb><rt>わらべども</rt></ruby><seg source="#source-159817-159832">手に木刀を</seg><ruby type="furigana" rend="right" source="#source-159832-159847"><rb>執</rb><rt>とり</rt></ruby><ruby type="furigana" rend="right" source="#source-159847-159862"><rb>途</rb><rt>みち</rt></ruby><seg source="#source-159862-159865">に</seg><seg type="annotated-text" source="#source-159892-159952"><ruby type="furigana" rend="right" source="#source-159865-159892"><rb>隊閙</rb><rt>たいだうし</rt></ruby><note type="gloss" place="left"><seg source="#source-159922-159937">ムレサワギ</seg></note></seg><seg source="#source-159952-159955">、</seg><ruby type="furigana" rend="right" source="#source-159955-159973"><rb>凡</rb><rt>すべて</rt></ruby><ruby type="furigana" rend="right" source="#source-159973-160003"><rb>有婚</rb><rt>こんれいして</rt></ruby><ruby type="furigana" rend="right" source="#source-160003-160024"><rb>无子</rb><rt>こなき</rt></ruby><seg source="#source-160024-160027">の</seg><ruby type="furigana" rend="right" source="#source-160027-160045"><rb>婦</rb><rt>をんな</rt></ruby><seg source="#source-160045-160054">木刀を</seg><ruby type="furigana" rend="right" source="#source-160054-160069"><rb>将</rb><rt>もつ</rt></ruby><seg source