source="#source-3407-3410">に</seg><ruby type="furigana" rend="right" source="#source-3410-3425"><rb>埋</rb><rt>うも</rt></ruby><seg source="#source-3425-3440">れたのを、</seg><ruby type="furigana" rend="right" source="#source-3440-3464"><rb>燈心</rb><rt>とうしん</rt></ruby><seg source="#source-3464-3467">を</seg><ruby type="furigana" rend="right" source="#source-3467-3488"><rb>掻立</rb><rt>かきた</rt></ruby><seg source="#source-3488-3494">てる</seg><ruby type="furigana" rend="right" source="#source-3494-3521"><rb>意氣組</rb><rt>いきぐみ</rt></ruby><seg source="#source-3521-3527">で、</seg><ruby type="furigana" rend="right" source="#source-3527-3601"><rb><seg source="#source-3527-3530">引</seg><g ref="#gaiji-4-2-78-12" source="#source-3530-3583">毮</g></rb><rt>ひきむし</rt></ruby><seg source="#source-3601-3613">るやうに</seg><ruby type="furigana" rend="right" source="#source-3613-3640"><rb>拂落</rb><rt>はらひおと</rt></ruby><seg source="#source-3640-3649">して、</seg><ruby type="furigana" rend="right" source="#source-3649-3667"><rb>南</rb><rt>みなみ</rt></ruby><seg source="#source-3667-3670">か</seg><ruby type="furigana" rend="right" source="#source-3670-3685"><rb>北</rb><rt>きた</rt></ruby><seg source="#source-3685-3688">か</seg><ruby type="furigana" rend="right" source="#source-3688-3712"><rb>方角</rb><rt>はうがく</rt></ruby><seg source="#source-3712-3715">を</seg><ruby type="furigana" rend="right" source="#source-3715-3727"><rb>讀</rb><rt>よ</rt></ruby><seg source="#source-3727-3751">むつもりが、ぶる</seg><choice source="#source-3751-3757"><orig>／＼</orig><reg>〱</reg></choice><seg source="#source-3757-3760">と</seg><ruby type="furigana" rend="right" source="#source-3760-3784"><rb>十本</rb><rt>じつぽん</rt></ruby><seg source="#source-3784-3787">の</seg><ruby type="furigana" rend="right" source="#source-3787-3802"><rb>指</rb><rt>ゆび</rt></ruby><seg source="#source-3802-3805">を</seg><ruby type="furigana" rend="right" source="#source-3805-3820"><rb>震</rb><rt>ふる</rt></ruby><seg source="#source-3820-3832">はして、</seg><ruby type="furigana" rend="right" source