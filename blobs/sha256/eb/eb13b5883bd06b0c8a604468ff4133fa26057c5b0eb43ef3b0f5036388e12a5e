rb>一人</rb><rt>ひとり</rt></ruby><ruby type="furigana" rend="right" source="#source-44532-44547"><rb>影</rb><rt>かげ</rt></ruby><ruby type="furigana" rend="right" source="#source-44547-44565"><rb>暖</rb><rt>あたゝ</rt></ruby><seg source="#source-44565-44571">かく</seg><ruby type="furigana" rend="right" source="#source-44571-44589"><rb>彳</rb><rt>たゝず</rt></ruby><seg source="#source-44589-44598">んだ、</seg><ruby type="furigana" rend="right" source="#source-44598-44622"><rb>少年</rb><rt>せうねん</rt></ruby><seg source="#source-44622-44625">の</seg><ruby type="furigana" rend="right" source="#source-44625-44649"><rb>書生</rb><rt>しよせい</rt></ruby><seg source="#source-44649-44652">の</seg><ruby type="furigana" rend="right" source="#source-44652-44670"><rb>姿</rb><rt>すがた</rt></ruby><seg source="#source-44670-44682">がある。</seg><ruby type="furigana" rend="right" source="#source-44682-44694"><rb>其</rb><rt>そ</rt></ruby><seg source="#source-44694-44697">の</seg><ruby type="furigana" rend="right" source="#source-44697-44712"><rb>人</rb><rt>ひと</rt></ruby><seg source="#source-44712-44715">、</seg><ruby type="furigana" rend="right" source="#source-44715-44739"><rb>形容</rb><rt>けいよう</rt></ruby><seg source="#source-44739-44742">、</seg><ruby type="furigana" rend="right" source="#source-44742-44754"><rb>都</rb><rt>と</rt></ruby><seg source="#source-44754-44763">にして</seg><ruby type="furigana" rend="right" source="#source-44763-44778"><rb>麗</rb><rt>れい</rt></ruby><seg source="#source-44778-44790">なり、と</seg><ruby type="furigana" rend="right" source="#source-44790-44802"><rb>書</rb><rt>か</rt></ruby><seg source="#source-44802-44817">いてある。</seg><ruby type="furigana" rend="right" source="#source-44817-44847"><rb>若旦那</rb><rt>わかだんな</rt></ruby><seg source="#source-44847-44853">には</seg><ruby type="furigana" rend="right" source="#source-44853-44865"><rb>氣</rb><rt>き</rt></ruby><seg source="#source-44865-44868">の</seg><ruby type="furigana" rend="right" source="#source-44868-44883"><rb>毒</rb><rt>どく</rt></ruby><seg source="#source-44883-44