      <div type="layout" source="#source-687-769" style="padding-inline-start: 8em">
        <div>
          <head n="2" source="#source-708-765"><ruby type="furigana" rend="right" source="#source-708-729"><rb>曠野</rb><rt>あらの</rt></ruby></head>
