        <p style="text-indent: 1em" rend="first-line-indent(1)"><seg source="#source-20121-20147">はなればなれに</seg></p>
        <p style="text-indent: 3em" rend="first-line-indent(3)"><seg source="#source-20147-20175">波々打つな</seg></p>
        <p><seg source="#source-20175-20192">同じ海でも</seg></p>
