        <p><seg source="#source-20218-20241">ざんぶざんぶと</seg></p>
        <p style="text-indent: 3em" rend="first-line-indent(3)"><seg source="#source-20241-20272">かなしい海か</seg></p>
        <p style="text-indent: 1em" rend="first-line-indent(1)"><seg source="#source-20272-20298">はなればなれに</seg></p>
        <p style="text-indent: 3em" rend="first-line-indent(3)"><seg source="#source-20298-20328">波々打つな</seg></p>
      </div>
      <div type="layout" source="#source-20328-20401" style="padding-inline-start: 1em">
        <div>
