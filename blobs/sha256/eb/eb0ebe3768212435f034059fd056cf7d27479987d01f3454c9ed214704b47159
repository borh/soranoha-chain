      <p source="#source-394-453"><seg source="#source-394-397">お</seg><ruby type="furigana" rend="right" source="#source-397-412"><rb>母</rb><rt>かあ</rt></ruby><ruby type="furigana" rend="right" source="#source-412-424"><rb>火</rb><rt>ひ</rt></ruby><seg source="#source-424-427">を</seg><ruby type="furigana" rend="right" source="#source-427-439"><rb>燃</rb><rt>も</rt></ruby><seg source="#source-439-453">すけえ。</seg></p>
      <p source="#source-453-530"><seg source="#source-453-465">そねえに</seg><ruby type="furigana" rend="right" source="#source-465-477"><rb>燃</rb><rt>も</rt></ruby><seg source="#source-477-492">さなくても</seg><ruby type="furigana" rend="right" source="#source-492-510"><rb>温</rb><rt>あたた</rt></ruby><seg source="#source-510-530">けえないか。</seg></p>
      <p source="#source-530-592"><seg source="#source-530-539">だって</seg><ruby type="furigana" rend="right" source="#source-539-560"><rb>今日</rb><rt>きょう</rt></ruby><seg source="#source-560-563">は</seg><ruby type="furigana" rend="right" source="#source-563-578"><rb>寒</rb><rt>さむ</rt></ruby><seg source="#source-578-592">いもの。</seg></p>
      <p source="#source-592-645"><ruby type="furigana" rend="right" source="#source-592-607"><rb>寒</rb><rt>さむ</rt></ruby><seg source="#source-607-645">いか、そんだらくべろえ。</seg></p>
      <p source="#source-645-737"><ruby type="furigana" rend="right" source="#source-645-663"><rb>明日</rb><rt>あす</rt></ruby><seg source="#source-663-672">、また</seg><ruby type="furigana" rend="right" source="#source-672-684"><rb>出</rb><rt>で</rt></ruby><seg source="#source-684-687">て</seg><ruby type="furigana" rend="right" source="#source-687-705"><rb>薪</rb><rt>たきぎ</rt></ruby><ruby type="furigana" rend="right" source="#source-705-717"><rb>取</rb><rt>と</rt></ruby><seg source="#source-717-737">ってくるわの</seg></p>
      <p source="#source-737-792"><seg source="#source-737-743">そう</seg><ruby type="furigana" rend="right" source="#source-743-767"><rb>心配</rb><rt>しんぱい</rt></ruby><seg source="#source-767-792">さっしゃんな。</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)" source="#source-792-835"><seg source="#source-792-835">＊　＊　＊　＊　＊　＊</seg></p>
      <p source="#source-835-912"><seg source="#source-835-838">お</seg><ruby type="furigana" rend="right" source="#source-838-853"><rb>母</rb><rt>かあ</rt></ruby><seg source="#source-853-856">、</seg><ruby type="furigana" rend="right" source="#source-856-868"><rb>燃</rb><rt>も</rt></ruby><seg source="#source-868-877">えたぜ</seg><ruby type="furigana" rend="right" source="#source-877-889"><rb>当</rb><rt>あ</rt></ruby><seg source="#source-889-912">たらっしゃい。</seg></p>
      <p source="#source-912-986"><ruby type="furigana" rend="right" source="#source-912-927"><rb>汝</rb><rt>われ</rt></ruby><seg source="#source-927-960">、やかましいそげなもの</seg><ruby type="furigana" rend="right" source="#source-960-972"><rb>吹</rb><rt>ふ</rt></ruby><seg source="#source-972-986">くなよ。</seg></p>
      <p source="#source-986-1042"><seg source="#source-986-1042">ごじゅうからがたくさんきていたぜの、</seg></p>
      <p source="#source-1042-1119"><seg source="#source-1042-1054">あっちの</seg><ruby type="furigana" rend="right" source="#source-1054-1075"><rb>神社</rb><rt>おみや</rt></ruby><seg source="#source-1075-1078">の</seg><ruby type="furigana" rend="right" source="#source-1078-1093"><rb>森</rb><rt>もり</rt></ruby><seg source="#source-1093-1119">にきていたぜの、</seg></p>
      <p source="#source-1119-1163"><seg source="#source-1119-1125">ほら</seg><ruby type="furigana" rend="right" source="#source-1125-1137"><rb>鳴</rb><rt>な</rt></ruby><seg source="#source-1137-1163">いているだろの、</seg></p>
      <p source="#source-1163-1258"><ruby type="furigana" rend="right" source="#source-1163-1178"><rb>俺</rb><rt>おら</rt></ruby><seg source="#source-1178-1187">のこの</seg><ruby type="furigana" rend="right" source="#source-1187-1202"><rb>笛</rb><rt>ふえ</rt></ruby><ruby type="furigana" rend="right" source="#source-1202-1214"><rb>聞</rb><rt>き</rt></ruby><seg source="#source-1214-1220">いて</seg><ruby type="furigana" rend="right" source="#source-1220-1232"><rb>鳴</rb><rt>な</rt></ruby><seg source="#source-1232-1258">いているだろの？</seg></p>
      <p source="#source-1258-1320"><hi rend="bouten 傍点 right" source="#source-1258-1318" corresp="#source-1276-1318"><seg source="#source-1258-1276">ふいふいふい</seg></hi></p>
      <p source="#source-1320-1383"><ruby type="furigana" rend="right" source="#source-1320-1335"><rb>悲</rb><rt>かな</rt></ruby><seg source="#source-1335-1341">しく</seg><ruby type="furigana" rend="right" source="#source-1341-1353"><rb>鳴</rb><rt>な</rt></ruby><seg source="#source-1353-1356">る</seg><ruby type="furigana" rend="right" source="#source-1356-1380"><rb>管笛</rb><rt>くだぶえ</rt></ruby><seg source="#source-1380-1383">。</seg></p>
    </body>
