        <p style="text-indent: 1em" rend="first-line-indent(1)"><seg source="#source-78907-78922">それから</seg><ruby type="furigana" rend="right" source="#source-78922-78937"><rb>遠</rb><rt>とほ</rt></ruby><seg source="#source-78937-78952">くへかけて</seg><ruby type="furigana" rend="right" source="#source-78952-78976"><rb>旅行</rb><rt>りよこう</rt></ruby><seg source="#source-78976-79012">するとわかることですが、</seg><ruby type="furigana" rend="right" source="#source-79012-79027"><rb>例</rb><rt>たと</rt></ruby><seg source="#source-79027-79033">へば</seg><ruby type="furigana" rend="right" source="#source-79033-79057"><rb>臺灣</rb><rt>たいわん</rt></ruby><seg source="#source-79057-79063">から</seg><ruby type="furigana" rend="right" source="#source-79063-79093"><rb>九州</rb><rt>きゆうしゆう</rt></ruby><seg source="#source-79093-79096">へ</seg><ruby type="furigana" rend="right" source="#source-79096-79111"><rb>渡</rb><rt>わた</rt></ruby><seg source="#source-79111-79117">り、</seg><ruby type="furigana" rend="right" source="#source-79117-79144"><rb>本州</rb><rt>ほんしゆう</rt></ruby><seg source="#source-79144-79147">を</seg><ruby type="furigana" rend="right" source="#source-79147-79174"><rb>縱斷</rb><rt>じゆうだん</rt></ruby><seg source="#source-79174-79180">して</seg><ruby type="furigana" rend="right" source="#source-79180-79213"><rb>北海道</rb><rt>ほつかいどう</rt></ruby><seg source="#source-79213-79216">へ</seg><ruby type="furigana" rend="right" source="#source-79216-79228"><rb>行</rb><rt>い</rt></ruby><seg source="#source-79228-79249">くとしますと、</seg><ruby type="furigana" rend="right" source="#source-79249-79279"><rb>九州</rb><rt>きゆうしゆう</rt></ruby><seg source="#source-79279-79285">では</seg><ruby type="furigana" rend="right" source="#source-79285-79309"><rb>臺灣</rb><rt>たいわん</rt></ruby><seg source="#source-79309-79312">で</seg><ruby type="furigana" rend="right" source="#source-79312-79324"><rb>見</rb><rt>み</rt></ruby><seg source="#source-79324-79336">なかつた</seg><ruby type="furigana" rend="right" source="#source-79336-79348"><rb>木</rb><rt>き</rt></ruby><seg source="#source-79348-79351">が</seg><ruby type="furigana" rend="right" source="#source-79351-79366"><rb>茂</rb><rt>しげ</rt></ruby><seg source="#source-79366-79381">つてをり、</seg><ruby type="furigana" rend="right" source="#source-79381-79414"><rb>北海道</rb><rt>ほつかいどう</rt></ruby><seg source="#source-79414-79432">へはひると、</seg><ruby type="furigana" rend="right" source="#source-79432-79447"><rb>又</rb><rt>また</rt></ruby><seg source="#source-79447-79471">さらに、すっかり</seg><ruby type="furigana" rend="right" source="#source-79471-79486"><rb>變</rb><rt>かは</rt></ruby><seg source="#source-79486-79492">つた</seg><ruby type="furigana" rend="right" source="#source-79492-79504"><rb>木</rb><rt>き</rt></ruby><seg source="#source-79504-79543">ばかりで、かなり、ちがつた</seg><ruby type="furigana" rend="right" source="#source-79543-79558"><rb>遠</rb><rt>とほ</rt></ruby><seg source="#source-79558-79561">い</seg><ruby type="furigana" rend="right" source="#source-79561-79576"><rb>國</rb><rt>くに</rt></ruby><seg source="#source-79576-79579">へ</seg><ruby type="furigana" rend="right" source="#source-79579-79591"><rb>來</rb><rt>き</rt></ruby><seg source="#source-79591-79603">たといふ</seg><ruby type="furigana" rend="right" source="#source-79603-79618"><rb>感</rb><rt>かん</rt></ruby><seg source="#source-79618-79648">じがします。かういふ</seg><ruby type="furigana" rend="right" source="#source-79648-79663"><rb>風</rb><rt>ふう</rt></ruby><seg source="#source-79663-79669">に、</seg><ruby type="furigana" rend="right" source="#source-79669-79687"><rb>土地</rb><rt>とち</rt></ruby><seg source="#source-79687-79690">の</seg><ruby type="furigana" rend="right" source="#source-79690-79714"><rb>高低</rb><rt>こうてい</rt></ruby><seg source="#source-79714-79717">や</seg><ruby type="furigana" rend="right" source="#source-79717-79735"><rb>位置</rb><rt>いち</rt></ruby><seg source="#source-79735-79738">の</seg><ruby type="furigana" rend="right" source="#source-79738-79759"><rb>相違</rb><rt>そうい</rt></ruby><seg source="#source-79759-79774">によつて、</seg><ruby type="furigana" rend="right" source="#source-7