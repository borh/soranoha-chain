<rb>我國</rb><rt>わがくに</rt></ruby><seg source="#source-44676-44679">に</seg><ruby type="furigana" rend="right" source="#source-44679-44703"><rb>移植</rb><rt>いしよく</rt></ruby><seg source="#source-44703-44709">され</seg><ruby type="furigana" rend="right" source="#source-44709-44724"><rb>多</rb><rt>おほ</rt></ruby><seg source="#source-44724-44730">くは</seg><ruby type="furigana" rend="right" source="#source-44730-44751"><rb>庭木</rb><rt>にはき</rt></ruby><seg source="#source-44751-44760">として</seg><ruby type="furigana" rend="right" source="#source-44760-44796"><rb>灌木状</rb><rt>かんぼくじよう</rt></ruby><seg source="#source-44796-44817">をしてゐます。</seg><ruby type="furigana" rend="right" source="#source-44817-44844"><rb>東京</rb><rt>とうきよう</rt></ruby><seg source="#source-44844-44850">では</seg><ruby type="furigana" rend="right" source="#source-44850-44874"><rb>一月</rb><rt>いちがつ</rt></ruby><ruby type="furigana" rend="right" source="#source-44874-44904"><rb>中旬</rb><rt>ちゆうじゆん</rt></ruby><seg source="#source-44904-44907">に</seg><ruby type="furigana" rend="right" source="#source-44907-44925"><rb>蕾</rb><rt>つぼみ</rt></ruby><seg source="#source-44925-44928">を</seg><ruby type="furigana" rend="right" source="#source-44928-44943"><rb>開</rb><rt>ひら</rt></ruby><seg source="#source-44943-44946">き</seg><ruby type="furigana" rend="right" source="#source-44946-44961"><rb>初</rb><rt>はじ</rt></ruby><seg source="#source-44961-44967">め、</seg><ruby type="furigana" rend="right" source="#source-44967-44988"><rb>二月</rb><rt>にがつ</rt></ruby><seg source="#source-44988-44991">に</seg><ruby type="furigana" rend="right" source="#source-44991-45006"><rb>至</rb><rt>いた</rt></ruby><seg source="#source-45006-45012">つて</seg><ruby type="furigana" rend="right" source="#source-45012-45036"><rb>滿開</rb><rt>まんかい</rt></ruby><seg source="#source-45036-45042">し、</seg><ruby type="furigana" rend="right" source="#source-45042-45066"><rb>三月</rb><rt>さんがつ</rt></ruby><seg source="#source-45066-45069">の</seg><ruby type="furigana" rend="right" source="#source-45069-45099"><rb>上旬</rb><rt>じようじゆん</rt></ruby><seg source="#source-45099-45105">まで</seg><ruby type="furigana" rend="right" source="#source-45105-45120"><rb>花</rb><rt>はな</rt></ruby><seg source="#source-45120-45123">を</seg><ruby type="furigana" rend="right" source="#source-45123-45138"><rb>開</rb><rt>ひら</rt></ruby><seg source="#source-45138-45167">きつゞけてゐます。</seg></p>
