        <p style="text-indent: 1em" rend="first-line-indent(1)"><ruby type="furigana" rend="right" source="#source-74954-74978"><rb>以上</rb><rt>いじよう</rt></ruby><seg source="#source-74978-74981">の</seg><ruby type="furigana" rend="right" source="#source-74981-74996"><rb>外</rb><rt>ほか</rt></ruby><ruby type="furigana" rend="right" source="#source-74996-75020"><rb>日本</rb><rt>につぽん</rt></ruby><seg source="#source-75020-75026">には</seg><ruby type="furigana" rend="right" source="#source-75026-75047"><rb>各地</rb><rt>かくち</rt></ruby><seg source="#source-75047-75050">に</seg><ruby type="furigana" rend="right" source="#source-75050-75074"><rb>老樹</rb><rt>ろうじゆ</rt></ruby><ruby type="furigana" rend="right" source="#source-75074-75098"><rb>名木</rb><rt>めいぼく</rt></ruby><seg source="#source-75098-75113">があつて、</seg><ruby type="furigana" rend="right" source="#source-75113-75137"><rb>一々</rb><rt><seg source="#source-75122-75128">いち</seg><choice source="#source-75128-75134"><orig>／＼</orig><reg>〱</reg></choice></rt></ruby><seg source="#source-75137-75146">あげて</seg><ruby type="furigana" rend="right" source="#source-75146-75161"><rb>數</rb><rt>かぞ</rt></ruby><seg source="#source-75161-75176">へることも</seg><ruby type="furigana" rend="right" source="#source-75176-75194"><rb>出來</rb><rt>でき</rt></ruby><seg source="#source-75194-75206">ません。</seg><ruby type="furigana" rend="right" source="#source-75206-75230"><rb>日本</rb><rt>につぽん</rt></ruby><seg source="#source-75230-75233">で</seg><ruby type="furigana" rend="right" source="#source-75233-75251"><rb>最</rb><rt>もつと</rt></ruby><seg source="#source-75251-75266">もおほきく</seg><ruby type="furigana" rend="right" source="#source-75266-75293"><rb>生長</rb><rt>せいちよう</rt></ruby><seg source="#source-75293-75299">する</seg><ruby type="furigana" rend="right" source="#source-75299-75311"><rb>木</rb><rt>き</rt></ruby><seg source="#source-75311-75314">は</seg><hi rend="bouten 傍点 right" source="#source-75314-75350"><seg source="#source-75314-75320">くす</seg></hi><seg source="#source-75350-7535