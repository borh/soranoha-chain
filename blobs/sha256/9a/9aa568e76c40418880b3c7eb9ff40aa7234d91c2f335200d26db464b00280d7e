      <p source="#source-709-744"><seg source="#source-709-733">気も遠く世も消え</seg><choice source="#source-733-739"><orig>／＼</orig><reg>〱</reg></choice><seg source="#source-739-744">や</seg></p>
      <p source="#source-744-770"><seg source="#source-744-770">丑三つの森の奥の</seg></p>
      <p source="#source-770-817"><ruby type="furigana" rend="right" source="#source-770-797"><rb>白檀</rb><rt>びやくたん</rt></ruby><seg source="#source-797-817">ほのにくゆり</seg></p>
      <p source="#source-817-864"><ruby type="furigana" rend="right" source="#source-817-841"><rb>木薩地</rb><rt>こさぢ</rt></ruby><seg source="#source-841-864">しづき頃ほひ。</seg></p>
      <p source="#source-864-908"><ruby type="furigana" rend="right" source="#source-864-885"><rb>魑魅</rb><rt>すだま</rt></ruby><seg source="#source-885-908">が気夢にふれて</seg></p>
      <p source="#source-908-961"><ruby type="furigana" rend="right" source="#source-908-923"><rb>孵</rb><rt>かへ</rt></ruby><seg source="#source-923-929">りし</seg><ruby type="furigana" rend="right" source="#source-929-944"><rb>我</rb><rt>われ</rt></ruby><seg source="#source-944-961">かの心地。</seg></p>
      <p source="#source-961-1008"><ruby type="furigana" rend="right" source="#source-961-991"><rb>皐月闇</rb><rt>さつきやみ</rt></ruby><seg source="#source-991-1008">霊気ばしる</seg></p>
      <p source="#source-1008-1052"><seg source="#source-1008-1023">夜半の戸に</seg><ruby type="furigana" rend="right" source="#source-1023-1038"><rb>額</rb><rt>ぬか</rt></ruby><seg source="#source-1038-1052">を垂れて</seg></p>
      <p source="#source-1052-1105"><seg source="#source-1052-1076">あゝ堪へ難き胸の</seg><ruby type="furigana" rend="right" source="#source-1076-1100"><rb>狂火</rb><rt>くるひゞ</rt></ruby><seg source="#source-1100-1105">。</seg></p>
      <p source="#source-1105-1139"><seg source="#source-1105-1139">雛よばふ焼野の雉子の</seg></p>
      <p source="#source-1139-1168"><seg source="#source-1139-1168">闇睨む眼か　きらに</seg></p>
      <p source="#source-1168-1200"><seg source="#source-1168-1200">燃え飛ぶ野火の遠火の</seg></p>
      <p source="#source-1200-1259"><ruby type="furigana" rend="right" source="#source-1200-1230"><rb>青火魂</rb><rt>あおひだま</rt></ruby><seg source="#source-1230-1259">――あなやの刹那。</seg></p>
      <p source="#source-1259-1303"><ruby type="furigana" rend="right" source="#source-1259-1283"><rb>魄霊</rb><rt>なほしび</rt></ruby><seg source="#source-1283-1303">ゆらに揺ぎつ</seg></p>
      <p source="#source-1303-1362"><ruby type="furigana" rend="right" source="#source-1303-1324"><rb>讃歌</rb><rt>さんか</rt></ruby><ruby type="furigana" rend="right" source="#source-1324-1345"><rb>咽喉</rb><rt>のみど</rt></ruby><seg source="#source-1345-1362">をあふれて</seg></p>
      <p source="#source-1362-1394"><seg source="#source-1362-1394">狂ひ心地、小手招き、</seg></p>
      <p source="#source-1394-1423"><seg source="#source-1394-1423">いと深き闇のをちに</seg></p>
      <p source="#source-1423-1488"><seg source="#source-1423-1444">認め得し小さき</seg><ruby type="furigana" rend="right" source="#source-1444-1462"><rb>焔</rb><rt>ほのほ</rt></ruby><seg source="#source-1462-1465">の</seg><ruby type="furigana" rend="right" source="#source-1465-1483"><rb>后</rb><rt>きさい</rt></ruby><seg source="#source-1483-1488">。</seg></p>
      <p source="#source-1488-1535"><ruby type="furigana" rend="right" source="#source-1488-1512"><rb>五十年</rb><rt>いそぢ</rt></ruby><seg source="#source-1512-1535">のわが歌の世を</seg></p>
      <p source="#source-1535-1573"><ruby type="furigana" rend="right" source="#source-1535-1559"><rb>上下</rb><rt>かみしも</rt></ruby><seg source="#source-1559-1573">の永劫に</seg></p>
      <p source="#source-1573-1620"><seg source="#source-1573-1591">うるはしくも</seg><ruby type="furigana" rend="right" source="#source-1591-1612"><rb>霊妙</rb><rt>いみじ</rt></ruby><seg source="#source-1612-1620">く。</seg></p>
      <p source="#source-1620-1661"><seg source="#source-1620-1629">不滅の</seg><ruby type="furigana" rend="right" source="#source-1629-1650"><rb>光明</rb><rt>ひかり</rt></ruby><seg source="#source-1650-1661">の宮の</seg></p>
      <p source="#source-1661-1729"><ruby type="furigana" rend="right" source="#source-1661-1685"><rb>常虹</rb><rt>とこにじ</rt></ruby><seg source="#source-1685-1688">の</seg><ruby type="furigana" rend="right" source="#source-1688-1709"><rb>御座</rb><rt>みくら</rt></ruby><seg source="#source-1709-1712">の</seg><ruby type="furigana" rend="right" source="#source-1712-1724"><rb>上</rb><rt>へ</rt></ruby><seg source="#source-1724-1729">。</seg></p>
      <p source="#source-1729-1770"><seg source="#source-1729-1735">われ</seg><ruby type="furigana" rend="right" source="#source-1735-1756"><rb>生命</rb><rt>いのち</rt></ruby><seg source="#source-1756-1770">の王者が</seg></p>
      <p source="#source-1770-1826"><ruby type="furigana" rend="right" source="#source-1770-1785"><rb>斎</rb><rt>いつ</rt></ruby><seg source="#source-1785-1806">かれむほのほの</seg><ruby type="furigana" rend="right" source="#source-1806-1824"><rb>后</rb><rt>きさい</rt></ruby></p>
      <p source="#source-1826-1897"><seg source="#source-1826-1829">猛</seg><ruby type="furigana" rend="right" source="#source-1829-1847"><rb>火</rb><rt>くわ</rt></ruby><seg source="#source-1847-1850">の</seg><ruby type="furigana" rend="right" source="#source-1850-1871"><rb>天衣</rb><rt>てんね</rt></ruby><ruby type="furigana" rend="right" source="#source-1871-1892"><rb>左手</rb><rt>ゆんで</rt></ruby><seg source="#source-1892-1897">に</seg></p>
      <p source="#source-1897-1985"><ruby type="furigana" rend="right" source="#source-1897-1918"><rb>着代</rb><rt>きかへ</rt></ruby><seg source="#source-1918-1933">をすゝむる</seg><ruby type="furigana" rend="right" source="#source-1933-1951"><rb>情</rb><rt>じやう</rt></ruby><seg source="#source-1951-1954">の</seg><ruby type="furigana" rend="right" source="#source-1954-1975"><rb>素振</rb><rt>そぶり</rt></ruby><seg source="#source-1975-1985">よ。</seg></p>
      <p source="#source-1985-2032"><seg source="#source-1985-1994">この時</seg><ruby type="furigana" rend="right" source="#source-1994-2021"><rb>白隼</rb><rt>しらはや</rt></ruby><seg source="#source-2021-2032">とびて</seg></p>
      <p source="#source-2032-2100"><ruby type="furigana" rend="right" source="#source-2032-2047"><rb>天</rb><rt>あめ</rt></ruby><seg source="#source-2047-2056">の世に</seg><ruby type="furigana" rend="right" source="#source-2056-2074"><rb>拍手</rb><rt>はで</rt></ruby><seg source="#source-2074-2080">打つ</seg><ruby type="furigana" rend="right" source="#source-2080-2092"><rb>音</rb><rt>ね</rt></ruby><seg source="#source-2092-2100">もす</seg></p>
      <p source="#source-2100-2132"><seg source="#source-2100-2132">くつがへれ今のこの世</seg></p>
      <p source="#source-2132-2176"><seg source="#source-2132-2144">我こそは</seg><ruby type="furigana" rend="right" source="#source-2144-2165"><rb>理想</rb><rt>おもひ</rt></ruby><seg source="#source-2165-2176">の宮に</seg></p>
      <p source="#source-2176-2211"><seg source="#source-2176-2211">ひとり笑む王者なるぞ。</seg></p>
      <p source="#source-2211-2237"><seg source="#source-2211-2237">焔そは燃ゆるもの</seg></p>
      <p source="#source-2237-2284"><seg source="#source-2237-2243">身の</seg><ruby type="furigana" rend="right" source="#source-2243-2261"><rb>膏</rb><rt>あぶら</rt></ruby><seg source="#source-2261-2284">しぼるものか。</seg></p>
      <p source="#source-2284-2343"><seg source="#source-2284-2299">あゝ好し、</seg><ruby type="furigana" rend="right" source="#source-2299-2317"><rb>后</rb><rt>きさい</rt></ruby><seg source="#source-2317-2320">に</seg><ruby type="furigana" rend="right" source="#source-2320-2335"><rb>参</rb><rt>まゐ</rt></ruby><seg source="#source-2335-2343">る。</seg></p>
      <p source="#source-2343-2400"><seg source="#source-2343-2355">焼けても</seg><ruby type="furigana" rend="right" source="#source-2355-2376"><rb>人世</rb><rt>じんせ</rt></ruby><seg source="#source-2376-2400">の外に活くべし。</seg></p>
    </body>
