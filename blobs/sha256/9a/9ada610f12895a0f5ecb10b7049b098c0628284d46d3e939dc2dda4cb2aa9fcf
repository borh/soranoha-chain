ource-58055-58058">が</seg><ruby type="furigana" rend="right" source="#source-58058-58070"><rb>子</rb><rt>こ</rt></ruby><seg source="#source-58070-58076">とは</seg><ruby type="furigana" rend="right" source="#source-58076-58091"><rb>認</rb><rt>みと</rt></ruby><seg source="#source-58091-58106">めぬとまで</seg><ruby type="furigana" rend="right" source="#source-58106-58127"><rb>云張</rb><rt>いいは</rt></ruby><seg source="#source-58127-58175">った。が、アンドレイ、エヒミチは</seg><ruby type="furigana" rend="right" source="#source-58175-58190"><rb>父</rb><rt>ちち</rt></ruby><seg source="#source-58190-58193">の</seg><ruby type="furigana" rend="right" source="#source-58193-58211"><rb>言</rb><rt>ことば</rt></ruby><seg source="#source-58211-58229">ではあるが、</seg><ruby type="furigana" rend="right" source="#source-58229-58250"><rb>自分</rb><rt>じぶん</rt></ruby><seg source="#source-58250-58265">はこれまで</seg><ruby type="furigana" rend="right" source="#source-58265-58286"><rb>医学</rb><rt>いがく</rt></ruby><seg source="#source-58286-58289">に</seg><ruby type="furigana" rend="right" source="#source-58289-58304"><rb>対</rb><rt>たい</rt></ruby><seg source="#source-58304-58322">して、また一</seg><ruby type="furigana" rend="right" source="#source-58322-58340"><rb>般</rb><rt>ぱん</rt></ruby><seg source="#source-58340-58343">の</seg><ruby type="furigana" rend="right" source="#source-58343-58382"><rb>専門学科</rb><rt>せんもんがっか</rt></ruby><seg source="#source-58382-58385">に</seg><ruby type="furigana" rend="right" source="#source-58385-58400"><rb>対</rb><rt>たい</rt></ruby><seg source="#source-58400-58409">して、</seg><ruby type="furigana" rend="right" source="#source-58409-58430"><rb>使命</rb><rt>しめい</rt></ruby><seg source="#source-58430-58433">を</seg><ruby type="furigana" rend="right" source="#source-58433-58448"><rb>感</rb><rt>かん</rt></ruby><seg source="#source-58448-58463">じたことは</seg><ruby type="furigana" rend="right" source="#source-58463-58475"><rb>無</rb><rt>な</rt></ruby><seg source="#source-58475-58487">かったと</seg><ruby type="furigana" rend="right" source="#source-584