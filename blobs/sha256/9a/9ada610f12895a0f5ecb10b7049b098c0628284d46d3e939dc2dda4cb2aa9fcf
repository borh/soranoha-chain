<seg source="#source-133711-133714">か</seg><ruby type="furigana" rend="right" source="#source-133714-133729"><rb>孫</rb><rt>まご</rt></ruby><seg source="#source-133729-133738">かは、</seg><ruby type="furigana" rend="right" source="#source-133738-133753"><rb>遂</rb><rt>つい</rt></ruby><seg source="#source-133753-133762">にその</seg><ruby type="furigana" rend="right" source="#source-133762-133783"><rb>時代</rb><rt>じだい</rt></ruby><seg source="#source-133783-133786">に</seg><ruby type="furigana" rend="right" source="#source-133786-133798"><rb>遇</rb><rt>あ</rt></ruby><seg source="#source-133798-133816">いましょう。</seg><ruby type="furigana" rend="right" source="#source-133816-133837"><rb>私</rb><rt>わたくし</rt></ruby><seg source="#source-133837-133840">は</seg><ruby type="furigana" rend="right" source="#source-133840-133864"><rb>誠心</rb><rt>まごころ</rt></ruby><seg source="#source-133864-133867">を</seg><ruby type="furigana" rend="right" source="#source-133867-133882"><rb>以</rb><rt>もっ</rt></ruby><seg source="#source-133882-133885">て</seg><ruby type="furigana" rend="right" source="#source-133885-133906"><rb>彼等</rb><rt>かれら</rt></ruby><seg source="#source-133906-133909">を</seg><ruby type="furigana" rend="right" source="#source-133909-133927"><rb>祝</rb><rt>しゅく</rt></ruby><seg source="#source-133927-133939">します、</seg><ruby type="furigana" rend="right" source="#source-133939-133960"><rb>彼等</rb><rt>かれら</rt></ruby><seg source="#source-133960-133963">の</seg><ruby type="furigana" rend="right" source="#source-133963-133978"><rb>為</rb><rt>ため</rt></ruby><seg source="#source-133978-133981">に</seg><ruby type="furigana" rend="right" source="#source-133981-133999"><rb>喜</rb><rt>よろこ</rt></ruby><seg source="#source-133999-134014">びます！　</seg><ruby type="furigana" rend="right" source="#source-134014-134029"><rb>進</rb><rt>すす</rt></ruby><seg source="#source-134029-134038">め！　</seg><ruby type="furigana" rend="right" source="#source-134038-134050"><rb>我</rb><rt>わ</rt></ruby><seg source="#source-134050-134053">が</seg><ruby type