2133"><rb>奴等</rb><rt>やつら</rt></ruby><seg source="#source-202133-202154">ばかりだとか、</seg><ruby type="furigana" rend="right" source="#source-202154-202178"><rb>乗馬</rb><rt>じょうば</rt></ruby><seg source="#source-202178-202181">で</seg><ruby type="furigana" rend="right" source="#source-202181-202193"><rb>行</rb><rt>ゆ</rt></ruby><seg source="#source-202193-202202">けば一</seg><ruby type="furigana" rend="right" source="#source-202202-202220"><rb>日</rb><rt>にち</rt></ruby><seg source="#source-202220-202244">に百ヴェルスタも</seg><ruby type="furigana" rend="right" source="#source-202244-202256"><rb>飛</rb><rt>と</rt></ruby><seg source="#source-202256-202274">ばせて、その</seg><ruby type="furigana" rend="right" source="#source-202274-202289"><rb>上</rb><rt>うえ</rt></ruby><ruby type="furigana" rend="right" source="#source-202289-202310"><rb>愉快</rb><rt>ゆかい</rt></ruby><seg source="#source-202310-202313">に</seg><ruby type="furigana" rend="right" source="#source-202313-202328"><rb>感</rb><rt>かん</rt></ruby><seg source="#source-202328-202349">じられるとか、</seg><ruby type="furigana" rend="right" source="#source-202349-202373"><rb>我々</rb><rt>われわれ</rt></ruby><seg source="#source-202373-202376">の</seg><ruby type="furigana" rend="right" source="#source-202376-202397"><rb>地方</rb><rt>ちほう</rt></ruby><seg source="#source-202397-202400">の</seg><ruby type="furigana" rend="right" source="#source-202400-202421"><rb>不作</rb><rt>ふさく</rt></ruby><seg source="#source-202421-202436">なのはピン</seg><ruby type="furigana" rend="right" source="#source-202436-202451"><rb>沼</rb><rt>ぬま</rt></ruby><seg source="#source-202451-202460">などを</seg><ruby type="furigana" rend="right" source="#source-202460-202475"><rb>枯</rb><rt>から</rt></ruby><seg source="#source-202475-202505">してしまったからだ、</seg><ruby type="furigana" rend="right" source="#source-202505-202529"><rb>非常</rb><rt>ひじょう</rt></ruby><seg source="#source-202529-202532">な</seg><ruby type="furigana" rend="right" source="#source-202532-202556"><rb>乱暴</rb><rt>らんぼう</rt></ruby><seg source="#source-202556-2025