<seg source="#source-110766-110778">く、その</seg><ruby type="furigana" rend="right" source="#source-110778-110790"><rb>言</rb><rt>い</rt></ruby><seg source="#source-110790-110793">う</seg><ruby type="furigana" rend="right" source="#source-110793-110811"><rb>所</rb><rt>ところ</rt></ruby><seg source="#source-110811-110814">を</seg><ruby type="furigana" rend="right" source="#source-110814-110838"><rb>批評</rb><rt>ひひょう</rt></ruby><seg source="#source-110838-110850">せずして</seg><ruby type="furigana" rend="right" source="#source-110850-110865"><rb>信</rb><rt>しん</rt></ruby><seg source="#source-110865-110880">じている。</seg><ruby type="furigana" rend="right" source="#source-110880-110895"><rb>例</rb><rt>たと</rt></ruby><seg source="#source-110895-110904">えば、</seg><ruby type="furigana" rend="right" source="#source-110904-110928"><rb>溶解</rb><rt>ようかい</rt></ruby><seg source="#source-110928-110934">せる</seg><ruby type="furigana" rend="right" source="#source-110934-110952"><rb>鉛</rb><rt>なまり</rt></ruby><seg source="#source-110952-110955">を</seg><ruby type="furigana" rend="right" source="#source-110955-110970"><rb>口</rb><rt>くち</rt></ruby><seg source="#source-110970-110973">に</seg><ruby type="furigana" rend="right" source="#source-110973-110985"><rb>入</rb><rt>い</rt></ruby><seg source="#source-110985-111000">るるとも、</seg><ruby type="furigana" rend="right" source="#source-111000-111015"><rb>少</rb><rt>すこ</rt></ruby><seg source="#source-111015-111021">しも</seg><ruby type="furigana" rend="right" source="#source-111021-111045"><rb>不思議</rb><rt>ふしぎ</rt></ruby><seg source="#source-111045-111051">には</seg><ruby type="furigana" rend="right" source="#source-111051-111066"><rb>思</rb><rt>おも</rt></ruby><seg source="#source-111066-111108">わぬであろう。が、もしこれが</seg><ruby type="furigana" rend="right" source="#source-111108-111120"><rb>他</rb><rt>た</rt></ruby><seg source="#source-111120-111123">の</seg><ruby type="furigana" rend="right" source="#source-111123-111141"><rb>所</rb><rt>ところ</rt></ruby><seg source="#source-111141-111180">においては