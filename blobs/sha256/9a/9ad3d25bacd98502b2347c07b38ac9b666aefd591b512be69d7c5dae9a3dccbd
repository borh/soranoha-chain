      <p source="#source-244-282"><ruby type="furigana" rend="right" source="#source-244-259"><rb>風</rb><rt>かぜ</rt></ruby><seg source="#source-259-265">ふき</seg><ruby type="furigana" rend="right" source="#source-265-280"><rb>鳥</rb><rt>どり</rt></ruby></p>
      <p source="#source-282-317"><ruby type="furigana" rend="right" source="#source-282-294"><rb>飛</rb><rt>と</rt></ruby><seg source="#source-294-317">んでどこへゆく</seg></p>
      <p source="#source-317-369"><ruby type="furigana" rend="right" source="#source-317-332"><rb>海</rb><rt>うみ</rt></ruby><seg source="#source-332-335">は</seg><ruby type="furigana" rend="right" source="#source-335-347"><rb>暴</rb><rt>あ</rt></ruby><seg source="#source-347-369">れているぞ。</seg></p>
      <p source="#source-369-395"><seg source="#source-369-378">なんで</seg><ruby type="furigana" rend="right" source="#source-378-390"><rb>鳴</rb><rt>な</rt></ruby><seg source="#source-390-395">く</seg></p>
      <p source="#source-395-409"><seg source="#source-395-409">かあかあ</seg></p>
      <p source="#source-409-461"><ruby type="furigana" rend="right" source="#source-409-424"><rb>山</rb><rt>やま</rt></ruby><seg source="#source-424-427">も</seg><ruby type="furigana" rend="right" source="#source-427-439"><rb>暴</rb><rt>あ</rt></ruby><seg source="#source-439-461">れているぞ。</seg></p>
      <p source="#source-461-493"><seg source="#source-461-473">あんなに</seg><ruby type="furigana" rend="right" source="#source-473-488"><rb>高</rb><rt>たか</rt></ruby><seg source="#source-488-493">く</seg></p>
      <p source="#source-493-525"><seg source="#source-493-505">あんなに</seg><ruby type="furigana" rend="right" source="#source-505-520"><rb>低</rb><rt>ひく</rt></ruby><seg source="#source-520-525">く</seg></p>
      <p source="#source-525-583"><ruby type="furigana" rend="right" source="#source-525-540"><rb>後</rb><rt>あと</rt></ruby><seg source="#source-540-552">になり、</seg><ruby type="furigana" rend="right" source="#source-552-567"><rb>先</rb><rt>さき</rt></ruby><seg source="#source-567-583">になり。</seg></p>
      <p source="#source-583-618"><seg source="#source-583-618">みんなから、きらわれて</seg></p>
      <p source="#source-618-650"><ruby type="furigana" rend="right" source="#source-618-630"><rb>鳴</rb><rt>な</rt></ruby><seg source="#source-630-633">き</seg><ruby type="furigana" rend="right" source="#source-633-645"><rb>鳴</rb><rt>な</rt></ruby><seg source="#source-645-650">き</seg></p>
      <p source="#source-650-681"><ruby type="furigana" rend="right" source="#source-650-662"><rb>飛</rb><rt>と</rt></ruby><seg source="#source-662-681">んでゆく。</seg></p>
      <p source="#source-681-740"><ruby type="furigana" rend="right" source="#source-681-696"><rb>黒</rb><rt>くろ</rt></ruby><seg source="#source-696-699">い</seg><ruby type="furigana" rend="right" source="#source-699-714"><rb>衣</rb><rt>べべ</rt></ruby><seg source="#source-714-717">を</seg><ruby type="furigana" rend="right" source="#source-717-729"><rb>着</rb><rt>き</rt></ruby><seg source="#source-729-740">かえて</seg></p>
      <p source="#source-740-753"><seg source="#source-740-753">こい。</seg></p>
      <p source="#source-753-800"><ruby type="furigana" rend="right" source="#source-753-768"><rb>金</rb><rt>きん</rt></ruby><seg source="#source-768-771">の</seg><ruby type="furigana" rend="right" source="#source-771-786"><rb>帯</rb><rt>おび</rt></ruby><seg source="#source-786-800">をしめて</seg></p>
      <p source="#source-800-813"><seg source="#source-800-813">こい。</seg></p>
      <p source="#source-813-857"><ruby type="furigana" rend="right" source="#source-813-834"><rb>今度</rb><rt>こんど</rt></ruby><seg source="#source-834-837">の</seg><ruby type="furigana" rend="right" source="#source-837-849"><rb>世</rb><rt>よ</rt></ruby><seg source="#source-849-857">には</seg></p>
      <p source="#source-857-899"><ruby type="furigana" rend="right" source="#source-857-872"><rb>王</rb><rt>おう</rt></ruby><seg source="#source-872-899">さまにしてやるぞ。</seg></p>
    </body>
