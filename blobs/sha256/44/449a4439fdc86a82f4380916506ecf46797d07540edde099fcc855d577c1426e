        <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-53546-54139"><ruby type="furigana" rend="right" source="#source-53549-53564"><rb>餘</rb><rt>あま</rt></ruby><seg source="#source-53564-53567">り</seg><ruby type="furigana" rend="right" source="#source-53567-53588"><rb>仔細</rb><rt>しさい</rt></ruby><seg source="#source-53588-53597">のない</seg><ruby type="furigana" rend="right" source="#source-53597-53612"><rb>事</rb><rt>こと</rt></ruby><seg source="#source-53612-53618">を、</seg><ruby type="furigana" rend="right" source="#source-53618-53630"><rb>聞</rb><rt>き</rt></ruby><seg source="#source-53630-53636">いて</seg><ruby type="furigana" rend="right" source="#source-53636-53657"><rb>飽氣</rb><rt>あつけ</rt></ruby><seg source="#source-53657-53663">なく</seg><ruby type="furigana" rend="right" source="#source-53663-53678"><rb>思</rb><rt>おも</rt></ruby><seg source="#source-53678-53690">ふほど、</seg><ruby type="furigana" rend="right" source="#source-53690-53714"><rb>唯吉</rb><rt>たゞきち</rt></ruby><seg source="#source-53714-53717">は</seg><ruby type="furigana" rend="right" source="#source-53717-53732"><rb>尚</rb><rt>なほ</rt></ruby><ruby type="furigana" rend="right" source="#source-53732-53744"><rb>氣</rb><rt>き</rt></ruby><seg source="#source-53744-53747">に</seg><ruby type="furigana" rend="right" source="#source-53747-53762"><rb>掛</rb><rt>かゝ</rt></ruby><seg source="#source-53762-53771">る……</seg><ruby type="furigana" rend="right" source="#source-53771-53789"><rb>昔</rb><rt>むかし</rt></ruby><seg source="#source-53789-53795">から</seg><ruby type="furigana" rend="right" source="#source-53795-53819"><rb>語繼</rb><rt>かたりつ</rt></ruby><seg source="#source-53819-53822">ぎ</seg><ruby type="furigana" rend="right" source="#source-53822-53846"><rb>言傳</rb><rt>いひつた</rt></ruby><seg source="#source-53846-53852">へる</seg><ruby type="furigana" rend="right" source="#source-53852-53867"><rb>例</rb><rt>れい</rt></ruby><seg source="#source-53867-53882">によると、</seg><ruby type="furigana" rend="right" source="#source-53882-5