furigana" rend="right" source="#source-98569-98584"><rb>壓</rb><rt>おさ</rt></ruby><seg source="#source-98584-98596">へても、</seg><ruby type="furigana" rend="right" source="#source-98596-98611"><rb>震</rb><rt>ふる</rt></ruby><seg source="#source-98611-98614">へ</seg><ruby type="furigana" rend="right" source="#source-98614-98629"><rb>上</rb><rt>あが</rt></ruby><seg source="#source-98629-98644">るやうに、</seg><ruby type="furigana" rend="right" source="#source-98644-98665"><rb>寢臺</rb><rt>ねだい</rt></ruby><seg source="#source-98665-98668">の</seg><ruby type="furigana" rend="right" source="#source-98668-98683"><rb>上</rb><rt>うへ</rt></ruby><seg source="#source-98683-98692">から、</seg><ruby type="furigana" rend="right" source="#source-98692-98719"><rb>天井</rb><rt>てんじやう</rt></ruby><seg source="#source-98719-98722">を</seg><ruby type="furigana" rend="right" source="#source-98722-98734"><rb>見</rb><rt>み</rt></ruby><seg source="#source-98734-98746">て、あれ</seg><choice source="#source-98746-98752"><orig>／＼</orig><reg>〱</reg></choice><ruby type="furigana" rend="right" source="#source-98752-98773"><rb>彼處</rb><rt>あすこ</rt></ruby><seg source="#source-98773-98776">に</seg><ruby type="furigana" rend="right" source="#source-98776-98791"><rb>變</rb><rt>へん</rt></ruby><seg source="#source-98791-98803">なものが</seg><ruby type="furigana" rend="right" source="#source-98803-98815"><rb>居</rb><rt>ゐ</rt></ruby><seg source="#source-98815-98821">て、</seg><ruby type="furigana" rend="right" source="#source-98821-98836"><rb>睨</rb><rt>にら</rt></ruby><seg source="#source-98836-98857">みます、とつて</seg><ruby type="furigana" rend="right" source="#source-98857-98884"><rb>頂戴</rb><rt>ちやうだい</rt></ruby><seg source="#source-98884-98905">、よう、とつて</seg><ruby type="furigana" rend="right" source="#source-98905-98932"><rb>頂戴</rb><rt>ちやうだい</rt></ruby><seg source="#source-98932-98944">。あれ、</seg><ruby type="furigana" rend="right" source="#source-98944-98968"><rb>釣下</rb><rt>つりさが</rt></ruby><seg source="#source-98968-98974">つた</seg><ruby type="furigana" rend="