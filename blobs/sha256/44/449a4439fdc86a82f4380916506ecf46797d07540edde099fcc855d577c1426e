        <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-17176-17541"><ruby type="furigana" rend="right" source="#source-17179-17203"><rb>少時</rb><rt>しばらく</rt></ruby><ruby type="furigana" rend="right" source="#source-17203-17218"><rb>人</rb><rt>ひと</rt></ruby><seg source="#source-17218-17221">の</seg><ruby type="furigana" rend="right" source="#source-17221-17233"><rb>住</rb><rt>す</rt></ruby><seg source="#source-17233-17245">まない、</seg><ruby type="furigana" rend="right" source="#source-17245-17266"><rb>裏家</rb><rt>うらや</rt></ruby><seg source="#source-17266-17269">の</seg><ruby type="furigana" rend="right" source="#source-17269-17284"><rb>庭</rb><rt>には</rt></ruby><seg source="#source-17284-17290">で、</seg><ruby type="furigana" rend="right" source="#source-17290-17302"><rb>此</rb><rt>こ</rt></ruby><seg source="#source-17302-17305">の</seg><ruby type="furigana" rend="right" source="#source-17305-17320"><rb>折</rb><rt>をり</rt></ruby><seg source="#source-17320-17326">から</seg><ruby type="furigana" rend="right" source="#source-17326-17341"><rb>又</rb><rt>また</rt></ruby><ruby type="furigana" rend="right" source="#source-17341-17356"><rb>颯</rb><rt>さつ</rt></ruby><seg source="#source-17356-17359">と</seg><ruby type="furigana" rend="right" source="#source-17359-17374"><rb>雲</rb><rt>くも</rt></ruby><seg source="#source-17374-17383">ながら</seg><ruby type="furigana" rend="right" source="#source-17383-17398"><rb>月</rb><rt>つき</rt></ruby><seg source="#source-17398-17401">の</seg><ruby type="furigana" rend="right" source="#source-17401-17416"><rb>宿</rb><rt>やど</rt></ruby><seg source="#source-17416-17425">つた、</seg><ruby type="furigana" rend="right" source="#source-17425-17446"><rb>小草</rb><rt>をぐさ</rt></ruby><seg source="#source-17446-17449">の</seg><ruby type="furigana" rend="right" source="#source-17449-17464"><rb>露</rb><rt>つゆ</rt></ruby><seg source="#source-17464-17470">を、</seg><ruby type="furigana" rend="right" source="#source-17470-17485"><rb>搖</rb><rt>ゆり</rt></ruby><seg source="#source