    <body>
      <p><seg source="#source-30-38">浪よ</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)"><seg source="#source-38-52">浪、浪</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)"><seg source="#source-52-78">ここまでおいで</seg></p>
      <p><seg source="#source-78-86">浪よ</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)"><seg source="#source-86-100">浪、浪</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)"><seg source="#source-100-129">つかまへておくれ</seg></p>
      <p><seg source="#source-129-158">どんと打つてくりや</seg></p>
      <p><seg source="#source-158-177">そらにげた</seg></p>
      <p><seg source="#source-177-185">浪よ</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)"><seg source="#source-185-199">浪、浪</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)"><seg source="#source-199-225">ここまでおいで</seg></p>
      <p><seg source="#source-225-245">腹がたつたか</seg></p>
      <p><seg source="#source-245-253">浪よ</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)"><seg source="#source-253-261">浪</seg></p>
      <p><seg source="#source-261-284">さつとひくとき</seg></p>
      <p><seg source="#source-284-314">砂の小山をけちらした</seg></p>
    </body>
