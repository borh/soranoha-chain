    <body>
      <p><seg source="#source-244-261">八ノ字山の</seg></p>
      <p><seg source="#source-261-281">八ノ字ゴウロ</seg></p>
      <p><seg source="#source-281-301">雪がこんこん</seg></p>
      <p><seg source="#source-301-320">ふつてゐる</seg></p>
      <p><seg source="#source-320-332">どこのお</seg><ruby type="furigana" rend="right" source="#source-332-347"><rb>家</rb><rt>うち</rt></ruby><seg source="#source-347-352">も</seg></p>
      <p><seg source="#source-352-369">戸をしめて</seg></p>
      <p><seg source="#source-369-389">昼まも夜さも</seg></p>
      <p><seg source="#source-389-405">知らん顔</seg></p>
      <p><seg source="#source-405-422">冬の神さま</seg></p>
      <p><seg source="#source-422-428">早よ</seg><ruby type="furigana" rend="right" source="#source-428-440"><rb>去</rb><rt>い</rt></ruby><seg source="#source-440-448">んで</seg></p>
      <p><seg source="#source-448-468">あかるい春に</seg></p>
      <p><seg source="#source-468-487">なつてくれ</seg></p>
      <p><seg source="#source-487-510">八ノ字ゴウロに</seg></p>
      <p><seg source="#source-510-527">菫が咲いて</seg></p>
      <p><seg source="#source-527-550">雉子がケンケン</seg></p>
      <p><seg source="#source-550-562">なく春に</seg></p>
    </body>
