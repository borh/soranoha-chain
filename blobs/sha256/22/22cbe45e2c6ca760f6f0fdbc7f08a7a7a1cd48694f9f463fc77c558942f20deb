    <body>
      <p><seg source="#source-333-353">義足のごとく</seg></p>
      <p><seg source="#source-353-385">つつ立つものの向ふに</seg></p>
      <p><seg source="#source-385-396">新月は</seg></p>
      <p><seg source="#source-396-413">かへれない</seg></p>
      <p><seg source="#source-413-436">緑の時差を示し</seg></p>
      <p><seg source="#source-436-447">地軸は</seg></p>
      <p><seg source="#source-447-473">若い意志のなかで</seg></p>
      <p><seg source="#source-473-487">折られた</seg></p>
      <div type="layout" source="#source-487-519" style="padding-inline-start: 19em">
        <p><seg source="#source-511-519">38.12.10</seg></p>
      </div>
    </body>
