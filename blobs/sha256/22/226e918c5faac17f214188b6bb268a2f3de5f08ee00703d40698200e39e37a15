        <p style="text-indent: 7em" rend="first-line-indent(7)" source="#source-51286-51318"><seg source="#source-51286-51318">８Ｘ３</seg></p>
        <p style="text-indent: 3em" rend="first-line-indent(3)" source="#source-51318-51350"><seg source="#source-51318-51350">＿＿＿＿＿＿＿</seg></p>
        <p source="#source-51350-51382"><seg source="#source-51350-51382">７４９）６ＣＤＥＦＧ</seg></p>
        <p source="#source-51382-51414"><seg source="#source-51382-51414">↑↑　　５９９２←ニ</seg></p>
        <p source="#source-51414-51443"><seg source="#source-51414-51443">イロ　　―――――</seg></p>
        <p style="text-indent: 5em" rend="first-line-indent(5)" source="#source-51443-51472"><seg source="#source-51443-51472">Ｋ９ＬＭ</seg></p>
        <p style="text-indent: 6em" rend="first-line-indent(6)" source="#source-51472-51495"><seg source="#source-51472-51495">↑</seg></p>
        <p style="text-indent: 6em" rend="first-line-indent(6)" source="#source-51495-51518"><seg source="#source-51495-51518">ホ</seg></p>
        <p style="text-indent: 5em" rend="first-line-indent(5)" source="#source-51518-51547"><seg source="#source-51518-51547">Ｎ７４Ｐ</seg></p>
        <p style="text-indent: 6em" rend="first-line-indent(6)" source="#source-51547-51573"><seg source="#source-51547-51573">↑↑</seg></p>
