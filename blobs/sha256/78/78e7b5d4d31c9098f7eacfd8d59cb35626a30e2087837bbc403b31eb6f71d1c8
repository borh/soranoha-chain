rend="right" source="#source-114330-114354"><rb>御陵</rb><rt>みささぎ</rt></ruby><seg source="#source-114354-114363">あり、</seg><hi rend="small-script right" snh:layout-kind="small-script" snh:layout-params="position=right" source="#source-114363-114423" corresp="#source-114363-114387 #source-114390-114423"><seg source="#source-114387-114390">八</seg></hi><ruby type="furigana" rend="right" source="#source-114423-114465"><rb>神功后宮</rb><rt>じんぐうこうぐう</rt></ruby><seg source="#source-114465-114477">の御墓と</seg><ruby type="furigana" rend="right" source="#source-114477-114492"><rb>云</rb><rt>いふ</rt></ruby><seg source="#source-114492-114501">。寺を</seg><hi rend="small-script right" snh:layout-kind="small-script" snh:layout-params="position=right" source="#source-114501-114561" corresp="#source-114501-114525 #source-114528-114561"><seg source="#source-114525-114528">九</seg></hi><ruby type="furigana" rend="right" source="#source-114561-114600"><rb>干滿珠寺</rb><rt>かんまんじゆじ</rt></ruby><seg source="#source-114600-114603">と</seg><ruby type="furigana" rend="right" source="#source-114603-114618"><rb>云</rb><rt>いふ</rt></ruby><seg source="#source-114618-114621">。</seg><ruby type="furigana" rend="right" source="#source-114621-114648"><rb>此處</rb><rt>このところ</rt></ruby><seg source="#source-114648-114651">に</seg><ruby type="furigana" rend="right" source="#source-114651-114678"><rb>行幸</rb><rt>ぎやうかう</rt></ruby><seg source="#source-114678-114699">ありし事いまだ</seg><ruby type="furigana" rend="right" source="#source-114699-114714"><rb>聞</rb><rt>きか</rt></ruby><seg source="#source-114714-114744">ず。いかなる事にや。</seg><ruby type="furigana" rend="right" source="#source-114744-114759"><rb>此</rb><rt>この</rt></ruby><seg source="#source-114759-114765">寺の</seg><ruby type="furigana" rend="right" source="#source-114765-114792"><rb>方丈</rb><rt>はうぢやう</rt></ruby><seg source="#source-114792-114795">に</seg><ruby type="furigana" rend="right" source="#source-114795-114807"><rb>座</rb><rt>ざ</rt></ruby><seg source="#source-114807-114813">して</seg><ruby type="furigana" rend="right" source="#source-114813-114831"><rb>簾</rb><rt>すだれ</rt></ruby><seg source="#source-114831-114834">を</seg><ruby type="furigana" rend="right" source="#source-114834-114849"><rb>捲</rb><rt>まけ</rt></ruby><seg source="#source-114849-114861">ば、風景</seg><ruby type="furigana" rend="right" source="#source-114861-114888"><rb>一眼</rb><rt>いちがん</rt></ruby><seg source="#source-114888-114891">の</seg><ruby type="furigana" rend="right" source="#source-114891-114906"><rb>中</rb><rt>うち</rt></ruby><seg source="#source-114906-114909">に</seg><ruby type="furigana" rend="right" source="#source-114909-114924"><rb>盡</rb><rt>つき</rt></ruby><seg source="#source-114924-114930">て、</seg><hi rend="small-script right" snh:layout-kind="small-script" snh:layout-params="position=right" source="#source-114930-114993" corresp="#source-114930-114954 #source-114960-114993"><seg source="#source-114954-114960">一〇</seg></hi><seg source="#source-114993-114999">南に</seg><ruby type="furigana" rend="right" source="#source-114999-115023"><rb>鳥海</rb><rt>てうかい</rt></ruby><seg source="#source-115023-115035">天をさゝ</seg><seg type="annotated-text" source="#source-115038-115083"><seg source="#source-115035-115038">え</seg><note type="gloss"><seg source="#source-115059-115068">（へ）</seg></note></seg><seg source="#source-115083-115086">、</seg><ruby type="furigana" rend="right" source="#source-115086-115110"><rb>其陰</rb><rt>そのかげ</rt></ruby><seg source="#source-115110-115122">うつりて</seg><ruby type="furigana" rend="right" source="#source-115122-115134"><rb>江</rb><rt>え</rt></ruby><seg source="#source-115134-115146">にあり。</seg><hi rend="small-script right" snh:layout-kind="small-script" snh:layout-params="position=right" source="#source-115146-115209" corresp="#source-115146-115170 #source-115176-115209"><seg source="#source-115170-115176">一一</seg></hi><seg source="#source-115209-115221">西はむや</seg><choice source="#source-115221-115227"><orig>／＼</orig><reg>〱</reg></choice><seg source="#source-115227-115230">の</seg><ruby type="furigana" rend="right" source="#source-115230-115245"><rb>關</rb><rt>せき</rt></ruby><ruby type="furigana" rend="right" source="#source-115245-115260"><rb>路</rb><rt>みち</rt></ruby><seg source="#source-115260-115275">をかぎり、</seg><hi rend="small-script right" snh:layout-kind="small-script" snh:layout-params="position=right" source="#source-115275-115338" corresp="#source-115275-115299 #source-115305-115338"><seg source="#source-115299-115305">一二</seg></hi><seg source="#source-115338-115350">東に堤を</seg><ruby type="furigana" rend="right" source="#source-115350-115368"><rb>築</rb><rt>きづき</rt></ruby><seg source="#source-115368-115392">て秋田にかよふ道</seg><ruby type="furigana" rend="right" source="#source-115392-115413"><rb>遙</rb><rt>はるか</rt></ruby><seg source="#source-115413-115419">に、</seg><ruby type="furigana" rend="right" source="#source-115419-115434"><rb>海</rb><rt>うみ</rt></ruby><hi rend="small-script right" snh:layout-kind="small-script" snh:layout-params="position=right" source="#source-115434-115497" corresp="#source-115434-115458 #source-115464-115497"><seg source="#source-115458-115464">一三</seg></hi><ruby type="furigana" rend="right" source="#source-115497-115512"><rb>北</rb><rt>きた</rt></ruby><seg source="#source-115512-115521">にかま</seg><seg type="annotated-text" source="#source-115524-115569"><seg source="#source-115521-115524">え</seg><note type="gloss"><seg source="#source-115545-115554">（へ）</seg></note></seg><seg source="#source-115569-115575">て浪</seg><ruby type="furigana" rend="right" source="#source-115575-115602"><rb>打入</rb><rt>うちいる</rt></ruby><seg source="#source-115602-115623">る所を汐ごしと</seg><ruby type="furigana" rend="right" source="#source-115623-115638"><rb>云</rb><rt>いふ</rt></ruby><seg source="#source-115638-115647">。江の</seg><hi rend="small-script right" snh:layout-kind="small-script" snh:layout-params="position=right" source="#source-115647-115710" corresp="#source-115647-115671 #source-115677-115710"><seg source="#source-115671-115677">一四</seg></hi><ruby type="furigana" rend="right" source="#source-115710-115737"><rb>縱横</rb><rt>じゆうわう</rt></ruby><seg source="#source-115737-115755">一里ばかり、</seg><ruby type="furigana" rend="right" source="#source-115755-115776"><rb>俤</rb><rt>おもかげ</rt></ruby><seg source="#source-115776-115800">松嶋にかよひて又</seg><ruby type="furigana" rend="right" source="#source-115800-115818"><rb>異</rb><rt>こと</rt></ruby><seg source="#source-115818-115857">なり。松嶋は笑ふが如く、象</seg><g ref="#gaiji-U-3D7C-43-9" source="#source-115857-115913">㵼</g><seg source="#source-115913-115970">はうらむがごとし。寂しさに悲しみをくは</seg><seg type="annotated-text" source="#source-115973-116018"><seg source="#source-115970-115973">え</seg><note type="gloss"><seg source="#source-115994-116003">（へ）</seg></note></seg><seg source="#source-116018-116024">て、</seg><ruby type="furigana" rend="right" source="#source-116024-116045"><rb>地勢</rb><rt>ちせい</rt></ruby><seg source="#source-116045-116080">魂をなやますに似たり。</seg></p>
