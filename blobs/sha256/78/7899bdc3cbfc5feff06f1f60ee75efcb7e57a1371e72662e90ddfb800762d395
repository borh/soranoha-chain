      <div type="layout" source="#source-721993-722246" style="padding-inline-start: 2em">
        <p><hi rend="small-script right" snh:layout-kind="small-script" snh:layout-params="position=right" source="#source-722014-722080"><seg source="#source-722038-722047">一六一</seg></hi><seg source="#source-722080-722092">安永五歳</seg><hi rend="font-size small(1)" snh:layout-kind="font-size" snh:layout-params="size-type=small;level=1" source="#source-722092-722164"><seg source="#source-722125-722131">丙申</seg></hi><hi rend="small-script right" snh:layout-kind="small-script" snh:layout-params="position=right" source="#source-722164-722230"><seg source="#source-722188-722197">一六二</seg></hi><seg source="#source-722230-722246">孟夏吉旦</seg></p>
