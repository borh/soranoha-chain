="furigana" rend="right" source="#source-31190-31226"><rb>毎日々々</rb><rt><seg source="#source-31205-31217">まいにち</seg><choice source="#source-31217-31223"><orig>／＼</orig><reg>〱</reg></choice></rt></ruby><ruby type="furigana" rend="right" source="#source-31226-31250"><rb>催促</rb><rt>さいそく</rt></ruby><seg source="#source-31250-31253">の</seg><ruby type="furigana" rend="right" source="#source-31253-31274"><rb>葉書</rb><rt>はがき</rt></ruby><seg source="#source-31274-31277">を</seg><ruby type="furigana" rend="right" source="#source-31277-31289"><rb>出</rb><rt>だ</rt></ruby><seg source="#source-31289-31301">した。十</seg><ruby type="furigana" rend="right" source="#source-31301-31316"><rb>日</rb><rt>か</rt></ruby><seg source="#source-31316-31319">も</seg><ruby type="furigana" rend="right" source="#source-31319-31334"><rb>續</rb><rt>つゞ</rt></ruby><seg source="#source-31334-31340">けて</seg><ruby type="furigana" rend="right" source="#source-31340-31364"><rb>催促</rb><rt>さいそく</rt></ruby><seg source="#source-31364-31373">したら</seg><ruby type="furigana" rend="right" source="#source-31373-31388"><rb>何</rb><rt>なん</rt></ruby><seg source="#source-31388-31394">とか</seg><ruby type="furigana" rend="right" source="#source-31394-31415"><rb>返事</rb><rt>へんじ</rt></ruby><seg source="#source-31415-31460">ぐらゐよこすだらうと思つたが、</seg><ruby type="furigana" rend="right" source="#source-31460-31475"><rb>少</rb><rt>すこ</rt></ruby><seg source="#source-31475-31481">しも</seg><ruby type="furigana" rend="right" source="#source-31481-31493"><rb>手</rb><rt>て</rt></ruby><seg source="#source-31493-31520">ごたへがない。いよ</seg><choice source="#source-31520-31526"><orig>／＼</orig><reg>〱</reg></choice><ruby type="furigana" rend="right" source="#source-31526-31550"><rb>忌々</rb><rt><seg source="#source-31535-31541">いま</seg><choice source="#source-31541-31547"><orig>／＼</orig><reg>〱</reg></choice></rt></ruby><seg source="#source-31550-31559">しくて</seg><ruby type="furigana" rend="right" source="#source-31559-31580"><rb>仕樣</rb><rt>しやう</rt></ruby><seg source="#sou