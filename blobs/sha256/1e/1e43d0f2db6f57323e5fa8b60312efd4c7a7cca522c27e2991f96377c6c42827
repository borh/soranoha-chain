        <p>『ひ、ひ、<ruby type="furigana" rend="right" source="#source-266762-266792"><rb>卑怯者</rb><rt>ひけふもの</rt></ruby>！。』と<ruby type="furigana" rend="right" source="#source-266804-266825"><rb>私</rb><rt>わたくし</rt></ruby><seg source="#source-266825-266828">は</seg><ruby type="furigana" rend="right" source="#source-266828-266849"><rb>躍起</rb><rt>やつき</rt></ruby><seg source="#source-266849-266864">になつた、</seg><ruby type="furigana" rend="right" source="#source-266864-266882"><rb>此處</rb><rt>こゝ</rt></ruby><seg source="#source-266882-266888">には</seg><ruby type="furigana" rend="right" source="#source-266888-266924"><rb>春枝夫人</rb><rt>はるえふじん</rt></ruby><seg source="#source-266924-266927">の</seg><ruby type="furigana" rend="right" source="#source-266927-266942"><rb>如</rb><rt>ごと</rt></ruby><seg source="#source-266942-266945">き</seg><ruby type="furigana" rend="right" source="#source-266945-266966"><rb>殊勝</rb><rt>けなげ</rt></ruby><seg source="#source-266966-266972">なる</seg><ruby type="furigana" rend="right" source="#source-266972-266996"><rb>女性</rb><rt>によせう</rt></ruby><seg source="#source-266996-267011">もあるに、</seg><ruby type="furigana" rend="right" source="#source-267011-267026"><rb>彼</rb><rt>かれ</rt></ruby><ruby type="furigana" rend="right" source="#source-267026-267053"><rb>船長</rb><rt>せんちやう</rt></ruby><seg source="#source-267053-267056">の</seg><ruby type="furigana" rend="right" source="#source-267056-267080"><rb>醜態</rb><rt>しうたい</rt></ruby><seg source="#source-267080-267083">は</seg><ruby type="furigana" rend="right" source="#source-267083-267107"><rb>何事</rb><rt>なにごと</rt></ruby><seg source="#source-267107-267113">ぞと</seg><ruby type="furigana" rend="right" source="#source-267113-267128"><rb>思</rb><rt>おも</rt></ruby><seg source="#source-267128-267143">ふと、もう</seg><ruby type="furigana" rend="right" source="#source-267143-267158"><rb>默</rb><rt>だま</rt></ruby><seg source="#source-267158-267167">つては</seg><ruby type="furigana" rend="right" source="#source-267167-267179"><rb>居</rb><rt>を</rt></ruby><seg source="#source-267179-267191">られぬ、</seg><ruby type="furigana" rend="right" source="#source-267191-267206"><rb>元</rb><rt>もと</rt></ruby><seg source="#source-267206-267212">より</seg><ruby type="furigana" rend="right" source="#source-267212-267233"><rb>無益</rb><rt>むえき</rt></ruby><seg source="#source-267233-267236">の</seg><ruby type="furigana" rend="right" source="#source-267236-267251"><rb>業</rb><rt>わざ</rt></ruby><seg source="#source-267251-267281">ではあるが、せめての</seg><ruby type="furigana" rend="right" source="#source-267281-267305"><rb>腹愈</rb><rt>はらいや</rt></ruby><seg source="#source-267305-267317">しには、</seg><ruby type="furigana" rend="right" source="#source-267317-267332"><rb>吾</rb><rt>わが</rt></ruby><ruby type="furigana" rend="right" source="#source-267332-267356"><rb>鐵拳</rb><rt>てつけん</rt></ruby><seg source="#source-267356-267368">をもつて</seg><ruby type="furigana" rend="right" source="#source-267368-267383"><rb>彼</rb><rt>かれ</rt></ruby><seg source="#source-267383-267386">の</seg><ruby type="furigana" rend="right" source="#source-267386-267404"><rb>頭</rb><rt>かしら</rt></ruby><seg source="#source-267404-267407">に</seg><ruby type="furigana" rend="right" source="#source-267407-267431"><rb>引導</rb><rt>いんどう</rt></ruby><ruby type="furigana" rend="right" source="#source-267431-267446"><rb>渡</rb><rt>わた</rt></ruby><seg source="#source-267446-267452">して</seg><ruby type="furigana" rend="right" source="#source-267452-267464"><rb>呉</rb><rt>く</rt></ruby><seg source="#source-267464-267476">れんと、</seg><ruby type="furigana" rend="right" source="#source-267476-267497"><rb>驅出</rb><rt>かけだ</rt></ruby><seg source="#source-267497-267500">す</seg><ruby type="furigana" rend="right" source="#source-267500-267518"><rb>袂</rb><rt>たもと</rt></ruby><seg source="#source-267518-267521">を</seg><ruby type="furigana" rend="right" source="#source-267521-267542"><rb>夫人</rb><rt>ふじん</rt></ruby><seg source="#source-267542-267545">は</seg><ruby type="furigana" rend="right" source="#source-267545-267563"><rb>靜</rb><rt>しづか</rt></ru