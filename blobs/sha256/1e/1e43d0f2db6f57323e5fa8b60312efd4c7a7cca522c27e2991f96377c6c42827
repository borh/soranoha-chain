right" source="#source-897304-897325"><rb>好意</rb><rt>かうゐ</rt></ruby><seg source="#source-897325-897328">を</seg><ruby type="furigana" rend="right" source="#source-897328-897343"><rb>謝</rb><rt>しや</rt></ruby><seg source="#source-897343-897349">する</seg><ruby type="furigana" rend="right" source="#source-897349-897364"><rb>事</rb><rt>こと</rt></ruby><seg source="#source-897364-897379">であらう。</seg><ruby type="furigana" rend="right" source="#source-897379-897391"><rb>其</rb><rt>そ</rt></ruby><seg source="#source-897391-897394">の</seg><ruby type="furigana" rend="right" source="#source-897394-897409"><rb>時</rb><rt>とき</rt></ruby><seg source="#source-897409-897415">は、</seg><ruby type="furigana" rend="right" source="#source-897415-897436"><rb>私</rb><rt>わたくし</rt></ruby><seg source="#source-897436-897442">は、</seg><ruby type="furigana" rend="right" source="#source-897442-897463"><rb>屹度</rb><rt>きつと</rt></ruby><seg source="#source-897463-897466">、</seg><ruby type="furigana" rend="right" source="#source-897466-897490"><rb>軍艦</rb><rt>ぐんかん</rt></ruby><seg source="#source-897490-897493">「</seg><ruby type="furigana" rend="right" source="#source-897493-897505"><rb>日</rb><rt>ひ</rt></ruby><seg source="#source-897505-897508">の</seg><ruby type="furigana" rend="right" source="#source-897508-897520"><rb>出</rb><rt>で</rt></ruby>」の<ruby type="furigana" rend="right" source="#source-897526-897547"><rb>艦尾</rb><rt>かんび</rt></ruby><seg source="#source-897547-897550">の</seg><ruby type="furigana" rend="right" source="#source-897550-897565"><rb>方</rb><rt>かた</rt></ruby><seg source="#source-897565-897571">、八</seg><ruby type="furigana" rend="right" source="#source-897571-897592"><rb>吋</rb><rt>インチ</rt></ruby><ruby type="furigana" rend="right" source="#source-897592-897625"><rb>速射砲</rb><rt>そくしやほう</rt></ruby><seg source="#source-897625-897628">の</seg><ruby type="furigana" rend="right" source="#source-897628-897643"><rb>横</rb><rt>よこ</rt></ruby><seg source="#source-897643-897652">たはる</seg><ruby type="furigana" rend="right" source="#source-897652-897667"><rb>邊</rb><rt>へん</rt></ruby><seg source="#source-897667-897670">、</seg><ruby type="furigana" rend="right" source="#source-897670-897685"><rb>若</rb><rt>もし</rt></ruby><seg source="#source-897685-897691">くば</seg><ruby type="furigana" rend="right" source="#source-897691-897715"><rb>水面</rb><rt>すいめん</rt></ruby><ruby type="furigana" rend="right" source="#source-897715-897730"><rb>高</rb><rt>たか</rt></ruby><seg source="#source-897730-897733">き</seg><ruby type="furigana" rend="right" source="#source-897733-897757"><rb>舷門</rb><rt>げんもん</rt></ruby><seg source="#source-897757-897772">のほとりに</seg><ruby type="furigana" rend="right" source="#source-897772-897784"><rb>立</rb><rt>た</rt></ruby><seg source="#source-897784-897796">つて――</seg><ruby type="furigana" rend="right" source="#source-897796-897817"><rb>恭</rb><rt><seg source="#source-897802-897808">うや</seg><choice source="#source-897808-897814"><orig>／＼</orig><reg>〱</reg></choice></rt></ruby><seg source="#source-897817-897829">しく――</seg><ruby type="furigana" rend="right" source="#source-897829-897847"><rb>右手</rb><rt>めて</rt></ruby><seg source="#source-897847-897850">に</seg><ruby type="furigana" rend="right" source="#source-897850-897865"><rb>高</rb><rt>たか</rt></ruby><seg source="#source-897865-897868">く</seg><ruby type="furigana" rend="right" source="#source-897868-897901"><rb>兜形</rb><rt>ヘルメツトがた</rt></ruby><seg source="#source-897901-897904">の</seg><ruby type="furigana" rend="right" source="#source-897904-897925"><rb>帽子</rb><rt>ぼうし</rt></ruby><seg source="#source-897925-897928">を</seg><ruby type="furigana" rend="right" source="#source-897928-897940"><rb>揚</rb><rt>あ</rt></ruby><seg source="#source-897940-897949">げて、</seg><ruby type="furigana" rend="right" source="#source-897949-897964"><rb>今</rb><rt>いま</rt></ruby><ruby type="furigana" rend="right" source="#source-897964-897985"><rb>一度</rb><rt>いちど</rt></ruby><seg source="#source-897985-897988">、</seg><ruby type="furigana" rend="right" source="#source-897988-898012"><rb>諸君</rb><rt>しよくん</rt></ruby><seg source="#source-898012-898015">と</seg><ruby type="furigana" rend="right" source="#source-898015-898030"><rb>共</rb><rt>とも</rt></ruby><seg source="#source-898030-898033">に</seg><ruby type="furigana" rend="right" source="#source-898033-898102"><rb>大日本帝國萬歳</rb><rt>だいにつぽんていこくばんざい</rt></ruby><seg source="#source-898102-898108">！　</seg><ruby type="furigana" rend="right" source="#source-898108-898168"><rb>帝國海軍萬歳</rb><rt>ていこくかいぐんばんざい</rt></ruby><seg source="#source-898168-898177">！　を</seg><ruby type="furigana" rend="right" source="#source-898177-898198"><rb>三呼</rb><rt>さんこ</rt></ruby>しませう。（軍艦「日の出」の甲板にて）</p>
