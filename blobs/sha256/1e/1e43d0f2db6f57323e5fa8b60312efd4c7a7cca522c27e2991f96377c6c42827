        <p><seg source="#source-680653-680656">『</seg><ruby type="furigana" rend="right" source="#source-680656-680668"><rb>未</rb><rt>ま</rt></ruby><seg source="#source-680668-680671">だ</seg><ruby type="furigana" rend="right" source="#source-680671-680695"><rb>實見</rb><rt>じつけん</rt></ruby><seg source="#source-680695-680716">はしませんが、</seg><ruby type="furigana" rend="right" source="#source-680716-680737"><rb>御覽</rb><rt>ごらん</rt></ruby><seg source="#source-680737-680740">の</seg><ruby type="furigana" rend="right" source="#source-680740-680755"><rb>通</rb><rt>とう</rt></ruby><seg source="#source-680755-680761">り、</seg><ruby type="furigana" rend="right" source="#source-680761-680785"><rb>海面</rb><rt>かいめん</rt></ruby><seg source="#source-680785-680791">から</seg><ruby type="furigana" rend="right" source="#source-680791-680812"><rb>餘程</rb><rt>よほど</rt></ruby><ruby type="furigana" rend="right" source="#source-680812-680827"><rb>高</rb><rt>たか</rt></ruby><seg source="#source-680827-680836">いあの</seg><ruby type="furigana" rend="right" source="#source-680836-680866"><rb>屏風岩</rb><rt>べうぶいわ</rt></ruby><seg source="#source-680866-680869">の</seg><ruby type="furigana" rend="right" source="#source-680869-680893"><rb>尖頭</rb><rt>せんとう</rt></ruby><seg source="#source-680893-680902">にも、</seg><ruby type="furigana" rend="right" source="#source-680902-680926"><rb>海草</rb><rt>かいさう</rt></ruby><seg source="#source-680926-680929">が</seg><ruby type="furigana" rend="right" source="#source-680929-680950"><rb>打上</rb><rt>うちあ</rt></ruby><seg source="#source-680950-680962">げられた</seg><ruby type="furigana" rend="right" source="#source-680962-680977"><rb>程</rb><rt>ほど</rt></ruby><seg source="#source-680977-680992">ですから、</seg><ruby type="furigana" rend="right" source="#source-680992-681040"><rb>秘密造船所</rb><rt>ひみつざうせんじよ</rt></ruby><seg source="#source-681040-681043">の</seg><ruby type="furigana" rend="right" source="#source-681043-681064"><rb>内部</rb><rt>ないぶ</rt></ruby><seg source="#source-681064-681067">は</seg><ruby type="furig