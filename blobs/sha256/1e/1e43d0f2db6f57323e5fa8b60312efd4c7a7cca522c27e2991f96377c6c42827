        <p><seg source="#source-474648-474651">『</seg><ruby type="furigana" rend="right" source="#source-474651-474663"><rb>若</rb><rt>も</rt></ruby><seg source="#source-474663-474666">し</seg><ruby type="furigana" rend="right" source="#source-474666-474684"><rb>不時</rb><rt>ふじ</rt></ruby><seg source="#source-474684-474687">の</seg><ruby type="furigana" rend="right" source="#source-474687-474711"><rb>天變</rb><rt>てんぺん</rt></ruby><seg source="#source-474711-474729">が無ければ、</seg><ruby type="furigana" rend="right" source="#source-474729-474744"><rb>今</rb><rt>いま</rt></ruby><seg source="#source-474744-474750">より</seg><ruby type="furigana" rend="right" source="#source-474750-474771"><rb>二年</rb><rt>にねん</rt></ruby><ruby type="furigana" rend="right" source="#source-474771-474783"><rb>九</rb><rt>く</rt></ruby><seg source="#source-474783-474786">ヶ</seg><ruby type="furigana" rend="right" source="#source-474786-474810"><rb>月目</rb><rt>げつめ</rt></ruby><seg source="#source-474810-474813">、</seg><ruby type="furigana" rend="right" source="#source-474813-474831"><rb>即</rb><rt>すなは</rt></ruby><seg source="#source-474831-474834">ち</seg><ruby type="furigana" rend="right" source="#source-474834-474849"><rb>之</rb><rt>これ</rt></ruby><seg source="#source-474849-474855">から</seg><ruby type="furigana" rend="right" source="#source-474855-474882"><rb>三度目</rb><rt>さんどめ</rt></ruby><seg source="#source-474882-474885">の</seg><ruby type="furigana" rend="right" source="#source-474885-474915"><rb>記元節</rb><rt>きげんせつ</rt></ruby><seg source="#source-474915-474918">を</seg><ruby type="furigana" rend="right" source="#source-474918-474933"><rb>迎</rb><rt>むか</rt></ruby><seg source="#source-474933-474939">ふる</seg><ruby type="furigana" rend="right" source="#source-474939-474954"><rb>頃</rb><rt>ころ</rt></ruby><seg source="#source-474954-474963">には、</seg><ruby type="furigana" rend="right" source="#source-474963-475002"><rb>試運轉式</rb><rt>しうんてんしき</rt></ruby><seg source="#source-475002-475005">を</seg><ruby type="furigana" rend="right" so