        <p><ruby type="furigana" rend="right" source="#source-676289-676310"><rb>私</rb><rt>わたくし</rt></ruby><seg source="#source-676310-676313">は</seg><ruby type="furigana" rend="right" source="#source-676313-676337"><rb>滿面</rb><rt>まんめん</rt></ruby><seg source="#source-676337-676340">に</seg><ruby type="furigana" rend="right" source="#source-676340-676355"><rb>笑</rb><rt>えみ</rt></ruby><seg source="#source-676355-676358">を</seg><ruby type="furigana" rend="right" source="#source-676358-676373"><rb>湛</rb><rt>たゝ</rt></ruby><seg source="#source-676373-676379">えて</seg><ruby type="furigana" rend="right" source="#source-676379-676400"><rb>大佐</rb><rt>たいさ</rt></ruby><seg source="#source-676400-676403">の</seg><ruby type="furigana" rend="right" source="#source-676403-676415"><rb>手</rb><rt>て</rt></ruby><seg source="#source-676415-676418">を</seg><ruby type="furigana" rend="right" source="#source-676418-676433"><rb>握</rb><rt>にぎ</rt></ruby><seg source="#source-676433-676448">り、かゝる</seg><ruby type="furigana" rend="right" source="#source-676448-676472"><rb>災難</rb><rt>さいなん</rt></ruby><seg source="#source-676472-676475">の</seg><ruby type="furigana" rend="right" source="#source-676475-676493"><rb>間</rb><rt>あひだ</rt></ruby><seg source="#source-676493-676499">にも</seg><ruby type="furigana" rend="right" source="#source-676499-676517"><rb>互</rb><rt>たがひ</rt></ruby><seg source="#source-676517-676520">の</seg><ruby type="furigana" rend="right" source="#source-676520-676532"><rb>身</rb><rt>み</rt></ruby><seg source="#source-676532-676535">の</seg><ruby type="furigana" rend="right" source="#source-676535-676553"><rb>無事</rb><rt>ぶじ</rt></ruby><seg source="#source-676553-676562">なりし</seg><ruby type="furigana" rend="right" source="#source-676562-676577"><rb>事</rb><rt>こと</rt></ruby><seg source="#source-676577-676603">をよろこび、さて</seg></p>
