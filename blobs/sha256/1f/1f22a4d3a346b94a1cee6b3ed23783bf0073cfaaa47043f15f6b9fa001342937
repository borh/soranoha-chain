      <div type="layout" source="#source-412-471" style="padding-inline-start: 2em">
        <div>
          <head n="2" source="#source-433-469"><seg source="#source-433-436">一</seg></head>
        </div>
      </div>
      <div>
        <p><seg source="#source-471-486">カハイイ　</seg><ruby type="furigana" rend="right" source="#source-486-504"><rb>山羊</rb><rt>ヤギ</rt></ruby><seg source="#source-504-518">サン　ハ</seg></p>
        <p><seg source="#source-518-544">オ年ガ　八ツ　ニ</seg></p>
        <p><seg source="#source-544-561">ナツタノ。</seg></p>
        <p><seg source="#source-561-581">オ母サン　ニ</seg></p>
        <p><seg source="#source-581-598">ツレラレテ</seg></p>
        <p><seg source="#source-598-627">学校ヘ行ツタノヨ。</seg></p>
        <p><seg source="#source-627-641">動物学校</seg></p>
        <p><seg source="#source-641-654">ヘネ。</seg></p>
      </div>
      <div type="layout" source="#source-654-713" style="padding-inline-start: 2em">
        <div>
          <head n="2" source="#source-675-711"><seg source="#source-675-678">二</seg></head>
        </div>
      </div>
      <div>
        <p><seg source="#source-713-748">カハイイ　山羊サン　ハ</seg></p>
        <p><seg source="#source-748-765">オヒゲ　ガ</seg></p>
        <p><seg source="#source-765-785">生エテタノ。</seg></p>
        <p><seg source="#source-785-805">ソレヲ　見テ</seg></p>
        <p><seg source="#source-805-822">ミンナ　ガ</seg></p>
        <p><seg source="#source-822-845">笑ツタ　ノヨ。</seg></p>
        <p><seg source="#source-845-865">山羊サン　ハ</seg></p>
        <p><seg source="#source-865-877">トテモ　</seg><ruby type="furigana" rend="right" source="#source-877-892"><rb>恥</rb><rt>ハヅ</rt></ruby><seg source="#source-892-917">カシカツタワ。</seg></p>
      </div>
      <div type="layout" source="#source-917-976" style="padding-inline-start: 2em">
        <div>
          <head n="2" source="#source-938-974"><seg source="#source-938-941">三</seg></head>
        </div>
      </div>
      <div>
        <p><seg source="#source-976-997">オ友達　ノ　オ</seg><ruby type="furigana" rend="right" source="#source-997-1012"><rb>猫</rb><rt>ネコ</rt></ruby><seg source="#source-1012-1026">サン　ガ</seg></p>
        <p><seg source="#source-1026-1067">ハサミ　デ　切リナサイ　ト</seg></p>
        <p><seg source="#source-1067-1084">イツタノ。</seg></p>
        <p><seg source="#source-1084-1104">山羊サン　ハ</seg></p>
        <p><seg source="#source-1104-1121">オヒゲ　ヲ</seg></p>
        <p><seg source="#source-1121-1141">チヨキン　ト</seg></p>
        <p><seg source="#source-1141-1158">切ツタノ。</seg></p>
        <p><seg source="#source-1158-1189">オ机ノ　カゲデネ。</seg></p>
      </div>
      <div type="layout" source="#source-1189-1248" style="padding-inline-start: 2em">
        <div>
          <head n="2" source="#source-1210-1246"><seg source="#source-1210-1213">四</seg></head>
        </div>
      </div>
      <div>
        <p><seg source="#source-1248-1268">ヒゲナシ　ニ</seg></p>
        <p><seg source="#source-1268-1279">ナツテ</seg></p>
        <p><seg source="#source-1279-1296">オウチ　ヘ</seg></p>
        <p><seg source="#source-1296-1322">カヘツテ　来タラ</seg></p>
        <p><seg source="#source-1322-1342">オ母サン　ハ</seg></p>
        <p><seg source="#source-1342-1359">オドロイテ</seg></p>
        <p><seg source="#source-1359-1379">山羊サン　ヲ</seg></p>
        <p><ruby type="furigana" rend="right" source="#source-1379-1394"><rb>叱</rb><rt>シカ</rt></ruby><seg source="#source-1394-1411">ツタ　ケド</seg></p>
        <p><seg source="#source-1411-1431">山羊サン　ハ</seg></p>
        <p><seg source="#source-1431-1456">平気ナ　顔ヨ。</seg></p>
      </div>
      <div type="layout" source="#source-1456-1515" style="padding-inline-start: 2em">
        <div>
          <head n="2" source="#source-1477-1513"><seg source="#source-1477-1480">五</seg></head>
        </div>
      </div>
      <div>
        <p><seg source="#source-1515-1547">オ母サン　ハ　手紙ヲ</seg></p>
        <p><seg source="#source-1547-1564">出シタノ。</seg></p>
        <p><seg source="#source-1564-1581">親類中　ノ</seg></p>
        <p><seg source="#source-1581-1607">山羊サンタチ　ヘ</seg></p>
        <p><seg source="#source-1607-1630">大事件、スグニ</seg></p>
        <p><seg source="#source-1630-1662">来テクダサイ　トネ。</seg></p>
        <p><seg source="#source-1662-1691">ミンナ　オドロイテ</seg></p>
        <p><seg source="#source-1691-1717">トコトコ　走ツテ</seg></p>
        <p><seg source="#source-1717-1733">来タノ。</seg></p>
      </div>
      <div type="layout" source="#source-1733-1792" style="padding-inline-start: 2em">
        <div>
          <head n="2" source="#source-1754-1790"><seg source="#source-1754-1757">六</seg></head>
        </div>
      </div>
      <div>
        <p><seg source="#source-1792-1824">ヒゲナシ山羊サン　ヲ</seg></p>
        <p><seg source="#source-1824-1832">見テ</seg></p>
        <p><seg source="#source-1832-1864">ミンナ　オコルヤラ、</seg></p>
        <p><seg source="#source-1864-1878">泣クヤラ</seg></p>
        <p><seg source="#source-1878-1910">大ヘン　ナ　サワギニ</seg></p>
        <p><seg source="#source-1910-1927">ナツタノ。</seg></p>
        <p><seg source="#source-1927-1962">デモ　ドウシテヨイヤラ</seg></p>
        <p><seg source="#source-1962-1991">タメイキ　ヲ　ツク</seg></p>
        <p><seg source="#source-1991-2007">バカリ。</seg></p>
      </div>
      <div type="layout" source="#source-2007-2066" style="padding-inline-start: 2em">
        <div>
          <head n="2" source="#source-2028-2064"><seg source="#source-2028-2031">七</seg></head>
        </div>
      </div>
      <div>
        <p><seg source="#source-2066-2086">オ母サン　ハ</seg></p>
        <p><seg source="#source-2086-2103">仕方　ナク</seg></p>
        <p><seg source="#source-2103-2123">ミンナ　カラ</seg></p>
        <p><seg source="#source-2123-2143">オヒゲ　ヲネ</seg></p>
        <p><seg source="#source-2143-2157">三本ヅツ</seg></p>
        <p><seg source="#source-2157-2177">モラツタノ。</seg></p>
        <p><seg source="#source-2177-2197">ソレヲ　糸デ</seg></p>
        <p><seg source="#source-2197-2214">シバツテネ</seg></p>
        <p><seg source="#source-2214-2249">山羊サン　ノ　アゴ　ヘ</seg></p>
        <p><seg source="#source-2249-2268">ツケタノ。</seg></p>
      </div>
      <div type="layout" source="#source-2268-2327" style="padding-inline-start: 2em">
        <div>
          <head n="2" source="#source-2289-2325"><seg source="#source-2289-2292">八</seg></head>
        </div>
      </div>
      <div>
        <p><seg source="#source-2327-2347">トテモ　ソノ</seg></p>
        <p><seg source="#source-2347-2367">カクカウ　ガ</seg></p>
        <p><seg source="#source-2367-2384">ワルイノデ</seg></p>
        <p><seg source="#source-2384-2410">ミンナ　大ワラヒ</seg></p>
        <p><seg source="#source-2410-2421">シテネ</seg></p>
        <p><seg source="#source-2421-2450">オヒゲ　ガ　生エル</seg></p>
        <p><seg source="#source-2450-2458">マデ</seg></p>
        <p><seg source="#source-2458-2487">ホツトク　コト　ニ</seg></p>
        <p><seg source="#source-2487-2504">ナツタノ。</seg></p>
        <p><seg source="#source-2504-2536">山羊サン　ハ　トテモ</seg></p>
        <p><seg source="#source-2536-2566">恥カシ　カツタノヨ。</seg></p>
      </div>
    </body>
