        <p source="#source-13770-13958">『あゝ<ruby type="furigana" rend="right" source="#source-13779-13800"><rb>文士</rb><rt>ぶんし</rt></ruby><seg source="#source-13800-13833">か。エミタヾカツといふ</seg><ruby type="furigana" rend="right" source="#source-13833-13854"><rb>文士</rb><rt>ぶんし</rt></ruby><seg source="#source-13854-13887">かい。エミ‥‥　あゝ、</seg><ruby type="furigana" rend="right" source="#source-13887-13905"><rb>江見</rb><rt>えみ</rt></ruby><seg source="#source-13905-13914">‥‥　</seg><ruby type="furigana" rend="right" source="#source-13914-13938"><rb>水蔭</rb><rt>すゐいん</rt></ruby>さんですか』</p>
        <p source="#source-13958-13987"><seg source="#source-13958-13961">『</seg><ruby type="furigana" rend="right" source="#source-13961-13973"><rb>然</rb><rt>さ</rt></ruby>うです』</p>
        <p source="#source-13987-14034">『それなら<ruby type="furigana" rend="right" source="#source-14002-14017"><rb>分</rb><rt>わか</rt></ruby>りました』</p>
        <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-14034-14351"><ruby type="furigana" rend="right" source="#source-14037-14067"><rb>馬鹿々々</rb><rt><app type="base-text-variant" source="#source-14067-14136"><lem><seg source="#source-14052-14058">ばか</seg><choice source="#source-14058-14064"><orig>／＼</orig><reg>〱</reg></choice></lem><rdg type="base-text"><seg source="#source-14118-14124">ばゝ</seg><choice source="#source-14124-14130"><orig>／＼</orig><reg>〱</reg></choice></rdg></app></rt></ruby><seg source="#source-14136-14145">しい。</seg><ruby type="furigana" rend="right" source="#source-14145-14157"><rb>聞</rb><rt>き</rt></ruby><seg source="#source-14157-14163">いて</seg><ruby type="furigana" rend="right" source="#source-14163-14175"><rb>見</rb><rt>み</rt></ruby><seg source="#source-14175-14184">ると、</seg><ruby type="furigana" rend="right" source="#source-14184-14208"><rb>強盜</rb><rt>がうたう</rt></ruby><seg source="#source-14208-14211">が</seg><ruby type="furigana" rend="right" source="#source-14211-14238"><rb>徘徊</rb><rt>はいくわい</rt></ruby><seg source="#source-14238-14262">するといふので、</seg><ruby type="furigana" rend="right" source="#source-14262-14295"><rb>非常線</rb><rt>ひじやうせん</rt></ruby><seg source="#source-14295-14298">を</seg><ruby type="furigana" rend="right" source="#source-14298-14310"><rb>張</rb><rt>は</rt></ruby><seg source="#source-14310-14316">つて</seg><ruby type="furigana" rend="right" source="#source-14316-14328"><rb>居</rb><rt>ゐ</rt></ruby><seg source="#source-14328-14351">たのであつた。</seg></p>
        <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-14351-15314"><ruby type="furigana" rend="right" source="#source-14354-14366"><rb>斯</rb><rt>か</rt></ruby><seg source="#source-14366-14381">うなると、</seg><ruby type="furigana" rend="right" source="#source-14381-14408"><rb>打石斧</rb><rt>だせきふ</rt></ruby><seg source="#source-14408-14411">を</seg><ruby type="furigana" rend="right" source="#source-14411-14426"><rb>隱</rb><rt>かく</rt></ruby><seg source="#source-14426-14432">して</seg><ruby type="furigana" rend="right" source="#source-14432-14444"><rb>行</rb><rt>ゆ</rt></ruby><seg source="#source-14444-14459">くわけにも</seg><ruby type="furigana" rend="right" source="#source-14459-14471"><rb>行</rb><rt>ゆ</rt></ruby><seg source="#source-14471-14480">かず。</seg><ruby type="furigana" rend="right" source="#source-14480-14504"><rb>強盜</rb><rt>がうとう</rt></ruby><seg source="#source-14504-14507">と</seg><ruby type="furigana" rend="right" source="#source-14507-14528"><rb>間違</rb><rt>まちが</rt></ruby><seg source="#source-14528-14540">へられた</seg><ruby type="furigana" rend="right" source="#source-14540-14564"><rb>憤慨</rb><rt>ふんがい</rt></ruby><ruby type="furigana" rend="right" source="#source-14564-14579"><rb>紛</rb><rt>まぎ</rt></ruby><seg source="#source-14579-14588">れに、</seg><ruby type="furigana" rend="right" source="#source-14588-14609"><rb>二人</rb><rt>ふたり</rt></ruby><seg source="#source-14609-14618">はウン</seg><choice source="#source-14618-14624"><orig>／＼</orig><reg>〱</reg></choice><ruby type="furigana" rend="right" source="#source-14624-14639"><rb>汗</rb><rt>あせ</rt></ruby><seg source="#source-14639-14642">を</seg><ruby type="furigana" rend="right" source="#source-14642-14657"><rb>絞</rb><rt>しぼ</rt></ruby><seg source="#source-14657-14675">りながら、一</seg><ruby type="furigana" rend="right" source="#source-14675-14690"><rb>里</rb><rt>り</rt></ruby><ruby type="furigana" rend="right" source="#source-14690-14702"><rb>餘</rb><rt>よ</rt></ruby><seg source="#source-14702-14705">の</seg><ruby type="furigana" rend="right" source="#source-14705-14720"><rb>道</rb><rt>みち</rt></ruby><seg source="#source-14720-14723">を</seg><ruby type="furigana" rend="right" source="#source-14723-14741"><rb>境</rb><rt>さかい</rt></ruby><seg source="#source-14741-14744">の</seg><ruby type="furigana" rend="right" source="#source-14744-14774"><rb>停車場</rb><rt>ていしやば</rt></ruby><seg source="#source-14774-14777">に</seg><ruby type="furigana" rend="right" source="#source-14777-14789"><rb>出</rb><rt>い</rt></ruby><seg source="#source-14789-14795">で、</seg><ruby type="furigana" rend="right" source="#source-14795-14816"><rb>其夜</rb><rt>そのよ</rt></ruby><seg source="#source-14816-14819">の</seg><ruby type="furigana" rend="right" source="#source-14819-14840"><rb>汽車</rb><rt>きしや</rt></ruby><seg source="#source-14840-14843">に</seg><ruby type="furigana" rend="right" source="#source-14843-14855"><rb>乘</rb><rt>の</rt></ruby><seg source="#source-14855-14864">つて、</seg><ruby type="furigana" rend="right" source="#source-14864-14888"><rb>品川</rb><rt>しながは</rt></ruby><seg source="#source-14888-14894">まで</seg><ruby type="furigana" rend="right" source="#source-14894-14909"><rb>歸</rb><rt>かへ</rt></ruby><seg source="#source-14909-14921">つたが、</seg><ruby type="furigana" rend="right" source="#source-14921-14948"><rb>新宿</rb><rt>しんじゆく</rt></ruby><seg source="#source-14948-14951">の</seg><ruby type="furigana" rend="right" source="#source-14951-14975"><rb>乘替</rb><rt>のりかへ</rt></ruby><seg source="#source-14975-14981">で、</seg><ruby type="furigana" rend="right" source="#source-14981-15005"><rb>陸橋</rb><rt>ブリツチ</rt></ruby><seg source="#source-15005-15008">を</seg><ruby type="furigana" rend="right" source="#source-15008-15032"><rb>上下</rb><rt>じやうげ</rt></ruby><seg source="#source-15032-15038">した</seg><ruby type="furigana" rend="right" source="#source-15038-15053"><rb>時</rb><rt>とき</rt></ruby><seg source="#source-15053-15056">の</seg><ruby type="furigana" rend="right" source="#source-15056-15071"><rb>苦</rb><rt>くる</rt></ruby><seg source="#source-15071-15107">しさ。――これならどんな</seg><ruby type="furigana" rend="right" source="#source-15107-15131"><rb>責任</rb><rt>せきにん</rt></ruby><seg source="#source-15131-15137">でも</seg><ruby type="furigana" rend="right" source="#source-15137-15155"><rb>背負</rb><rt>せお</rt></ruby><seg source="#source-15155-15161">つて</seg><ruby type="furigana" rend="right" source="#source-15161-15173"><rb>立</rb><rt>た</rt></ruby><seg source="#source-15173-15191">てると、つく</seg><choice source="#source-15191-15197"><orig>／＼</orig><reg>〱</reg></choice><note type="sic" source="#source-15197-15233" target="#source-15185-15197"><seg source="#source-15203-15212">「つく</seg><choice source="#source-15212-15218"><orig>／＼</orig><reg>〱</reg></choice><seg source="#source-15218-15230">」はママ</seg></note><ruby type="furigana" rend="right" source="#source-15233-15257"><rb>蠻勇</rb><rt>ばんゆう</rt></ruby><seg source="#source-15257-15260">の</seg><ruby type="furigana" rend="right" source="#source-15260-15284"><rb>難有</rb><rt>ありがた</rt></ruby><seg source="#source-15284-15290">さを</seg><ruby type="furigana" rend="right" source="#source-15290-15305"><rb>覺</rb><rt>おぼ</rt></ruby><seg source="#source-15305-15314">えた。</seg></p>
