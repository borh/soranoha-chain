          <div type="layout" source="#source-134642-134773" style="padding-inline-start: 12em">
            <p><seg source="#source-134666-134669">（</seg><hi rend="bold" source="#source-134669-134723"><seg source="#source-134684-134699">Ｊ五五六六</seg></hi><seg source="#source-134723-134726">―</seg><hi rend="bold" source="#source-134726-134768"><seg source="#source-134741-134744">七</seg></hi><seg source="#source-134768-134773">）</seg></p>
          </div>
          <div>
            <p><seg source="#source-134773-134776">『</seg><hi rend="bold" source="#source-134776-134833"><seg source="#source-134791-134809">協奏曲第四番</seg></hi><seg source="#source-134833-134836">＝</seg><hi rend="bold" source="#source-134836-134884"><seg source="#source-134851-134860">ニ長調</seg></hi>』（モーツァルト・Ｋ二一八）</p>
          </div>
