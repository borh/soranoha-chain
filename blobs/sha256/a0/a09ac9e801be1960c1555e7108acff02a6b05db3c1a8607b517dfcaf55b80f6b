            <p><seg source="#source-553189-553224">（ピアノ）シュナーベル</seg></p>
          </div>
          <div type="layout" source="#source-553224-553427" style="padding-inline-start: 12em">
            <p><seg source="#source-553248-553251">（</seg><hi rend="bold" source="#source-553251-553317"><seg source="#source-553266-553293">ビクターＪＤ四八六</seg></hi><seg source="#source-553317-553320">―</seg><hi rend="bold" source="#source-553320-553362"><seg source="#source-553335-553338">八</seg></hi><seg source="#source-553362-553365">、</seg><hi rend="bold" source="#source-553365-553422"><seg source="#source-553380-553398">名曲集五六一</seg></hi><seg source="#source-553422-553427">）</seg></p>
