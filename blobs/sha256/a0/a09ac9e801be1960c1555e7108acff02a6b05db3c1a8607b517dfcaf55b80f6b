            <p><seg source="#source-135103-135106">（</seg><hi rend="bold" source="#source-135106-135160"><seg source="#source-135121-135136">Ｊ八四四五</seg></hi><seg source="#source-135160-135163">―</seg><hi rend="bold" source="#source-135163-135205"><seg source="#source-135178-135181">七</seg></hi><seg source="#source-135205-135208">、</seg><hi rend="bold" source="#source-135208-135265"><seg source="#source-135223-135241">傑作集二一五</seg></hi><seg source="#source-135265-135270">）</seg></p>
