      <p><seg source="#source-63171-63176">○</seg></p>
      <p><seg source="#source-63176-63200">やれやれ　やつと</seg><ruby type="furigana" rend="right" source="#source-63200-63224"><rb>安心</rb><rt>あんしん</rt></ruby><seg source="#source-63224-63232">した</seg></p>
      <p><seg source="#source-63232-63247">ほんとに心</seg><ruby type="furigana" rend="right" source="#source-63247-63265"><rb>配</rb><rt>ぱい</rt></ruby><seg source="#source-63265-63287">してしまつた</seg></p>
      <p><seg source="#source-63287-63292">○</seg></p>
