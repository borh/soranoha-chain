      <p><seg source="#source-61982-61991">さらば</seg><ruby type="furigana" rend="right" source="#source-61991-62015"><rb>火星</rb><rt>くわせい</rt></ruby><seg source="#source-62015-62025">よ！</seg></p>
      <p><seg source="#source-62025-62030">○</seg></p>
      <p><seg source="#source-62030-62042">もうどの</seg><ruby type="furigana" rend="right" source="#source-62042-62060"><rb>位</rb><rt>くらゐ</rt></ruby><ruby type="furigana" rend="right" source="#source-62060-62072"><rb>飛</rb><rt>と</rt></ruby><seg source="#source-62072-62089">んだかしら</seg></p>
      <p><ruby type="furigana" rend="right" source="#source-62089-62116"><rb>出発</rb><rt>しゆつぱつ</rt></ruby><seg source="#source-62116-62131">してから一</seg><ruby type="furigana" rend="right" source="#source-62131-62149"><rb>分</rb><rt>ぷん</rt></ruby><seg source="#source-62149-62152">五</seg><ruby type="furigana" rend="right" source="#source-62152-62170"><rb>秒</rb><rt>べう</rt></ruby><seg source="#source-62170-62175">！</seg></p>
