      <p><seg source="#source-62792-62797">○</seg></p>
      <p><seg source="#source-62797-62809">これは大</seg><ruby type="furigana" rend="right" source="#source-62809-62827"><rb>変</rb><rt>へん</rt></ruby><g ref="#gaiji-1-8-75" source="#source-62827-62863">‼</g></p>
      <p><seg source="#source-62865-62880">月なんかに</seg><ruby type="furigana" rend="right" source="#source-62880-62892"><rb>着</rb><rt>つ</rt></ruby><seg source="#source-62892-62901">いたら</seg><ruby type="furigana" rend="right" source="#source-62901-62916"><rb>困</rb><rt>こま</rt></ruby><seg source="#source-62916-62938">つてしまふぞ</seg></p>
      <p><seg source="#source-62938-62943">○</seg></p>
