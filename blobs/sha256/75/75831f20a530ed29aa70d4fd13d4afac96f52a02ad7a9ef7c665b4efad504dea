<ruby><rb>宗助</rb><rt>そうすけ</rt></ruby>は<ruby><rb>御米</rb><rt>およね</rt></ruby>の<ruby><rb>汲</rb><rt>く</rt></ruby>んで<ruby><rb>來</rb><rt>き</rt></ruby>た<ruby><rb>熱</rb><rt>あつ</rt></ruby>い<ruby><rb>茶</rb><rt>ちや</rt></ruby>を<ruby><rb>湯呑</rb><rt>ゆのみ</rt></ruby>から<ruby><rb>二口</rb><rt>ふたくち</rt></ruby><ruby><rb>程</rb><rt>ほど</rt></ruby><ruby><rb>飮</rb><rt>の</rt></ruby>んで、

