        <p source="#source-320707-320779"><seg source="#source-320707-320713">（＝</seg><hi rend="italic" source="#source-320713-320771" corresp="#source-320730-320771"><seg source="#source-320713-320730">Bombax pentandrum</seg></hi><seg source="#source-320771-320779"> L.）</seg></p>
        <p source="#source-320779-320851"><seg source="#source-320779-320785">（＝</seg><hi rend="italic" source="#source-320785-320839" corresp="#source-320800-320839"><seg source="#source-320785-320800">Ceiba pentandra</seg></hi><seg source="#source-320839-320851"> Gaert.）</seg></p>
        <p source="#source-320851-320928"><seg source="#source-320851-320857">（＝</seg><hi rend="italic" source="#source-320857-320913" corresp="#source-320873-320913"><seg source="#source-320857-320873">Xylon pentandrum</seg></hi><seg source="#source-320913-320928"> O. Kuntze）</seg></p>
