        <p source="#source-321003-321087"><seg source="#source-321003-321009">（＝</seg><hi rend="italic" source="#source-321009-321075" corresp="#source-321030-321075"><seg source="#source-321009-321030">Eriodendron orientale</seg></hi><seg source="#source-321075-321087"> Steud.）</seg></p>
        <p source="#source-321087-321173"><seg source="#source-321087-321093">（＝</seg><hi rend="italic" source="#source-321093-321163" corresp="#source-321116-321163"><seg source="#source-321093-321116">Eriodendron occidentale</seg></hi><seg source="#source-321163-321173"> Don.）</seg></p>
        <p source="#source-321173-321256"><seg source="#source-321173-321179">（＝</seg><hi rend="italic" source="#source-321179-321235" corresp="#source-321195-321235"><seg source="#source-321179-321195">Bombax guineense</seg></hi><seg source="#source-321235-321256"> Schm. et Thoun.）</seg></p>
        <p source="#source-321256-321290"><seg source="#source-321256-321290">Panja; Pania; Panial; Panjabaum.</seg></p>
        <p source="#source-321290-321337"><seg source="#source-321290-321337">Kapok; Kapok-tree; Kapokbaum; Ceiba; Pochote.</seg></p>
        <p source="#source-321337-321408"><seg source="#source-321337-321376">カボック樹、インド棉ノ木、</seg><ruby type="furigana" rend="right" source="#source-321376-321406"><rb>白木棉</rb><rt>シロキワタ</rt></ruby></p>
        <p source="#source-321408-321565"><seg source="#source-321408-321420">（分布）</seg><hi rend="bosen 傍線 right" source="#source-321420-321462" corresp="#source-321429-321462"><seg source="#source-321420-321429">インド</seg></hi><seg source="#source-321462-321489">、セイロン、南米、</seg><hi rend="bosen 傍線 right" source="#source-321489-321537" corresp="#source-321501-321537"><seg source="#source-321489-321501">西インド</seg></hi><seg source="#source-321537-321565">、熱帯アフリカ？</seg></p>
        <p source="#source-321565-321582"><seg source="#source-321565-321582">○非パンヤ</seg></p>
      </div>
      <div type="layout" source="#source-321582-321667" style="padding-inline-start: 3em">
        <p source="#source-321617-321667"><seg source="#source-321617-321636">Bombax malabaricum </seg><hi rend="italic" source="#source-321636-321664" corresp="#source-321638-321664"><seg source="#source-321636-321638">DC</seg></hi><seg source="#source-321664-321667">.</seg></p>
      </div>
