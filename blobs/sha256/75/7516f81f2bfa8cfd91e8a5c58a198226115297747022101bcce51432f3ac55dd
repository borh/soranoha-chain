        <p><ruby type="furigana" rend="right" source="#source-67938-67965"><rb>一廻</rb><rt>ひとまはり</rt></ruby><seg source="#source-67965-67977">くるりと</seg><ruby type="furigana" rend="right" source="#source-67977-67989"><rb>環</rb><rt>わ</rt></ruby><seg source="#source-67989-68004">にまはつて</seg><ruby type="furigana" rend="right" source="#source-68004-68028"><rb>前足</rb><rt>まへあし</rt></ruby><seg source="#source-68028-68043">をついて、</seg><ruby type="furigana" rend="right" source="#source-68043-68067"><rb>棒杭</rb><rt>ばうぐひ</rt></ruby><seg source="#source-68067-68070">の</seg><ruby type="furigana" rend="right" source="#source-68070-68085"><rb>上</rb><rt>うへ</rt></ruby><seg source="#source-68085-68088">へ</seg><ruby type="furigana" rend="right" source="#source-68088-68100"><rb>乗</rb><rt>の</rt></ruby><seg source="#source-68100-68112">つて、お</seg><ruby type="furigana" rend="right" source="#source-68112-68133"><rb>天気</rb><rt>てんき</rt></ruby><seg source="#source-68133-68136">を</seg><ruby type="furigana" rend="right" source="#source-68136-68148"><rb>見</rb><rt>み</rt></ruby><seg source="#source-68148-68169">るのであらう、</seg><ruby type="furigana" rend="right" source="#source-68169-68190"><rb>仰向</rb><rt>あをむ</rt></ruby><seg source="#source-68190-68196">いて</seg><ruby type="furigana" rend="right" source="#source-68196-68211"><rb>空</rb><rt>そら</rt></ruby><seg source="#source-68211-68214">を</seg><ruby type="furigana" rend="right" source="#source-68214-68226"><rb>見</rb><rt>み</rt></ruby><seg source="#source-68226-68232">た。</seg><ruby type="furigana" rend="right" source="#source-68232-68244"><rb>晴</rb><rt>は</rt></ruby><seg source="#source-68244-68262">れるといまに</seg><ruby type="furigana" rend="right" source="#source-68262-68274"><rb>行</rb><rt>ゆ</rt></ruby><seg source="#source-68274-68285">くよ。</seg></p>
