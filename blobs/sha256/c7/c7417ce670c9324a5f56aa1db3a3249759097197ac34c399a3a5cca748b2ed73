        <div type="layout" source="#source-853-1327" style="padding-inline-start: 5em">
          <p style="text-indent: 2em" rend="first-line-indent(2)"><seg source="#source-888-900">芭蕉</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-900-918">ハ</note><seg source="#source-918-921">無</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-921-945">クシテ</note><note type="kunten" subtype="return-mark" rend="subscript" source="#source-945-957">レ</note><seg source="#source-957-963">耳聞</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-963-984">イテ</note><note type="kunten" subtype="return-mark" rend="subscript" source="#source-984-996">レ</note><seg source="#source-996-999">雷</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-999-1017">ヲ</note><seg source="#source-1017-1020">開</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-1020-1038">キ</note></p>
          <p style="text-indent: 2em" rend="first-line-indent(2)"><seg source="#source-1040-1052">葵花</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-1052-1070">ハ</note><seg source="#source-1070-1073">無</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-1073-1097">クシテ</note><note type="kunten" subtype="return-mark" rend="subscript" source="#source-1097-1109">レ</note><seg source="#source-1109-1115">眼随</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-1115-1136">イテ</note><note type="kunten" subtype="return-mark" rend="subscript" source="#source-1136-1148">レ</note><seg source="#source-1148-1151">日</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-1151-1169">ニ</note><seg source="#source-1169-1172">転</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-1172-1190">ズ</note></p>
          <p><seg source="#source-1194-1241">そめ色の山もなき世におのづから</seg></p>
          <p style="text-indent: 5em" rend="first-line-indent(5)"><seg source="#source-1241-1291">柳はみどり花はくれなゐ</seg></p>
