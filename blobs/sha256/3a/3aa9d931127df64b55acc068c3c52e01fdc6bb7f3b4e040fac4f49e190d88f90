      <div type="layout" source="#source-43819-45587" style="padding-inline-start: 2em">
        <div type="layout" source="#source-43819-43923" style="writing-mode: horizontal-tb; text-align: right">
          <p><seg source="#source-43878-43884">2名</seg></p>
