      <p source="#source-771-833"><ruby type="furigana" rend="right" source="#source-771-795"><rb>瞬時</rb><rt>またゝき</rt></ruby><seg source="#source-795-804">の夢の</seg><ruby type="furigana" rend="right" source="#source-804-825"><rb>装飾</rb><rt>よそひ</rt></ruby><seg source="#source-825-833">も、</seg></p>
      <p source="#source-833-889"><seg source="#source-833-848">しかすがに</seg><ruby type="furigana" rend="right" source="#source-848-863"><rb>彩</rb><rt>あや</rt></ruby><ruby type="furigana" rend="right" source="#source-863-875"><rb>映</rb><rt>は</rt></ruby><seg source="#source-875-889">ゆれば、</seg></p>
      <p source="#source-889-924"><seg source="#source-889-901">紫の絹の</seg><ruby type="furigana" rend="right" source="#source-901-919"><rb>帳</rb><rt>とばり</rt></ruby><seg source="#source-919-924">、</seg></p>
      <p source="#source-924-986"><ruby type="furigana" rend="right" source="#source-924-948"><rb>永遠</rb><rt>えいえん</rt></ruby><seg source="#source-948-951">の</seg><ruby type="furigana" rend="right" source="#source-951-972"><rb>生命</rb><rt>いのち</rt></ruby><seg source="#source-972-986">ありと、</seg></p>
      <p source="#source-986-1045"><ruby type="furigana" rend="right" source="#source-986-1010"><rb>平和</rb><rt>やわらぎ</rt></ruby><seg source="#source-1010-1013">を</seg><ruby type="furigana" rend="right" source="#source-1013-1025"><rb>守</rb><rt>も</rt></ruby><seg source="#source-1025-1045">りいつきて、</seg></p>
      <p source="#source-1045-1071"><seg source="#source-1045-1071">心ある春の雨は、</seg></p>
      <p source="#source-1071-1139"><ruby type="furigana" rend="right" source="#source-1071-1086"><rb>軟</rb><rt>やわ</rt></ruby><seg source="#source-1086-1092">らに</seg><ruby type="furigana" rend="right" source="#source-1092-1107"><rb>音</rb><rt>おと</rt></ruby><seg source="#source-1107-1113">なく</seg><ruby type="furigana" rend="right" source="#source-1113-1128"><rb>濺</rb><rt>そゝ</rt></ruby><seg source="#source-1128-1139">いで、</seg></p>
      <p source="#source-1139-1182"><seg source="#source-1139-1182">しのびに葉末を流れぬるか。</seg></p>
      <p source="#source-1182-1241"><ruby type="furigana" rend="right" source="#source-1182-1197"><rb>瞬</rb><rt>また</rt></ruby><seg source="#source-1197-1212">たけばまた</seg><ruby type="furigana" rend="right" source="#source-1212-1230"><rb>夜明</rb><rt>よあ</rt></ruby><seg source="#source-1230-1241">けて、</seg></p>
      <p source="#source-1241-1276"><seg source="#source-1241-1276">瞬たけばまた日暮れぬ、</seg></p>
      <p source="#source-1276-1320"><ruby type="furigana" rend="right" source="#source-1276-1297"><rb>直黄</rb><rt>ひたき</rt></ruby><seg source="#source-1297-1320">もゆる夕雲を、</seg></p>
      <p source="#source-1320-1364"><seg source="#source-1320-1329">きらの</seg><ruby type="furigana" rend="right" source="#source-1329-1341"><rb>眼</rb><rt>め</rt></ruby><seg source="#source-1341-1364">に見かへりて、</seg></p>
      <p source="#source-1364-1408"><ruby type="furigana" rend="right" source="#source-1364-1391"><rb>白無垢</rb><rt>しらむく</rt></ruby><seg source="#source-1391-1408">の乱れ羽に</seg></p>
      <p source="#source-1408-1467"><seg source="#source-1408-1414">血を</seg><ruby type="furigana" rend="right" source="#source-1414-1426"><rb>浴</rb><rt>あ</rt></ruby><seg source="#source-1426-1435">べる、</seg><ruby type="furigana" rend="right" source="#source-1435-1456"><rb>小鴒</rb><rt>こばと</rt></ruby><seg source="#source-1456-1467">一羽、</seg></p>
      <p source="#source-1467-1508"><seg source="#source-1467-1485">枝ぶり怪しき</seg><ruby type="furigana" rend="right" source="#source-1485-1503"><rb>柏</rb><rt>かしは</rt></ruby><seg source="#source-1503-1508">の</seg></p>
      <p source="#source-1508-1554"><seg source="#source-1508-1554">木ぐれに落ちたる様はいかに。</seg></p>
      <p source="#source-1554-1589"><seg source="#source-1554-1589">瞬たけばまた夜明けて、</seg></p>
      <p source="#source-1589-1648"><ruby type="furigana" rend="right" source="#source-1589-1610"><rb>四辺</rb><rt>あたり</rt></ruby><seg source="#source-1610-1622">また暗き</seg><ruby type="furigana" rend="right" source="#source-1622-1643"><rb>千里</rb><rt>せんり</rt></ruby><seg source="#source-1643-1648">、</seg></p>
      <p source="#source-1648-1698"><seg source="#source-1648-1666">かゝるときや</seg><ruby type="furigana" rend="right" source="#source-1666-1690"><rb>古琴</rb><rt>ふるごと</rt></ruby><seg source="#source-1690-1698">も、</seg></p>
      <p source="#source-1698-1733"><seg source="#source-1698-1733">虫ばみ折れて落つらむ、</seg></p>
      <p source="#source-1733-1762"><seg source="#source-1733-1762">若葉の雨も今宵は、</seg></p>
      <p source="#source-1762-1824"><ruby type="furigana" rend="right" source="#source-1762-1789"><rb>蕭々</rb><rt><seg source="#source-1771-1777">せう</seg><choice source="#source-1777-1786"><orig>／″＼</orig><reg>〲</reg></choice></rt></ruby><seg source="#source-1789-1798">のわび</seg><ruby type="furigana" rend="right" source="#source-1798-1810"><rb>音</rb><rt>ね</rt></ruby><seg source="#source-1810-1824">立てゝ、</seg></p>
      <p source="#source-1824-1877"><seg source="#source-1824-1836">あな悲し</seg><ruby type="furigana" rend="right" source="#source-1836-1872"><rb>白木蓮</rb><rt>びやくもくれん</rt></ruby><seg source="#source-1872-1877">の</seg></p>
      <p source="#source-1877-1923"><seg source="#source-1877-1923">ほろゝのこぼれぞ胸にひゞく。</seg></p>
      <p source="#source-1923-1985"><ruby type="furigana" rend="right" source="#source-1923-1947"><rb>点滴</rb><rt>あまだれ</rt></ruby><ruby type="furigana" rend="right" source="#source-1947-1968"><rb>拍子</rb><rt>べうし</rt></ruby><seg source="#source-1968-1985">さびしう、</seg></p>
      <p source="#source-1985-2029"><seg source="#source-1985-1991">刻々</seg><ruby type="furigana" rend="right" source="#source-1991-2009"><rb>夜</rb><rt>よる</rt></ruby><seg source="#source-2009-2029">をきざみて、</seg></p>
      <p source="#source-2029-2088"><ruby type="furigana" rend="right" source="#source-2029-2053"><rb>短檠</rb><rt>たんけい</rt></ruby><seg source="#source-2053-2065">のほびも</seg><ruby type="furigana" rend="right" source="#source-2065-2077"><rb>瘠</rb><rt>や</rt></ruby><seg source="#source-2077-2088">せぬ、</seg></p>
      <p source="#source-2088-2138"><ruby type="furigana" rend="right" source="#source-2088-2115"><rb>小香炉</rb><rt>こがうろ</rt></ruby><seg source="#source-2115-2138">の灰も冷えぬ。</seg></p>
      <p source="#source-2138-2209"><ruby type="furigana" rend="right" source="#source-2138-2165"><rb>晩春</rb><rt>ばんしゆん</rt></ruby><seg source="#source-2165-2168">の</seg><ruby type="furigana" rend="right" source="#source-2168-2186"><rb>項</rb><rt>うなじ</rt></ruby><ruby type="furigana" rend="right" source="#source-2186-2201"><rb>重</rb><rt>おも</rt></ruby><seg source="#source-2201-2209">う、</seg></p>
      <p source="#source-2209-2280"><ruby type="furigana" rend="right" source="#source-2209-2233"><rb>古甕</rb><rt>ふるがめ</rt></ruby><seg source="#source-2233-2236">の</seg><ruby type="furigana" rend="right" source="#source-2236-2254"><rb>神酒</rb><rt>みき</rt></ruby><seg source="#source-2254-2257">を</seg><ruby type="furigana" rend="right" source="#source-2257-2269"><rb>汲</rb><rt>く</rt></ruby><seg source="#source-2269-2280">みて、</seg></p>
      <p source="#source-2280-2321"><ruby type="furigana" rend="right" source="#source-2280-2295"><rb>肱</rb><rt>ひじ</rt></ruby><seg source="#source-2295-2321">まくら思ひ入れば</seg></p>
      <p source="#source-2321-2391"><seg source="#source-2321-2327">あゝ</seg><ruby type="furigana" rend="right" source="#source-2327-2354"><rb>胸柱</rb><rt>むなばしら</rt></ruby><ruby type="furigana" rend="right" source="#source-2354-2369"><rb>切</rb><rt>せち</rt></ruby><seg source="#source-2369-2391">にわなゝく。</seg></p>
      <p source="#source-2391-2429"><seg source="#source-2391-2429">わなゝきはあわたゞしく、</seg></p>
      <p source="#source-2429-2473"><seg source="#source-2429-2438">小暗き</seg><ruby type="furigana" rend="right" source="#source-2438-2453"><rb>室</rb><rt>むろ</rt></ruby><seg source="#source-2453-2473">をはしりて、</seg></p>
      <p source="#source-2473-2505"><seg source="#source-2473-2505">闇に消えぬ、一しきり</seg></p>
      <p source="#source-2505-2546"><seg source="#source-2505-2520">木蓮の散る</seg><ruby type="furigana" rend="right" source="#source-2520-2532"><rb>音</rb><rt>ね</rt></ruby><seg source="#source-2532-2546">につれ、</seg></p>
      <p source="#source-2546-2596"><ruby type="furigana" rend="right" source="#source-2546-2570"><rb>古甕</rb><rt>ふるがめ</rt></ruby><seg source="#source-2570-2596">はげしく裂けて、</seg></p>
      <p source="#source-2596-2643"><seg source="#source-2596-2602">あら</seg><ruby type="furigana" rend="right" source="#source-2602-2620"><rb>御酒</rb><rt>みき</rt></ruby><seg source="#source-2620-2643">の泡もとめす、</seg></p>
      <p source="#source-2643-2678"><seg source="#source-2643-2678">大いなる、わなゝきぞ、</seg></p>
      <p source="#source-2678-2739"><ruby type="furigana" rend="right" source="#source-2678-2699"><rb>天地</rb><rt>てんち</rt></ruby><seg source="#source-2699-2739">のかぎりにひろごりぬる。</seg></p>
      <p source="#source-2739-2774"><seg source="#source-2739-2774">折りから真闇のをちに、</seg></p>
      <p source="#source-2774-2854"><ruby type="furigana" rend="right" source="#source-2774-2795"><rb>生命</rb><rt>いのち</rt></ruby><seg source="#source-2795-2798">の</seg><ruby type="furigana" rend="right" source="#source-2798-2810"><rb>緒</rb><rt>を</rt></ruby><ruby type="furigana" rend="right" source="#source-2810-2822"><rb>断</rb><rt>た</rt></ruby><seg source="#source-2822-2825">つ</seg><ruby type="furigana" rend="right" source="#source-2825-2849"><rb>氷鋏</rb><rt>ひばさみ</rt></ruby><seg source="#source-2849-2854">、</seg></p>
      <p source="#source-2854-2892"><seg source="#source-2854-2892">わなゝく大気にひゞきて、</seg></p>
      <p source="#source-2892-2951"><ruby type="furigana" rend="right" source="#source-2892-2913"><rb>終焉</rb><rt>をはり</rt></ruby><seg source="#source-2913-2922">の影を</seg><ruby type="furigana" rend="right" source="#source-2922-2940"><rb>依々</rb><rt>いゝ</rt></ruby><seg source="#source-2940-2951">たる、</seg></p>
      <p source="#source-2951-3019"><seg source="#source-2951-2957">あゝ</seg><ruby type="furigana" rend="right" source="#source-2957-2972"><rb>束</rb><rt>つか</rt></ruby><seg source="#source-2972-2975">の</seg><ruby type="furigana" rend="right" source="#source-2975-2987"><rb>間</rb><rt>ま</rt></ruby><seg source="#source-2987-2990">の</seg><ruby type="furigana" rend="right" source="#source-2990-3011"><rb>装飾</rb><rt>よそひ</rt></ruby><seg source="#source-3011-3019">に、</seg></p>
      <p source="#source-3019-3057"><seg source="#source-3019-3057">酔ひしれず、霊のまへに、</seg></p>
      <p source="#source-3057-3101"><seg source="#source-3057-3063">涙の</seg><ruby type="furigana" rend="right" source="#source-3063-3081"><rb>意</rb><rt>こゝろ</rt></ruby><seg source="#source-3081-3101">さぐらずば、</seg></p>
      <p source="#source-3101-3152"><seg source="#source-3101-3107">わが</seg><ruby type="furigana" rend="right" source="#source-3107-3122"><rb>魂</rb><rt>たま</rt></ruby><seg source="#source-3122-3152">いかにか迷ひけらし。</seg></p>
    </body>
