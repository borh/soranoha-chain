ruby type="furigana" rend="right" source="#source-692627-692651"><rb>宗助</rb><rt>そうすけ</rt></ruby><seg source="#source-692651-692654">は</seg><ruby type="furigana" rend="right" source="#source-692654-692669"><rb>又</rb><rt>また</rt></ruby><ruby type="furigana" rend="right" source="#source-692669-692690"><rb>自分</rb><rt>じぶん</rt></ruby><seg source="#source-692690-692693">の</seg><ruby type="furigana" rend="right" source="#source-692693-692708"><rb>未</rb><rt>いま</rt></ruby><seg source="#source-692708-692711">だ</seg><ruby type="furigana" rend="right" source="#source-692711-692726"><rb>曾</rb><rt>かつ</rt></ruby><seg source="#source-692726-692729">て</seg><ruby type="furigana" rend="right" source="#source-692729-692744"><rb>耳</rb><rt>みゝ</rt></ruby><seg source="#source-692744-692753">にした</seg><ruby type="furigana" rend="right" source="#source-692753-692768"><rb>事</rb><rt>こと</rt></ruby><seg source="#source-692768-692777">のない</seg><ruby type="furigana" rend="right" source="#source-692777-692795"><rb>話</rb><rt>はなし</rt></ruby><ruby type="furigana" rend="right" source="#source-692795-692810"><rb>丈</rb><rt>だけ</rt></ruby><seg source="#source-692810-692816">に、</seg><ruby type="furigana" rend="right" source="#source-692816-692840"><rb>一々</rb><rt><seg source="#source-692825-692831">いち</seg><choice source="#source-692831-692837"><orig>／＼</orig><reg>〱</reg></choice></rt></ruby><ruby type="furigana" rend="right" source="#source-692840-692855"><rb>少</rb><rt>すく</rt></ruby><seg source="#source-692855-692867">なからぬ</seg><ruby type="furigana" rend="right" source="#source-692867-692891"><rb>興味</rb><rt>きようみ</rt></ruby><seg source="#source-692891-692894">を</seg><ruby type="furigana" rend="right" source="#source-692894-692906"><rb>有</rb><rt>も</rt></ruby><seg source="#source-692906-692921">つてそれを</seg><ruby type="furigana" rend="right" source="#source-692921-692933"><rb>聞</rb><rt>き</rt></ruby><seg source="#source-692933-692939">いて</seg><ruby type="furigana" rend="right" source="#source-692939-692951"><rb>行</r