></ruby><seg source="#source-421160-421166">つて</seg><ruby type="furigana" rend="right" source="#source-421166-421181"><rb>下</rb><rt>くだ</rt></ruby><seg source="#source-421181-421193">さいと、</seg><ruby type="furigana" rend="right" source="#source-421193-421214"><rb>小六</rb><rt>ころく</rt></ruby><seg source="#source-421214-421217">の</seg><ruby type="furigana" rend="right" source="#source-421217-421232"><rb>方</rb><rt>はう</rt></ruby><seg source="#source-421232-421238">から</seg><ruby type="furigana" rend="right" source="#source-421238-421253"><rb>進</rb><rt>すゝ</rt></ruby><seg source="#source-421253-421262">んで、</seg><ruby type="furigana" rend="right" source="#source-421262-421283"><rb>御米</rb><rt>およね</rt></ruby><seg source="#source-421283-421286">に</seg><ruby type="furigana" rend="right" source="#source-421286-421301"><rb>物</rb><rt>もの</rt></ruby><seg source="#source-421301-421304">を</seg><ruby type="furigana" rend="right" source="#source-421304-421319"><rb>頼</rb><rt>たの</rt></ruby><seg source="#source-421319-421322">む</seg><ruby type="furigana" rend="right" source="#source-421322-421337"><rb>樣</rb><rt>やう</rt></ruby><seg source="#source-421337-421364">になつた。さうして</seg><ruby type="furigana" rend="right" source="#source-421364-421385"><rb>御米</rb><rt>およね</rt></ruby><seg source="#source-421385-421388">が</seg><ruby type="furigana" rend="right" source="#source-421388-421406"><rb>絣</rb><rt>かすり</rt></ruby><seg source="#source-421406-421409">の</seg><ruby type="furigana" rend="right" source="#source-421409-421430"><rb>羽織</rb><rt>はおり</rt></ruby><seg source="#source-421430-421433">を</seg><ruby type="furigana" rend="right" source="#source-421433-421454"><rb>受取</rb><rt>うけと</rt></ruby><seg source="#source-421454-421463">つて、</seg><ruby type="furigana" rend="right" source="#source-421463-421487"><rb>袖口</rb><rt>そでくち</rt></ruby><seg source="#source-421487-421490">の</seg><ruby type="furigana" rend="right" source="#source-421490-421511"><rb>綻</rb><rt>ほころび</rt></ruby><seg source="#source-421511-421514">を</se