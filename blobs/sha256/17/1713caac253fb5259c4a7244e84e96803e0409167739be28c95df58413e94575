"#source-421880-421901"><rb>御米</rb><rt>およね</rt></ruby><seg source="#source-421901-421904">の</seg><ruby type="furigana" rend="right" source="#source-421904-421919"><rb>例</rb><rt>れい</rt></ruby><seg source="#source-421919-421937">であつたが、</seg><ruby type="furigana" rend="right" source="#source-421937-421958"><rb>相手</rb><rt>あいて</rt></ruby><seg source="#source-421958-421961">が</seg><ruby type="furigana" rend="right" source="#source-421961-421982"><rb>小六</rb><rt>ころく</rt></ruby><seg source="#source-421982-421985">の</seg><ruby type="furigana" rend="right" source="#source-421985-422000"><rb>時</rb><rt>とき</rt></ruby><seg source="#source-422000-422015">には、さう</seg><ruby type="furigana" rend="right" source="#source-422015-422039"><rb>投遣</rb><rt>なげやり</rt></ruby><seg source="#source-422039-422042">に</seg><ruby type="furigana" rend="right" source="#source-422042-422060"><rb>出來</rb><rt>でき</rt></ruby><seg source="#source-422060-422075">ないのが、</seg><ruby type="furigana" rend="right" source="#source-422075-422090"><rb>又</rb><rt>また</rt></ruby><ruby type="furigana" rend="right" source="#source-422090-422111"><rb>御米</rb><rt>およね</rt></ruby><seg source="#source-422111-422114">の</seg><ruby type="furigana" rend="right" source="#source-422114-422138"><rb>性質</rb><rt>せいしつ</rt></ruby><seg source="#source-422138-422171">であつた。だからそんな</seg><ruby type="furigana" rend="right" source="#source-422171-422186"><rb>時</rb><rt>とき</rt></ruby><seg source="#source-422186-422192">には</seg><ruby type="furigana" rend="right" source="#source-422192-422207"><rb>力</rb><rt>つと</rt></ruby><seg source="#source-422207-422216">めても</seg><ruby type="furigana" rend="right" source="#source-422216-422234"><rb>話</rb><rt>はなし</rt></ruby><seg source="#source-422234-422246">をした。</seg><ruby type="furigana" rend="right" source="#source-422246-422264"><rb>話</rb><rt>はなし</rt></ruby><seg source="#source-422264-422267">の</seg><ruby type="furigana" rend="right" source="#source-422267-422291"><rb>題目</rb><rt>だいもく</rt></ruby><seg source="#source-422