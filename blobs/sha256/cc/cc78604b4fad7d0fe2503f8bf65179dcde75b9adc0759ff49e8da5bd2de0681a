  <text>
    <body>
      <p><seg source="#source-250-264">ついぢの</seg></p>
      <p><seg source="#source-264-287">椿の花のした、</seg></p>
      <p><seg source="#source-287-301">ここから</seg></p>
      <p><seg source="#source-301-315">輪まはし</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)"><seg source="#source-315-343">かけてつた。</seg></p>
      <p><seg source="#source-343-357">木ぎれで</seg></p>
      <p><seg source="#source-357-380">ひいた横の線、</seg></p>
      <p><seg source="#source-380-394">ここから</seg></p>
      <p><seg source="#source-394-408">からから</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)"><seg source="#source-408-436">かけてつた。</seg></p>
      <p><seg source="#source-436-447">帽子に</seg></p>
      <p><seg source="#source-447-470">椿の花插して、</seg></p>
      <p><seg source="#source-470-484">ぬくとい</seg></p>
      <p><seg source="#source-484-495">垣根に</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)"><seg source="#source-495-523">そつてつた。</seg></p>
      <p><seg source="#source-523-537">ついぢに</seg></p>
      <p><ruby type="furigana" rend="right" source="#source-537-552"><rb>凭</rb><rt>もた</rt></ruby><seg source="#source-552-578">れてあつち見て、</seg></p>
      <p><seg source="#source-578-592">あの子が</seg></p>
      <p><seg source="#source-592-603">ひとり</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)"><seg source="#source-603-627">まつてゐる。</seg></p>
    </body>
