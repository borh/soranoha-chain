        <p><seg source="#source-47855-47899">くりかへし、さはくりかへし、</seg></p>
        <p><seg source="#source-47899-47914">ゆめのごと</seg><ruby type="furigana" rend="right" source="#source-47914-47932"><rb>後</rb><rt>しりへ</rt></ruby><seg source="#source-47932-47935">に</seg><ruby type="furigana" rend="right" source="#source-47935-47947"><rb>連</rb><rt>つ</rt></ruby><seg source="#source-47947-47953">るる</seg><ruby type="furigana" rend="right" source="#source-47953-47968"><rb>笙</rb><rt>せう</rt></ruby><seg source="#source-47968-47971">の</seg><ruby type="furigana" rend="right" source="#source-47971-47986"><rb>節</rb><rt>ふし</rt></ruby><seg source="#source-47986-47991">、</seg></p>
