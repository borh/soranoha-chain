      <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-9706-10458"><seg source="#source-9706-9715">二三</seg><ruby type="furigana" rend="right" source="#source-9715-9733"><rb>日</rb><rt>にち</rt></ruby><ruby type="furigana" rend="right" source="#source-9733-9745"><rb>經</rb><rt>た</rt></ruby><seg source="#source-9745-9751">つた</seg><ruby type="furigana" rend="right" source="#source-9751-9763"><rb>或</rb><rt>あ</rt></ruby><seg source="#source-9763-9766">る</seg><ruby type="furigana" rend="right" source="#source-9766-9778"><rb>晴</rb><rt>は</rt></ruby><seg source="#source-9778-9784">れた</seg><ruby type="furigana" rend="right" source="#source-9784-9796"><rb>日</rb><rt>ひ</rt></ruby><seg source="#source-9796-9799">の</seg><ruby type="furigana" rend="right" source="#source-9799-9817"><rb>午後</rb><rt>ごご</rt></ruby><seg source="#source-9817-9829">だつた。</seg><ruby type="furigana" rend="right" source="#source-9829-9844"><rb>朝</rb><rt>あさ</rt></ruby><seg source="#source-9844-9847">の</seg><ruby type="furigana" rend="right" source="#source-9847-9871"><rb>半日</rb><rt>はんにち</rt></ruby><seg source="#source-9871-9889">をアトリエに</seg><ruby type="furigana" rend="right" source="#source-9889-9904"><rb>籠</rb><rt>こも</rt></ruby><seg source="#source-9904-9910">つた</seg><ruby type="furigana" rend="right" source="#source-9910-9928"><rb>夫</rb><rt>をつと</rt></ruby><seg source="#source-9928-9931">は</seg><ruby type="furigana" rend="right" source="#source-9931-9946"><rb>庭</rb><rt>には</rt></ruby><seg source="#source-9946-9949">で</seg><ruby type="furigana" rend="right" source="#source-9949-9970"><rb>二人</rb><rt>ふたり</rt></ruby><seg source="#source-9970-9973">の</seg><ruby type="furigana" rend="right" source="#source-9973-9994"><rb>子供</rb><rt>こども</rt></ruby><seg source="#source-9994-9997">と</seg><ruby type="furigana" rend="right" source="#source-9997-10027"><rb>快活</rb><rt>くわいくわつ</rt></ruby><seg source="#source-10027-10030">な</seg><ruby type="furigana" rend="right" source="#source-10030-10057"><rb>笑聲</rb><rt>