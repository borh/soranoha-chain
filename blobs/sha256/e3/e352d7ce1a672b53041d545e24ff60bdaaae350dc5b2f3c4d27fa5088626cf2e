      <p source="#source-241-270"><seg source="#source-241-270">波止場近くの白い船</seg></p>
      <p source="#source-270-290"><seg source="#source-270-290">波が寄せます</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-290-313"><seg source="#source-290-313">タポ　タポン</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-313-347"><seg source="#source-313-347">ホラ　タポ　タポン</seg></p>
      <p source="#source-347-391"><ruby type="furigana" rend="right" source="#source-347-368"><rb>甲板</rb><rt>でつき</rt></ruby><seg source="#source-368-391">に並んだ白い服</seg></p>
      <p source="#source-391-411"><seg source="#source-391-411">海をみてます</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-411-434"><seg source="#source-411-434">トロ　トロリ</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-434-468"><seg source="#source-434-468">ホラ　トロ　トロリ</seg></p>
      <p source="#source-468-512"><seg source="#source-468-512">お空にのびてる　メーンマスト</seg></p>
      <p source="#source-512-532"><seg source="#source-512-532">鴎が飛びます</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-532-555"><seg source="#source-532-555">サツ　サラリ</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-555-585"><seg source="#source-555-585">ホラ　サツ　サラリ</seg></p>
    </body>
