 rend="right" source="#source-91636-91651"><rb>細</rb><rt>こま</rt></ruby><seg source="#source-91651-91666">かくわける</seg><ruby type="furigana" rend="right" source="#source-91666-91690"><rb>學者</rb><rt>がくしや</rt></ruby><seg source="#source-91690-91693">が</seg><ruby type="furigana" rend="right" source="#source-91693-91705"><rb>出</rb><rt>で</rt></ruby><seg source="#source-91705-91708">て</seg><ruby type="furigana" rend="right" source="#source-91708-91720"><rb>來</rb><rt>き</rt></ruby><seg source="#source-91720-91777">ました。それはイギリスのラボックといふ</seg><ruby type="furigana" rend="right" source="#source-91777-91792"><rb>人</rb><rt>ひと</rt></ruby><seg source="#source-91792-91798">で、</seg><ruby type="furigana" rend="right" source="#source-91798-91834"><rb>石器時代</rb><rt>せつきじだい</rt></ruby><seg source="#source-91834-91840">をば</seg><ruby type="furigana" rend="right" source="#source-91840-91888"><rb>舊石器時代</rb><rt>きゆうせつきじだい</rt></ruby><seg source="#source-91888-91891">と</seg><ruby type="furigana" rend="right" source="#source-91891-91936"><rb>新石器時代</rb><rt>しんせつきじだい</rt></ruby><seg source="#source-91936-91939">の</seg><ruby type="furigana" rend="right" source="#source-91939-91954"><rb>二</rb><rt>ふた</rt></ruby><seg source="#source-91954-91996">つにわけることになりました。</seg><ruby type="furigana" rend="right" source="#source-91996-92020"><rb>今日</rb><rt>こんにち</rt></ruby><seg source="#source-92020-92026">われ</seg><choice source="#source-92026-92032"><orig>／＼</orig><reg>〱</reg></choice><seg source="#source-92032-92056">はラボックのわけ</seg><ruby type="furigana" rend="right" source="#source-92056-92071"><rb>方</rb><rt>かた</rt></ruby><seg source="#source-92071-92086">によつて、</seg><ruby type="furigana" rend="right" source="#source-92086-92122"><rb>石器時代</rb><rt>せつきじだい</rt></ruby><seg source="#source-92122-92125">を</seg><ruby type="furigana" rend="right" source="#source-92125-92140"><rb>二</rb><rt>ふた</rt></ruby><seg source="#source-92140-92158">つとするのが</seg><ruby type="furigana" rend="right" source="#source-92158-92179"><rb>普通</rb><rt>ふつう</r