 source="#source-132815-132842"><rb>兩方</rb><rt>りようほう</rt></ruby><seg source="#source-132842-132848">から</seg><ruby type="furigana" rend="right" source="#source-132848-132863"><rb>磨</rb><rt>みが</rt></ruby><seg source="#source-132863-132866">き</seg><ruby type="furigana" rend="right" source="#source-132866-132878"><rb>出</rb><rt>だ</rt></ruby><seg source="#source-132878-132890">してゐる</seg><ruby type="furigana" rend="right" source="#source-132890-132911"><rb>石斧</rb><rt>せきふ</rt></ruby><seg source="#source-132911-132926">、あるひは</seg><ruby type="furigana" rend="right" source="#source-132926-132941"><rb>長</rb><rt>なが</rt></ruby><seg source="#source-132941-132944">い</seg><ruby type="furigana" rend="right" source="#source-132944-132959"><rb>槍</rb><rt>やり</rt></ruby><seg source="#source-132959-132974">、あるひは</seg><ruby type="furigana" rend="right" source="#source-132974-133001"><rb>庖丁</rb><rt>ほうちよう</rt></ruby><seg source="#source-133001-133025">といつたふうに、</seg><ruby type="furigana" rend="right" source="#source-133025-133046"><rb>使用</rb><rt>しよう</rt></ruby><seg source="#source-133046-133049">に</seg><ruby type="furigana" rend="right" source="#source-133049-133070"><rb>便利</rb><rt>べんり</rt></ruby><seg source="#source-133070-133073">な</seg><ruby type="furigana" rend="right" source="#source-133073-133100"><rb>種々</rb><rt><seg source="#source-133082-133088">しゆ</seg><choice source="#source-133088-133097"><orig>／″＼</orig><reg>〲</reg></choice></rt></ruby><seg source="#source-133100-133103">の</seg><ruby type="furigana" rend="right" source="#source-133103-133121"><rb>形</rb><rt>かたち</rt></ruby><seg source="#source-133121-133124">が</seg><ruby type="furigana" rend="right" source="#source-133124-133142"><rb>出來</rb><rt>でき</rt></ruby><seg source="#source-133142-133187">たのであります。そしてそれらが</seg><ruby type="furigana" rend="right" source="#source-133187-133202"><rb>皆</rb><rt>みな</rt></ruby><seg source="#source-133202-133211">、その</seg><ruby type="furigana" rend="right" source="#source-133211-133223"><rb>後</rb><rt>ご</r