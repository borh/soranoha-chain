<ruby type="furigana" rend="right" source="#source-164657-164672"><rb>開</rb><rt>ひら</rt></ruby><seg source="#source-164672-164678">ける</seg><ruby type="furigana" rend="right" source="#source-164678-164693"><rb>前</rb><rt>まへ</rt></ruby><seg source="#source-164693-164714">に、クリートの</seg><ruby type="furigana" rend="right" source="#source-164714-164729"><rb>嶋</rb><rt>しま</rt></ruby><seg source="#source-164729-164738">やその</seg><ruby type="furigana" rend="right" source="#source-164738-164759"><rb>附近</rb><rt>ふきん</rt></ruby><seg source="#source-164759-164771">において</seg><ruby type="furigana" rend="right" source="#source-164771-164795"><rb>發達</rb><rt>はつたつ</rt></ruby><seg source="#source-164795-164801">した</seg><ruby type="furigana" rend="right" source="#source-164801-164825"><rb>文明</rb><rt>ぶんめい</rt></ruby><seg source="#source-164825-164840">も、やはり</seg><ruby type="furigana" rend="right" source="#source-164840-164870"><rb>青銅器</rb><rt>せいどうき</rt></ruby><seg source="#source-164870-164873">の</seg><ruby type="furigana" rend="right" source="#source-164873-164894"><rb>時代</rb><rt>じだい</rt></ruby><seg source="#source-164894-164897">に</seg><ruby type="furigana" rend="right" source="#source-164897-164912"><rb>屬</rb><rt>ぞく</rt></ruby><seg source="#source-164912-164963">するのでありました。ヨーロッパでは</seg><ruby type="furigana" rend="right" source="#source-164963-164981"><rb>南</rb><rt>みなみ</rt></ruby><seg source="#source-164981-164984">の</seg><ruby type="furigana" rend="right" source="#source-164984-164999"><rb>方</rb><rt>ほう</rt></ruby><seg source="#source-164999-165005">には</seg><ruby type="furigana" rend="right" source="#source-165005-165020"><rb>早</rb><rt>はや</rt></ruby><seg source="#source-165020-165023">く</seg><ruby type="furigana" rend="right" source="#source-165023-165038"><rb>鐵</rb><rt>てつ</rt></ruby><seg source="#source-165038-165053">がはひつて</seg><ruby type="furigana" rend="right" source="#source-165053-165065"><rb>來</rb><rt>き</rt></ruby><seg source="#source-165065-165080">ましたが、</seg><ruby type="furigana" ren