9">の</seg><ruby type="furigana" rend="right" source="#source-235389-235401"><rb>具</rb><rt>ぐ</rt></ruby><seg source="#source-235401-235404">で</seg><ruby type="furigana" rend="right" source="#source-235404-235416"><rb>塗</rb><rt>ぬ</rt></ruby><seg source="#source-235416-235434">つたものさへ</seg><ruby type="furigana" rend="right" source="#source-235434-235446"><rb>見</rb><rt>み</rt></ruby><seg source="#source-235446-235491">かけられるのであります。しかし</seg><ruby type="furigana" rend="right" source="#source-235491-235503"><rb>燒</rb><rt>や</rt></ruby><seg source="#source-235503-235506">き</seg><ruby type="furigana" rend="right" source="#source-235506-235521"><rb>方</rb><rt>かた</rt></ruby><seg source="#source-235521-235533">はどれも</seg><ruby type="furigana" rend="right" source="#source-235533-235551"><rb>軟</rb><rt>やはら</rt></ruby><seg source="#source-235551-235557">かい</seg><ruby type="furigana" rend="right" source="#source-235557-235572"><rb>質</rb><rt>しつ</rt></ruby><seg source="#source-235572-235587">ですから、</seg><ruby type="furigana" rend="right" source="#source-235587-235602"><rb>水</rb><rt>みづ</rt></ruby><seg source="#source-235602-235605">を</seg><ruby type="furigana" rend="right" source="#source-235605-235617"><rb>入</rb><rt>い</rt></ruby><seg source="#source-235617-235641">れるとたいていは</seg><ruby type="furigana" rend="right" source="#source-235641-235653"><rb>浸</rb><rt>し</rt></ruby><seg source="#source-235653-235656">み</seg><ruby type="furigana" rend="right" source="#source-235656-235668"><rb>出</rb><rt>だ</rt></ruby><seg source="#source-235668-235692">します。それには</seg><ruby type="furigana" rend="right" source="#source-235692-235713"><rb>當時</rb><rt>とうじ</rt></ruby><seg source="#source-235713-235716">の</seg><ruby type="furigana" rend="right" source="#source-235716-235731"><rb>人</rb><rt>ひと</rt></ruby><seg source="#source-235731-235734">も</seg><ruby type="furigana" rend="right" source="#source-235734-235749"><rb>定</rb><rt>さだ</rt></ruby><seg source="#source-235749-235755">めし</seg><ruby type="furigana" rend="right" source="#source-235755-235770"><rb>困</rb><rt>こま</rt></ruby><seg source="#source-235770-235797">つたこともあらうと</seg><ruby type="furigana" rend="right" source="#source-235797-235812"><rb>思</rb><rt>おも</rt></ruby><seg source="#source-235812-235830">はれますが、</seg><ruby type="furigana" rend="right" source="#source-235830-235854"><rb>今日</rb><rt>こんにち</rt></ruby><seg source="#source-235854-235866">のように</seg><ruby type="furigana" rend="right" source="#source-235866-235884"><rb>美</rb><rt>うつく</rt></ruby><seg source="#source-235884-235890">しい</seg><ruby type="furigana" rend="right" source="#source-235890-235911"><rb>座敷</rb><rt>ざしき</rt></ruby><seg source="#source-235911-235923">があつて</seg><ruby type="furigana" rend="right" source="#source-235923-235941"><rb>疊</rb><rt>たゝみ</rt></ruby><seg source="#source-235941-235944">の</seg><ruby type="furigana" rend="right" source="#source-235944-235959"><rb>上</rb><rt>うへ</rt></ruby><seg source="#source-235959-235989">にゐるわけではなく、</seg><ruby type="furigana" rend="right" source="#source-235989-236004"><rb>少</rb><rt>すこ</rt></ruby><seg source="#source-236004-236019">しぐらゐは</seg><ruby type="furigana" rend="right" source="#source-236019-236034"><rb>水</rb><rt>みづ</rt></ruby><seg source="#source-236034-236043">がしみ</seg><ruby type="furigana" rend="right" source="#source-236043-236055"><rb>出</rb><rt>だ</rt></ruby><seg source="#source-236055-236061">して</seg><ruby type="furigana" rend="right" source="#source-236061-236073"><rb>濡</rb><rt>ぬ</rt></ruby><seg source="#source-236073-236094">れたとて、さう</seg><ruby type="furigana" rend="right" source="#source-236094-236109"><rb>困</rb><rt>こま</rt></ruby><seg source="#source-236109-236175">るようなことはなかつたでせう。ところが、この</seg><ruby type="furigana" rend="right" source="#source-236175-236193"><rb>土器</rb><rt>どき</rt></ruby><seg source="#source-236193-236196">を</seg><ruby type="furigana" rend="right" source="#source-236196-236211"><rb>長</rb><rt>なが</rt></ruby><seg source="#source-236211-236214">く</seg><ruby type="furigana" rend="right" source="#sou