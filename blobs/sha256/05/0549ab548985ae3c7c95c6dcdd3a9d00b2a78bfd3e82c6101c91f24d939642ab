-56855"><rb>驚</rb><rt>おどろ</rt></ruby><seg source="#source-56855-56891">かされるたつて、のべつに</seg><ruby type="furigana" rend="right" source="#source-56891-56906"><rb>騷</rb><rt>さわ</rt></ruby><seg source="#source-56906-56909">ぐ</seg><ruby type="furigana" rend="right" source="#source-56909-56924"><rb>譯</rb><rt>わけ</rt></ruby><seg source="#source-56924-56936">はない。</seg><ruby type="furigana" rend="right" source="#source-56936-56954"><rb>塒</rb><rt>ねぐら</rt></ruby><seg source="#source-56954-56957">が</seg><ruby type="furigana" rend="right" source="#source-56957-56969"><rb>足</rb><rt>た</rt></ruby><seg source="#source-56969-56978">りない</seg><ruby type="furigana" rend="right" source="#source-56978-57002"><rb>喧嘩</rb><rt>けんくわ</rt></ruby><seg source="#source-57002-57011">なら、</seg><ruby type="furigana" rend="right" source="#source-57011-57032"><rb>銀杏</rb><rt>いてふ</rt></ruby><seg source="#source-57032-57035">の</seg><ruby type="furigana" rend="right" source="#source-57035-57050"><rb>方</rb><rt>はう</rt></ruby><seg source="#source-57050-57068">へ、いくらか</seg><ruby type="furigana" rend="right" source="#source-57068-57083"><rb>分</rb><rt>わか</rt></ruby><seg source="#source-57083-57092">れたら</seg><ruby type="furigana" rend="right" source="#source-57092-57104"><rb>可</rb><rt>よ</rt></ruby><seg source="#source-57104-57134">ささうなものだ。――</seg><ruby type="furigana" rend="right" source="#source-57134-57146"><rb>然</rb><rt>さ</rt></ruby><seg source="#source-57146-57167">うだ、ぽぷらの</seg><ruby type="furigana" rend="right" source="#source-57167-57179"><rb>樹</rb><rt>き</rt></ruby><seg source="#source-57179-57191">ばかりで</seg><ruby type="furigana" rend="right" source="#source-57191-57206"><rb>騷</rb><rt>さわ</rt></ruby><seg source="#source-57206-57218">ぐ。……</seg><ruby type="furigana" rend="right" source="#source-57218-57239"><rb>銀杏</rb><rt>いてふ</rt></ruby><seg source="#source-57239-57242">は</seg><ruby type="furigana" rend="right" source="#source-57242-57266"><rb>星空</rb><rt>ほしぞら</rt></ruby><seg source="#source-57266-57269">に</seg><ruby t