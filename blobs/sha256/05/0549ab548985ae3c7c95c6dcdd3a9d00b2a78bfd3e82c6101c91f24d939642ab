      <p style="text-indent: 1em" rend="first-line-indent(1)"><ruby type="furigana" rend="right" source="#source-30649-30673"><rb>天明</rb><rt>てんめい</rt></ruby><ruby type="furigana" rend="right" source="#source-30673-30688"><rb>六</rb><rt>ろく</rt></ruby><seg source="#source-30688-30691">、</seg><ruby type="furigana" rend="right" source="#source-30691-30727"><rb>丙午年</rb><rt>ひのえうまどし</rt></ruby><seg source="#source-30727-30733">は、</seg><ruby type="furigana" rend="right" source="#source-30733-30757"><rb>不思議</rb><rt>ふしぎ</rt></ruby><seg source="#source-30757-30760">に</seg><ruby type="furigana" rend="right" source="#source-30760-30787"><rb>元日</rb><rt>ぐわんじつ</rt></ruby><seg source="#source-30787-30790">も</seg><ruby type="furigana" rend="right" source="#source-30790-30817"><rb>丙午</rb><rt>ひのえうま</rt></ruby><seg source="#source-30817-30820">で</seg><ruby type="furigana" rend="right" source="#source-30820-30832"><rb>此</rb><rt>こ</rt></ruby><seg source="#source-30832-30835">の</seg><ruby type="furigana" rend="right" source="#source-30835-30850"><rb>年</rb><rt>とし</rt></ruby><seg source="#source-30850-30853">、</seg><ruby type="furigana" rend="right" source="#source-30853-30874"><rb>皆虧</rb><rt>かいき</rt></ruby><seg source="#source-30874-30877">の</seg><ruby type="furigana" rend="right" source="#source-30877-30895"><rb>蝕</rb><rt>しよく</rt></ruby><seg source="#source-30895-30910">があつた。</seg><ruby type="furigana" rend="right" source="#source-30910-30925"><rb>春</rb><rt>はる</rt></ruby><seg source="#source-30925-30940">よりして、</seg><ruby type="furigana" rend="right" source="#source-30940-30979"><rb>流言妖語</rb><rt>りうげんえうご</rt></ruby><seg source="#source-30979-30982">、</seg><ruby type="furigana" rend="right" source="#source-30982-31000"><rb>壯</rb><rt>さかん</rt></ruby><seg source="#source-31000-31003">に</seg><ruby type="furigana" rend="right" source="#source-31003-31021"><rb>行</rb><rt>おこな</rt></ruby><seg source="#source-31021-31030">はれ、</seg><ruby type="furigana" rend="right" source="#source-31030-31057"><rb>十月</r