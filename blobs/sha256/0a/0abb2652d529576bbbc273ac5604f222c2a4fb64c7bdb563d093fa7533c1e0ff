 rend="right" source="#source-635180-635192"><rb>痛</rb><rt>い</rt></ruby>てえまあ」<ruby type="furigana" rend="right" source="#source-635207-635231"><rb>群集</rb><rt>ぐんしふ</rt></ruby><seg source="#source-635231-635234">の</seg><ruby type="furigana" rend="right" source="#source-635234-635249"><rb>中</rb><rt>なか</rt></ruby><seg source="#source-635249-635255">から</seg><ruby type="furigana" rend="right" source="#source-635255-635279"><rb>假聲</rb><rt>こわいろ</rt></ruby><seg source="#source-635279-635294">でいつた。</seg><ruby type="furigana" rend="right" source="#source-635294-635312"><rb>踊</rb><rt>をどり</rt></ruby><seg source="#source-635312-635315">の</seg><ruby type="furigana" rend="right" source="#source-635315-635330"><rb>列</rb><rt>れつ</rt></ruby><seg source="#source-635330-635333">は</seg><ruby type="furigana" rend="right" source="#source-635333-635354"><rb>先刻</rb><rt>さつき</rt></ruby><seg source="#source-635354-635360">から</seg><ruby type="furigana" rend="right" source="#source-635360-635375"><rb>崩</rb><rt>くづ</rt></ruby><seg source="#source-635375-635381">れて</seg><ruby type="furigana" rend="right" source="#source-635381-635393"><rb>堵</rb><rt>と</rt></ruby><seg source="#source-635393-635396">の</seg><ruby type="furigana" rend="right" source="#source-635396-635411"><rb>如</rb><rt>ごと</rt></ruby><seg source="#source-635411-635414">く</seg><ruby type="furigana" rend="right" source="#source-635414-635435"><rb>勘次</rb><rt>かんじ</rt></ruby><seg source="#source-635435-635450">とおつぎの</seg><ruby type="furigana" rend="right" source="#source-635450-635471"><rb>周圍</rb><rt>まはり</rt></ruby><seg source="#source-635471-635474">に</seg><ruby type="furigana" rend="right" source="#source-635474-635489"><rb>集</rb><rt>あつ</rt></ruby><seg source="#source-635489-635525">まつたのである。おつぎは</seg><ruby type="furigana" rend="right" source="#source-635525-635540"><rb>此</rb><rt>この</rt></ruby><ruby type="furigana" rend="right" source="#source-635540-635555"><rb>聲</rb><rt>こゑ</rt></ruby><seg source="#source-635555-635558">を</seg><ruby type="furigana" rend="right" source="#source-635558-635570"><rb>聞</rb><rt>き</rt></ruby><seg source="#source-635570-635576">くと</seg><ruby type="furigana" rend="right" source="#source-635576-635591"><rb>共</rb><rt>とも</rt></ruby><seg source="#source-635591-635594">に</seg><ruby type="furigana" rend="right" source="#source-635594-635609"><rb>亂</rb><rt>みだ</rt></ruby><seg source="#source-635609-635612">れ</seg><ruby type="furigana" rend="right" source="#source-635612-635624"><rb>掛</rb><rt>か</rt></ruby><seg source="#source-635624-635630">けた</seg><ruby type="furigana" rend="right" source="#source-635630-635651"><rb>衣物</rb><rt>きもの</rt></ruby><seg source="#source-635651-635654">の</seg><ruby type="furigana" rend="right" source="#source-635654-635669"><rb>合</rb><rt>あは</rt></ruby><seg source="#source-635669-635672">せ</seg><ruby type="furigana" rend="right" source="#source-635672-635684"><rb>目</rb><rt>め</rt></ruby><seg source="#source-635684-635687">を</seg><ruby type="furigana" rend="right" source="#source-635687-635705"><rb>繕</rb><rt>つくろ</rt></ruby><seg source="#source-635705-635716">うた。</seg></p>
