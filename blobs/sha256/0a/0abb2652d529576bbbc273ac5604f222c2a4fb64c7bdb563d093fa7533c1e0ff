        <p><seg source="#source-590917-590920">「</seg><ruby type="furigana" rend="right" source="#source-590920-590950"><rb>毎日暮</rb><rt>まいひぐれ</rt></ruby><seg source="#source-590950-590965">ぢやねえけ</seg><ruby type="furigana" rend="right" source="#source-590965-590989"><rb>徳利</rb><rt>とつくり</rt></ruby><seg source="#source-590989-590995">おつ</seg><ruby type="furigana" rend="right" source="#source-590995-591007"><rb>立</rb><rt>た</rt></ruby>てゝんな」</p>
        <p>「さうなんだ、<ruby type="furigana" rend="right" source="#source-591045-591069"><rb>近頃</rb><rt>ちかごろ</rt></ruby><ruby type="furigana" rend="right" source="#source-591069-591093"><rb>唐鍬</rb><rt>たうぐは</rt></ruby><ruby type="furigana" rend="right" source="#source-591093-591108"><rb>使</rb><rt>つけ</rt></ruby><seg source="#source-591108-591111">え</seg><ruby type="furigana" rend="right" source="#source-591111-591126"><rb>骨</rb><rt>ほね</rt></ruby><ruby type="furigana" rend="right" source="#source-591126-591141"><rb>折</rb><rt>おれ</rt></ruby><seg source="#source-591141-591156">つからつて</seg><ruby type="furigana" rend="right" source="#source-591156-591177"><rb>仕事</rb><rt>しごと</rt></ruby><ruby type="furigana" rend="right" source="#source-591177-591192"><rb>畢</rb><rt>しま</rt></ruby><seg source="#source-591192-591204">つちや一</seg><ruby type="furigana" rend="right" source="#source-591204-591222"><rb>合</rb><rt>がふ</rt></ruby><ruby type="furigana" rend="right" source="#source-591222-591240"><rb>位</rb><rt>ぐれえ</rt></ruby><ruby type="furigana" rend="right" source="#source-591240-591252"><rb>引</rb><rt>ひ</rt></ruby><seg source="#source-591252-591255">つ</seg><ruby type="furigana" rend="right" source="#source-591255-591267"><rb>掛</rb><rt>か</rt></ruby><seg source="#source-591267-591273">けて</seg><ruby type="furigana" rend="right" source="#source-591273-591285"><rb>直</rb><rt>す</rt></ruby><seg source="#source-591285-591288">ぐ</seg><ruby type="furigana" rend="right" source="#source-591288-591300"><rb>行</rb><rt>い</rt></ruby><seg source="#source-591300-591339">つちやあんだつちけが、それ</seg><ruby type="furigana" rend="right" source="#source-591339-591357"><rb>今日</rb><rt>けふ</rt></ruby><seg source="#source-591357-591360">は</seg><ruby type="furigana" rend="right" source="#source-591360-591375"><rb>早</rb><rt>はや</rt></ruby><seg source="#source-591375-591384">くから</seg><ruby type="furigana" rend="right" source="#source-591384-591396"><rb>來</rb><rt>き</rt></ruby><seg source="#source-591396-591423">てたんだつちきや、</seg><ruby type="f