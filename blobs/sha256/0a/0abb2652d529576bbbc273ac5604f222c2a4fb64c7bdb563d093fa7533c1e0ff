<rt>ほか</rt></ruby><seg source="#source-465338-465341">に</seg><ruby type="furigana" rend="right" source="#source-465341-465356"><rb>道</rb><rt>みち</rt></ruby><seg source="#source-465356-465359">は</seg><ruby type="furigana" rend="right" source="#source-465359-465371"><rb>無</rb><rt>な</rt></ruby><seg source="#source-465371-465392">いのであるが、</seg><ruby type="furigana" rend="right" source="#source-465392-465413"><rb>不在</rb><rt>ふざい</rt></ruby><seg source="#source-465413-465425">であつた</seg><ruby type="furigana" rend="right" source="#source-465425-465449"><rb>主人</rb><rt>しゆじん</rt></ruby><seg source="#source-465449-465452">は</seg><ruby type="furigana" rend="right" source="#source-465452-465464"><rb>其</rb><rt>そ</rt></ruby><seg source="#source-465464-465467">の</seg><ruby type="furigana" rend="right" source="#source-465467-465479"><rb>日</rb><rt>ひ</rt></ruby><seg source="#source-465479-465482">も</seg><ruby type="furigana" rend="right" source="#source-465482-465497"><rb>歸</rb><rt>かへ</rt></ruby><seg source="#source-465497-465509">らない。</seg><ruby type="furigana" rend="right" source="#source-465509-465530"><rb>勘次</rb><rt>かんじ</rt></ruby><seg source="#source-465530-465533">は</seg><ruby type="furigana" rend="right" source="#source-465533-465557"><rb>只管</rb><rt>ひたすら</rt></ruby><seg source="#source-465557-465560">に</seg><ruby type="furigana" rend="right" source="#source-465560-465584"><rb>主人</rb><rt>しゆじん</rt></ruby><seg source="#source-465584-465587">の</seg><ruby type="furigana" rend="right" source="#source-465587-465605"><rb>力</rb><rt>ちから</rt></ruby><seg source="#source-465605-465608">に</seg><ruby type="furigana" rend="right" source="#source-465608-465620"><rb>倚</rb><rt>よ</rt></ruby><seg source="#source-465620-465632">つてのみ</seg><ruby type="furigana" rend="right" source="#source-465632-465647"><rb>救</rb><rt>すく</rt></ruby><seg source="#source-465647-465665">はれるものと</seg><ruby type="furigana" rend="right" source="#source-465665-465680"><rb>念</rb><rt>ねん</rt></ruby><seg source="#source-465680-465686