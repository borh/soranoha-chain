        <p>「どうしたんでえ、<hi rend="bouten 傍点 right" source="#source-268901-268937"><seg source="#source-268901-268907">よき</seg></hi>は」おつぎは<ruby type="furigana" rend="right" source="#source-268955-268967"><rb>見</rb><rt>み</rt></ruby><seg source="#source-268967-268973">ると</seg><ruby type="furigana" rend="right" source="#source-268973-268988"><rb>針</rb><rt>はり</rt></ruby><seg source="#source-268988-268991">が</seg><ruby type="furigana" rend="right" source="#source-268991-269009"><rb>向</rb><rt>むかふ</rt></ruby><seg source="#source-269009-269012">の</seg><ruby type="furigana" rend="right" source="#source-269012-269027"><rb>岸</rb><rt>きし</rt></ruby><seg source="#source-269027-269033">から</seg><ruby type="furigana" rend="right" source="#source-269033-269045"><rb>出</rb><rt>で</rt></ruby><seg source="#source-269045-269048">た</seg><ruby type="furigana" rend="right" source="#source-269048-269063"><rb>低</rb><rt>ひく</rt></ruby><seg source="#source-269063-269066">い</seg><ruby type="furigana" rend="right" source="#source-269066-269093"><rb>川楊</rb><rt>かはやなぎ</rt></ruby><seg source="#source-269093-269096">の</seg><ruby type="furigana" rend="right" source="#source-269096-269111"><rb>枝</rb><rt>えだ</rt></ruby><seg source="#source-269111-269114">に</seg><ruby type="furigana" rend="right" source="#source-269114-269132"><rb>纏</rb><rt>まつは</rt></ruby><seg source="#source-269132-269138">つて</seg><ruby type="furigana" rend="right" source="#source-269138-269153"><rb>絲</rb><rt>いと</rt></ruby><seg source="#source-269153-269156">の</seg><ruby type="furigana" rend="right" source="#source-269156-269171"><rb>端</rb><rt>はし</rt></ruby><seg source="#source-269171-269174">が</seg><ruby type="furigana" rend="right" source="#source-269174-269189"><rb>水</rb><rt>みづ</rt></ruby><seg source="#source-269189-269201">について</seg><ruby type="furigana" rend="right" source="#source-269201-269222"><rb>下流</rb><rt>かりう</rt></ruby><seg source="#source-269222-269225">へ</seg><ruby type="furigana" rend="right" source="#source-269225-269237"><rb>向</r