        <p><seg source="#source-100154-100157">「</seg><ruby type="furigana" rend="right" source="#source-100157-100184"><rb>蒟蒻</rb><rt>こんにやく</rt></ruby><seg source="#source-100184-100190">はお</seg><ruby type="furigana" rend="right" source="#source-100190-100205"><rb>品</rb><rt>しな</rt></ruby><seg source="#source-100205-100226">がもんだから、</seg><ruby type="furigana" rend="right" source="#source-100226-100241"><rb>錢</rb><rt>ぜに</rt></ruby><seg source="#source-100241-100265">はみんなおめえげ</seg><ruby type="furigana" rend="right" source="#source-100265-100277"><rb>遣</rb><rt>や</rt></ruby><seg source="#source-100277-100283">つて</seg><ruby type="furigana" rend="right" source="#source-100283-100295"><rb>置</rb><rt>お</rt></ruby>くべ」<ruby type="furigana" rend="right" source="#source-100304-100325"><rb>勘次</rb><rt>かんじ</rt></ruby><seg source="#source-100325-100328">は</seg><ruby type="furigana" rend="right" source="#source-100328-100352"><rb>銅貨</rb><rt>どうくわ</rt></ruby><seg source="#source-100352-100364">をぢやら</seg><choice source="#source-100364-100370"><orig>／＼</orig><reg>〱</reg></choice><seg source="#source-100370-100376">とお</seg><ruby type="furigana" rend="right" source="#source-100376-100391"><rb>品</rb><rt>しな</rt></ruby><seg source="#source-100391-100394">の</seg><ruby type="furigana" rend="right" source="#source-100394-100421"><rb>枕元</rb><rt>まくらもと</rt></ruby><seg source="#source-100421-100424">へ</seg><ruby type="furigana" rend="right" source="#source-100424-100436"><rb>明</rb><rt>あ</rt></ruby><seg source="#source-100436-100448">けた。お</seg><ruby type="furigana" rend="right" source="#source-100448-100463"><rb>品</rb><rt>しな</rt></ruby><seg source="#source-100463-100466">は</seg><ruby type="furigana" rend="right" source="#source-100466-100490"><rb>銅貨</rb><rt>どうくわ</rt></ruby><seg source="#source-100490-100499">を一つ</seg><choice source="#source-100499-100505"><orig>／＼</orig><reg>〱</reg></choice><ruby type="furigana" rend="right" source="#source-100505-100532"><rb>勘定</rb><rt>かんぢやう</rt></ruby><seg source="#