        <p style="text-indent: 1em" rend="first-line-indent(1)"><ruby type="furigana" rend="right" source="#source-964295-964313"><rb>隣</rb><rt>となり</rt></ruby><seg source="#source-964313-964316">の</seg><ruby type="furigana" rend="right" source="#source-964316-964331"><rb>庭</rb><rt>には</rt></ruby><seg source="#source-964331-964337">では</seg><ruby type="furigana" rend="right" source="#source-964337-964358"><rb>先刻</rb><rt>さつき</rt></ruby><seg source="#source-964358-964367">よりも</seg><ruby type="furigana" rend="right" source="#source-964367-964382"><rb>更</rb><rt>さら</rt></ruby><seg source="#source-964382-964385">に</seg><ruby type="furigana" rend="right" source="#source-964385-964406"><rb>勢</rb><rt>いきほひ</rt></ruby><seg source="#source-964406-964418">がついた</seg><ruby type="furigana" rend="right" source="#source-964418-964433"><rb>樣</rb><rt>やう</rt></ruby><seg source="#source-964433-964436">に</seg><ruby type="furigana" rend="right" source="#source-964436-964457"><rb>連枷</rb><rt>ふるぢ</rt></ruby><seg source="#source-964457-964460">の</seg><ruby type="furigana" rend="right" source="#source-964460-964478"><rb>響</rb><rt>ひゞき</rt></ruby><seg source="#source-964478-964481">が</seg><ruby type="furigana" rend="right" source="#source-964481-964499"><rb>囃</rb><rt>はやし</rt></ruby><seg source="#source-964499-964502">の</seg><ruby type="furigana" rend="right" source="#source-964502-964517"><rb>聲</rb><rt>こゑ</rt></ruby><seg source="#source-964517-964520">を</seg><ruby type="furigana" rend="right" source="#source-964520-964538"><rb>伴</rb><rt>ともな</rt></ruby><seg source="#source-964538-964547">ひつゝ</seg><ruby type="furigana" rend="right" source="#source-964547-964562"><rb>森</rb><rt>もり</rt></ruby><seg source="#source-964562-964565">を</seg><ruby type="furigana" rend="right" source="#source-964565-964577"><rb>洩</rb><rt>も</rt></ruby><seg source="#source-964577-964583">れて</seg><ruby type="furigana" rend="right" source="#source-964583-964598"><rb>聞</rb><rt>きこ</rt></ruby><seg source="#source-964598-964609">えた。</se