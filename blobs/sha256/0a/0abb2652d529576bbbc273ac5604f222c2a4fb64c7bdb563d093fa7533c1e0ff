" rend="right" source="#source-968936-968948"><rb>云</rb><rt>ゆ</rt></ruby><seg source="#source-968948-968957">つちや</seg><ruby type="furigana" rend="right" source="#source-968957-968978"><rb>我慾</rb><rt>がよく</rt></ruby><seg source="#source-968978-968981">の</seg><ruby type="furigana" rend="right" source="#source-968981-968996"><rb>樣</rb><rt>やう</rt></ruby><seg source="#source-968996-969026">だがおんなじもんなら</seg><ruby type="furigana" rend="right" source="#source-969026-969041"><rb>軟</rb><rt>やつ</rt></ruby><seg source="#source-969041-969047">けえ</seg><ruby type="furigana" rend="right" source="#source-969047-969068"><rb>言辭</rb><rt>ことば</rt></ruby><seg source="#source-969068-969074">でも</seg><ruby type="furigana" rend="right" source="#source-969074-969086"><rb>掛</rb><rt>か</rt></ruby><seg source="#source-969086-969101">けてくれる</seg><ruby type="furigana" rend="right" source="#source-969101-969116"><rb>嫁</rb><rt>よめ</rt></ruby>でなくつちやねえ、さうぢやあんめえかね」おつたは<ruby type="furigana" rend="right" source="#source-969188-969203"><rb>狹</rb><rt>せま</rt></ruby><seg source="#source-969203-969206">い</seg><ruby type="furigana" rend="right" source="#source-969206-969227"><rb>戸口</rb><rt>とぐち</rt></ruby><seg source="#source-969227-969230">に</seg><ruby type="furigana" rend="right" source="#source-969230-969242"><rb>立</rb><rt>た</rt></ruby><seg source="#source-969242-969248">つた</seg><ruby type="furigana" rend="right" source="#source-969248-969263"><rb>儘</rb><rt>まゝ</rt></ruby><ruby type="furigana" rend="right" source="#source-969263-969281"><rb>洋傘</rb><rt>かさ</rt></ruby><seg source="#source-969281-969284">の</seg><ruby type="furigana" rend="right" source="#source-969284-969299"><rb>先</rb><rt>さき</rt></ruby><seg source="#source-969299-969302">で</seg><ruby type="furigana" rend="right" source="#source-969302-969317"><rb>土</rb><rt>つち</rt></ruby><seg source="#source-969317-969320">へ</seg><ruby type="furigana" rend="right" source="#source-969320-969335"><rb>穴</rb><rt>あな</rt></ruby><seg source="#source-969335-969338">を</seg><ruby