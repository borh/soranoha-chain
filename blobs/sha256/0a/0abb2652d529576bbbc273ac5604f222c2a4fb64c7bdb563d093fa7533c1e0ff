        <p><seg source="#source-100818-100821">「</seg><ruby type="furigana" rend="right" source="#source-100821-100836"><rb>幾</rb><rt>いく</rt></ruby><seg source="#source-100836-100863">らでもねえな、はあ</seg><ruby type="furigana" rend="right" source="#source-100863-100887"><rb>此丈</rb><rt>これだけ</rt></ruby><seg source="#source-100887-100893">ぢや</seg><ruby type="furigana" rend="right" source="#source-100893-100908"><rb>又</rb><rt>また</rt></ruby><ruby type="furigana" rend="right" source="#source-100908-100920"><rb>出</rb><rt>で</rt></ruby><seg source="#source-100920-100923">る</seg><ruby type="furigana" rend="right" source="#source-100923-100938"><rb>程</rb><rt>ほど</rt></ruby>のこつてもあんめえよ」<ruby type="furigana" rend="right" source="#source-100971-100992"><rb>勘次</rb><rt>かんじ</rt></ruby><seg source="#source-100992-101010">はいつた。お</seg><ruby type="furigana" rend="right" source="#source-101010-101025"><rb>品</rb><rt>しな</rt></ruby><seg source="#source-101025-101028">は</seg><ruby type="furigana" rend="right" source="#source-101028-101049"><rb>自分</rb><rt>じぶん</rt></ruby><seg source="#source-101049-101052">の</seg><ruby type="furigana" rend="right" source="#source-101052-101064"><rb>手</rb><rt>て</rt></ruby><seg source="#source-101064-101067">で</seg><ruby type="furigana" rend="right" source="#source-101067-101082"><rb>錢</rb><rt>ぜに</rt></ruby><seg source="#source-101082-101085">を</seg><ruby type="furigana" rend="right" source="#source-101085-101106"><rb>蒲團</rb><rt>ふとん</rt></ruby><seg source="#source-101106-101109">の</seg><ruby type="furigana" rend="right" source="#source-101109-101124"><rb>下</rb><rt>した</rt></ruby><seg source="#source-101124-101127">へ</seg><ruby type="furigana" rend="right" source="#source-101127-101139"><rb>入</rb><rt>い</rt></ruby><seg source="#source-101139-101148">れた。</seg><ruby type="furigana" rend="right" source="#source-101148-101160"><rb>其</rb><rt>そ</rt></ruby><seg source="#source-101160-101163">の</seg><ruby type="furigana" rend="right" source="#source-101163-101175"><rb>日</rb><rt>ひ</rt></ruby><seg source="#source-101175-101178">お</seg><ruby type="furigana" rend="right" source="#source-101178-101193"><rb>品</rb><rt>しな</rt></ruby><seg source="#source-101193-101196">は</seg><ruby type="furigana" rend="right" source="#source-101196-101217"><rb>勘次</rb><rt>かんじ</rt></ruby><seg source="#source-101217-101220">を</seg><ruby type="furigana" rend="right" source="#source-101220-101232"><rb>出</rb><rt>だ</rt></ruby><seg source="#source-101232-101238">して</seg><ruby type="furigana" rend="right" source="#source-101238-101256"><rb>情</rb><rt>なさけ</rt></ruby><seg source="#source-101256-101271">ないやうな</seg><ruby type="furigana" rend="right" source="#source-101271-101298"><rb>心持</rb><rt>こゝろもち</rt></ruby><seg source="#source-101298-101307">がして</seg><ruby type="furigana" rend="right" source="#source-101307-101319"><rb>居</rb><rt>ゐ</rt></ruby><seg source="#source-101319-101340">たのであるが、</seg><ruby type="furigana" rend="right" source="#source-101340-101355"><rb>思</rb><rt>おも</rt></ruby><seg source="#source-101355-101370">つたよりは</seg><ruby type="furigana" rend="right" source="#source-101370-101391"><rb>商</rb><rt>あきなひ</rt></ruby><seg source="#source-101391-101400">をして</seg><ruby type="furigana" rend="right" source="#source-101400-101412"><rb>來</rb><rt>き</rt></ruby><seg source="#source-101412-101415">て</seg><ruby type="furigana" rend="right" source="#source-101415-101427"><rb>呉</rb><rt>く</rt></ruby><seg source="#source-101427-101442">れたので一</seg><ruby type="furigana" rend="right" source="#source-101442-101460"><rb>日</rb><rt>にち</rt></ruby><seg source="#source-101460-101463">の</seg><ruby type="furigana" rend="right" source="#source-101463-101484"><rb>不足</rb><rt>ふそく</rt></ruby><seg source="#source-101484-101487">が</seg><ruby type="furigana" rend="right" source="#source-101487-101505"><rb>全</rb><rt>まつた</rt></ruby><seg source="#source-101505-101508">く</seg><ruby type="furigana" rend="right" source="#source-101508-101535"><rb>恢復</rb><rt>くわいふく</rt></ruby><seg source="#source-101535-101561">