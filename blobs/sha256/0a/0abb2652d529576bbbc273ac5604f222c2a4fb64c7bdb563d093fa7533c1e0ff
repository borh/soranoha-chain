        <p>「そりや<ruby type="furigana" rend="right" source="#source-486709-486733"><rb>書付</rb><rt>かきつけ</rt></ruby><seg source="#source-486733-486748">なんぞは、</seg><ruby type="furigana" rend="right" source="#source-486748-486769"><rb>旦那</rb><rt>だんな</rt></ruby><seg source="#source-486769-486772">が</seg><ruby type="furigana" rend="right" source="#source-486772-486784"><rb>書</rb><rt>か</rt></ruby><seg source="#source-486784-486790">いて</seg><ruby type="furigana" rend="right" source="#source-486790-486802"><rb>遣</rb><rt>や</rt></ruby><seg source="#source-486802-486811">るから</seg><ruby type="furigana" rend="right" source="#source-486811-486835"><rb>心配</rb><rt>しんぱい</rt></ruby><seg source="#source-486835-486841">にや</seg><ruby type="furigana" rend="right" source="#source-486841-486853"><rb>成</rb><rt>な</rt></ruby>らないがね」<ruby type="furigana" rend="right" source="#source-486871-486889"><rb>内儀</rb><rt>かみ</rt></ruby><seg source="#source-486889-486898">さんは</seg><ruby type="furigana" rend="right" source="#source-486898-486916"><rb>漸</rb><rt>やうや</rt></ruby><seg source="#source-486916-486919">く</seg><ruby type="furigana" rend="right" source="#source-486919-486943"><rb>近所</rb><rt>きんじよ</rt></ruby><seg source="#source-486943-486946">の</seg><ruby type="furigana" rend="right" source="#source-486946-486961"><rb>者</rb><rt>もの</rt></ruby><seg source="#source-486961-486964">を</seg><ruby type="furigana" rend="right" source="#source-486964-486985"><rb>一人</rb><rt>ひとり</rt></ruby><ruby type="furigana" rend="right" source="#source-486985-486997"><rb>跟</rb><rt>つ</rt></ruby><seg source="#source-486997-487021">いてくやうにして</seg><ruby type="furigana" rend="right" source="#source-487021-487033"><rb>遣</rb><rt>や</rt></ruby><seg source="#source-487033-487066">るといふことにしたので</seg><ruby type="furigana" rend="right" source="#source-487066-487096"><rb>被害者</rb><rt>ひがいしや</rt></ruby><seg source="#source-487096-487099">も</seg><ruby type="furigana" rend="right" source="#source-487099-487114"><rb>思</rb><rt>おも</rt></ruby><seg source