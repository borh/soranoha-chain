        <p><seg source="#source-80218-80221">「</seg><ruby type="furigana" rend="right" source="#source-80221-80236"><rb>米</rb><rt>こめ</rt></ruby><seg source="#source-80236-80245">ばかり</seg><ruby type="furigana" rend="right" source="#source-80245-80257"><rb>炊</rb><rt>た</rt></ruby><seg source="#source-80257-80266">えても</seg><ruby type="furigana" rend="right" source="#source-80266-80290"><rb>毎日</rb><rt>まいにち</rt></ruby><seg source="#source-80290-80293">一</seg><ruby type="furigana" rend="right" source="#source-80293-80314"><rb>升</rb><rt>しよう</rt></ruby><seg source="#source-80314-80323">づゝは</seg><ruby type="furigana" rend="right" source="#source-80323-80335"><rb>要</rb><rt>え</rt></ruby><seg source="#source-80335-80338">る</seg><ruby type="furigana" rend="right" source="#source-80338-80356"><rb>位</rb><rt>くれえ</rt></ruby><seg source="#source-80356-80365">だから</seg><ruby type="furigana" rend="right" source="#source-80365-80380"><rb>骨</rb><rt>ほね</rt></ruby><seg source="#source-80380-80383">も</seg><ruby type="furigana" rend="right" source="#source-80383-80407"><rb>隨分</rb><rt>ずゐぶん</rt></ruby><ruby type="furigana" rend="right" source="#source-80407-80419"><rb>折</rb><rt>を</rt></ruby><seg source="#source-80419-80428">れんが</seg><ruby type="furigana" rend="right" source="#source-80428-80440"><rb>出</rb><rt>で</rt></ruby><seg source="#source-80440-80458">せえすりや二</seg><ruby type="furigana" rend="right" source="#source-80458-80479"><rb>貫</rb><rt>くわん</rt></ruby><seg source="#source-80479-80485">と三</seg><ruby type="furigana" rend="right" source="#source-80485-80506"><rb>貫</rb><rt>ぐわん</rt></ruby><seg source="#source-80506-80509">は</seg><ruby type="furigana" rend="right" source="#source-80509-80524"><rb>殘</rb><rt>のこ</rt></ruby><seg source="#source-80524-80539">せつから、</seg><ruby type="furigana" rend="right" source="#source-80539-80554"><rb>歸</rb><rt>けえ</rt></ruby><seg source="#source-80554-80569">るまでにや</seg><ruby type="furigana" rend="right" source="#source-80569-80584"><rb>俺</rb><rt>おれ</rt></ruby><seg 