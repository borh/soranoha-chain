seg><ruby type="furigana" rend="right" source="#source-427896-427908"><rb>欲</rb><rt>ほ</rt></ruby><seg source="#source-427908-427911">し</seg><ruby type="furigana" rend="right" source="#source-427911-427926"><rb>相</rb><rt>さう</rt></ruby><seg source="#source-427926-427929">な</seg><ruby type="furigana" rend="right" source="#source-427929-427944"><rb>顏</rb><rt>かほ</rt></ruby><seg source="#source-427944-427953">をして</seg><ruby type="furigana" rend="right" source="#source-427953-427968"><rb>默</rb><rt>だま</rt></ruby><seg source="#source-427968-427974">つて</seg><ruby type="furigana" rend="right" source="#source-427974-427986"><rb>見</rb><rt>み</rt></ruby><seg source="#source-427986-427989">て</seg><ruby type="furigana" rend="right" source="#source-427989-428001"><rb>居</rb><rt>ゐ</rt></ruby><seg source="#source-428001-428010">るので</seg><ruby type="furigana" rend="right" source="#source-428010-428028"><rb>何處</rb><rt>どこ</rt></ruby><seg source="#source-428028-428034">でも</seg><ruby type="furigana" rend="right" source="#source-428034-428049"><rb>熱</rb><rt>あつ</rt></ruby><seg source="#source-428049-428052">い</seg><ruby type="furigana" rend="right" source="#source-428052-428079"><rb>甘藷</rb><rt>さつまいも</rt></ruby><seg source="#source-428079-428082">が</seg><ruby type="furigana" rend="right" source="#source-428082-428097"><rb>與</rb><rt>あた</rt></ruby><seg source="#source-428097-428127">へられるのであつた。</seg><ruby type="furigana" rend="right" source="#source-428127-428142"><rb>或</rb><rt>ある</rt></ruby><ruby type="furigana" rend="right" source="#source-428142-428157"><rb>時</rb><rt>とき</rt></ruby><ruby type="furigana" rend="right" source="#source-428157-428172"><rb>彼</rb><rt>かれ</rt></ruby><seg source="#source-428172-428177">は</seg></p>
        <p><seg source="#source-428177-428180">「</seg><ruby type="furigana" rend="right" source="#source-428180-428192"><rb>俺</rb><rt>お</rt></ruby><seg source="#source-428192-428198">らあ</seg><ruby type="furigana" rend="right" source="#source-428198-428213"><rb>家</rb><rt>うち</rt></ruby><seg source="#source-428213-428216">で</seg><ruby type="furigana" rend="right" source="#source-428216-428237"><rb>甘藷</rb><rt>さつま</rt></ruby>くつたなんてゆはねえんだ」<ruby type="furigana" rend="right" source="#source-428276-428303"><rb>甘藷</rb><rt>さつまいも</rt></ruby><seg source="#source-428303-428306">を</seg><ruby type="furigana" rend="right" source="#source-428306-428318"><rb>手</rb><rt>て</rt></ruby><seg source="#source-428318-428321">に</seg><ruby type="furigana" rend="right" source="#source-428321-428333"><rb>持</rb><rt>も</rt></ruby><seg source="#source-428333-428339">つて</seg><ruby type="furigana" rend="right" source="#source-428339-428351"><rb>怖</rb><rt>お</rt></ruby><seg source="#source-428351-428354">づ</seg><choice source="#source-428354-428360"><orig>／＼</orig><reg>〱</reg></choice><seg source="#source-428360-428372">いつた。</seg><ruby type="furigana" rend="right" source="#source-428372-428387"><rb>彼</rb><rt>かれ</rt></ruby><seg source="#source-428387-428390">は</seg><ruby type="furigana" rend="right" source="#source-428390-428405"><rb>只</rb><rt>たゞ</rt></ruby><ruby type="furigana" rend="right" source="#source-428405-428420"><rb>嬉</rb><rt>うれ</rt></ruby><seg source="#source-428420-428449">しかつたのである。</seg></p>
