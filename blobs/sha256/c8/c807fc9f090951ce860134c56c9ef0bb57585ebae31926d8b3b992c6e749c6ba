      <p source="#source-399-1712"><ruby type="furigana" rend="right" source="#source-399-414"><rb>傳</rb><rt>つた</rt></ruby><seg source="#source-414-420">ふる</seg><ruby type="furigana" rend="right" source="#source-420-438"><rb>處</rb><rt>ところ</rt></ruby><seg source="#source-438-441">の</seg><ruby type="furigana" rend="right" source="#source-441-465"><rb>怪異</rb><rt>くわいい</rt></ruby><seg source="#source-465-468">の</seg><ruby type="furigana" rend="right" source="#source-468-483"><rb>書</rb><rt>しよ</rt></ruby><seg source="#source-483-486">、</seg><ruby type="furigana" rend="right" source="#source-486-501"><rb>多</rb><rt>おほ</rt></ruby><seg source="#source-501-507">くは</seg><ruby type="furigana" rend="right" source="#source-507-531"><rb>徳育</rb><rt>とくいく</rt></ruby><seg source="#source-531-546">のために、</seg><ruby type="furigana" rend="right" source="#source-546-570"><rb>訓戒</rb><rt>くんかい</rt></ruby><seg source="#source-570-585">のために、</seg><ruby type="furigana" rend="right" source="#source-585-606"><rb>寓意</rb><rt>ぐうい</rt></ruby><seg source="#source-606-609">を</seg><ruby type="furigana" rend="right" source="#source-609-624"><rb>談</rb><rt>だん</rt></ruby><seg source="#source-624-633">じて、</seg><ruby type="furigana" rend="right" source="#source-633-663"><rb>勸懲</rb><rt>くわんちやう</rt></ruby><seg source="#source-663-666">の</seg><ruby type="furigana" rend="right" source="#source-666-678"><rb>資</rb><rt>し</rt></ruby><seg source="#source-678-690">となすに</seg><ruby type="furigana" rend="right" source="#source-690-702"><rb>過</rb><rt>す</rt></ruby><seg source="#source-702-711">ぎず。</seg><ruby type="furigana" rend="right" source="#source-711-726"><rb>蓋</rb><rt>けだ</rt></ruby><seg source="#source-726-729">し</seg><ruby type="furigana" rend="right" source="#source-729-747"><rb>教</rb><rt>をしへ</rt></ruby><seg source="#source-747-762">のために、</seg><ruby type="furigana" rend="right" source="#source-762-774"><rb>彼</rb><rt>か</rt></ruby><seg source="#source-774-777">の</seg><ruby type="furigana" rend="right" source="#source-777