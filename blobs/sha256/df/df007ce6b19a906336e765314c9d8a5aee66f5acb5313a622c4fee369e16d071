        <p><seg source="#source-360472-360475">『</seg><ruby type="furigana" rend="right" source="#source-360475-360493"><rb>御身</rb><rt>おみ</rt></ruby><seg source="#source-360493-360496">が</seg><ruby type="furigana" rend="right" source="#source-360496-360508"><rb>言</rb><rt>い</rt></ruby><seg source="#source-360508-360514">ふ、</seg><ruby type="furigana" rend="right" source="#source-360514-360526"><rb>其</rb><rt>そ</rt></ruby><seg source="#source-360526-360529">の</seg><ruby type="furigana" rend="right" source="#source-360529-360544"><rb>像</rb><rt>ざう</rt></ruby><seg source="#source-360544-360550">には</seg><ruby type="furigana" rend="right" source="#source-360550-360562"><rb>血</rb><rt>ち</rt></ruby><seg source="#source-360562-360565">が</seg><ruby type="furigana" rend="right" source="#source-360565-360580"><rb>通</rb><rt>かよ</rt></ruby>ふか、』</p>
        <p><seg source="#source-360594-360597">『</seg><ruby type="furigana" rend="right" source="#source-360597-360609"><rb>血</rb><rt>ち</rt></ruby><seg source="#source-360609-360612">が</seg><ruby type="furigana" rend="right" source="#source-360612-360627"><rb>通</rb><rt>かよ</rt></ruby>ふだ？』と<ruby type="furigana" rend="right" source="#source-360642-360666"><rb>聞返</rb><rt>きゝかへ</rt></ruby><seg source="#source-360666-360674">す。</seg></p>
        <p><seg source="#source-360674-360677">『</seg><ruby type="furigana" rend="right" source="#source-360677-360689"><rb>然</rb><rt>さ</rt></ruby><seg source="#source-360689-360701">ればよ、</seg><ruby type="furigana" rend="right" source="#source-360701-360716"><rb>針</rb><rt>はり</rt></ruby><seg source="#source-360716-360719">の</seg><ruby type="furigana" rend="right" source="#source-360719-360734"><rb>尖</rb><rt>さき</rt></ruby><seg source="#source-360734-360737">で</seg><ruby type="furigana" rend="right" source="#source-360737-360749"><rb>突</rb><rt>つ</rt></ruby><seg source="#source-360749-360758">いても</seg><ruby type="furigana" rend="right" source="#source-360758-360779"><rb>生命</rb><rt>いのち</rt></ruby><seg source="#source-360779-360782">を</seg><ruby type="furigana" rend="right" source="#source-360782-360797"><rb>絞</rb><rt>しぼ</rt></ruby><seg source="#source-360797-360803">る、</seg><ruby type="furigana" rend="right" source="#source-360803-360815"><rb>其</rb><rt>そ</rt></ruby><seg source="#source-360815-360827">の、あの</seg><ruby type="furigana" rend="right" source="#source-360827-360851"><rb>人間</rb><rt>にんげん</rt></ruby><seg source="#source-360851-360854">の</seg><ruby type="furigana" rend="right" source="#source-360854-360872"><rb>美</rb><rt>うつく</rt></ruby><seg source="#source-360872-360878">しい</seg><ruby type="furigana" rend="right" source="#source-360878-360890"><rb>血</rb><rt>ち</rt></ruby><seg source="#source-360890-360893">が</seg><ruby type="furigana" rend="right" source="#source-360893-360908"><rb>通</rb><rt>かよ</rt></ruby>ふかな。』</p>
        <p>『…………』と<ruby type="furigana" rend="right" source="#source-360946-360964"><rb>老爺</rb><rt>ぢい</rt></ruby><seg source="#source-360964-360967">の</seg><ruby type="furigana" rend="right" source="#source-360967-360982"><rb>眉</rb><rt>まゆ</rt></ruby><seg source="#source-360982-360997">がはじめて</seg><ruby type="furigana" rend="right" source="#source-360997-361012"><rb>顰</rb><rt>ひそ</rt></ruby><seg source="#source-361012-361022">む。</seg></p>
