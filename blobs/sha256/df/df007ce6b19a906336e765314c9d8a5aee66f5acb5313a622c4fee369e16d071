 type="furigana" rend="right" source="#source-95205-95229"><rb>密語</rb><rt>さゝやき</rt></ruby><seg source="#source-95229-95238">ぞ、と</seg><ruby type="furigana" rend="right" source="#source-95238-95250"><rb>聞</rb><rt>き</rt></ruby><seg source="#source-95250-95256">く、</seg><ruby type="furigana" rend="right" source="#source-95256-95277"><rb>温泉</rb><rt>いでゆ</rt></ruby><seg source="#source-95277-95280">の</seg><ruby type="furigana" rend="right" source="#source-95280-95295"><rb>煙</rb><rt>けむ</rt></ruby><seg source="#source-95295-95301">りの</seg><ruby type="furigana" rend="right" source="#source-95301-95322"><rb>暖</rb><rt>あたゝか</rt></ruby><seg source="#source-95322-95328">い、</seg><ruby type="furigana" rend="right" source="#source-95328-95352"><rb>山国</rb><rt>やまぐに</rt></ruby><seg source="#source-95352-95361">ながら</seg><ruby type="furigana" rend="right" source="#source-95361-95382"><rb>紫</rb><rt>むらさき</rt></ruby><seg source="#source-95382-95385">の</seg><ruby type="furigana" rend="right" source="#source-95385-95403"><rb>霞</rb><rt>かすみ</rt></ruby><seg source="#source-95403-95406">の</seg><ruby type="furigana" rend="right" source="#source-95406-95430"><rb>立籠</rb><rt>たてこも</rt></ruby><seg source="#source-95430-95433">る</seg><ruby type="furigana" rend="right" source="#source-95433-95448"><rb>閨</rb><rt>ねや</rt></ruby><seg source="#source-95448-95454">を、</seg><ruby type="furigana" rend="right" source="#source-95454-95472"><rb>菫</rb><rt>すみれ</rt></ruby><seg source="#source-95472-95475">に</seg><ruby type="furigana" rend="right" source="#source-95475-95487"><rb>満</rb><rt>み</rt></ruby><seg source="#source-95487-95493">ちた</seg><ruby type="furigana" rend="right" source="#source-95493-95508"><rb>池</rb><rt>いけ</rt></ruby><seg source="#source-95508-95520">と見る、</seg><ruby type="furigana" rend="right" source="#source-95520-95544"><rb>鴛鴦</rb><rt>えんわう</rt></ruby><seg source="#source-95544-95547">の</seg><ruby type="furigana" rend="right" source="#source-95547-95565"><rb>衾</rb><rt>ふすま</rt></ruby><seg source="#source-95565-95568">の</seg><ruby type="furigana" rend="right" source="#source-95568-95598"><rb>寝物語</rb><rt>ねものがた</rt></ruby><seg source="#source-95598-95610">りに――</seg><ruby type="furigana" rend="right" source="#source-95610-95634"><rb>主従</rb><rt>しゆじう</rt></ruby><seg source="#source-95634-95637">は</seg><ruby type="furigana" rend="right" source="#source-95637-95658"><rb>三世</rb><rt>さんぜ</rt></ruby><seg source="#source-95658-95661">、</seg><ruby type="furigana" rend="right" source="#source-95661-95682"><rb>親子</rb><rt>おやこ</rt></ruby><seg source="#source-95682-95685">は</seg><ruby type="furigana" rend="right" source="#source-95685-95706"><rb>一世</rb><rt>いつせ</rt></ruby><seg source="#source-95706-95709">、</seg><ruby type="furigana" rend="right" source="#source-95709-95730"><rb>夫婦</rb><rt>ふうふ</rt></ruby><seg source="#source-95730-95733">は</seg><ruby type="furigana" rend="right" source="#source-95733-95751"><rb>二世</rb><rt>にせ</rt></ruby><seg source="#source-95751-95754">の</seg><ruby type="furigana" rend="right" source="#source-95754-95772"><rb>契</rb><rt>ちぎり</rt></ruby><seg source="#source-95772-95775">と</seg><ruby type="furigana" rend="right" source="#source-95775-95787"><rb>聞</rb><rt>き</rt></ruby><seg source="#source-95787-95798">く……</seg></p>
