        <p>『はツ、』と<ruby type="furigana" rend="right" source="#source-280465-280477"><rb>云</rb><rt>い</rt></ruby><seg source="#source-280477-280483">ふと</seg><ruby type="furigana" rend="right" source="#source-280483-280504"><rb>一個</rb><rt>ひとつ</rt></ruby><seg source="#source-280504-280507">、</seg><ruby type="furigana" rend="right" source="#source-280507-280525"><rb>丁</rb><rt>ちやう</rt></ruby><seg source="#source-280525-280528">ど</seg><ruby type="furigana" rend="right" source="#source-280528-280561"><rb>石高道</rb><rt>いしだかみち</rt></ruby><seg source="#source-280561-280564">の</seg><ruby type="furigana" rend="right" source="#source-280564-280632"><rb><seg source="#source-280564-280567">石</seg><g ref="#gaiji-4-2-82-48" source="#source-280567-280614">磈</g></rb><rt>いしころ</rt></ruby><seg source="#source-280632-280635">へ</seg><ruby type="furigana" rend="right" source="#source-280635-280647"><rb>其</rb><rt>そ</rt></ruby><seg source="#source-280647-280650">の</seg><ruby type="furigana" rend="right" source="#source-280650-280683"><rb>一本竹</rb><rt>いつぽんだけ</rt></ruby><seg source="#source-280683-280686">を</seg><ruby type="furigana" rend="right" source="#source-280686-280707"><rb>踏掛</rb><rt>ふみか</rt></ruby><seg source="#source-280707-280713">けた</seg><ruby type="furigana" rend="right" source="#source-280713-280737"><rb>真中</rb><rt>まんなか</rt></ruby><seg source="#source-280737-280758">のが、カタリと</seg><ruby type="furigana" rend="right" source="#source-280758-280773"><rb>脚</rb><rt>あし</rt></ruby><seg source="#source-280773-280776">に</seg><ruby type="furigana" rend="right" source="#source-280776-280791"><rb>音</rb><rt>おと</rt></ruby><seg source="#source-280791-280794">を</seg><ruby type="furigana" rend="right" source="#source-280794-280806"><rb>立</rb><rt>た</rt></ruby><seg source="#source-280806-280818">てると、</seg><ruby type="furigana" rend="right" source="#source-280818-280842"><rb>乗上</rb><rt>のりあが</rt></ruby><seg source="#source-280842-280875">つたやうに、ひよい、と</seg><ruby type="furigana" rend="right" source="#source-2808