      <p source="#source-370-399"><seg source="#source-370-399">一、春の枝に花あり</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)" source="#source-399-428"><seg source="#source-399-428">夏の枝に葉あり</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)" source="#source-428-457"><seg source="#source-428-457">秋の枝に果あり</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)" source="#source-457-506"><seg source="#source-457-475">冬の枝に</seg><ruby type="furigana" rend="right" source="#source-475-496"><rb>慰</rb><rt>なぐさめ</rt></ruby><seg source="#source-496-506">あり</seg></p>
      <p source="#source-506-532"><seg source="#source-506-532">二、花散りて後に</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)" source="#source-532-558"><seg source="#source-532-558">葉落ちて後に</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)" source="#source-558-584"><seg source="#source-558-584">果失せて後に</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)" source="#source-584-627"><seg source="#source-584-602">芽は枝に</seg><ruby type="furigana" rend="right" source="#source-602-617"><rb>顕</rb><rt>あら</rt></ruby><seg source="#source-617-627">はる</seg></p>
      <p source="#source-627-674"><seg source="#source-627-633">三、</seg><ruby type="furigana" rend="right" source="#source-633-651"><rb>嗚呼</rb><rt>ああ</rt></ruby><seg source="#source-651-674">憂に沈むものよ</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)" source="#source-674-715"><seg source="#source-674-715">嗚呼不幸をかこつものよ</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)" source="#source-715-774"><seg source="#source-715-727">嗚呼</seg><ruby type="furigana" rend="right" source="#source-727-751"><rb>冀望</rb><rt>きぼう</rt></ruby><seg source="#source-751-774">の失せしものよ</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)" source="#source-774-802"><seg source="#source-774-802">春陽の期近し</seg></p>
      <p source="#source-802-831"><seg source="#source-802-831">四、春の枝に花あり</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)" source="#source-831-860"><seg source="#source-831-860">夏の枝に葉あり</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)" source="#source-860-889"><seg source="#source-860-889">秋の枝に果あり</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)" source="#source-889-916"><seg source="#source-889-916">冬の枝に慰あり</seg></p>
    </body>
