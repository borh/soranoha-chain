      <p source="#source-241-309"><seg source="#source-241-247">わが</seg><ruby type="furigana" rend="right" source="#source-247-259"><rb>日</rb><rt>ひ</rt></ruby><seg source="#source-259-262">の</seg><ruby type="furigana" rend="right" source="#source-262-277"><rb>本</rb><rt>もと</rt></ruby><seg source="#source-277-280">は</seg><ruby type="furigana" rend="right" source="#source-280-304"><rb>島国</rb><rt>しまぐに</rt></ruby><seg source="#source-304-309">よ</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-309-365"><ruby type="furigana" rend="right" source="#source-312-333"><rb>朝日</rb><rt>あさひ</rt></ruby><seg source="#source-333-345">かがよう</seg><ruby type="furigana" rend="right" source="#source-345-360"><rb>海</rb><rt>うみ</rt></ruby><seg source="#source-360-365">に</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)" source="#source-365-439"><ruby type="furigana" rend="right" source="#source-371-389"><rb>連</rb><rt>つらな</rt></ruby><seg source="#source-389-404">りそばだつ</seg><ruby type="furigana" rend="right" source="#source-404-428"><rb>島々</rb><rt>しまじま</rt></ruby><seg source="#source-428-439">なれば</seg></p>
      <p style="text-indent: 3em" rend="first-line-indent(3)" source="#source-439-524"><seg source="#source-439-460">あらゆる</seg><ruby type="furigana" rend="right" source="#source-460-475"><rb>国</rb><rt>くに</rt></ruby><seg source="#source-475-481">より</seg><ruby type="furigana" rend="right" source="#source-481-496"><rb>舟</rb><rt>ふね</rt></ruby><seg source="#source-496-502">こそ</seg><ruby type="furigana" rend="right" source="#source-502-517"><rb>通</rb><rt>かよ</rt></ruby><seg source="#source-517-524">え</seg></p>
      <p source="#source-524-595"><seg source="#source-524-533">されば</seg><ruby type="furigana" rend="right" source="#source-533-551"><rb>港</rb><rt>みなと</rt></ruby><seg source="#source-551-554">の</seg><ruby type="furigana" rend="right" source="#source-554-569"><rb>数</rb><rt>かず</rt></ruby><ruby type="furigana" rend="right" source="#source-569-584"><rb>多</rb><rt>おお</rt></ruby><seg source="#source-584-595">かれど</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-595-654"><seg source="#source-595-604">この</seg><ruby type="furigana" rend="right" source="#source-604-628"><rb>横浜</rb><rt>よこはま</rt></ruby><seg source="#source-628-654">にまさるあらめや</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)" source="#source-654-734"><seg source="#source-654-669">むかし</seg><ruby type="furigana" rend="right" source="#source-669-684"><rb>思</rb><rt>おも</rt></ruby><seg source="#source-684-699">えば　とま</seg><ruby type="furigana" rend="right" source="#source-699-711"><rb>屋</rb><rt>や</rt></ruby><seg source="#source-711-714">の</seg><ruby type="furigana" rend="right" source="#source-714-732"><rb>煙</rb><rt>けむり</rt></ruby></p>
      <p style="text-indent: 3em" rend="first-line-indent(3)" source="#source-734-807"><seg source="#source-734-764">ちらりほらりと</seg><ruby type="furigana" rend="right" source="#source-764-776"><rb>立</rb><rt>た</rt></ruby><seg source="#source-776-785">てりし</seg><ruby type="furigana" rend="right" source="#source-785-803"><rb>処</rb><rt>ところ</rt></ruby></p>
      <p source="#source-807-875"><ruby type="furigana" rend="right" source="#source-807-822"><rb>今</rb><rt>いま</rt></ruby><seg source="#source-822-831">はもも</seg><ruby type="furigana" rend="right" source="#source-831-846"><rb>舟</rb><rt>ふね</rt></ruby><seg source="#source-846-852">もも</seg><ruby type="furigana" rend="right" source="#source-852-873"><rb>千舟</rb><rt>ちふね</rt></ruby></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-875-937"><ruby type="furigana" rend="right" source="#source-878-893"><rb>泊</rb><rt>とま</rt></ruby><seg source="#source-893-896">る</seg><ruby type="furigana" rend="right" source="#source-896-914"><rb>処</rb><rt>ところ</rt></ruby><seg source="#source-914-917">ぞ</seg><ruby type="furigana" rend="right" source="#source-917-929"><rb>見</rb><rt>み</rt></ruby><seg source="#source-929-937">よや</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)" source="#source-937-1026"><ruby type="furigana" rend="right" source="#source-943-958"><rb>果</rb><rt>はて</rt></ruby><seg source="#source-958-964">なく</seg><ruby type="furigana" rend="right" source="#source-964-979"><rb>栄</rb><rt>さか</rt></ruby><seg source="#source-979-985">えて</seg><ruby type="furigana" rend="right" source="#source-985-997"><rb>行</rb><rt>ゆ</rt></ruby><seg source="#source-997-1009">くらんみ</seg><ruby type="furigana" rend="right" source="#source-1009-1021"><rb>代</rb><rt>よ</rt></ruby><seg source="#source-1021-1026">を</seg></p>
      <p style="text-indent: 3em" rend="first-line-indent(3)" source="#source-1026-1113"><ruby type="furigana" rend="right" source="#source-1035-1050"><rb>飾</rb><rt>かざ</rt></ruby><seg source="#source-1050-1053">る</seg><ruby type="furigana" rend="right" source="#source-1053-1071"><rb>宝</rb><rt>たから</rt></ruby><seg source="#source-1071-1074">も</seg><ruby type="furigana" rend="right" source="#source-1074-1086"><rb>入</rb><rt>い</rt></ruby><seg source="#source-1086-1095">りくる</seg><ruby type="furigana" rend="right" source="#source-1095-1113"><rb>港</rb><rt>みなと</rt></ruby></p>
    </body>
