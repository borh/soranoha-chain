      <div type="layout" source="#source-12594-12837" style="padding-inline-start: 4em">
        <p><seg source="#source-12629-12632">「</seg><ruby type="furigana" rend="right" source="#source-12632-12647"><rb>人</rb><rt>ひと</rt></ruby><ruby type="furigana" rend="right" source="#source-12647-12659"><rb>知</rb><rt>し</rt></ruby><seg source="#source-12659-12667">れぬ</seg></p>
        <p><ruby type="furigana" rend="right" source="#source-12667-12700"><rb>大内山</rb><rt>おおうちやま</rt></ruby><seg source="#source-12700-12705">の</seg></p>
