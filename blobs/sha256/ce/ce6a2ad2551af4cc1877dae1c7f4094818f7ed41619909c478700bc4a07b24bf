      <p source="#source-244-255"><seg source="#source-244-255">おや雀</seg></p>
      <p source="#source-255-266"><seg source="#source-255-266">おや雀</seg></p>
      <p source="#source-266-289"><seg source="#source-266-289">もう日が暮れる</seg></p>
      <p source="#source-289-308"><seg source="#source-289-308">くらくなる</seg></p>
      <p source="#source-308-325"><seg source="#source-308-325">日がくれて</seg></p>
      <p source="#source-325-348"><seg source="#source-325-348">くらくなつたら</seg></p>
      <p source="#source-348-365"><seg source="#source-348-365">どうしよう</seg></p>
      <p source="#source-365-399"><ruby type="furigana" rend="right" source="#source-365-383"><rb>何処</rb><rt>どこ</rt></ruby><seg source="#source-383-399">に行かう</seg></p>
      <p source="#source-399-416"><seg source="#source-399-416">ぼつちやん</seg></p>
      <p source="#source-416-445"><seg source="#source-416-445">わたしの巣をかへせ</seg></p>
      <p source="#source-445-466"><seg source="#source-445-466">子どもをかへせ</seg></p>
    </body>
