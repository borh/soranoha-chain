source="#source-5271-5295"><rb>電車</rb><rt>でんしゃ</rt></ruby><seg source="#source-5295-5298">の</seg><ruby type="furigana" rend="right" source="#source-5298-5313"><rb>通</rb><rt>とお</rt></ruby><seg source="#source-5313-5325">っている</seg><ruby type="furigana" rend="right" source="#source-5325-5340"><rb>広</rb><rt>ひろ</rt></ruby><seg source="#source-5340-5343">い</seg><ruby type="furigana" rend="right" source="#source-5343-5358"><rb>通</rb><rt>とお</rt></ruby><seg source="#source-5358-5373">りは、まだ</seg><ruby type="furigana" rend="right" source="#source-5373-5388"><rb>暑</rb><rt>あつ</rt></ruby><seg source="#source-5388-5400">そうに、</seg><ruby type="furigana" rend="right" source="#source-5400-5412"><rb>日</rb><rt>ひ</rt></ruby><seg source="#source-5412-5436">がてらしている、</seg><ruby type="furigana" rend="right" source="#source-5436-5460"><rb>人間</rb><rt>にんげん</rt></ruby><seg source="#source-5460-5463">の</seg><ruby type="furigana" rend="right" source="#source-5463-5481"><rb>姿</rb><rt>すがた</rt></ruby><seg source="#source-5481-5484">が</seg><ruby type="furigana" rend="right" source="#source-5484-5499"><rb>小</rb><rt>ちい</rt></ruby><seg source="#source-5499-5532">さなありのように、その</seg><ruby type="furigana" rend="right" source="#source-5532-5550"><rb>間</rb><rt>あいだ</rt></ruby><seg source="#source-5550-5553">に</seg><ruby type="furigana" rend="right" source="#source-5553-5568"><rb>動</rb><rt>うご</rt></ruby><seg source="#source-5568-5580">いている</seg><ruby type="furigana" rend="right" source="#source-5580-5592"><rb>有</rb><rt>あ</rt></ruby><seg source="#source-5592-5595">り</seg><ruby type="furigana" rend="right" source="#source-5595-5610"><rb>様</rb><rt>さま</rt></ruby><seg source="#source-5610-5619">などが</seg><ruby type="furigana" rend="right" source="#source-5619-5643"><rb>想像</rb><rt>そうぞう</rt></ruby><seg source="#source-5643-5700">されたのでした。しかし、しばらくそこを</seg><ruby type="furigana" rend="right" source="#source-5700-5715"><rb>離</rb><rt>はな</rt></ruby><seg source="#source-5715-5748">れていると、なんとなく</seg><ruby type="furigana" rend="rig