    <body>
      <div type="layout" source="#source-627-712" style="padding-inline-start: 3em">
        <div>
          <head n="1" source="#source-648-708"><ruby type="furigana" rend="right" source="#source-648-672"><rb>日輪</rb><rt>にちりん</rt></ruby></head>
        </div>
