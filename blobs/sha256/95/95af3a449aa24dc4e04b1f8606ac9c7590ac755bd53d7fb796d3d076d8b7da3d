        <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-16889-17668"><seg source="#source-16889-16898">その</seg><ruby type="furigana" rend="right" source="#source-16898-16913"><rb>方</rb><rt>ほう</rt></ruby><seg source="#source-16913-16916">は</seg><ruby type="furigana" rend="right" source="#source-16916-16931"><rb>波</rb><rt>なみ</rt></ruby><seg source="#source-16931-16934">が</seg><ruby type="furigana" rend="right" source="#source-16934-16949"><rb>穏</rb><rt>おだ</rt></ruby><seg source="#source-16949-16961">やかで、</seg><ruby type="furigana" rend="right" source="#source-16961-16985"><rb>太陽</rb><rt>たいよう</rt></ruby><seg source="#source-16985-16988">が</seg><ruby type="furigana" rend="right" source="#source-16988-17003"><rb>静</rb><rt>しず</rt></ruby><seg source="#source-17003-17009">かに</seg><ruby type="furigana" rend="right" source="#source-17009-17033"><rb>大空</rb><rt>おおぞら</rt></ruby><seg source="#source-17033-17036">に</seg><ruby type="furigana" rend="right" source="#source-17036-17048"><rb>燃</rb><rt>も</rt></ruby><seg source="#source-17048-17069">えていました。</seg><ruby type="furigana" rend="right" source="#source-17069-17084"><rb>空</rb><rt>そら</rt></ruby><seg source="#source-17084-17090">は、</seg><ruby type="furigana" rend="right" source="#source-17090-17105"><rb>青</rb><rt>あお</rt></ruby><seg source="#source-17105-17111">く、</seg><ruby type="furigana" rend="right" source="#source-17111-17126"><rb>青</rb><rt>あお</rt></ruby><seg source="#source-17126-17129">く</seg><ruby type="furigana" rend="right" source="#source-17129-17141"><rb>晴</rb><rt>は</rt></ruby><seg source="#source-17141-17150">れて、</seg><ruby type="furigana" rend="right" source="#source-17150-17174"><rb>海鳥</rb><rt>うみどり</rt></ruby><seg source="#source-17174-17177">が</seg><ruby type="furigana" rend="right" source="#source-17177-17189"><rb>飛</rb><rt>と</rt></ruby><seg source="#source-17189-17207">んでいるのも</seg><ruby type="furigana" rend="right" source="#source-17207-17219"><rb>見</rb><rt>み</rt></ruby><seg source="#source