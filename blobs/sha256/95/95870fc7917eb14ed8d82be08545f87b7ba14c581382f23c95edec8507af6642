          <head n="2" source="#source-206752-206854"><seg source="#source-206773-206779">民俗</seg><hi rend="text-combine-upright" snh:layout-kind="tcy" source="#source-206779-206824" corresp="#source-206788-206824"><seg source="#source-206779-206788">（１）</seg></hi></head>
