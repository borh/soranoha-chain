      <div type="layout" source="#source-18012-18403" style="padding-inline-start: 2em; text-indent: -2em">
        <p source="#source-18080-18403"><seg source="#source-18080-18089">（一）</seg><ruby type="furigana" rend="right" source="#source-18089-18167"><rb>明神御宇日本</rb><rt>アキツミカミトアメノシタシロスヤマト</rt></ruby><note type="kunten" subtype="okurigana" rend="superscript" source="#source-18167-18185">ノ</note><ruby type="furigana" rend="right" source="#source-18185-18209"><rb>天皇</rb><rt>スメラガ</rt></ruby><seg source="#source-18209-18215">詔旨</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-18215-18239">ラマト</note><seg source="#source-18239-18242">、</seg><seg type="warichu" rend="two-line" source="#source-18242-18386"><seg source="#source-18260-18263">謂</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-18263-18275">下</note><seg source="#source-18275-18278">以</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-18278-18290">二</note><seg source="#source-18290-18296">大事</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-18296-18308">一</note><seg source="#source-18308-18311">宣</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-18311-18323">中</note><seg source="#source-18323-18335">於蕃国使</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-18335-18347">上</note><seg source="#source-18347-18359">之辞也。</seg></seg><seg source="#source-18386-18403">云々咸聞。</seg></p>
