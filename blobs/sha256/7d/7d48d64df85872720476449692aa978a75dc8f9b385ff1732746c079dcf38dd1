  <text>
    <body>
      <p><ruby type="furigana" rend="right" source="#source-250-268"><rb>私</rb><rt>わたし</rt></ruby><seg source="#source-268-271">の</seg><ruby type="furigana" rend="right" source="#source-271-286"><rb>家</rb><rt>うち</rt></ruby><seg source="#source-286-295">にきた</seg><ruby type="furigana" rend="right" source="#source-295-316"><rb>盲目</rb><rt>めくら</rt></ruby><seg source="#source-316-321">、</seg></p>
      <p><ruby type="furigana" rend="right" source="#source-321-336"><rb>帰</rb><rt>かえ</rt></ruby><seg source="#source-336-354">りにあんずの</seg><ruby type="furigana" rend="right" source="#source-354-369"><rb>花</rb><rt>はな</rt></ruby><ruby type="furigana" rend="right" source="#source-369-381"><rb>折</rb><rt>お</rt></ruby><seg source="#source-381-394">って、</seg></p>
      <p><ruby type="furigana" rend="right" source="#source-394-409"><rb>夏</rb><rt>なつ</rt></ruby><seg source="#source-409-444">がきたら、またこよう。</seg></p>
      <p><ruby type="furigana" rend="right" source="#source-444-459"><rb>赤</rb><rt>あか</rt></ruby><seg source="#source-459-465">いお</seg><ruby type="furigana" rend="right" source="#source-465-480"><rb>月</rb><rt>つき</rt></ruby><seg source="#source-480-486">さま</seg><ruby type="furigana" rend="right" source="#source-486-498"><rb>出</rb><rt>で</rt></ruby><seg source="#source-498-501">る</seg><ruby type="furigana" rend="right" source="#source-501-516"><rb>晩</rb><rt>ばん</rt></ruby><seg source="#source-516-526">に。</seg></p>
      <p><ruby type="furigana" rend="right" source="#source-526-541"><rb>俺</rb><rt>おれ</rt></ruby><seg source="#source-541-556">はくるくる</seg><ruby type="furigana" rend="right" source="#source-556-586"><rb>青坊主</rb><rt>あおぼうず</rt></ruby><seg source="#source-586-591">、</seg></p>
      <p><ruby type="furigana" rend="right" source="#source-591-606"><rb>笠</rb><rt>かさ</rt></ruby><seg source="#source-606-621">をかぶって</seg><ruby type="furigana" rend="right" source="#source-621-636"><rb>坊</rb><rt>ぼっ</rt></ruby><seg source="#source-636-653">ちゃんの、</seg></p>
      <p><seg source="#source-653-656">お</seg><ruby type="furigana" rend="right" source="#source-656-671"><rb>家</rb><rt>いえ</rt></ruby><seg source="#source-671-674">の</seg><ruby type="furigana" rend="right" source="#source-674-689"><rb>窓</rb><rt>まど</rt></ruby><seg source="#source-689-722">から、のぞきましょう。</seg></p>
    </body>
