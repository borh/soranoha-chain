      <p source="#source-30-44"><seg source="#source-30-44">ねえむい</seg></p>
      <p source="#source-44-55"><seg source="#source-44-55">ねむい</seg></p>
      <p source="#source-55-72"><seg source="#source-55-72">ゆきのよる</seg></p>
      <p source="#source-72-86"><seg source="#source-72-86">くうらい</seg></p>
      <p source="#source-86-100"><seg source="#source-86-100">のきばで</seg></p>
      <p source="#source-100-117"><seg source="#source-100-117">はとぽつぽ</seg></p>
      <p source="#source-117-140"><seg source="#source-117-140">ぽつぽとなけば</seg></p>
      <p source="#source-140-162"><seg source="#source-140-162">さみしいな。</seg></p>
      <p source="#source-162-176"><seg source="#source-162-176">とろとろ</seg></p>
      <p source="#source-176-187"><seg source="#source-176-187">ねむる</seg></p>
      <p source="#source-187-204"><seg source="#source-187-204">めがさめる</seg></p>
      <p source="#source-204-227"><seg source="#source-204-227">ぽつぽとないた</seg></p>
      <p source="#source-227-244"><seg source="#source-227-244">はとぽつぽ</seg></p>
      <p source="#source-244-267"><seg source="#source-244-267">どこへいつたか</seg></p>
      <p source="#source-267-285"><seg source="#source-267-285">さみしいな。</seg></p>
    </body>
