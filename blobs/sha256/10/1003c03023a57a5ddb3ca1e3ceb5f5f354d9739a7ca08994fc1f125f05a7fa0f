        <p><seg source="#source-328687-328689">φ</seg><hi rend="subscript" source="#source-328689-328731"><seg source="#source-328689-328692">a,1</seg></hi><seg source="#source-328731-328733">(q</seg><hi rend="subscript" source="#source-328733-328775"><seg source="#source-328733-328736">a,1</seg></hi><seg source="#source-328775-328778">)=p</seg><hi rend="subscript" source="#source-328778-328816"><seg source="#source-328778-328779">a</seg></hi><seg source="#source-328816-328818">φ</seg><hi rend="subscript" source="#source-328818-328860"><seg source="#source-328818-328821">b,1</seg></hi><seg source="#source-328860-328862">(q</seg><hi rend="subscript" source="#source-328862-328904"><seg source="#source-328862-328865">b,1</seg></hi><seg source="#source-328904-328907">)</seg></p>
