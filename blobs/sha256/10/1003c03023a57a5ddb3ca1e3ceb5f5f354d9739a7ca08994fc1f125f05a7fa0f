        <p style="text-indent: 1em" rend="first-line-indent(1)"><seg source="#source-671586-671617">二〇三　かつまた、a</seg><hi rend="subscript" source="#source-671617-671655"><seg source="#source-671617-671618">t</seg></hi><seg source="#source-671655-671658">, a</seg><hi rend="subscript" source="#source-671658-671696"><seg source="#source-671658-671659">p</seg></hi><seg source="#source-671696-671699">, a</seg><hi rend="subscript" source="#source-671699-671737"><seg source="#source-671699-671700">k</seg></hi><seg source="#source-671737-671746"> …… b</seg><hi rend="subscript" source="#source-671746-671784"><seg source="#source-671746-671747">t</seg></hi><seg source="#source-671784-671787">, b</seg><hi rend="subscript" source="#source-671787-671825"><seg source="#source-671787-671788">p</seg></hi><seg source="#source-671825-671828">, b</seg><hi rend="subscript" source="#source-671828-671866"><seg source="#source-671828-671829">k</seg></hi><seg source="#source-671866-671875"> …… c</seg><hi rend="subscript" source="#source-671875-671913"><seg source="#source-671875-671876">t</seg></hi><seg source="#source-671913-671916">, c</seg><hi rend="subscript" source="#source-671916-671954"><seg source="#source-671916-671917">p</seg></hi><seg source="#source-671954-671957">, c</seg><hi rend="subscript" source="#source-671957-671995"><seg source="#source-671957-671958">k</seg></hi><seg source="#source-671995-672004"> …… d</seg><hi rend="subscript" source="#source-672004-672042"><seg source="#source-672004-672005">t</seg></hi><seg source="#source-672042-672045">, d</seg><hi rend="subscript" source="#source-672045-672083"><seg source="#source-672045-672046">p</seg></hi><seg source="#source-672083-672086">, d</seg><hi rend="subscript" source="#source-672086-672124"><seg source="#source-672086-672087">k</seg></hi><seg source="#source-672124-672134"> ……を</seg><hi rend="bouten 傍点 right" source="#source-672134-672182"><seg source="#source-672134-672146">製造係数</seg></hi><seg source="#source-672182-