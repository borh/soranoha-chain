      <div type="layout" source="#source-505812-506297" style="padding-inline-start: 4em">
        <p><seg source="#source-505847-505852">Y'=y'</seg><hi rend="subscript" source="#source-505852-505890"><seg source="#source-505852-505853">1</seg></hi><seg source="#source-505890-505893">+y'</seg><hi rend="subscript" source="#source-505893-505931"><seg source="#source-505893-505894">2</seg></hi><seg source="#source-505931-505934">+y'</seg><hi rend="subscript" source="#source-505934-505972"><seg source="#source-505934-505935">3</seg></hi><seg source="#source-505972-505985">+ …… =0</seg></p>
        <p><seg source="#source-505985-505990">Z'=z'</seg><hi rend="subscript" source="#source-505990-506028"><seg source="#source-505990-505991">1</seg></hi><seg source="#source-506028-506031">+z'</seg><hi rend="subscript" source="#source-506031-506069"><seg source="#source-506031-506032">2</seg></hi><seg source="#source-506069-506072">+z'</seg><hi rend="subscript" source="#source-506072-506110"><seg source="#source-506072-506073">3</seg></hi><seg source="#source-506110-506123">+ …… =0</seg></p>
        <p><seg source="#source-506123-506128">W'=w'</seg><hi rend="subscript" source="#source-506128-506166"><seg source="#source-506128-506129">1</seg></hi><seg source="#source-506166-506169">+w'</seg><hi rend="subscript" source="#source-506169-506207"><seg source="#source-506169-506170">2</seg></hi><seg source="#source-506207-506210">+w'</seg><hi rend="subscript" source="#source-506210-506248"><seg source="#source-506210-506211">3</seg></hi><seg source="#source-506248-506261">+ …… =0</seg></p>
