        <p style="text-indent: 1em" rend="first-line-indent(1)"><seg source="#source-504547-504554">-(q'</seg><hi rend="subscript" source="#source-504554-504596"><seg source="#source-504554-504557">a,1</seg></hi><seg source="#source-504596-504599">+q'</seg><hi rend="subscript" source="#source-504599-504641"><seg source="#source-504599-504602">a,2</seg></hi><seg source="#source-504641-504642">+</seg><app type="base-text-variant" source="#source-504644-504683"><lem><seg source="#source-504642-504644">q'</seg></lem><rdg type="base-text"><seg source="#source-504676-504677">q</seg></rdg></app><hi rend="subscript" source="#source-504683-504725"><seg source="#source-504683-504686">a,3</seg></hi><seg source="#source-504725-504736">+ ……)+x</seg><hi rend="subscript" source="#source-504736-504774"><seg source="#source-504736-504737">1</seg></hi><seg source="#source-504774-504776">+x</seg><hi rend="subscript" source="#source-504776-504814"><seg source="#source-504776-504777">2</seg></hi><seg source="#source-504814-504816">+x</seg><hi rend="subscript" source="#source-504816-504854"><seg source="#source-504816-504817">3</seg></hi><seg source="#source-504854-504864">+ ……</seg></p>
      </div>
      <div>
        <p><seg source="#source-504902-504940">が得られる。そして既に、</seg></p>
      </div>
      <div type="layout" source="#source-504940-505145" style="padding-inline-start: 4em">
        <p><seg source="#source-504975-504978">X=x</seg><hi rend="subscript" source="#source-504978-505016"><seg source="#source-504978-504979">1</seg></hi><seg source="#source-505016-505018">+x</seg><hi rend="subscript" source="#source-505018-505056"><seg source="#source-505018-505019">2</seg></hi><seg source="#source-505056-505058">+x</seg><hi rend="subscript" source="#source-505058-505096"><seg source="#source-505058-505059">3</seg></hi><seg source="#source-505096-505109">+ …… =0</seg></p>
