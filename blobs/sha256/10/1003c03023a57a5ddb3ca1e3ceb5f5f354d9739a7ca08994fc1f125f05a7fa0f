        <p><seg source="#source-218275-218276">D</seg><hi rend="subscript" source="#source-218276-218314"><seg source="#source-218276-218277">a</seg></hi><seg source="#source-218314-218316">=O</seg><hi rend="subscript" source="#source-218316-218354"><seg source="#source-218316-218317">a</seg></hi></p>
