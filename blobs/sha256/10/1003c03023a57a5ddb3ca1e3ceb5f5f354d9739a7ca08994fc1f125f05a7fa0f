        <p><seg source="#source-422146-422147">x</seg><hi rend="subscript" source="#source-422147-422185"><seg source="#source-422147-422148">1</seg></hi><seg source="#source-422185-422187">φ</seg><hi rend="subscript" source="#source-422187-422229"><seg source="#source-422187-422190">a,1</seg></hi><seg source="#source-422229-422231">(q</seg><hi rend="subscript" source="#source-422231-422273"><seg source="#source-422231-422234">a,1</seg></hi><seg source="#source-422273-422275">+x</seg><hi rend="subscript" source="#source-422275-422313"><seg source="#source-422275-422276">1</seg></hi><seg source="#source-422313-422316">)+z</seg><hi rend="subscript" source="#source-422316-422354"><seg source="#source-422316-422317">1</seg></hi><seg source="#source-422354-422356">φ</seg><hi rend="subscript" source="#source-422356-422398"><seg source="#source-422356-422359">c,1</seg></hi><seg source="#source-422398-422400">(q</seg><hi rend="subscript" source="#source-422400-422442"><seg source="#source-422400-422403">c,1</seg></hi><seg source="#source-422442-422444">+z</seg><hi rend="subscript" source="#source-422444-422482"><seg source="#source-422444-422445">1</seg></hi><seg source="#source-422482-422485">)+w</seg><hi rend="subscript" source="#source-422485-422523"><seg source="#source-422485-422486">1</seg></hi><seg source="#source-422523-422525">φ</seg><hi rend="subscript" source="#source-422525-422567"><seg source="#source-422525-422528">d,1</seg></hi><seg source="#source-422567-422569">(q</seg><hi rend="subscript" source="#source-422569-422611"><seg source="#source-422569-422572">d,1</seg></hi><seg source="#source-422611-422613">+w</seg><hi rend="subscript" source="#source-422613-422651"><seg source="#source-422613-422614">1</seg></hi><seg source="#source-422651-422663">)+ …… =q</seg><hi rend="subscript" source="#source-422663-422705"><seg source="#source-422663-422666">b,1</seg></hi><seg source="#source-422705-422707">φ</seg><hi rend="subscript" source="#source-422707-422749"><seg