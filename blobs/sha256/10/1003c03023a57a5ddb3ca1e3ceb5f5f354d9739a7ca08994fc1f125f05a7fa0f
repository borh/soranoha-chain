        <p><seg source="#source-709202-709204">D'</seg><hi rend="subscript" source="#source-709204-709242"><seg source="#source-709204-709205">k</seg></hi><seg source="#source-709242-709244">=a</seg><hi rend="subscript" source="#source-709244-709282"><seg source="#source-709244-709245">k</seg></hi><seg source="#source-709282-709284">Ω</seg><hi rend="subscript" source="#source-709284-709322"><seg source="#source-709284-709285">a</seg></hi><seg source="#source-709322-709324">+b</seg><hi rend="subscript" source="#source-709324-709362"><seg source="#source-709324-709325">k</seg></hi><seg source="#source-709362-709364">D'</seg><hi rend="subscript" source="#source-709364-709402"><seg source="#source-709364-709365">b</seg></hi><seg source="#source-709402-709404">+c</seg><hi rend="subscript" source="#source-709404-709442"><seg source="#source-709404-709405">k</seg></hi><seg source="#source-709442-709444">D'</seg><hi rend="subscript" source="#source-709444-709482"><seg source="#source-709444-709445">c</seg></hi><seg source="#source-709482-709484">+d</seg><hi rend="subscript" source="#source-709484-709522"><seg source="#source-709484-709485">k</seg></hi><seg source="#source-709522-709524">D'</seg><hi rend="subscript" source="#source-709524-709562"><seg source="#source-709524-709525">d</seg></hi><seg source="#source-709562-709572">+ ……</seg></p>
        <p><seg source="#source-709572-709628">………………………………………………</seg></p>
      </div>
      <div>
        <p><seg source="#source-709666-709744">によって、（Ｔ）、（Ｐ）、（Ｋ）……のそれぞれの量 D'</seg><hi rend="subscript" source="#source-709744-709782"><seg source="#source-709744-709745">t</seg></hi><seg source="#source-709782-709786">, D'</seg><hi rend="subscript" source="#source-709786-709824"><seg source="#source-709786-709787">p</seg></hi><seg source="#source-709824-709828">, D'</seg><hi rend="subscript" source="#source-709828-709866"><seg source="#source-709828-709829">k</seg></hi><seg source="#source-709866-709916">……を必要とする所の、かつ方程式</seg></p>
