      <div type="layout" source="#source-505170-505526" style="padding-inline-start: 4em">
        <p><seg source="#source-505205-505207">q'</seg><hi rend="subscript" source="#source-505207-505249"><seg source="#source-505207-505210">a,1</seg></hi><seg source="#source-505249-505252">+q'</seg><hi rend="subscript" source="#source-505252-505294"><seg source="#source-505252-505255">a,2</seg></hi><seg source="#source-505294-505297">+q'</seg><hi rend="subscript" source="#source-505297-505339"><seg source="#source-505297-505300">a,3</seg></hi><seg source="#source-505339-505350">+ …… =q</seg><hi rend="subscript" source="#source-505350-505392"><seg source="#source-505350-505353">a,1</seg></hi><seg source="#source-505392-505394">+q</seg><hi rend="subscript" source="#source-505394-505436"><seg source="#source-505394-505397">a,2</seg></hi><seg source="#source-505436-505438">+q</seg><hi rend="subscript" source="#source-505438-505480"><seg source="#source-505438-505441">a,3</seg></hi><seg source="#source-505480-505490">+ ……</seg></p>
      </div>
      <div>
        <p><seg source="#source-505528-505548">であるから、</seg></p>
      </div>
      <div type="layout" source="#source-505548-505757" style="padding-inline-start: 4em">
        <p><seg source="#source-505583-505588">X'=x'</seg><hi rend="subscript" source="#source-505588-505626"><seg source="#source-505588-505589">1</seg></hi><seg source="#source-505626-505629">+x'</seg><hi rend="subscript" source="#source-505629-505667"><seg source="#source-505629-505630">2</seg></hi><seg source="#source-505667-505670">+x'</seg><hi rend="subscript" source="#source-505670-505708"><seg source="#source-505670-505671">3</seg></hi><seg source="#source-505708-505721">+ …… =0</seg></p>
