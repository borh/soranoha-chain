        <p><seg source="#source-528672-528682">(Gπ=Fμ)v</seg><hi rend="subscript" source="#source-528682-528720"><seg source="#source-528682-528683">a</seg></hi><seg source="#source-528720-528723">=Fv</seg><hi rend="subscript" source="#source-528723-528761"><seg source="#source-528723-528724">b</seg></hi><seg source="#source-528761-528773">, (Kπ=Lρ)v</seg><hi rend="subscript" source="#source-528773-528811"><seg source="#source-528773-528774">a</seg></hi><seg source="#source-528811-528814">=Lv</seg><hi rend="subscript" source="#source-528814-528852"><seg source="#source-528814-528815">d</seg></hi><seg source="#source-528852-528861"> ……</seg></p>
