        <p><seg source="#source-528976-528986">(Jρ=Hμ)v</seg><hi rend="subscript" source="#source-528986-529024"><seg source="#source-528986-528987">a</seg></hi><seg source="#source-529024-529027">=Hv</seg><hi rend="subscript" source="#source-529027-529065"><seg source="#source-529027-529028">b</seg></hi><seg source="#source-529065-529077">, (Lρ=Kπ)v</seg><hi rend="subscript" source="#source-529077-529115"><seg source="#source-529077-529078">a</seg></hi><seg source="#source-529115-529118">=Kv</seg><hi rend="subscript" source="#source-529118-529156"><seg source="#source-529118-529119">c</seg></hi><seg source="#source-529156-529165"> ……</seg></p>
