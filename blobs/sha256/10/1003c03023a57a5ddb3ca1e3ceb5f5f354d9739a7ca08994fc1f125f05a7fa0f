        <p style="text-indent: 1em" rend="first-line-indent(1)"><seg source="#source-464134-464138">v</seg><hi rend="subscript" source="#source-464138-464176"><seg source="#source-464138-464139">a</seg></hi><seg source="#source-464176-464178">:v</seg><hi rend="subscript" source="#source-464178-464216"><seg source="#source-464178-464179">b</seg></hi><seg source="#source-464216-464218">:v</seg><hi rend="subscript" source="#source-464218-464256"><seg source="#source-464218-464219">c</seg></hi><seg source="#source-464256-464258">:v</seg><hi rend="subscript" source="#source-464258-464296"><seg source="#source-464258-464259">d</seg></hi><seg source="#source-464296-464306">: ……</seg></p>
        <p><seg source="#source-464306-464309">::r</seg><hi rend="subscript" source="#source-464309-464351"><seg source="#source-464309-464312">a,1</seg></hi><seg source="#source-464351-464353">:r</seg><hi rend="subscript" source="#source-464353-464395"><seg source="#source-464353-464356">b,1</seg></hi><seg source="#source-464395-464397">:r</seg><hi rend="subscript" source="#source-464397-464439"><seg source="#source-464397-464400">c,1</seg></hi><seg source="#source-464439-464441">:r</seg><hi rend="subscript" source="#source-464441-464483"><seg source="#source-464441-464444">d,1</seg></hi><seg source="#source-464483-464493">: ……</seg></p>
        <p><seg source="#source-464493-464496">::r</seg><hi rend="subscript" source="#source-464496-464538"><seg source="#source-464496-464499">a,2</seg></hi><seg source="#source-464538-464540">:r</seg><hi rend="subscript" source="#source-464540-464582"><seg source="#source-464540-464543">b,2</seg></hi><seg source="#source-464582-464584">:r</seg><hi rend="subscript" source="#source-464584-464626"><seg source="#source-464584-464587">c,2</seg></hi><seg source="#source-464626-464628">:r</seg><hi rend="subscript" source="#source-464628-464670"><seg source="#source-464628-464631">d,2</seg></hi><seg source="#source-464670-464680">: ……</seg></p>
        <p><seg source="#source-464680-464683">::r</seg><hi rend="subscript" source="#source-464683-464725"><seg source="#source-464683-464686">a,3</seg></hi><seg source="#source-464725-464727">:r</seg><hi rend="subscript" source="#source-464727-464769"><seg source="#source-464727-464730">b,3</seg></hi><seg source="#source-464769-464771">:r</seg><hi rend="subscript" source="#source-464771-464813"><seg source="#source-464771-464774">c,3</seg></hi><seg source="#source-464813-464815">:r</seg><hi rend="subscript" source="#source-464815-464857"><seg source="#source-464815-464818">d,3</seg></hi><seg source="#source-464857-464867">: ……</seg></p>
