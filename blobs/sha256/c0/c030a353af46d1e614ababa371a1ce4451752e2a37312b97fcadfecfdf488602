ubtype="return-mark" rend="subscript" source="#source-62190-62202">一</note><seg source="#source-62202-62208">。雖</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-62208-62220">レ</note><seg source="#source-62220-62223">欲</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-62223-62235">レ</note><seg source="#source-62235-62238">爲</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-62238-62250">二</note><seg source="#source-62250-62256">孤豚</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-62256-62268">一</note><seg source="#source-62268-62277">。豈可</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-62277-62289">レ</note><seg source="#source-62289-62313">得乎。子亟去。無</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-62313-62325">レ</note><seg source="#source-62325-62328">汚</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-62328-62340">レ</note><seg source="#source-62340-62355">我。我寧游</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-62355-62367">二</note><seg source="#source-62367-62382">戲汚涜之中</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-62382-62394">一</note><seg source="#source-62394-62406">自快。無</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-62406-62418">レ</note><seg source="#source-62418-62421">爲</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-62421-62433">二</note><seg source="#source-62433-62436">有</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-62436-62448">レ</note><seg source="#source-62448-62457">國者所</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-62457-62472">一レ</note><seg source="#source-62472-62487">覊。終身不</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source