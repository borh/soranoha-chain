      <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-689-1917"><ruby type="furigana" rend="right" source="#source-692-716"><rb>帝王</rb><rt>ていわう</rt></ruby><ruby type="furigana" rend="right" source="#source-716-737"><rb>世紀</rb><rt>せいき</rt></ruby><seg source="#source-737-758">にありといふ。</seg><ruby type="furigana" rend="right" source="#source-758-770"><rb>日</rb><rt>ひ</rt></ruby><seg source="#source-770-773">の</seg><ruby type="furigana" rend="right" source="#source-773-788"><rb>怪</rb><rt>あや</rt></ruby><seg source="#source-788-797">しきを</seg><ruby type="furigana" rend="right" source="#source-797-809"><rb>射</rb><rt>い</rt></ruby><seg source="#source-809-812">て</seg><ruby type="furigana" rend="right" source="#source-812-824"><rb>世</rb><rt>よ</rt></ruby><seg source="#source-824-827">に</seg><ruby type="furigana" rend="right" source="#source-827-842"><rb>聞</rb><rt>きこ</rt></ruby><seg source="#source-842-851">えたる</seg><ruby type="furigana" rend="right" source="#source-851-922"><rb><g ref="#gaiji-3-1-90-29" source="#source-851-910">羿</g></rb><rt>げい</rt></ruby><seg source="#source-922-925">、</seg><ruby type="furigana" rend="right" source="#source-925-940"><rb>嘗</rb><rt>かつ</rt></ruby><seg source="#source-940-943">て</seg><ruby type="furigana" rend="right" source="#source-943-961"><rb>呉賀</rb><rt>ごが</rt></ruby><seg source="#source-961-964">と</seg><ruby type="furigana" rend="right" source="#source-964-979"><rb>北</rb><rt>きた</rt></ruby><seg source="#source-979-982">に</seg><ruby type="furigana" rend="right" source="#source-982-997"><rb>遊</rb><rt>あそ</rt></ruby><seg source="#source-997-1018">べることあり。</seg><ruby type="furigana" rend="right" source="#source-1018-1036"><rb>呉賀</rb><rt>ごが</rt></ruby><ruby type="furigana" rend="right" source="#source-1036-1054"><rb>雀</rb><rt>すゞめ</rt></ruby><seg source="#source-1054-1057">を</seg><ruby type="furigana" rend="right" source="#source-1057-1069"><rb>指</rb><rt>さ</rt></ruby><seg source="#source-1069-1075">して</seg><ruby type="furigana" re