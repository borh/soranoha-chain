ruby><seg source="#source-172647-172650">へ</seg><ruby type="furigana" rend="right" source="#source-172650-172665"><rb>姫</rb><rt>ひい</rt></ruby><seg source="#source-172665-172674">さまを</seg><ruby type="furigana" rend="right" source="#source-172674-172686"><rb>伴</rb><rt>つ</rt></ruby><seg source="#source-172686-172692">れて</seg><ruby type="furigana" rend="right" source="#source-172692-172704"><rb>行</rb><rt>ゆ</rt></ruby><seg source="#source-172704-172746">かっしゃるやうならば、ほんに</seg><choice source="#source-172746-172752"><orig>／＼</orig><reg>〱</reg></choice><seg source="#source-172752-172755">、</seg><ruby type="furigana" rend="right" source="#source-172755-172776"><rb>世間</rb><rt>せけん</rt></ruby><seg source="#source-172776-172779">で</seg><ruby type="furigana" rend="right" source="#source-172779-172791"><rb>言</rb><rt>い</rt></ruby><seg source="#source-172791-172794">ふ</seg><ruby type="furigana" rend="right" source="#source-172794-172809"><rb>通</rb><rt>とほ</rt></ruby><seg source="#source-172809-172815">り、</seg><ruby type="furigana" rend="right" source="#source-172815-172836"><rb>不埓</rb><rt>ふらち</rt></ruby><seg source="#source-172836-172839">な</seg><ruby type="furigana" rend="right" source="#source-172839-172854"><rb>事</rb><rt>こと</rt></ruby><seg source="#source-172854-172863">ぢゃ。</seg><ruby type="furigana" rend="right" source="#source-172863-172881"><rb>何故</rb><rt>なぜ</rt></ruby><seg source="#source-172881-172884">と</seg><ruby type="furigana" rend="right" source="#source-172884-172908"><rb>被言</rb><rt>おッしゃ</rt></ruby><seg source="#source-172908-172920">りませ、</seg><ruby type="furigana" rend="right" source="#source-172920-172935"><rb>姫</rb><rt>ひい</rt></ruby><seg source="#source-172935-172950">さまはまだ</seg><ruby type="furigana" rend="right" source="#source-172950-172965"><rb>齡</rb><rt>とし</rt></ruby><seg source="#source-172965-173004">がゆかッしゃらぬによって、</seg><ruby type="furigana" rend="right" source="#source-173004-173019"><rb>騙</rb><rt>だま</rt></ruby><seg source="#source-173019-173073">さッしゃるやうであれば、ほんにそれ