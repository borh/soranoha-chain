ource-282379-282400"><rb>彼奴</rb><rt>あいつ</rt></ruby><seg source="#source-282400-282403">の</seg><ruby type="furigana" rend="right" source="#source-282403-282415"><rb>名</rb><rt>な</rt></ruby><seg source="#source-282415-282418">を</seg><ruby type="furigana" rend="right" source="#source-282418-282430"><rb>聞</rb><rt>き</rt></ruby><seg source="#source-282430-282436">くと</seg><ruby type="furigana" rend="right" source="#source-282436-282448"><rb>身</rb><rt>み</rt></ruby><seg source="#source-282448-282451">が</seg><ruby type="furigana" rend="right" source="#source-282451-282469"><rb>顫</rb><rt>ふるへ</rt></ruby><seg source="#source-282469-282517">る。もどかしいなア、チッバルトを</seg><ruby type="furigana" rend="right" source="#source-282517-282532"><rb>殺</rb><rt>ころ</rt></ruby><seg source="#source-282532-282544">しをった</seg><ruby type="furigana" rend="right" source="#source-282544-282565"><rb>彼奴</rb><rt>あいつ</rt></ruby><seg source="#source-282565-282568">の</seg><ruby type="furigana" rend="right" source="#source-282568-282589"><rb>肉體</rb><rt>からだ</rt></ruby><seg source="#source-282589-282595">をば</seg><ruby type="furigana" rend="right" source="#source-282595-282619"><rb>掻毟</rb><rt>かきむし</rt></ruby><seg source="#source-282619-282628">って、</seg><ruby type="furigana" rend="right" source="#source-282628-282646"><rb>懷</rb><rt>なつか</rt></ruby><seg source="#source-282646-282652">しい</seg><choice source="#source-282652-282658"><orig>／＼</orig><reg>〱</reg></choice><ruby type="furigana" rend="right" source="#source-282658-282679"><rb>從兄</rb><rt>いとこ</rt></ruby><seg source="#source-282679-282685">への</seg><ruby type="furigana" rend="right" source="#source-282685-282700"><rb>此</rb><rt>この</rt></ruby><ruby type="furigana" rend="right" source="#source-282700-282724"><rb>眞情</rb><rt>まごゝろ</rt></ruby><seg source="#source-282724-282727">を</seg><ruby type="furigana" rend="right" source="#source-282727-282739"><rb>見</rb><rt>み</rt></ruby><seg source="#source-282739-282754">することも</seg><ruby type="furigana" rend="right" source="#source-2827