</ruby><seg source="#source-175317-175323">しい</seg><ruby type="furigana" rend="right" source="#source-175323-175338"><rb>事</rb><rt>こと</rt></ruby><seg source="#source-175338-175341">の</seg><ruby type="furigana" rend="right" source="#source-175341-175368"><rb>頂點</rb><rt>ちゃうてん</rt></ruby><seg source="#source-175368-175371">へ</seg><ruby type="furigana" rend="right" source="#source-175371-175392"><rb>此身</rb><rt>このみ</rt></ruby><seg source="#source-175392-175395">を</seg><ruby type="furigana" rend="right" source="#source-175395-175410"><rb>運</rb><rt>はこ</rt></ruby><seg source="#source-175410-175413">ぶ</seg><ruby type="furigana" rend="right" source="#source-175413-175428"><rb>縁</rb><rt>えん</rt></ruby><seg source="#source-175428-175431">の</seg><ruby type="furigana" rend="right" source="#source-175431-175446"><rb>綱</rb><rt>つな</rt></ruby><seg source="#source-175446-175470">。……さよなら。</seg><ruby type="furigana" rend="right" source="#source-175470-175494"><rb>眞實</rb><rt>しんじつ</rt></ruby><seg source="#source-175494-175497">を</seg><ruby type="furigana" rend="right" source="#source-175497-175512"><rb>盡</rb><rt>つく</rt></ruby><seg source="#source-175512-175545">しておくりゃれ、きっと</seg><ruby type="furigana" rend="right" source="#source-175545-175569"><rb>骨折</rb><rt>ほねをり</rt></ruby><seg source="#source-175569-175572">の</seg><ruby type="furigana" rend="right" source="#source-175572-175590"><rb>報</rb><rt>むくひ</rt></ruby><seg source="#source-175590-175614">はせう。さらば。</seg><ruby type="furigana" rend="right" source="#source-175614-175629"><rb>姫</rb><rt>ひめ</rt></ruby><seg source="#source-175629-175632">へ</seg><ruby type="furigana" rend="right" source="#source-175632-175647"><rb>宜</rb><rt>よろ</rt></ruby><seg source="#source-175647-175653">しう</seg><ruby type="furigana" rend="right" source="#source-175653-175668"><rb>傳</rb><rt>つた</rt></ruby><seg source="#source-175668-175674">へて</seg><ruby type="furigana" rend="right" source="#source-175674-175689"><rb>下</rb><rt>くだ</rt></ruby><seg source="#source-175689-175700"