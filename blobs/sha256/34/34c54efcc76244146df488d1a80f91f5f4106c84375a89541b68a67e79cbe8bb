      <p source="#source-60-83"><seg source="#source-60-83">湧く水のように</seg></p>
      <p source="#source-83-103"><seg source="#source-83-103">自然の素直さ</seg></p>
      <p source="#source-103-123"><seg source="#source-103-123">自然の親しさ</seg></p>
      <p source="#source-123-149"><seg source="#source-123-149">親しさの深まった</seg></p>
      <p source="#source-149-169"><seg source="#source-149-169">少女と少年の</seg></p>
      <p source="#source-169-198"><seg source="#source-169-198">永遠をねがう二人の</seg></p>
      <p source="#source-198-215"><seg source="#source-198-215">愛　親しみ</seg></p>
      <p source="#source-215-238"><seg source="#source-215-238">子供から大人へ</seg></p>
      <p source="#source-238-258"><seg source="#source-238-258">成長してゆく</seg></p>
      <p source="#source-258-278"><seg source="#source-258-278">ありのままの</seg></p>
      <p source="#source-278-300"><seg source="#source-278-300">素直なねがい</seg></p>
      <p source="#source-300-329"><seg source="#source-300-329">りんどうと野ぎくと</seg></p>
      <p source="#source-329-351"><seg source="#source-329-351">花にたとえて</seg></p>
      <p source="#source-351-386"><seg source="#source-351-386">りんどうの花しか知らぬ</seg></p>
      <p source="#source-386-403"><seg source="#source-386-403">触れもせぬ</seg></p>
      <p source="#source-403-420"><seg source="#source-403-420">野菊の花の</seg></p>
      <p source="#source-420-455"><seg source="#source-420-455">りんどうの花しか知らぬ</seg></p>
      <p source="#source-455-480"><seg source="#source-455-480">子供をみもごり</seg></p>
      <p source="#source-480-512"><seg source="#source-480-512">死んだ方がいいのです</seg></p>
      <p source="#source-512-529"><seg source="#source-512-529">死んだ手に</seg></p>
      <p source="#source-529-580"><seg source="#source-529-580">りんどうの花と手紙とにぎられていた</seg></p>
    </body>
