      <p source="#source-574-642"><ruby type="furigana" rend="right" source="#source-574-589"><rb>友</rb><rt>とも</rt></ruby><seg source="#source-589-592">よ</seg><ruby type="furigana" rend="right" source="#source-592-607"><rb>恨</rb><rt>うら</rt></ruby><seg source="#source-607-613">まじ</seg><ruby type="furigana" rend="right" source="#source-613-631"><rb>今日</rb><rt>けふ</rt></ruby><seg source="#source-631-642">よりは</seg></p>
      <p source="#source-642-704"><seg source="#source-642-657">ねたまじ、</seg><ruby type="furigana" rend="right" source="#source-657-672"><rb>君</rb><rt>きみ</rt></ruby><seg source="#source-672-675">は</seg><ruby type="furigana" rend="right" source="#source-675-699"><rb>濃藍</rb><rt>のうらん</rt></ruby><seg source="#source-699-704">の</seg></p>
      <p source="#source-704-754"><ruby type="furigana" rend="right" source="#source-704-725"><rb>底見</rb><rt>そこみ</rt></ruby><seg source="#source-725-754">えわかぬわたづみの</seg></p>
      <p source="#source-754-831"><ruby type="furigana" rend="right" source="#source-754-775"><rb>珊瑚</rb><rt>さんご</rt></ruby><seg source="#source-775-778">の</seg><ruby type="furigana" rend="right" source="#source-778-793"><rb>宮</rb><rt>みや</rt></ruby><seg source="#source-793-796">に</seg><ruby type="furigana" rend="right" source="#source-796-811"><rb>恋</rb><rt>こひ</rt></ruby><seg source="#source-811-814">を</seg><ruby type="furigana" rend="right" source="#source-814-826"><rb>得</rb><rt>え</rt></ruby><seg source="#source-826-831">て</seg></p>
      <p source="#source-831-907"><ruby type="furigana" rend="right" source="#source-831-846"><rb>幸</rb><rt>さき</rt></ruby><seg source="#source-846-864">くあり、とに</seg><ruby type="furigana" rend="right" source="#source-864-879"><rb>思</rb><rt>おも</rt></ruby><seg source="#source-879-882">ひ</seg><ruby type="furigana" rend="right" source="#source-882-894"><rb>止</rb><rt>や</rt></ruby><seg source="#source-894-907">まむ。</seg></p>
      <p source="#source-907-966"><ruby type="furigana" rend="right" source="#source-907-928"><rb>濃藍</rb><rt>こあゐ</rt></ruby><seg source="#source-928-940">たゞえて</seg><ruby type="furigana" rend="right" source="#source-940-952"><rb>見</rb><rt>み</rt></ruby><seg source="#source-952-966">えわかぬ</seg></p>
      <p source="#source-966-1022"><seg source="#source-966-978">わたづみ</seg><ruby type="furigana" rend="right" source="#source-978-993"><rb>底</rb><rt>ぞこ</rt></ruby><seg source="#source-993-996">の</seg><ruby type="furigana" rend="right" source="#source-996-1011"><rb>恋</rb><rt>こひ</rt></ruby><seg source="#source-1011-1022">なれば</seg></p>
      <p source="#source-1022-1105"><ruby type="furigana" rend="right" source="#source-1022-1034"><rb>誰</rb><rt>た</rt></ruby><seg source="#source-1034-1037">が</seg><ruby type="furigana" rend="right" source="#source-1037-1049"><rb>子</rb><rt>こ</rt></ruby><ruby type="furigana" rend="right" source="#source-1049-1061"><rb>誰</rb><rt>た</rt></ruby><seg source="#source-1061-1064">が</seg><ruby type="furigana" rend="right" source="#source-1064-1076"><rb>子</rb><rt>こ</rt></ruby><seg source="#source-1076-1079">の</seg><ruby type="furigana" rend="right" source="#source-1079-1091"><rb>手</rb><rt>て</rt></ruby><seg source="#source-1091-1105">をとりて</seg></p>
      <p source="#source-1105-1161"><ruby type="furigana" rend="right" source="#source-1105-1120"><rb>口</rb><rt>くち</rt></ruby><seg source="#source-1120-1135">つけかはし</seg><ruby type="furigana" rend="right" source="#source-1135-1147"><rb>笑</rb><rt>ゑ</rt></ruby><seg source="#source-1147-1161">みかはし</seg></p>
      <p source="#source-1161-1222"><seg source="#source-1161-1182">ありともいかで</seg><ruby type="furigana" rend="right" source="#source-1182-1194"><rb>名</rb><rt>な</rt></ruby><seg source="#source-1194-1197">を</seg><ruby type="furigana" rend="right" source="#source-1197-1209"><rb>知</rb><rt>し</rt></ruby><seg source="#source-1209-1222">らむ。</seg></p>
      <p source="#source-1222-1293"><ruby type="furigana" rend="right" source="#source-1222-1237"><rb>恋</rb><rt>こひ</rt></ruby><seg source="#source-1237-1240">を</seg><ruby type="furigana" rend="right" source="#source-1240-1252"><rb>恋</rb><rt>こ</rt></ruby><seg source="#source-1252-1261">はれぬ</seg><ruby type="furigana" rend="right" source="#source-1261-1282"><rb>嫉妬</rb><rt>ねたみ</rt></ruby><seg source="#source-1282-1293">もて、</seg></p>
      <p source="#source-1293-1364"><ruby type="furigana" rend="right" source="#source-1293-1314"><rb>相合</rb><rt>あひあ</rt></ruby><seg source="#source-1314-1317">ふ</seg><ruby type="furigana" rend="right" source="#source-1317-1332"><rb>魂</rb><rt>たま</rt></ruby><seg source="#source-1332-1335">を</seg><ruby type="furigana" rend="right" source="#source-1335-1350"><rb>咀</rb><rt>のろ</rt></ruby><seg source="#source-1350-1364">ふとも、</seg></p>
      <p source="#source-1364-1441"><seg source="#source-1364-1367">三</seg><ruby type="furigana" rend="right" source="#source-1367-1388"><rb>月</rb><rt>ぐわつ</rt></ruby><ruby type="furigana" rend="right" source="#source-1388-1403"><rb>尽</rb><rt>じん</rt></ruby><seg source="#source-1403-1406">の</seg><ruby type="furigana" rend="right" source="#source-1406-1439"><rb>百蓮華</rb><rt>びやくれんげ</rt></ruby></p>
      <p source="#source-1441-1497"><ruby type="furigana" rend="right" source="#source-1441-1453"><rb>得</rb><rt>え</rt></ruby><seg source="#source-1453-1459">やは</seg><ruby type="furigana" rend="right" source="#source-1459-1474"><rb>枯</rb><rt>から</rt></ruby><seg source="#source-1474-1497">さむあたゝかき</seg></p>
      <p source="#source-1497-1564"><ruby type="furigana" rend="right" source="#source-1497-1515"><rb>蕾</rb><rt>つぼみ</rt></ruby><seg source="#source-1515-1527">ふくめる</seg><ruby type="furigana" rend="right" source="#source-1527-1554"><rb>緋牡丹</rb><rt>ひぼたん</rt></ruby><seg source="#source-1554-1564">を。</seg></p>
      <p source="#source-1564-1635"><ruby type="furigana" rend="right" source="#source-1564-1585"><rb>寄藻</rb><rt>よりも</rt></ruby><seg source="#source-1585-1588">の</seg><ruby type="furigana" rend="right" source="#source-1588-1603"><rb>花</rb><rt>はな</rt></ruby><seg source="#source-1603-1606">も</seg><ruby type="furigana" rend="right" source="#source-1606-1621"><rb>匂</rb><rt>にほ</rt></ruby><seg source="#source-1621-1635">はざる。</seg></p>
      <p source="#source-1635-1715"><ruby type="furigana" rend="right" source="#source-1635-1656"><rb>荒磯</rb><rt>ありそ</rt></ruby><seg source="#source-1656-1659">の</seg><ruby type="furigana" rend="right" source="#source-1659-1674"><rb>辺</rb><rt>ほと</rt></ruby><seg source="#source-1674-1680">り、</seg><ruby type="furigana" rend="right" source="#source-1680-1695"><rb>夏</rb><rt>なつ</rt></ruby><seg source="#source-1695-1698">の</seg><ruby type="furigana" rend="right" source="#source-1698-1710"><rb>日</rb><rt>ひ</rt></ruby><seg source="#source-1710-1715">に</seg></p>
      <p source="#source-1715-1786"><ruby type="furigana" rend="right" source="#source-1715-1727"><rb>照</rb><rt>て</rt></ruby><seg source="#source-1727-1730">り</seg><ruby type="furigana" rend="right" source="#source-1730-1742"><rb>晒</rb><rt>さ</rt></ruby><seg source="#source-1742-1754">らされて</seg><ruby type="furigana" rend="right" source="#source-1754-1784"><rb>帆立貝</rb><rt>ほたてがい</rt></ruby></p>
      <p source="#source-1786-1863"><ruby type="furigana" rend="right" source="#source-1786-1798"><rb>帆</rb><rt>ほ</rt></ruby><seg source="#source-1798-1801">を</seg><ruby type="furigana" rend="right" source="#source-1801-1816"><rb>失</rb><rt>うし</rt></ruby><seg source="#source-1816-1828">なひぬ、</seg><ruby type="furigana" rend="right" source="#source-1828-1843"><rb>砂</rb><rt>すな</rt></ruby><seg source="#source-1843-1846">の</seg><ruby type="furigana" rend="right" source="#source-1846-1858"><rb>上</rb><rt>へ</rt></ruby><seg source="#source-1858-1863">に</seg></p>
      <p source="#source-1863-1921"><ruby type="furigana" rend="right" source="#source-1863-1875"><rb>歯</rb><rt>は</rt></ruby><seg source="#source-1875-1893">をくひあてゝ</seg><ruby type="furigana" rend="right" source="#source-1893-1908"><rb>滅</rb><rt>ほろ</rt></ruby><seg source="#source-1908-1921">ばゞや</seg></p>
      <p source="#source-1921-1971"><seg source="#source-1921-1942">とおもひにしも</seg><ruby type="furigana" rend="right" source="#source-1942-1966"><rb>怨疾</rb><rt>をんしつ</rt></ruby><seg source="#source-1966-1971">の</seg></p>
      <p source="#source-1971-2042"><ruby type="furigana" rend="right" source="#source-1971-1986"><rb>膿</rb><rt>うみ</rt></ruby><seg source="#source-1986-1989">に</seg><ruby type="furigana" rend="right" source="#source-1989-2004"><rb>悩</rb><rt>なや</rt></ruby><seg source="#source-2004-2010">める</seg><ruby type="furigana" rend="right" source="#source-2010-2028"><rb>昨夜</rb><rt>よべ</rt></ruby><seg source="#source-2028-2042">なりし、</seg></p>
      <p source="#source-2042-2107"><ruby type="furigana" rend="right" source="#source-2042-2054"><rb>帆</rb><rt>ほ</rt></ruby><seg source="#source-2054-2057">を</seg><ruby type="furigana" rend="right" source="#source-2057-2072"><rb>失</rb><rt>うし</rt></ruby><seg source="#source-2072-2081">なひし</seg><ruby type="furigana" rend="right" source="#source-2081-2096"><rb>貝</rb><rt>かい</rt></ruby><seg source="#source-2096-2107">ならば</seg></p>
      <p source="#source-2107-2178"><ruby type="furigana" rend="right" source="#source-2107-2125"><rb>今日</rb><rt>けふ</rt></ruby><seg source="#source-2125-2131">より</seg><ruby type="furigana" rend="right" source="#source-2131-2146"><rb>思</rb><rt>おも</rt></ruby><seg source="#source-2146-2149">ひ</seg><ruby type="furigana" rend="right" source="#source-2149-2164"><rb>安</rb><rt>やす</rt></ruby><seg source="#source-2164-2178">からむ、</seg></p>
      <p source="#source-2178-2266"><ruby type="furigana" rend="right" source="#source-2178-2199"><rb>荒磯</rb><rt>ありそ</rt></ruby><seg source="#source-2199-2202">の</seg><ruby type="furigana" rend="right" source="#source-2202-2217"><rb>上</rb><rt>うえ</rt></ruby><seg source="#source-2217-2220">や</seg><ruby type="furigana" rend="right" source="#source-2220-2256"><rb>寂光土</rb><rt>じやくくわうど</rt></ruby><seg source="#source-2256-2266">――</seg></p>
      <p source="#source-2266-2313"><seg source="#source-2266-2287">ねたみくづれし</seg><ruby type="furigana" rend="right" source="#source-2287-2302"><rb>花</rb><rt>はな</rt></ruby><seg source="#source-2302-2313">ならば</seg></p>
      <p source="#source-2313-2366"><ruby type="furigana" rend="right" source="#source-2313-2331"><rb>今日</rb><rt>けふ</rt></ruby><seg source="#source-2331-2366">よりなげきあらためむ、</seg></p>
      <p source="#source-2366-2434"><ruby type="furigana" rend="right" source="#source-2366-2381"><rb>法</rb><rt>のり</rt></ruby><seg source="#source-2381-2384">の</seg><ruby type="furigana" rend="right" source="#source-2384-2399"><rb>雨</rb><rt>あめ</rt></ruby><ruby type="furigana" rend="right" source="#source-2399-2411"><rb>降</rb><rt>ふ</rt></ruby><seg source="#source-2411-2434">れあゝさらば、</seg></p>
      <p source="#source-2434-2502"><ruby type="furigana" rend="right" source="#source-2434-2449"><rb>乱</rb><rt>みだ</rt></ruby><seg source="#source-2449-2455">れて</seg><ruby type="furigana" rend="right" source="#source-2455-2467"><rb>飛</rb><rt>と</rt></ruby><seg source="#source-2467-2473">びし</seg><ruby type="furigana" rend="right" source="#source-2473-2497"><rb>花片</rb><rt>はなびら</rt></ruby><seg source="#source-2497-2502">を</seg></p>
      <p source="#source-2502-2575"><ruby type="furigana" rend="right" source="#source-2502-2514"><rb>濡</rb><rt>ぬ</rt></ruby><seg source="#source-2514-2517">れ</seg><ruby type="furigana" rend="right" source="#source-2517-2529"><rb>朽</rb><rt>く</rt></ruby><seg source="#source-2529-2541">たしめよ</seg><ruby type="furigana" rend="right" source="#source-2541-2562"><rb>土着</rb><rt>つちき</rt></ruby><seg source="#source-2562-2575">せよ。</seg></p>
      <p source="#source-2575-2646"><ruby type="furigana" rend="right" source="#source-2575-2596"><rb>日毎</rb><rt>ひごと</rt></ruby><ruby type="furigana" rend="right" source="#source-2596-2617"><rb>夜毎</rb><rt>よごと</rt></ruby><seg source="#source-2617-2620">に</seg><ruby type="furigana" rend="right" source="#source-2620-2632"><rb>死</rb><rt>し</rt></ruby><seg source="#source-2632-2646">にかはり</seg></p>
      <p source="#source-2646-2702"><ruby type="furigana" rend="right" source="#source-2646-2658"><rb>死</rb><rt>し</rt></ruby><seg source="#source-2658-2682">にかはりてもあゝ</seg><ruby type="furigana" rend="right" source="#source-2682-2697"><rb>友</rb><rt>とも</rt></ruby><seg source="#source-2697-2702">よ</seg></p>
      <p source="#source-2702-2764"><seg source="#source-2702-2714">ねたまじ</seg><ruby type="furigana" rend="right" source="#source-2714-2729"><rb>友</rb><rt>とも</rt></ruby><seg source="#source-2729-2732">の</seg><ruby type="furigana" rend="right" source="#source-2732-2756"><rb>恋人</rb><rt>こひゞと</rt></ruby><seg source="#source-2756-2764">よ、</seg></p>
      <p source="#source-2764-2811"><seg source="#source-2764-2785">こひねがはくは</seg><ruby type="furigana" rend="right" source="#source-2785-2800"><rb>円</rb><rt>まど</rt></ruby><seg source="#source-2800-2811">かなる</seg></p>
      <p source="#source-2811-2883"><ruby type="furigana" rend="right" source="#source-2811-2826"><rb>愛</rb><rt>あひ</rt></ruby><seg source="#source-2826-2829">の</seg><ruby type="furigana" rend="right" source="#source-2829-2844"><rb>光</rb><rt>ひか</rt></ruby><seg source="#source-2844-2850">りを</seg><ruby type="furigana" rend="right" source="#source-2850-2865"><rb>仰</rb><rt>あふ</rt></ruby><seg source="#source-2865-2883">がしめずや。</seg></p>
