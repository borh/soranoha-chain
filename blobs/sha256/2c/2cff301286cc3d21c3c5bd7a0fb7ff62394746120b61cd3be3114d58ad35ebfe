        <p style="text-indent: 1em" rend="first-line-indent(1)"><ruby type="furigana" rend="right" source="#source-12275-12299"><rb>片歌</rb><rt>かたうた</rt></ruby><seg source="#source-12299-12305">は、</seg><ruby type="furigana" rend="right" source="#source-12305-12326"><rb>三句</rb><rt>さんく</rt></ruby><seg source="#source-12326-12332">から</seg><ruby type="furigana" rend="right" source="#source-12332-12350"><rb>出來</rb><rt>でき</rt></ruby><seg source="#source-12350-12362">てゐて、</seg><ruby type="furigana" rend="right" source="#source-12362-12386"><rb>一番</rb><rt>いちばん</rt></ruby><seg source="#source-12386-12392">めの</seg><ruby type="furigana" rend="right" source="#source-12392-12404"><rb>句</rb><rt>く</rt></ruby><seg source="#source-12404-12407">が</seg><ruby type="furigana" rend="right" source="#source-12407-12428"><rb>五音</rb><rt>ごおん</rt></ruby><seg source="#source-12428-12431">、</seg><ruby type="furigana" rend="right" source="#source-12431-12452"><rb>二番</rb><rt>にばん</rt></ruby><seg source="#source-12452-12458">めの</seg><ruby type="furigana" rend="right" source="#source-12458-12470"><rb>句</rb><rt>く</rt></ruby><seg source="#source-12470-12473">が</seg><ruby type="furigana" rend="right" source="#source-12473-12497"><rb>七音</rb><rt>しちおん</rt></ruby><seg source="#source-12497-12500">、</seg><ruby type="furigana" rend="right" source="#source-12500-12524"><rb>第三</rb><rt>だいさん</rt></ruby><seg source="#source-12524-12527">の</seg><ruby type="furigana" rend="right" source="#source-12527-12539"><rb>句</rb><rt>く</rt></ruby><seg source="#source-12539-12548">がまた</seg><ruby type="furigana" rend="right" source="#source-12548-12572"><rb>七音</rb><rt>しちおん</rt></ruby><seg source="#source-12572-12614">、といふふうになつてゐるのが</seg><ruby type="furigana" rend="right" source="#source-12614-12635"><rb>普通</rb><rt>ふつう</rt></ruby><seg source="#source-12635-12647">で、その</seg><ruby type="furigana" rend="right" source="#source-12647-12671"><rb>音數</rb><rt>おんすう</rt></ruby><seg source="#source-12671-12680">には、</seg><ruby type="furigana" r