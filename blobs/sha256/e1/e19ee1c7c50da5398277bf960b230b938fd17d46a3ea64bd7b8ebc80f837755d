  <text>
    <body>
      <p source="#source-27-65"><seg source="#source-27-65">一れつ一れつならんでる、</seg></p>
      <p source="#source-65-105"><seg source="#source-65-105">土人が浜べにならんでる。</seg></p>
      <p source="#source-105-143"><seg source="#source-105-143">一れつ一れつならんでる、</seg></p>
      <p source="#source-143-189"><seg source="#source-143-189">カヌーがなぎさにならんでる。</seg></p>
      <p source="#source-189-227"><seg source="#source-189-227">一れつ一れつならんでる、</seg></p>
      <p source="#source-227-264"><seg source="#source-227-264">わにの卵がならんでる。</seg></p>
      <p source="#source-264-302"><seg source="#source-264-302">一れつ一れつならんでる、</seg></p>
      <p source="#source-302-345"><seg source="#source-302-345">しげつたやしがならんでる。</seg></p>
      <p source="#source-345-383"><seg source="#source-345-383">一れつ一れつならんでる、</seg></p>
      <p source="#source-383-423"><seg source="#source-383-423">ひでりの雲がならんでる。</seg></p>
      <p source="#source-423-461"><seg source="#source-423-461">一れつ一れつあゝみんな、</seg></p>
      <p source="#source-461-497"><seg source="#source-461-497">水にうつつてならんでる。</seg></p>
    </body>
