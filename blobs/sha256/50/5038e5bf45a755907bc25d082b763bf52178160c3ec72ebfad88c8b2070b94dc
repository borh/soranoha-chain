    <body>
      <p><seg source="#source-21-35">とて馬車</seg></p>
      <p><seg source="#source-35-49">とろとろ</seg></p>
      <p><seg source="#source-49-68">峠の眞晝よ</seg></p>
      <p><seg source="#source-68-82">ひらひら</seg></p>
      <p><seg source="#source-82-93">蝶々よ</seg></p>
      <p><seg source="#source-93-112">青い空だよ</seg></p>
      <p><seg source="#source-112-126">とろとろ</seg></p>
      <p><seg source="#source-126-140">かげろふ</seg></p>
      <p><seg source="#source-140-159">白い道だよ</seg></p>
      <p><seg source="#source-159-173">ゐねむり</seg></p>
      <p><seg source="#source-173-187">とろとろ</seg></p>
      <p><seg source="#source-187-212">馬車屋の爺さよ</seg></p>
      <p><seg source="#source-212-226">とろとろ</seg></p>
      <p><seg source="#source-226-237">お馬も</seg></p>
      <p><seg source="#source-237-259">足並おそいよ</seg></p>
      <p><seg source="#source-259-270">お客も</seg></p>
      <p><seg source="#source-270-284">とろとろ</seg></p>
      <p><seg source="#source-284-309">何だかとろとろ</seg></p>
      <p><seg source="#source-309-323">とろとろ</seg></p>
      <p><seg source="#source-323-331">峠は</seg></p>
      <p><seg source="#source-331-346">遠い道だよ</seg></p>
    </body>
