      <div>
        <head n="1" source="#source-198622-198682"><seg source="#source-198622-198637">昭和十七年</seg></head>
        <div type="layout" source="#source-198692-198777" style="padding-inline-start: 1em">
          <div>
            <head n="2" source="#source-198713-198773"><seg source="#source-198713-198728">興亜の節句</seg></head>
          </div>
        </div>
        <div>
          <p><seg source="#source-198777-198792">輝く戦果　</seg><ruby type="furigana" rend="right" source="#source-198792-198813"><rb>五月</rb><rt>さつき</rt></ruby><seg source="#source-198813-198821">晴れ</seg></p>
          <p><seg source="#source-198821-198862">飛行機ぶんぶん　飛んでゐる</seg></p>
          <p><seg source="#source-198862-198883">世界を照らす　</seg><ruby type="furigana" rend="right" source="#source-198883-198916"><rb>大御稜威</rb><rt>おほみいつ</rt></ruby></p>
          <p><seg source="#source-198918-198952">勇み勇んで　限りない</seg></p>
          <p><seg source="#source-198952-198981">五月節句の　大空に</seg></p>
