          <p><seg source="#source-182131-182157">ここは　日なたで</seg></p>
          <p><seg source="#source-182157-182182">とまり場が多い</seg></p>
          <p><seg source="#source-182182-182199">池の岸には</seg></p>
          <p><seg source="#source-182199-182227">とんぼつりゐるに</seg></p>
          <p><seg source="#source-182227-182244">川の岸にも</seg></p>
          <p><seg source="#source-182244-182272">とんぼつりゐるに</seg></p>
          <p><seg source="#source-182272-182289">池や川へは</seg></p>
          <p><seg source="#source-182289-182317">こはいからゆくな</seg></p>
          <p><seg source="#source-182317-182346">とんぼ　ここへきて</seg></p>
          <p><seg source="#source-182346-182379">ひるねして　あそべ</seg></p>
        </div>
        <div type="layout" source="#source-182379-182470" style="padding-inline-start: 1em">
          <div>
            <head n="2" source="#source-182400-182466"><seg source="#source-182400-182418">おちぼひろひ</seg></head>
          </div>
        </div>
        <div>
          <p><seg source="#source-182470-182493">たんぼの　稲は</seg></p>
          <p><seg source="#source-182493-182512">かられたが</seg></p>
          <p><seg source="#source-182512-182532">稲のかられた</seg></p>
          <p><seg source="#source-182532-182548">田の中に</seg></p>
          <p><seg source="#source-182548-182568">朝おき小鳥が</seg></p>
          <p><seg source="#source-182568-182587">なきながら</seg></p>
          <p><seg source="#source-182587-182610">おちぼ見つけに</seg></p>
          <p><seg source="#source-182610-182629">とんでくる</seg></p>
          <p><seg source="#source-182629-182655">小鳥に　まけずに</seg></p>
          <p><seg source="#source-182655-182671">早くから</seg></p>
          <p><seg source="#source-182671-182691">小さい子供も</seg></p>
          <p><seg source="#source-182691-182710">ともどもに</seg></p>
          <p><seg source="#source-182710-182730">ざるを片手に</seg></p>
          <p><seg source="#source-182730-182746">元気よく</seg></p>
          <p><seg source="#source-182746-182769">おちぼひろひに</seg></p>
          <p><seg source="#source-182769-182786">あるいてる</seg></p>
          <p><pb source="#source-182786-182807"/></p>
        </div>
      </div>
      <div>
        <head n="1" source="#source-182809-182869"><seg source="#source-182809-182824">昭和十二年</seg></head>
        <div type="layout" source="#source-182879-182952" style="padding-inline-start: 1em">
          <div>
