      <p style="text-indent: 1em" rend="first-line-indent(1)"><ruby type="furigana" rend="right" source="#source-636-651"><rb>孰</rb><rt>いづ</rt></ruby><seg source="#source-651-657">れが</seg><ruby type="furigana" rend="right" source="#source-657-672"><rb>前</rb><rt>さき</rt></ruby><seg source="#source-672-675">に</seg><ruby type="furigana" rend="right" source="#source-675-693"><rb>出来</rb><rt>でき</rt></ruby><seg source="#source-693-702">たか、</seg><ruby type="furigana" rend="right" source="#source-702-726"><rb>穿鑿</rb><rt>せんさく</rt></ruby><seg source="#source-726-729">に</seg><ruby type="furigana" rend="right" source="#source-729-744"><rb>及</rb><rt>およ</rt></ruby><seg source="#source-744-756">ばぬが、</seg><ruby type="furigana" rend="right" source="#source-756-783"><rb>怪力</rb><rt>くわいりき</rt></ruby><seg source="#source-783-786">の</seg><ruby type="furigana" rend="right" source="#source-786-810"><rb>盲人</rb><rt>まうじん</rt></ruby><seg source="#source-810-813">の</seg><ruby type="furigana" rend="right" source="#source-813-837"><rb>物語</rb><rt>ものがた</rt></ruby><seg source="#source-837-858">りが二ツある。</seg><ruby type="furigana" rend="right" source="#source-858-873"><rb>同</rb><rt>おな</rt></ruby><seg source="#source-873-876">じ</seg><ruby type="furigana" rend="right" source="#source-876-894"><rb>話</rb><rt>はなし</rt></ruby><seg source="#source-894-897">の</seg><ruby type="furigana" rend="right" source="#source-897-912"><rb>型</rb><rt>かた</rt></ruby><seg source="#source-912-915">が</seg><ruby type="furigana" rend="right" source="#source-915-930"><rb>変</rb><rt>かは</rt></ruby><seg source="#source-930-948">つて、一ツは</seg><ruby type="furigana" rend="right" source="#source-948-981"><rb>講釈師</rb><rt>かうしやくし</rt></ruby><seg source="#source-981-984">が</seg><ruby type="furigana" rend="right" source="#source-984-999"><rb>板</rb><rt>いた</rt></ruby><seg source="#source-999-1020">にかけて、のん</seg><choice source="#source-1020-1026"><orig>／＼</orig><reg>〱</reg></choice><seg source="#source-1026-1032">づい</seg><choice source="#source-1032-103