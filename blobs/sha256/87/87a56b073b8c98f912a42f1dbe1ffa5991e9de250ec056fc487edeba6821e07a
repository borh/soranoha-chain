      <div type="layout" source="#source-118162-118193" style="padding-inline-start: 3em">
        <p source="#source-118183-118193"><seg source="#source-118183-118193">兵児</seg></p>
      </div>
      <div type="layout" source="#source-118193-118377" style="padding-inline-start: 5em">
        <p source="#source-118214-118377"><hi rend="font-size small(1)" snh:layout-kind="font-size" snh:layout-params="size-type=small;level=1" source="#source-118214-118373" corresp="#source-118214-118247 #source-118340-118373"><seg source="#source-118247-118253">九州</seg><ruby type="furigana" rend="right" source="#source-118253-118271"><rb>者</rb><rt>もん</rt></ruby><seg source="#source-118271-118280">な横道</seg><ruby type="furigana" rend="right" source="#source-118280-118298"><rb>者</rb><rt>もん</rt></ruby><seg source="#source-118298-118313">青竹割つて</seg><ruby type="furigana" rend="right" source="#source-118313-118331"><rb>兵児</rb><rt>へこ</rt></ruby><seg source="#source-118331-118340">にかく</seg></hi></p>
      </div>
      <div>
        <p source="#source-118377-118510"><seg source="#source-118377-118389">青竹割り</seg><ruby type="furigana" rend="right" source="#source-118389-118410"><rb>睾丸</rb><rt>ふぐり</rt></ruby><seg source="#source-118410-118422">締め込む</seg><ruby type="furigana" rend="right" source="#source-118422-118449"><rb>不知火</rb><rt>しらぬひ</rt></ruby><seg source="#source-118449-118452">の</seg><ruby type="furigana" rend="right" source="#source-118452-118485"><rb>南筑紫</rb><rt>みなみつくし</rt></ruby><seg source="#source-118485-118510">のますらを我は</seg></p>
      </div>
      <div type="layout" source="#source-118510-118556" style="padding-inline-start: 3em">
        <p source="#source-118531-118556"><seg source="#source-118531-118556">田打蟹をおもふ</seg></p>
      </div>
      <div>
        <p source="#source-118556-118635"><seg source="#source-118556-118635">黒崎潟潮干てゆけば田打蟹はろばろと湧くこゑの寂しさ</seg></p>
      </div>
      <div type="layout" source="#source-118635-118714" style="padding-inline-start: 1em">
        <div>
          <head n="3" source="#source-118656-118710"><seg source="#source-118656-118668">途上所見</seg></head>
        </div>
      </div>
      <div type="layout" source="#source-118714-118748" style="padding-inline-start: 3em">
        <p source="#source-118735-118748"><seg source="#source-118735-118748">ろくろ</seg></p>
      </div>
      <div>
        <p source="#source-118748-118887"><seg source="#source-118748-118754">思ひ</seg><ruby type="furigana" rend="right" source="#source-118754-118766"><rb>屈</rb><rt>く</rt></ruby><seg source="#source-118766-118778">ししばし</seg><ruby type="furigana" rend="right" source="#source-118778-118796"><rb>見惚</rb><rt>みほ</rt></ruby><seg source="#source-118796-118814">れつ昼さがり</seg><ruby type="furigana" rend="right" source="#source-118814-118850"><rb>陶器師</rb><rt>すゑものつくり</rt></ruby><seg source="#source-118850-118853">の</seg><ruby type="furigana" rend="right" source="#source-118853-118868"><rb>廻</rb><rt>まは</rt></ruby><seg source="#source-118868-118887">すろくろを</seg></p>
        <p source="#source-118887-118984"><seg source="#source-118887-118959">見つつゐて寂しかりしかいつしかと我を忘れつろくろ</seg><ruby type="furigana" rend="right" source="#source-118959-118974"><rb>廻</rb><rt>まは</rt></ruby><seg source="#source-118974-118984">せる</seg></p>
        <p source="#source-118984-119075"><seg source="#source-118984-119017">父母も妻も思はずろくろ</seg><ruby type="furigana" rend="right" source="#source-119017-119029"><rb>繰</rb><rt>く</rt></ruby><seg source="#source-119029-119075">り廻るろくろをただに見ほれつ</seg></p>
        <p source="#source-119075-119184"><seg source="#source-119075-119123">ろくろ見るろくろ廻るがただうれし</seg><ruby type="furigana" rend="right" source="#source-119123-119159"><rb>陶器師</rb><rt>すゑものつくり</rt></ruby><seg source="#source-119159-119184">はろくろ廻せる</seg></p>
        <p source="#source-119184-119305"><seg source="#source-119184-119220">ろくろ見るろくろまたなし</seg><ruby type="furigana" rend="right" source="#source-119220-119235"><rb>己</rb><rt>おの</rt></ruby><seg source="#source-119235-119244">れなし</seg><ruby type="furigana" rend="right" source="#source-119244-119280"><rb>陶器師</rb><rt>すゑものつくり</rt></ruby><seg source="#source-119280-119305">はろくろ廻せる</seg></p>
      </div>
      <div type="layout" source="#source-119305-119345" style="padding-inline-start: 3em">
        <p source="#source-119326-119345"><seg source="#source-119326-119345">子供の野球</seg></p>
      </div>
      <div>
        <p source="#source-119345-119448"><ruby type="furigana" rend="right" source="#source-119345-119360"><rb>球</rb><rt>たま</rt></ruby><seg source="#source-119360-119417">を打つ音のよろしさ聞くさへや心は晴るる</seg><ruby type="furigana" rend="right" source="#source-119417-119432"><rb>悔</rb><rt>くや</rt></ruby><seg source="#source-119432-119448">しき時も</seg></p>
        <p source="#source-119448-119527"><seg source="#source-119448-119527">球投ぐる振のよろしさ見るさへや心はをどる苦しき時も</seg></p>
        <p source="#source-119527-119645"><ruby type="furigana" rend="right" source="#source-119527-119551"><rb>真向</rb><rt>まつかう</rt></ruby><seg source="#source-119551-119563">より飛び</seg><ruby type="furigana" rend="right" source="#source-119563-119578"><rb>来</rb><rt>きた</rt></ruby><seg source="#source-119578-119645">る球待ち構ふる張りきらむずる立ちの雄々しさ</seg></p>
        <p source="#source-119645-119754"><ruby type="furigana" rend="right" source="#source-119645-119663"><rb>童</rb><rt>わらべ</rt></ruby><seg source="#source-119663-119711">こそはひたむきなれ火のごとく飛び</seg><ruby type="furigana" rend="right" source="#source-119711-119726"><rb>来</rb><rt>きた</rt></ruby><seg source="#source-119726-119754">る球を音高くうつ</seg></p>
        <p source="#source-119754-119869"><ruby type="furigana" rend="right" source="#source-119754-119772"><rb>童</rb><rt>わらべ</rt></ruby><seg source="#source-119772-119820">こそはひたむきなれ火のごとく飛び</seg><ruby type="furigana" rend="right" source="#source-119820-119835"><rb>来</rb><rt>きた</rt></ruby><seg source="#source-119835-119869">る球を身をそらし取る</seg></p>
        <p source="#source-119869-119993"><ruby type="furigana" rend="right" source="#source-119869-119887"><rb>童</rb><rt>わらべ</rt></ruby><seg source="#source-119887-119914">こそはひたむきなれ</seg><ruby type="furigana" rend="right" source="#source-119914-119935"><rb>傍目</rb><rt>わきめ</rt></ruby><seg source="#source-119935-119950">ふらず飛び</seg><ruby type="furigana" rend="right" source="#source-119950-119962"><rb>逸</rb><rt>そ</rt></ruby><seg source="#source-119962-119993">れ球をひた走り追ふ</seg></p>
      </div>
      <div type="layout" source="#source-119993-120078" style="padding-inline-start: 1em">
