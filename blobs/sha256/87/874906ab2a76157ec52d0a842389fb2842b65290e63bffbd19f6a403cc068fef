rigana" rend="right" source="#source-25415-25433"><rb>此處</rb><rt>ここ</rt></ruby><seg source="#source-25433-25436">は</seg><ruby type="furigana" rend="right" source="#source-25436-25448"><rb>去</rb><rt>さ</rt></ruby><seg source="#source-25448-25460">るまいと</seg><ruby type="furigana" rend="right" source="#source-25460-25481"><rb>覺悟</rb><rt>かくご</rt></ruby><seg source="#source-25481-25498">しました。</seg></p>
        <p style="text-indent: 1em" rend="first-line-indent(1)"><seg source="#source-25498-25510">しかし</seg><ruby type="furigana" rend="right" source="#source-25510-25528"><rb>男</rb><rt>をとこ</rt></ruby><seg source="#source-25528-25531">を</seg><ruby type="furigana" rend="right" source="#source-25531-25546"><rb>殺</rb><rt>ころ</rt></ruby><seg source="#source-25546-25564">すにしても、</seg><ruby type="furigana" rend="right" source="#source-25564-25585"><rb>卑怯</rb><rt>ひけふ</rt></ruby><seg source="#source-25585-25588">な</seg><ruby type="furigana" rend="right" source="#source-25588-25603"><rb>殺</rb><rt>ころ</rt></ruby><seg source="#source-25603-25606">し</seg><ruby type="furigana" rend="right" source="#source-25606-25621"><rb>方</rb><rt>かた</rt></ruby><seg source="#source-25621-25663">はしたくありません。わたしは</seg><ruby type="furigana" rend="right" source="#source-25663-25681"><rb>男</rb><rt>をとこ</rt></ruby><seg source="#source-25681-25684">の</seg><ruby type="furigana" rend="right" source="#source-25684-25699"><rb>繩</rb><rt>なは</rt></ruby><seg source="#source-25699-25702">を</seg><ruby type="furigana" rend="right" source="#source-25702-25714"><rb>解</rb><rt>と</rt></ruby><seg source="#source-25714-25720">いた</seg><ruby type="furigana" rend="right" source="#source-25720-25735"><rb>上</rb><rt>うへ</rt></ruby><seg source="#source-25735-25738">、</seg><ruby type="furigana" rend="right" source="#source-25738-25762"><rb>太刀打</rb><rt>たちう</rt></ruby><seg source="#source-25762-25777">ちをしろと</seg><ruby type="furigana" rend="right" source="#source-25777-25789"><rb>云</rb><rt>い</rt></ruby><seg source="#source-25789-25807">ひました。（</seg><ruby type="furigana" rend="right" source="#source-25807-25822"><rb>杉</rb><rt>すぎ</rt></ruby><seg source="#source-25822-25825">の</seg><ruby type="furigana" rend="right" source="#source-25825-25837"><rb>根</rb><rt>ね</rt></ruby><seg source="#source-25837-25846">がたに</seg><ruby type="furigana" rend="right" source="#source-25846-25858"><rb>落</rb><rt>お</rt></ruby><seg source="#source-25858-25885">ちてゐたの