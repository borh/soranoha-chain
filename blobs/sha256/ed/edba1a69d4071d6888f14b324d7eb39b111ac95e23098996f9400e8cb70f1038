ubscript" source="#source-13478-13490">二</note><seg source="#source-13490-13499">婢千人</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-13499-13511">一</note><seg source="#source-13511-13526">自侍。唯有</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-13526-13538">二</note><seg source="#source-13538-13550">男子一人</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-13550-13562">一</note><seg source="#source-13562-13568">。給</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-13568-13580">二</note><seg source="#source-13580-13586">飮食</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-13586-13598">一</note><seg source="#source-13598-13604">。傳</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-13604-13616">レ</note><seg source="#source-13616-13631">辭出入。居</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-13631-13643">二</note><seg source="#source-13643-13652">處宮室</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-13652-13664">一</note><seg source="#source-13664-13694">。樓觀城柵嚴設。常有</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-13694-13706">レ</note><seg source="#source-13706-13712">人持</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-13712-13724">レ</note><seg source="#source-13724-13751">兵守衞。女王國東渡</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-13751-13763">レ</note><seg source="#source-13763-13784">海千餘里。復有</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-13784-13796">レ</note><seg source="#source-13796-13820">國。皆倭種。又有</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-13820-13832">二</note><seg source="#source-13832-13841">侏儒國</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-13841-13853">一</note><seg source="#source-13853-13859">。在</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-13859-13871">二</note><seg source="#source-13871-13877">其南</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-13877-13889">一</note><seg source="#source-13889-13913">。人長三四尺。去</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-13913-13925">二</note><seg source="#source-13925-13931">女王</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-13931-13943">一</note><seg source="#source-13943-13964">四千餘里。又有</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-13964-13976">二</note><seg source="#source-13976-13994">裸國、黒齒國</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-13994-14006">一</note><seg source="#source-14006-14015">。復在</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-14015-14027">二</note><seg source="#source-14027-14036">其東南</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-14036-14048">一</note><seg source="#source-14048-14066">。船行一年可</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-14066-14078">レ</note><seg source="#source-14078-14102">至。參問倭地絶在</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-14102-14114">二</note><seg source="#source-14114-14132">海中洲島之上</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-14132-14144">一</note><seg source="#source-14144-14171">。或絶或連。周旋可</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-14171-14183">二</note><seg source="#source-14183-14195">五千餘里</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-14195-14207">一</note><seg source="#source-14207-14243">。景初二年六月。倭女王遣</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-14243-14255">二</note><seg source="#source-14255-14273">大夫難升米等</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-14273-14285">一</note><seg source="#source-14285-14288">詣</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-14288-14300">レ</note><seg source="#source-14300-14309">郡。求</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-14309-14321">下</note><seg source="#source-14321-14324">詣</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-14324-14336">二</note><seg source="#source-14336-14342">天子</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-14342-14354">一</note><seg source="#source-14354-14360">朝獻</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-14360-14372">上</note><seg source="#source-14372-14390">。太守劉夏遣</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-14390-14402">二</note><seg source="#source-14402-14408">吏將</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-14408-14420">一</note><seg source="#source-14420-14429">。送詣</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-14429-14441">二</note><seg source="#source-14441-14447">京都</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-14447-14459">一</note><seg source="#source-14459-14489">。其年十二月。詔書報</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-14489-14501">二</note><seg source="#source-14501-14510">倭女王</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-14510-14522">一</note><seg source="#source-14522-14579">。曰制詔親魏倭王卑彌呼。帶方太守劉夏遣</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-14579-14591">レ</note><seg source="#source-14591-14597">使送</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-14597-14609">二</note><seg source="#source-14609-14648">汝大