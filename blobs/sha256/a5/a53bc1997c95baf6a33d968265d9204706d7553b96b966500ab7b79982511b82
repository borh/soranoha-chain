      <p><seg source="#source-35-49">きれいな</seg></p>
      <p><seg source="#source-49-63">雪だこと</seg></p>
      <p><seg source="#source-63-71">畑も</seg></p>
      <p><seg source="#source-71-82">屋根も</seg></p>
