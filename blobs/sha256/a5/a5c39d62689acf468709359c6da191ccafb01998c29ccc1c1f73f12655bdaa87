      <p source="#source-238-249"><seg source="#source-238-249">へちま</seg></p>
      <p source="#source-249-263"><seg source="#source-249-263">垂れてる</seg></p>
      <p source="#source-263-282"><seg source="#source-263-282">青い窓――</seg></p>
      <p source="#source-282-296"><seg source="#source-282-296">ピアノの</seg></p>
      <p source="#source-296-319"><ruby type="furigana" rend="right" source="#source-296-308"><rb>音</rb><rt>ね</rt></ruby><seg source="#source-308-319">してた</seg></p>
      <p source="#source-319-338"><seg source="#source-319-338">青い窓――</seg></p>
      <p source="#source-338-352"><seg source="#source-338-352">だれだか</seg></p>
      <p source="#source-352-366"><seg source="#source-352-366">知らない</seg></p>
      <p source="#source-366-391"><seg source="#source-366-391">住んでゐた――</seg></p>
      <p source="#source-391-405"><seg source="#source-391-405">どこだか</seg></p>
      <p source="#source-405-419"><seg source="#source-405-419">知らない</seg></p>
      <p source="#source-419-444"><seg source="#source-419-444">越してつた――</seg></p>
      <p source="#source-444-455"><seg source="#source-444-455">いつも</seg></p>
      <p source="#source-455-469"><seg source="#source-455-469">通つてく</seg></p>
      <p source="#source-469-488"><seg source="#source-469-488">學校道――</seg></p>
      <p source="#source-488-499"><seg source="#source-488-499">へちま</seg></p>
      <p source="#source-499-513"><seg source="#source-499-513">搖れてる</seg></p>
      <p source="#source-513-528"><seg source="#source-513-528">青い窓――</seg></p>
    </body>
