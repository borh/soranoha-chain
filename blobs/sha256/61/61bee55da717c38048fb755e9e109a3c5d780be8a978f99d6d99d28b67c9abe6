    <body>
      <p source="#source-241-273"><seg source="#source-241-247">夏の</seg><ruby type="furigana" rend="right" source="#source-247-268"><rb>昼間</rb><rt>ひるま</rt></ruby><seg source="#source-268-273">の</seg></p>
      <p source="#source-273-293"><seg source="#source-273-293">ひきがへる、</seg></p>
      <p source="#source-293-319"><seg source="#source-293-319">そなたは、なんで</seg></p>
      <p source="#source-319-341"><seg source="#source-319-341">さびしいぞ。</seg></p>
      <p source="#source-341-355"><seg source="#source-341-355">白い女の</seg></p>
      <p source="#source-355-372"><seg source="#source-355-372">指さきで、</seg></p>
      <p source="#source-372-398"><seg source="#source-372-398">刺され、突かれて</seg></p>
      <p source="#source-398-420"><seg source="#source-398-420">うれしいか。</seg></p>
      <p source="#source-420-437"><seg source="#source-420-437">夏の昼間の</seg></p>
      <p source="#source-437-457"><seg source="#source-437-457">ひきがへる、</seg></p>
      <p source="#source-457-495"><ruby type="furigana" rend="right" source="#source-457-487"><rb>海鼠色</rb><rt>なまこいろ</rt></ruby><seg source="#source-487-495">した</seg></p>
      <p source="#source-495-517"><seg source="#source-495-517">ひきがへる。</seg></p>
      <p source="#source-517-537"><seg source="#source-517-537">金の指輪に、</seg></p>
      <p source="#source-537-566"><ruby type="furigana" rend="right" source="#source-537-549"><rb>肢</rb><rt>て</rt></ruby><seg source="#source-549-566">が切れて、</seg></p>
      <p source="#source-566-589"><seg source="#source-566-589">血でも出したら</seg></p>
      <p source="#source-589-608"><seg source="#source-589-608">何とする。</seg></p>
      <p source="#source-608-640"><seg source="#source-608-614">夏の</seg><ruby type="furigana" rend="right" source="#source-614-635"><rb>昼間</rb><rt>ひるま</rt></ruby><seg source="#source-635-640">の</seg></p>
      <p source="#source-640-660"><seg source="#source-640-660">ひきがへる、</seg></p>
      <p source="#source-660-677"><seg source="#source-660-677">海鼠色した</seg></p>
      <p source="#source-677-695"><seg source="#source-677-695">ひきがへる。</seg></p>
    </body>
