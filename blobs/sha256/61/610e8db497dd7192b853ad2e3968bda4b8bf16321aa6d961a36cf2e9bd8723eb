><rt>い</rt></ruby><seg source="#source-767323-767329">って</seg><ruby type="furigana" rend="right" source="#source-767329-767341"><rb>居</rb><rt>お</rt></ruby><seg source="#source-767341-767347">り、</seg><ruby type="furigana" rend="right" source="#source-767347-767362"><rb>又</rb><rt>また</rt></ruby><ruby type="furigana" rend="right" source="#source-767362-767380"><rb>女</rb><rt>おんな</rt></ruby><seg source="#source-767380-767383">の</seg><ruby type="furigana" rend="right" source="#source-767383-767398"><rb>方</rb><rt>ほう</rt></ruby><seg source="#source-767398-767404">でも</seg><ruby type="furigana" rend="right" source="#source-767404-767422"><rb>男</rb><rt>おとこ</rt></ruby><seg source="#source-767422-767425">が</seg><ruby type="furigana" rend="right" source="#source-767425-767437"><rb>好</rb><rt>す</rt></ruby><seg source="#source-767437-767482">きだったものでございますので、</seg><ruby type="furigana" rend="right" source="#source-767482-767503"><rb>最後</rb><rt>さいご</rt></ruby>に、『<ruby type="furigana" rend="right" source="#source-767512-767533"><rb>二人</rb><rt>ふたり</rt></ruby><seg source="#source-767533-767536">の</seg><ruby type="furigana" rend="right" source="#source-767536-767554"><rb>間</rb><rt>あいだ</rt></ruby><seg source="#source-767554-767557">に</seg><ruby type="furigana" rend="right" source="#source-767557-767578"><rb>子供</rb><rt>こども</rt></ruby><seg source="#source-767578-767602">ができたらそれを</seg><ruby type="furigana" rend="right" source="#source-767602-767614"><rb>与</rb><rt>や</rt></ruby>る』という<ruby type="furigana" rend="right" source="#source-767629-767653"><rb>約束</rb><rt>やくそく</rt></ruby><seg source="#source-767653-767656">が</seg><ruby type="furigana" rend="right" source="#source-767656-767668"><rb>成</rb><rt>な</rt></ruby><seg source="#source-767668-767671">り</seg><ruby type="furigana" rend="right" source="#source-767671-767683"><rb>立</rb><rt>た</rt></ruby><seg source="#source-767683-767710">ちまして、とうとう</seg><ruby type="furigana" rend="right" source="#source-767710-767752"><rb>黄道吉日</rb><rt>こうどうきつじつ</rt></ruby>