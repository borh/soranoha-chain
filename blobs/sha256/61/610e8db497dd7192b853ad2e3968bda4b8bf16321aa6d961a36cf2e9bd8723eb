        <p source="#source-500730-501776">答『いかなる<ruby type="furigana" rend="right" source="#source-500748-500766"><rb>教</rb><rt>おしえ</rt></ruby><seg source="#source-500766-500769">を</seg><ruby type="furigana" rend="right" source="#source-500769-500784"><rb>信</rb><rt>しん</rt></ruby><seg source="#source-500784-500793">じても</seg><ruby type="furigana" rend="right" source="#source-500793-500817"><rb>産土</rb><rt>うぶすな</rt></ruby><seg source="#source-500817-500820">の</seg><ruby type="furigana" rend="right" source="#source-500820-500835"><rb>神</rb><rt>かみ</rt></ruby><seg source="#source-500835-500838">の</seg><ruby type="furigana" rend="right" source="#source-500838-500859"><rb>司配</rb><rt>しはい</rt></ruby><seg source="#source-500859-500862">を</seg><ruby type="furigana" rend="right" source="#source-500862-500874"><rb>受</rb><rt>う</rt></ruby><seg source="#source-500874-500889">けることに</seg><ruby type="furigana" rend="right" source="#source-500889-500904"><rb>変</rb><rt>かわ</rt></ruby><seg source="#source-500904-500928">りはないが、ただ</seg><ruby type="furigana" rend="right" source="#source-500928-500946"><rb>仏</rb><rt>ほとけ</rt></ruby><seg source="#source-500946-500949">の</seg><ruby type="furigana" rend="right" source="#source-500949-500964"><rb>救</rb><rt>すく</rt></ruby><seg source="#source-500964-500970">いを</seg><ruby type="furigana" rend="right" source="#source-500970-500985"><rb>信</rb><rt>しん</rt></ruby><seg source="#source-500985-500988">じ</seg><ruby type="furigana" rend="right" source="#source-500988-501000"><rb>切</rb><rt>き</rt></ruby><seg source="#source-501000-501006">って</seg><ruby type="furigana" rend="right" source="#source-501006-501018"><rb>居</rb><rt>い</rt></ruby><seg source="#source-501018-501039">るものは、その</seg><ruby type="furigana" rend="right" source="#source-501039-501060"><rb>迷夢</rb><rt>まよい</rt></ruby><seg source="#source-501060-501063">の</seg><ruby type="furigana" rend="right" source="#source-501063-501075"><rb>覚</rb><rt>さ</rt></ruby><seg source="#source-501075-501102">めるまで、しばらく</seg>