><seg source="#source-600280-600283">で</seg><ruby type="furigana" rend="right" source="#source-600283-600298"><rb>滝</rb><rt>たき</rt></ruby><seg source="#source-600298-600301">の</seg><ruby type="furigana" rend="right" source="#source-600301-600334"><rb>修行場</rb><rt>しゅぎょうば</rt></ruby><seg source="#source-600334-600337">を</seg><ruby type="furigana" rend="right" source="#source-600337-600349"><rb>出</rb><rt>で</rt></ruby><seg source="#source-600349-600358">かけ、</seg><ruby type="furigana" rend="right" source="#source-600358-600373"><rb>足</rb><rt>あし</rt></ruby><seg source="#source-600373-600391">のまにまに、</seg><ruby type="furigana" rend="right" source="#source-600391-600415"><rb>谷川</rb><rt>たにがわ</rt></ruby><seg source="#source-600415-600418">を</seg><ruby type="furigana" rend="right" source="#source-600418-600433"><rb>伝</rb><rt>つた</rt></ruby><seg source="#source-600433-600442">って、</seg><ruby type="furigana" rend="right" source="#source-600442-600460"><rb>下方</rb><rt>した</rt></ruby><seg source="#source-600460-600463">へ</seg><ruby type="furigana" rend="right" source="#source-600463-600481"><rb>下方</rb><rt>した</rt></ruby><seg source="#source-600481-600487">へと</seg><ruby type="furigana" rend="right" source="#source-600487-600499"><rb>降</rb><rt>お</rt></ruby><seg source="#source-600499-600505">りて</seg><ruby type="furigana" rend="right" source="#source-600505-600517"><rb>行</rb><rt>ゆ</rt></ruby><seg source="#source-600517-600534">きました。</seg></p>
        <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-600534-601484"><ruby type="furigana" rend="right" source="#source-600537-600558"><rb>戸外</rb><rt>おもて</rt></ruby><seg source="#source-600558-600561">は</seg><ruby type="furigana" rend="right" source="#source-600561-600579"><rb>矢張</rb><rt>やは</rt></ruby><seg source="#source-600579-600582">り</seg><ruby type="furigana" rend="right" source="#source-600582-600603"><rb>戸外</rb><rt>おもて</rt></ruby><seg source="#source-600603-600615">らしく、</seg><ruby type="furigana" rend="right" source="#source-600615-600636"><rb>私</rb><rt>わたくし</rt></ruby><seg source="#source-600636-600639">は</seg><ruby type="furigana" rend="right" source="#source-600639-600654"><rb>直</rb><rt>じき</rt></ruby><seg source="#source-600654-600657">に</seg><ruby type="furigana" rend="right" source="#source-600657-600672"><rb>何</rb><rt>なん</rt></ruby><seg source="#source-600672-600687">ともいえぬ</seg><ruby type="furigana" rend="right" source="#source-600687-600705"><rb>朗</rb><rt>ほがら</rt></ruby><seg source="#source-600705-600711">かな</seg><ruby type="furigana" rend="right" source="#source-600711-600732"><rb>気持</rb><rt>きもち</rt></ruby><seg source="#source-600732-600765">になりました。それに一</seg><ruby type="furigana" rend="right" source="#source-600765-600780"><rb>歩</rb><rt>ぽ</rt></ruby><seg source="#source-600780-600783">一</seg><ruby type="furigana" rend="right" source="#source-600783-600798"><rb>歩</rb><rt>ぽ</rt></ruby><seg source="#source-600798-600801">と</seg><ruby type="furigana" rend="right" source="#source-600801-600816"><rb>川</rb><rt>かわ</rt></ruby><seg source="#source-600816-600819">の</seg><ruby type="furigana" rend="right" source="#source-600819-600846"><rb>両岸</rb><rt>りょうがん</rt></ruby><seg source="#source-600846-600864">がのんびりと</seg><ruby type="furigana" rend="right" source="#source-600864-600879"><rb>開</rb><rt>ひら</rt></ruby><seg source="#source-600879-600885">けて</seg><ruby type="furigana" rend="right" source="#source-600885-600897"><rb>行</rb><rt>ゆ</rt></