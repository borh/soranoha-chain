furigana" rend="right" source="#source-693943-693958"><rb>陸</rb><rt>おか</rt></ruby><seg source="#source-693958-693964">に一</seg><ruby type="furigana" rend="right" source="#source-693964-693982"><rb>軒</rb><rt>けん</rt></ruby><seg source="#source-693982-693985">の</seg><ruby type="furigana" rend="right" source="#source-693985-694006"><rb>人家</rb><rt>じんか</rt></ruby><seg source="#source-694006-694009">も</seg><ruby type="furigana" rend="right" source="#source-694009-694021"><rb>見</rb><rt>み</rt></ruby><seg source="#source-694021-694036">えないのが</seg><ruby type="furigana" rend="right" source="#source-694036-694057"><rb>現世</rb><rt>げんせ</rt></ruby><seg source="#source-694057-694060">と</seg><ruby type="furigana" rend="right" source="#source-694060-694075"><rb>異</rb><rt>ちが</rt></ruby><seg source="#source-694075-694087">っている</seg><ruby type="furigana" rend="right" source="#source-694087-694102"><rb>点</rb><rt>てん</rt></ruby><seg source="#source-694102-694117">で、それが</seg><ruby type="furigana" rend="right" source="#source-694117-694129"><rb>為</rb><rt>た</rt></ruby><seg source="#source-694129-694135">めに</seg><ruby type="furigana" rend="right" source="#source-694135-694150"><rb>何</rb><rt>なに</rt></ruby><seg source="#source-694150-694156">やら</seg><ruby type="furigana" rend="right" source="#source-694156-694180"><rb>全体</rb><rt>ぜんたい</rt></ruby><seg source="#source-694180-694183">の</seg><ruby type="furigana" rend="right" source="#source-694183-694204"><rb>景色</rb><rt>けしき</rt></ruby><seg source="#source-694204-694207">に</seg><ruby type="furigana" rend="right" source="#source-694207-694237"><rb>夢幻</rb><rt>ゆめまぼろし</rt></ruby><seg source="#source-694237-694240">に</seg><ruby type="furigana" rend="right" source="#source-694240-694255"><rb>近</rb><rt>ちか</rt></ruby><seg source="#source-694255-694258">い</seg><ruby type="furigana" rend="right" source="#source-694258-694273"><rb>感</rb><rt>かん</rt></ruby><seg source="#source-694273-694279">じを</seg><ruby type="furigana" rend="right" source="#source-694279-694294"><