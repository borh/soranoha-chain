</ruby><seg source="#source-660625-660628">に</seg><ruby type="furigana" rend="right" source="#source-660628-660652"><rb>神様</rb><rt>かみさま</rt></ruby><seg source="#source-660652-660658">から</seg><ruby type="furigana" rend="right" source="#source-660658-660685"><rb>修行</rb><rt>しゅぎょう</rt></ruby><ruby type="furigana" rend="right" source="#source-660685-660715"><rb>終了</rb><rt>しゅうりょう</rt></ruby><seg source="#source-660715-660718">の</seg><ruby type="furigana" rend="right" source="#source-660718-660733"><rb>仰</rb><rt>おお</rt></ruby><seg source="#source-660733-660739">せを</seg><ruby type="furigana" rend="right" source="#source-660739-660757"><rb>戴</rb><rt>いただ</rt></ruby><seg source="#source-660757-660787">いたのでございます。</seg><ruby type="furigana" rend="right" source="#source-660787-660808"><rb>同時</rb><rt>どうじ</rt></ruby><seg source="#source-660808-660811">に</seg><ruby type="furigana" rend="right" source="#source-660811-660832"><rb>現世</rb><rt>げんせ</rt></ruby><seg source="#source-660832-660835">の</seg><ruby type="furigana" rend="right" source="#source-660835-660850"><rb>方</rb><rt>ほう</rt></ruby><seg source="#source-660850-660865">ではすでに</seg><ruby type="furigana" rend="right" source="#source-660865-660886"><rb>私</rb><rt>わたくし</rt></ruby><seg source="#source-660886-660889">の</seg><ruby type="furigana" rend="right" source="#source-660889-660901"><rb>為</rb><rt>た</rt></ruby><seg source="#source-660901-660907">めに</seg><ruby type="furigana" rend="right" source="#source-660907-660922"><rb>一</rb><rt>ひと</rt></ruby><seg source="#source-660922-660928">つの</seg><ruby type="furigana" rend="right" source="#source-660928-660952"><rb>神社</rb><rt>じんじゃ</rt></ruby><seg source="#source-660952-660955">が</seg><ruby type="furigana" rend="right" source="#source-660955-660982"><rb>建立</rb><rt>こんりゅう</rt></ruby><seg source="#source-660982-660991">されて</seg><ruby type="furigana" rend="right" source="#source-660991-661003"><rb>居</rb><rt>お</rt></ruby><seg source="#source-661003-661009">り、</seg><ruby type="furigana" rend="right" source="#source-661009-661030"><rb>私</rb><rt>わたくし</rt></ruby><seg source="#source-661030-661033">は</seg><ruby type="furigana" rend="right" source="#source-661033-661045"><rb>間</rb><rt>ま</rt></ruby><seg source="#source-661045-661060">もなくこの</seg><ruby type="furigana" rend="right" source="#source-661060-661093"><rb>修行場</rb><rt>しゅぎょうば</rt></ruby><seg source="#source-661093-661105">からその</seg><ruby type="furigana" rend="right" source="#source-661105-661129"><rb>神社</rb><rt>じんじゃ</rt></ruby><seg source="#source-661129-661132">の</seg><ruby type="furigana" rend="right" source="#source-661132-661147"><rb>方</rb><rt>ほう</rt></ruby><seg source="#source-661147-661153">へと</seg><ruby type="furigana" rend="right" source="#source-661153-661177"><rb>引移</rb><rt>ひきうつ</rt></ruby><seg source="#source-661177-661224">ることになったのでございます。</seg></p>
        <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-661224-661426"><seg source="#source-661224-661236">それに</seg><ruby type="furigana" rend="right" source="#source-661236-661248"><rb>就</rb><rt>つ</rt></ruby><seg source="#source-661248-661257">きての</seg><ruby type="furigana" rend="right" source="#source-661257-661281"><rb>経緯</rb><rt>いきさつ</rt></ruby><seg source="#source-661281-661284">は</seg><ruby type="furigana" rend="right" source="#source-661284-661299"><rb>何</rb><rt>いず</rt></ruby><seg source="#source-661299-661302">れ</seg><ruby type="furigana" rend="right" source="#source-661302-661320"><rb>改</rb><rt>あらた</rt></ruby><seg source="#source-661320-661332">めてこの</seg><ruby type="furigana" rend="right" source="#source-661332-661344"><rb>次</rb><rt>つ</rt></ruby><seg source="#source-661344-661350">ぎに</seg><ruby type="furigana" rend="right" source="#source-661350-661374"><rb>申上</rb><rt>もうしあ</rt></ruby><seg source="#source-661374-661389">げることに</seg><ruby type="furigana" rend="right" source="#source-661389-661404"><rb>致</rb><rt>いた</rt></ruby><seg source="#source-661404-661426">しましょう。</seg></p>
