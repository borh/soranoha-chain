ource-468140-468143">を</seg><ruby type="furigana" rend="right" source="#source-468143-468164"><rb>看破</rb><rt>かんぱ</rt></ruby><seg source="#source-468164-468170">して</seg><ruby type="furigana" rend="right" source="#source-468170-468185"><rb>了</rb><rt>しま</rt></ruby><seg source="#source-468185-468197">います。</seg><ruby type="furigana" rend="right" source="#source-468197-468221"><rb>大体</rb><rt>だいたい</rt></ruby><seg source="#source-468221-468224">に</seg><ruby type="furigana" rend="right" source="#source-468224-468239"><rb>於</rb><rt>おい</rt></ruby><seg source="#source-468239-468242">て</seg><ruby type="furigana" rend="right" source="#source-468242-468257"><rb>申</rb><rt>もう</rt></ruby><seg source="#source-468257-468272">しますと、</seg><ruby type="furigana" rend="right" source="#source-468272-468293"><rb>天狗</rb><rt>てんぐ</rt></ruby><seg source="#source-468293-468296">の</seg><ruby type="furigana" rend="right" source="#source-468296-468323"><rb>正体</rb><rt>しょうたい</rt></ruby><seg source="#source-468323-468326">は</seg><ruby type="furigana" rend="right" source="#source-468326-468350"><rb>人間</rb><rt>にんげん</rt></ruby><seg source="#source-468350-468359">よりは</seg><ruby type="furigana" rend="right" source="#source-468359-468374"><rb>少</rb><rt>すこ</rt></ruby><seg source="#source-468374-468377">し</seg><ruby type="furigana" rend="right" source="#source-468377-468392"><rb>大</rb><rt>おお</rt></ruby><seg source="#source-468392-468410">きく、そして</seg><ruby type="furigana" rend="right" source="#source-468410-468434"><rb>人間</rb><rt>にんげん</rt></ruby><seg source="#source-468434-468443">よりは</seg><ruby type="furigana" rend="right" source="#source-468443-468458"><rb>寧</rb><rt>むし</rt></ruby><seg source="#source-468458-468461">ろ</seg><ruby type="furigana" rend="right" source="#source-468461-468479"><rb>獣</rb><rt>けもの</rt></ruby><seg source="#source-468479-468482">に</seg><ruby type="furigana" rend="right" source="#source-468482-468494"><rb>似</rb><rt>に</rt></ruby><seg source="#source-468494-468497">て</seg><ruby type="furigana" rend="right" source="#source-468497-468509"><rb>居</rb><rt>お</rt></ruby><seg source="#source-468509-468515">り、</seg><ruby type="furigana" rend="right" source="#source-468515-468536"><rb>普通</rb><rt>ふつう</rt></ruby><ruby type="furigana" rend="right" source="#source-468536-468560"><rb>全身</rb><rt>ぜんしん</rt></ruby><seg source="#source-468560-468563">が</seg><ruby type="furigana" rend="right" source="#source-468563-468575"><rb>毛</rb><rt>け</rt></ruby><seg source="#source-468575-468605">だらけでございます。</seg><ruby type="furigana" rend="right" source="#source-468605-468626"><rb>天狗</rb><rt>てんぐ</rt></ruby><seg source="#source-468626-468629">の</seg><ruby type="furigana" rend="right" source="#source-468629-468644"><rb>中</rb><rt>なか</rt></ruby><seg source="#source-468644-468659">のごくごく</seg><ruby type="furigana" rend="right" source="#source-468659-468686"><rb>上等</rb><rt>じょうとう</rt></ruby><seg source="#source-468686-468704">のもののみが</seg><ruby type="furigana" rend="right" source="#source-468704-468728"><rb>人間</rb><rt>にんげん</rt></ruby><seg source="#source-468728-468731">に</seg><ruby type="furigana" rend="right" source="#source-468731-468746"><rb>近</rb><rt>ちか</rt></ruby><seg source="#source-468746-468749">い</seg><ruby type="furigana" rend="right" source="#source-468749-468767"><rb>姿</rb><rt>すがた</rt></ruby><seg source="#source-468767-468776">をして</seg><ruby type="furigana" rend="right" source="#source-468776-468788"><rb>居</rb><rt>お</rt></ruby><seg source="#source-468788-468817">りますようで……。</seg></p>
        <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-468817-469521"><ruby type="furigana" rend="right" source="#source-468820-468835"><rb>但</rb><rt>ただ</rt></ruby><seg source="#source-468835-468847">しこれは</seg><ruby type="furigana" rend="right" source="#source-468847-468865"><rb>姿</rb><rt>すがた</rt></ruby><seg source="#source-468865-468874">のある</seg><ruby type="furigana" rend="right" source="#source-468874-468895"><rb>天狗</rb><rt>てんぐ</rt></ruby><seg source="#source-468895-468898">に</seg><ruby type="furigana" rend="right" source="#source-468898-468910"><rb>就</rb><rt>つ</rt></ruby><seg source="#source-468910-468916">いて</seg><ruby type="furigana" rend="right" source="#source-468916-468931"><rb>申</rb><rt>もう</rt></ruby><seg source="#source-468931-468961">したのでございます。</seg><ruby type="furigana" rend="right" source="#source-468961-468982"><rb>天狗</rb><rt>てんぐ</rt></ruby><seg source="#source-468982-468985">の</seg><ruby type="furigana" rend="right" source="#source-468985-469000"><rb>中</rb><rt>なか</rt></ruby><seg source="#source-469000-469006">には</seg><ruby type="furigana" rend="right" source="#source-469006-469024"><rb>姿</rb><rt>すがた</rt></ruby><seg source="#source-469024-469027">を</seg><ruby type="furigana" rend="right" source="#source-469027-469039"><rb>有</rb><rt>も</rt></ruby><seg source="#source-469039-469081">たないのもございます。それは</seg><ruby type="furigana" rend="right" source="#source-469081-469102"><rb>青味</rb><rt>あおみ</rt></ruby><seg source="#source-469102-469114">がかった</seg><ruby type="furigana" rend="right" source="#source-469114-469129"><rb>丸</rb><rt>まる</rt></ruby><seg source="#source-469129-469132">い</seg><ruby type="furigana" rend="right" source="#source-469132-469147"><rb>魂</rb><rt>たま</rt></ruby><seg source="#source-469147-469153">で、</seg><ruby type="furigana" rend="right" source="#source-469153-469180"><rb>直径</rb><rt>ちょくけい</rt></ruby><seg source="#source-469180-469186">は三</seg><ruby type="furigana" rend="right" source="#source-469186-469204"><rb>寸</rb><rt>