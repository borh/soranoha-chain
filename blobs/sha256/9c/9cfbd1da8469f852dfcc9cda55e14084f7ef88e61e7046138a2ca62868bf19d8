        <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-77769-77876"><seg source="#source-77769-77778">きり</seg><choice source="#source-77778-77784"><orig>／＼</orig><reg>〱</reg></choice><seg source="#source-77784-77790">と、</seg><ruby type="furigana" rend="right" source="#source-77790-77805"><rb>鳥</rb><rt>とり</rt></ruby><seg source="#source-77805-77808">の</seg><ruby type="furigana" rend="right" source="#source-77808-77826"><rb>形</rb><rt>かたち</rt></ruby><seg source="#source-77826-77829">は</seg><ruby type="furigana" rend="right" source="#source-77829-77847"><rb>柱</rb><rt>はしら</rt></ruby><seg source="#source-77847-77850">を</seg><ruby type="furigana" rend="right" source="#source-77850-77865"><rb>繞</rb><rt>めぐ</rt></ruby><seg source="#source-77865-77876">つた。</seg></p>
        <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-77876-77923"><ruby type="furigana" rend="right" source="#source-77879-77891"><rb>其</rb><rt>そ</rt></ruby><seg source="#source-77891-77894">の</seg><ruby type="furigana" rend="right" source="#source-77894-77912"><rb>女</rb><rt>をんな</rt></ruby><seg source="#source-77912-77923">は――</seg></p>
        <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-77923-78040"><seg source="#source-77923-77932">――</seg><ruby type="furigana" rend="right" source="#source-77932-77947"><rb>此</rb><rt>これ</rt></ruby><seg source="#source-77947-77950">に</seg><ruby type="furigana" rend="right" source="#source-77950-77962"><rb>就</rb><rt>つ</rt></ruby><seg source="#source-77962-77971">いて、</seg><ruby type="furigana" rend="right" source="#source-77971-77986"><rb>別</rb><rt>べつ</rt></ruby><seg source="#source-77986-77989">に</seg><ruby type="furigana" rend="right" source="#source-77989-78016"><rb>物語</rb><rt>ものがたり</rt></ruby><seg source="#source-78016-78040">があるのである。</seg></p>
