        <p source="#source-61540-61584"><seg source="#source-61540-61546">花の</seg><ruby type="furigana" rend="right" source="#source-61546-61564"><rb>台</rb><rt>うてな</rt></ruby><seg source="#source-61564-61584">に泣きまどふ</seg></p>
