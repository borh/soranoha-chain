        <p source="#source-36326-36373"><seg source="#source-36326-36335">こゝに</seg><ruby type="furigana" rend="right" source="#source-36335-36350"><rb>永</rb><rt>なが</rt></ruby><seg source="#source-36350-36373">きあり遠きあり</seg></p>
