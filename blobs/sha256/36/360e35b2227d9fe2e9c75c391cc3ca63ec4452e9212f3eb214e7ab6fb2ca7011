        <p source="#source-61044-61091"><seg source="#source-61044-61062">春を得知らぬ</seg><ruby type="furigana" rend="right" source="#source-61062-61083"><rb>処女</rb><rt>をとめ</rt></ruby><seg source="#source-61083-61091">さへ</seg></p>
        <p source="#source-61091-61129"><seg source="#source-61091-61129">かのうぐひすのひとこゑに</seg></p>
        <p source="#source-61129-61158"><seg source="#source-61129-61158">枕の紙のしめりきて</seg></p>
        <p source="#source-61158-61193"><seg source="#source-61158-61193">人なつかしきおもひあり</seg></p>
