        <p source="#source-62223-62279"><seg source="#source-62223-62235">さみしき</seg><ruby type="furigana" rend="right" source="#source-62235-62250"><rb>蘆</rb><rt>あし</rt></ruby><seg source="#source-62250-62253">の</seg><ruby type="furigana" rend="right" source="#source-62253-62274"><rb>湖</rb><rt>みづうみ</rt></ruby><seg source="#source-62274-62279">の</seg></p>
        <p source="#source-62279-62320"><seg source="#source-62279-62294">沈める水に</seg><ruby type="furigana" rend="right" source="#source-62294-62306"><rb>映</rb><rt>う</rt></ruby><seg source="#source-62306-62320">つるとき</seg></p>
        <p source="#source-62320-62352"><seg source="#source-62320-62352">名もなき賤の片びさし</seg></p>
        <p source="#source-62352-62381"><seg source="#source-62352-62381">春の夜風の音を絶え</seg></p>
        <p source="#source-62381-62410"><seg source="#source-62381-62410">村の南のかたほとり</seg></p>
        <p source="#source-62410-62451"><seg source="#source-62410-62428">その夜生れし</seg><ruby type="furigana" rend="right" source="#source-62428-62440"><rb>牝</rb><rt>め</rt></ruby><seg source="#source-62440-62451">の馬は</seg></p>
