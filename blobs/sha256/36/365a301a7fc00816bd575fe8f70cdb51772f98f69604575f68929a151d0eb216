    <body>
      <p><seg source="#source-244-253">だれが</seg><ruby type="furigana" rend="right" source="#source-253-268"><rb>山</rb><rt>やま</rt></ruby><seg source="#source-268-280">でらっぱ</seg><ruby type="furigana" rend="right" source="#source-280-292"><rb>吹</rb><rt>ふ</rt></ruby><seg source="#source-292-300">く、</seg></p>
      <p><ruby type="furigana" rend="right" source="#source-300-315"><rb>青</rb><rt>あお</rt></ruby><seg source="#source-315-318">い</seg><ruby type="furigana" rend="right" source="#source-318-333"><rb>空</rb><rt>そら</rt></ruby><seg source="#source-333-339">から</seg><ruby type="furigana" rend="right" source="#source-339-354"><rb>月</rb><rt>つき</rt></ruby><seg source="#source-354-357">が</seg><ruby type="furigana" rend="right" source="#source-357-369"><rb>出</rb><rt>で</rt></ruby><seg source="#source-369-379">る。</seg></p>
      <p><seg source="#source-379-388">だれが</seg><ruby type="furigana" rend="right" source="#source-388-400"><rb>野</rb><rt>の</rt></ruby><seg source="#source-400-403">で</seg><ruby type="furigana" rend="right" source="#source-403-424"><rb>太鼓</rb><rt>たいこ</rt></ruby><ruby type="furigana" rend="right" source="#source-424-436"><rb>打</rb><rt>う</rt></ruby><seg source="#source-436-444">つ、</seg></p>
      <p><ruby type="furigana" rend="right" source="#source-444-459"><rb>広</rb><rt>ひろ</rt></ruby><seg source="#source-459-462">い</seg><ruby type="furigana" rend="right" source="#source-462-477"><rb>畑</rb><rt>はた</rt></ruby><seg source="#source-477-483">から</seg><ruby type="furigana" rend="right" source="#source-483-498"><rb>月</rb><rt>つき</rt></ruby><seg source="#source-498-501">が</seg><ruby type="furigana" rend="right" source="#source-501-513"><rb>出</rb><rt>で</rt></ruby><seg source="#source-513-523">る。</seg></p>
      <p><seg source="#source-523-532">だれが</seg><ruby type="furigana" rend="right" source="#source-532-547"><rb>海</rb><rt>うみ</rt></ruby><seg source="#source-547-550">で</seg><ruby type="furigana" rend="right" source="#source-550-565"><rb>笛</rb><rt>ふえ</rt></ruby><seg source="#source-565-568">を</seg><ruby type="furigana" rend="right" source="#source-568-580"><rb>吹</rb><rt>ふ</rt></ruby><seg source="#source-580-588">く、</seg></p>
      <p><ruby type="furigana" rend="right" source="#source-588-603"><rb>波</rb><rt>なみ</rt></ruby><seg source="#source-603-606">の</seg><ruby type="furigana" rend="right" source="#source-606-621"><rb>中</rb><rt>なか</rt></ruby><seg source="#source-621-627">から</seg><ruby type="furigana" rend="right" source="#source-627-642"><rb>月</rb><rt>つき</rt></ruby><seg source="#source-642-658">がでる。</seg></p>
      <p><seg source="#source-658-667">だれが</seg><ruby type="furigana" rend="right" source="#source-667-682"><rb>町</rb><rt>まち</rt></ruby><seg source="#source-682-685">で</seg><ruby type="furigana" rend="right" source="#source-685-700"><rb>歌</rb><rt>うた</rt></ruby><seg source="#source-700-714">うたう、</seg></p>
      <p><ruby type="furigana" rend="right" source="#source-714-729"><rb>月</rb><rt>つき</rt></ruby><seg source="#source-729-747">がまんまるく</seg><ruby type="furigana" rend="right" source="#source-747-759"><rb>照</rb><rt>て</rt></ruby><seg source="#source-759-777">らしている。</seg></p>
    </body>
