        <p source="#source-65007-65060"><seg source="#source-65007-65022">風は胡蝶の</seg><ruby type="furigana" rend="right" source="#source-65022-65040"><rb>羽翼</rb><rt>はね</rt></ruby><seg source="#source-65040-65043">を</seg><ruby type="furigana" rend="right" source="#source-65043-65055"><rb>裂</rb><rt>さ</rt></ruby><seg source="#source-65055-65060">き</seg></p>
        <p source="#source-65060-65125"><seg source="#source-65060-65066">霜は</seg><ruby type="furigana" rend="right" source="#source-65066-65084"><rb>猿</rb><rt>ましら</rt></ruby><seg source="#source-65084-65087">の</seg><ruby type="furigana" rend="right" source="#source-65087-65102"><rb>食</rb><rt>かて</rt></ruby><seg source="#source-65102-65105">を</seg><ruby type="furigana" rend="right" source="#source-65105-65120"><rb>奪</rb><rt>うば</rt></ruby><seg source="#source-65120-65125">ひ</seg></p>
        <p source="#source-65125-65184"><seg source="#source-65125-65128">秋</seg><ruby type="furigana" rend="right" source="#source-65128-65143"><rb>老</rb><rt>お</rt></ruby><seg source="#source-65143-65155">いにける</seg><ruby type="furigana" rend="right" source="#source-65155-65179"><rb>朝毎</rb><rt>あさごと</rt></ruby><seg source="#source-65179-65184">に</seg></p>
