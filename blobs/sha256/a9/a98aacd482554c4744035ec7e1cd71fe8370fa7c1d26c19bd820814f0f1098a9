        <p source="#source-50185-50220"><seg source="#source-50185-50220">まろねの袖をかたしきて</seg></p>
        <p source="#source-50220-50255"><seg source="#source-50220-50255">月はさせども身じろがず</seg></p>
        <p source="#source-50255-50292"><seg source="#source-50255-50292">花は散れどもさめずして</seg></p>
        <p source="#source-50292-50351"><ruby type="furigana" rend="right" source="#source-50292-50322"><rb>若紫</rb><rt>わかむらさき</rt></ruby><seg source="#source-50322-50325">の</seg><ruby type="furigana" rend="right" source="#source-50325-50340"><rb>房</rb><rt>ふさ</rt></ruby><seg source="#source-50340-50351">ながき</seg></p>
        <p source="#source-50351-50392"><seg source="#source-50351-50366">籠の鸚鵡も</seg><ruby type="furigana" rend="right" source="#source-50366-50378"><rb>餌</rb><rt>え</rt></ruby><seg source="#source-50378-50392">を呼ばで</seg></p>
        <p source="#source-50392-50448"><seg source="#source-50392-50398">苑に</seg><ruby type="furigana" rend="right" source="#source-50398-50413"><rb>對</rb><rt>むか</rt></ruby><seg source="#source-50413-50419">へる</seg><ruby type="furigana" rend="right" source="#source-50419-50443"><rb>渡殿</rb><rt>わたどの</rt></ruby><seg source="#source-50443-50448">の</seg></p>
