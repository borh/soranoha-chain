        <p source="#source-70396-70413"><seg source="#source-70396-70413">空も水なる</seg></p>
        <p style="text-indent: 2em" rend="first-line-indent(2)" source="#source-70413-70448"><ruby type="furigana" rend="right" source="#source-70419-70443"><rb>大海</rb><rt>わだつみ</rt></ruby><seg source="#source-70443-70448">に</seg></p>
        <p source="#source-70448-70477"><seg source="#source-70448-70454">わが</seg><ruby type="furigana" rend="right" source="#source-70454-70466"><rb>漕</rb><rt>こ</rt></ruby><seg source="#source-70466-70477">ぐ舟を</seg></p>
        <p style="text-indent: 2em" rend="first-line-indent(2)" source="#source-70477-70514"><seg source="#source-70477-70489">誰か</seg><ruby type="furigana" rend="right" source="#source-70489-70507"><rb>遮</rb><rt>さへぎ</rt></ruby><seg source="#source-70507-70514">る</seg></p>
