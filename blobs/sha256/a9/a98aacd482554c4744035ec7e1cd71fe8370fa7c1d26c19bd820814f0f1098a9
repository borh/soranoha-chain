      <div>
        <p source="#source-66739-66756"><seg source="#source-66739-66756">花なる人の</seg></p>
        <p style="text-indent: 2em" rend="first-line-indent(2)" source="#source-66756-66779"><seg source="#source-66756-66779">こひしとて</seg></p>
        <p source="#source-66779-66799"><seg source="#source-66779-66799">月に泣いたは</seg></p>
        <p style="text-indent: 2em" rend="first-line-indent(2)" source="#source-66799-66824"><seg source="#source-66799-66824">夢なるもの</seg></p>
        <p source="#source-66824-66856"><seg source="#source-66824-66830">たて</seg><ruby type="furigana" rend="right" source="#source-66830-66848"><rb>綻</rb><rt>ほころ</rt></ruby><seg source="#source-66848-66856">びし</seg></p>
        <p style="text-indent: 2em" rend="first-line-indent(2)" source="#source-66856-66879"><seg source="#source-66856-66879">ころも手に</seg></p>
        <p source="#source-66879-66893"><seg source="#source-66879-66893">涙の痕の</seg></p>
        <p style="text-indent: 2em" rend="first-line-indent(2)" source="#source-66893-66918"><seg source="#source-66893-66918">しるくとも</seg></p>
        <p source="#source-66918-66941"><seg source="#source-66918-66941">うき世にあさき</seg></p>
        <p style="text-indent: 2em" rend="first-line-indent(2)" source="#source-66941-66961"><seg source="#source-66941-66961">我なれば</seg></p>
        <p source="#source-66961-66981"><seg source="#source-66961-66981">君もさのみは</seg></p>
        <p style="text-indent: 2em" rend="first-line-indent(2)" source="#source-66981-67003"><seg source="#source-66981-67003">とがめじ</seg></p>
        <p source="#source-67003-67026"><seg source="#source-67003-67026">――花なる人の</seg></p>
        <p style="text-indent: 2em" rend="first-line-indent(2)" source="#source-67026-67046"><seg source="#source-67026-67046">戀しとて</seg></p>
        <p source="#source-67046-67066"><seg source="#source-67046-67066">月に泣いたは</seg></p>
        <p style="text-indent: 2em" rend="first-line-indent(2)" source="#source-67066-67100"><seg source="#source-67066-67100">ゆめなるもの――</seg></p>
        <p source="#source-67100-67126"><seg source="#source-67100-67126">つらけれど、紅葉</seg></p>
        <p style="text-indent: 2em" rend="first-line-indent(2)" source="#source-67126-67155"><seg source="#source-67126-67155">綾なす葦穗ろの</seg></p>
        <p source="#source-67155-67169"><seg source="#source-67155-67169">麓に今は</seg></p>
        <p style="text-indent: 2em" rend="first-line-indent(2)" source="#source-67169-67191"><seg source="#source-67169-67191">歸らうよ</seg></p>
        <p source="#source-67191-67208"><seg source="#source-67191-67208">破れ太鼓は</seg></p>
        <p style="text-indent: 2em" rend="first-line-indent(2)" source="#source-67208-67234"><seg source="#source-67208-67234">叩けどならぬ</seg></p>
        <p source="#source-67234-67248"><seg source="#source-67234-67248">落る涙を</seg></p>
        <p style="text-indent: 2em" rend="first-line-indent(2)" source="#source-67248-67268"><seg source="#source-67248-67268">知るや君</seg></p>
        <p style="text-indent: 2em" rend="first-line-indent(2)" source="#source-67268-67301"><seg source="#source-67268-67301">～～～～～～～</seg></p>
