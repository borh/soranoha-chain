        <p source="#source-49700-49753"><ruby type="furigana" rend="right" source="#source-49700-49715"><rb>瑤</rb><rt>たま</rt></ruby><seg source="#source-49715-49718">の</seg><ruby type="furigana" rend="right" source="#source-49718-49736"><rb>臺</rb><rt>うてな</rt></ruby><seg source="#source-49736-49753">に咲き纏ふ</seg></p>
        <p source="#source-49753-49797"><seg source="#source-49753-49759">花や</seg><ruby type="furigana" rend="right" source="#source-49759-49777"><rb>栞</rb><rt>しをり</rt></ruby><seg source="#source-49777-49797">をおほふらん</seg></p>
