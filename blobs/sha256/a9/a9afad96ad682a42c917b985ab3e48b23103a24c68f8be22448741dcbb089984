seg source="#source-125675-125687">退散之次</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-125687-125699">一</note><seg source="#source-125699-125726">、数宇之住宅悉焼‐</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-125726-125738">二</note><seg source="#source-125738-125744">払之</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-125744-125756">一</note><seg source="#source-125756-125822">条、狼藉之至、先代未聞之珍事也。仍寺家一同有</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-125822-125834">二</note><seg source="#source-125834-125843">其沙汰</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-125843-125855">一</note><seg source="#source-125855-125861">。至</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-125861-125873">二</note><seg source="#source-125873-125888">非人之党類</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-125888-125900">一</note><seg source="#source-125900-125912">者、永不</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-125912-125924">レ</note><seg source="#source-125924-125927">可</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-125927-125939">レ</note><seg source="#source-125939-125945">入‐</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-125945-125957">二</note><seg source="#source-125957-125963">立庄</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-125963-125975">一</note><seg source="#source-125975-126014">之由、其沙汰一揆畢。其間於</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-126014-126026">二</note><seg source="#source-126026-126050">当寺領之諸国諸庄</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-126050-126062">一</note><seg source="#source-126062-126071">者、可</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-126071-126083">レ</note><seg source="#source-126083-126086">令</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-126086-126098">レ</note><seg source="#source-126098-126104">停‐</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-126104-126116">二</note><seg source="#source-126116-126125">止乞場</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-126125-126137">一</note><seg source="#source-126137-126173">之由、衆議事切了。庄家存</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-126173-126185">二</note><seg source="#source-126185-126191">此旨</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-126191-126203">一</note><seg source="#source-126203-126209">、任</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-126209-126221">二</note><seg source="#source-126221-126230">下知旨</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-126230-126242">一</note><seg source="#source-126242-126248">、可</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-126248-126260">レ</note><seg source="#source-126260-126263">致</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-126263-126275">二</note><seg source="#source-126275-126284">其沙汰</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-126284-126296">一</note><seg source="#source-126296-126308">之状、依</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-126308-126320">二</note><seg source="#source-126320-126326">衆議</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-126326-126338">一</note><seg source="#source-126338-126347">下知如</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-126347-126359">レ</note><seg source="#source-126359-126367">件。</seg></p>
