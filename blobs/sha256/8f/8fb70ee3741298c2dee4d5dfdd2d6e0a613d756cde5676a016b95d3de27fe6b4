6-6857"><rb>袖子</rb><rt>そでこ</rt></ruby><seg source="#source-6857-6860">の</seg><ruby type="furigana" rend="right" source="#source-6860-6872"><rb>言</rb><rt>い</rt></ruby><seg source="#source-6872-6914">うなりになった。どうしてあの</seg><ruby type="furigana" rend="right" source="#source-6914-6929"><rb>少</rb><rt>すこ</rt></ruby><seg source="#source-6929-6983">しもじっとしていないで、どうかすると</seg><ruby type="furigana" rend="right" source="#source-6983-7004"><rb>袖子</rb><rt>そでこ</rt></ruby><seg source="#source-7004-7007">の</seg><ruby type="furigana" rend="right" source="#source-7007-7019"><rb>手</rb><rt>て</rt></ruby><seg source="#source-7019-7043">におえないことが</seg><ruby type="furigana" rend="right" source="#source-7043-7058"><rb>多</rb><rt>おお</rt></ruby><seg source="#source-7058-7067">かった</seg><ruby type="furigana" rend="right" source="#source-7067-7088"><rb>光子</rb><rt>みつこ</rt></ruby><seg source="#source-7088-7097">さんを</seg><ruby type="furigana" rend="right" source="#source-7097-7112"><rb>遊</rb><rt>あそ</rt></ruby><seg source="#source-7112-7127">ばせるとは</seg><ruby type="furigana" rend="right" source="#source-7127-7151"><rb>大違</rb><rt>おおちが</rt></ruby><seg source="#source-7151-7160">いだ。</seg><ruby type="furigana" rend="right" source="#source-7160-7181"><rb>袖子</rb><rt>そでこ</rt></ruby><seg source="#source-7181-7184">は</seg><ruby type="furigana" rend="right" source="#source-7184-7211"><rb>人形</rb><rt>にんぎょう</rt></ruby><seg source="#source-7211-7214">を</seg><ruby type="furigana" rend="right" source="#source-7214-7226"><rb>抱</rb><rt>だ</rt></ruby><seg source="#source-7226-7238">くように</seg><ruby type="furigana" rend="right" source="#source-7238-7268"><rb>金之助</rb><rt>きんのすけ</rt></ruby><seg source="#source-7268-7277">さんを</seg><ruby type="furigana" rend="right" source="#source-7277-7289"><rb>抱</rb><rt>だ</rt></ruby><seg source="#source-7289-7313">いて、どこへでも</seg><ruby type="furigana" rend="right" source="#source-7313-7325"><rb>好</rb><rt>す</rt></ruby><seg source="#source-7325-7343">きなところへ</seg><ruby type="furigana" rend="right" sourc