9475-39490"><rb>倒</rb><rt>たふ</rt></ruby><seg source="#source-39490-39511">れかゝつたのも</seg><ruby type="furigana" rend="right" source="#source-39511-39529"><rb>殆</rb><rt>ほとん</rt></ruby><seg source="#source-39529-39532">ど</seg><ruby type="furigana" rend="right" source="#source-39532-39547"><rb>同</rb><rt>おな</rt></ruby><seg source="#source-39547-39550">じ</seg><ruby type="furigana" rend="right" source="#source-39550-39571"><rb>時刻</rb><rt>じこく</rt></ruby><seg source="#source-39571-39583">である。</seg><ruby type="furigana" rend="right" source="#source-39583-39601"><rb>娘</rb><rt>むすめ</rt></ruby><seg source="#source-39601-39604">も</seg><ruby type="furigana" rend="right" source="#source-39604-39622"><rb>其處</rb><rt>そこ</rt></ruby><seg source="#source-39622-39625">に</seg><ruby type="furigana" rend="right" source="#source-39625-39646"><rb>按摩</rb><rt>あんま</rt></ruby><seg source="#source-39646-39649">も</seg><ruby type="furigana" rend="right" source="#source-39649-39670"><rb>彼處</rb><rt>かしこ</rt></ruby><seg source="#source-39670-39681">に――</seg></p>
        <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-39681-40163"><ruby type="furigana" rend="right" source="#source-39684-39696"><rb>其</rb><rt>そ</rt></ruby><seg source="#source-39696-39699">の</seg><ruby type="furigana" rend="right" source="#source-39699-39729"><rb>大地震</rb><rt>おほぢしん</rt></ruby><seg source="#source-39729-39741">を、あの</seg><ruby type="furigana" rend="right" source="#source-39741-39756"><rb>時</rb><rt>とき</rt></ruby><ruby type="furigana" rend="right" source="#source-39756-39771"><rb>既</rb><rt>すで</rt></ruby><seg source="#source-39771-39777">に、</seg><ruby type="furigana" rend="right" source="#source-39777-39801"><rb>不氣味</rb><rt>ぶきみ</rt></ruby><seg source="#source-39801-39804">に</seg><ruby type="furigana" rend="right" source="#source-39804-39825"><rb>按摩</rb><rt>あんま</rt></ruby><seg source="#source-39825-39828">は</seg><ruby type="furigana" rend="right" source="#source-39828-39849"><rb>豫覺</rb><rt>よかく</rt></ruby><seg source="#source-39849-39879">したるにあらざるか。</seg><ruby type="furigana" rend="right" source="#source-39879-39894"><rb>然</rb><rt>しか</rt></ruby><seg source="#source-39894-39900">らば</seg><ruby type="furigana" rend="right" source="#source-39900-39939"><rb>八千八聲</rb><rt>はつせんやこゑ</rt></ruby><seg source="#source-39939-39942">を</seg><ruby type="furigana" rend="right" source="#source-39942-39954"><rb>泣</rb><rt>な</rt></ruby><seg source="#source-39954-39969">きつゝも、</seg><ruby type="furigana" rend="right" source="#source-39969-39993"><rb>生命</rb><rt>せいめい</rt></ruby><seg source="#source-39993-40002">だけは</seg><ruby type="furigana" rend="right" source="#source-40002-40017"><rb>助</rb><rt>たす</rt></ruby><seg source="#source-40017-40035">かつたらう。</seg><ruby type="furigana" rend="right" source="#source-40035-40050"><rb>衣</rb><rt>きぬ</rt></ruby><seg source="#source-40050-40053">を</seg><ruby type="furigana" rend="right" source="#source-40053-40068"><rb>洗</rb><rt>あら</rt></ruby><seg source="#source-40068-40074">ひし</seg><ruby type="furigana" rend="right" sour