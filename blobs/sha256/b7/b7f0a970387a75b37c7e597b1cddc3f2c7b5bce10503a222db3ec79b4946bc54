      <p source="#source-238-297"><seg source="#source-238-277">みいちゃんみいちゃん、なぜ</seg><ruby type="furigana" rend="right" source="#source-277-289"><rb>泣</rb><rt>な</rt></ruby><seg source="#source-289-297">く、</seg></p>
      <p source="#source-297-371"><ruby type="furigana" rend="right" source="#source-297-312"><rb>青</rb><rt>あお</rt></ruby><seg source="#source-312-315">い</seg><ruby type="furigana" rend="right" source="#source-315-330"><rb>空</rb><rt>そら</rt></ruby><ruby type="furigana" rend="right" source="#source-330-342"><rb>見</rb><rt>み</rt></ruby><seg source="#source-342-345">て</seg><ruby type="furigana" rend="right" source="#source-345-357"><rb>泣</rb><rt>な</rt></ruby><seg source="#source-357-371">くんだ。</seg></p>
      <p source="#source-371-445"><ruby type="furigana" rend="right" source="#source-371-386"><rb>青</rb><rt>あお</rt></ruby><seg source="#source-386-389">い</seg><ruby type="furigana" rend="right" source="#source-389-404"><rb>空</rb><rt>そら</rt></ruby><ruby type="furigana" rend="right" source="#source-404-416"><rb>見</rb><rt>み</rt></ruby><seg source="#source-416-425">てなぜ</seg><ruby type="furigana" rend="right" source="#source-425-437"><rb>泣</rb><rt>な</rt></ruby><seg source="#source-437-445">く、</seg></p>
      <p source="#source-445-510"><seg source="#source-445-457">つばめの</seg><ruby type="furigana" rend="right" source="#source-457-478"><rb>行方</rb><rt>ゆくえ</rt></ruby><seg source="#source-478-481">が</seg><ruby type="furigana" rend="right" source="#source-481-496"><rb>悲</rb><rt>かな</rt></ruby><seg source="#source-496-510">しくて、</seg></p>
      <p source="#source-510-573"><ruby type="furigana" rend="right" source="#source-510-525"><rb>母</rb><rt>かか</rt></ruby><seg source="#source-525-528">を</seg><ruby type="furigana" rend="right" source="#source-528-543"><rb>思</rb><rt>おも</rt></ruby><seg source="#source-543-549">うて</seg><ruby type="furigana" rend="right" source="#source-549-561"><rb>泣</rb><rt>な</rt></ruby><seg source="#source-561-573">くんだ。</seg></p>
    </body>
