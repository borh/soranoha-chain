><seg source="#source-28974-28977">な</seg><ruby type="furigana" rend="right" source="#source-28977-28992"><rb>家</rb><rt>いえ</rt></ruby><seg source="#source-28992-29037">でした。あらしはますますつのる</seg><ruby type="furigana" rend="right" source="#source-29037-29061"><rb>一方</rb><rt>いっぽう</rt></ruby><seg source="#source-29061-29067">で、</seg><ruby type="furigana" rend="right" source="#source-29067-29094"><rb>子家鴨</rb><rt>こあひる</rt></ruby><seg source="#source-29094-29106">にはもう</seg><ruby type="furigana" rend="right" source="#source-29106-29130"><rb>一足</rb><rt>ひとあし</rt></ruby><seg source="#source-29130-29133">も</seg><ruby type="furigana" rend="right" source="#source-29133-29145"><rb>行</rb><rt>い</rt></ruby><seg source="#source-29145-29190">けそうもなくなりました。そこで</seg><ruby type="furigana" rend="right" source="#source-29190-29205"><rb>彼</rb><rt>かれ</rt></ruby><seg source="#source-29205-29208">は</seg><ruby type="furigana" rend="right" source="#source-29208-29226"><rb>小屋</rb><rt>こや</rt></ruby><seg source="#source-29226-29229">の</seg><ruby type="furigana" rend="right" source="#source-29229-29244"><rb>前</rb><rt>まえ</rt></ruby><seg source="#source-29244-29247">に</seg><ruby type="furigana" rend="right" source="#source-29247-29262"><rb>坐</rb><rt>すわ</rt></ruby><seg source="#source-29262-29280">りましたが、</seg><ruby type="furigana" rend="right" source="#source-29280-29292"><rb>見</rb><rt>み</rt></ruby><seg source="#source-29292-29301">ると、</seg><ruby type="furigana" rend="right" source="#source-29301-29313"><rb>戸</rb><rt>と</rt></ruby><seg source="#source-29313-29316">の</seg><ruby type="furigana" rend="right" source="#source-29316-29346"><rb>蝶番</rb><rt>ちょうつがい</rt></ruby><seg source="#source-29346-29349">が</seg><ruby type="furigana" rend="right" source="#source-29349-29364"><rb>一</rb><rt>ひと</rt></ruby><seg source="#source-29364-29406">つなくなっていて、そのために</seg><ruby type="furigana" rend="right" source="#source-29406-29418"><rb>戸</rb><rt>と</rt></ruby><seg source="#source-29418-29433">がきっちり</seg><ruby type="furigana" rend="