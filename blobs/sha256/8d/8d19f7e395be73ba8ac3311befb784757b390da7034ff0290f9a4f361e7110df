        <p source="#source-4416-4496"><ruby type="furigana" rend="right" source="#source-4416-4431"><rb>挑</rb><rt>いど</rt></ruby><seg source="#source-4431-4434">み</seg><ruby type="furigana" rend="right" source="#source-4434-4446"><rb>搏</rb><rt>う</rt></ruby><seg source="#source-4446-4449">つ</seg><ruby type="furigana" rend="right" source="#source-4449-4470"><rb>硫黄</rb><rt>いわう</rt></ruby><seg source="#source-4470-4473">の</seg><ruby type="furigana" rend="right" source="#source-4473-4491"><rb>炎</rb><rt>ほむら</rt></ruby><seg source="#source-4491-4496">、</seg></p>
        <p source="#source-4496-4552"><seg source="#source-4496-4502">また</seg><ruby type="furigana" rend="right" source="#source-4502-4517"><rb>苦</rb><rt>にが</rt></ruby><seg source="#source-4517-4520">き</seg><ruby type="furigana" rend="right" source="#source-4520-4535"><rb>檻</rb><rt>をり</rt></ruby><seg source="#source-4535-4552">のおびえに</seg></p>
        <p source="#source-4552-4607"><seg source="#source-4552-4567">くれなゐの</seg><ruby type="furigana" rend="right" source="#source-4567-4588"><rb>破滅</rb><rt>はめつ</rt></ruby><seg source="#source-4588-4607">をさそふ。</seg></p>
