        <p source="#source-4953-5026"><ruby type="furigana" rend="right" source="#source-4953-4965"><rb>濡</rb><rt>ぬ</rt></ruby><seg source="#source-4965-4977">れつつも</seg><ruby type="furigana" rend="right" source="#source-4977-4989"><rb>燃</rb><rt>も</rt></ruby><seg source="#source-4989-4995">ゆる</seg><ruby type="furigana" rend="right" source="#source-4995-5019"><rb>悲愁</rb><rt>かなしみ</rt></ruby><seg source="#source-5019-5026">。</seg></p>
        <p source="#source-5026-5073"><seg source="#source-5026-5041">濡れつつも</seg><ruby type="furigana" rend="right" source="#source-5041-5053"><rb>燃</rb><rt>も</rt></ruby><seg source="#source-5053-5073">ゆるかなしみ</seg></p>
