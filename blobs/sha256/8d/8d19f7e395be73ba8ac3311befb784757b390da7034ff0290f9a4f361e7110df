        <p source="#source-43129-43185"><ruby type="furigana" rend="right" source="#source-43129-43144"><rb>逃</rb><rt>のが</rt></ruby><seg source="#source-43144-43153">れゆく</seg><ruby type="furigana" rend="right" source="#source-43153-43168"><rb>我</rb><rt>われ</rt></ruby><seg source="#source-43168-43185">のものごゑ</seg></p>
        <p source="#source-43185-43225"><seg source="#source-43185-43225">また見えてとどろと奔る。</seg></p>
        <p source="#source-43225-43314"><ruby type="furigana" rend="right" source="#source-43225-43249"><rb>水牛</rb><rt>すゐぎう</rt></ruby><seg source="#source-43249-43264">の声………</seg><ruby type="furigana" rend="right" source="#source-43264-43288"><rb>千万</rb><rt>せんまん</rt></ruby><seg source="#source-43288-43314">の砥石の響………</seg></p>
        <p source="#source-43314-43438"><ruby type="furigana" rend="right" source="#source-43314-43329"><rb>苦</rb><rt>にが</rt></ruby><seg source="#source-43329-43332">き</seg><ruby type="furigana" rend="right" source="#source-43332-43356"><rb>嘲罵</rb><rt>あざけり</rt></ruby><seg source="#source-43356-43383">………はたや、なほ</seg><ruby type="furigana" rend="right" source="#source-43383-43398"><rb>奔</rb><rt>はし</rt></ruby><seg source="#source-43398-43401">る</seg><ruby type="furigana" rend="right" source="#source-43401-43425"><rb>足音</rb><rt>あしおと</rt></ruby><seg source="#source-43425-43438">………</seg></p>
