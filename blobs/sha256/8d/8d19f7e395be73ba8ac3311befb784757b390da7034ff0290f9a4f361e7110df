        <p source="#source-6878-6946"><seg source="#source-6878-6896">さあれ、なほ</seg><ruby type="furigana" rend="right" source="#source-6896-6908"><rb>弾</rb><rt>ひ</rt></ruby><seg source="#source-6908-6917">きゆく</seg><ruby type="furigana" rend="right" source="#source-6917-6941"><rb>胡弓</rb><rt>こきゆう</rt></ruby><seg source="#source-6941-6946">、</seg></p>
        <p source="#source-6946-6998"><seg source="#source-6946-6961">はてもなき</seg><ruby type="furigana" rend="right" source="#source-6961-6976"><rb>路</rb><rt>みち</rt></ruby><seg source="#source-6976-6998">のゆく手に。</seg></p>
        <p source="#source-6998-7039"><seg source="#source-6998-7039">いつまでかかくて泣きつつ、</seg></p>
        <p source="#source-7039-7082"><seg source="#source-7039-7082">いつまでかかくもあるべき。</seg></p>
        <p source="#source-7082-7138"><seg source="#source-7082-7106">あはれ、あはれ、</seg><ruby type="furigana" rend="right" source="#source-7106-7127"><rb>銀杏</rb><rt>いてふ</rt></ruby><seg source="#source-7127-7138">の林、</seg></p>
        <p source="#source-7138-7184"><seg source="#source-7138-7150">青き青き</seg><ruby type="furigana" rend="right" source="#source-7150-7171"><rb>若樹</rb><rt>わかき</rt></ruby><seg source="#source-7171-7184">の林。</seg></p>
