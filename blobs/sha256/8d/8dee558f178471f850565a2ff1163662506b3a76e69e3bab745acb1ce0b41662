      <div type="layout" source="#source-70404-70501" style="padding-inline-start: 5em">
        <div>
          <head n="2" source="#source-70425-70497"><seg source="#source-70425-70440">憶出のかず</seg><choice source="#source-70440-70446"><orig>／＼</orig><reg>〱</reg></choice></head>
        </div>
