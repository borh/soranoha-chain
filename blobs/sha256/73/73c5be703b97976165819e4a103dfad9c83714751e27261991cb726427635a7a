    <body>
      <div type="layout" source="#source-1060-1186" rend="page-horizontal-center source-blank-lines-before(2) source-blank-lines-after(2)">
        <div type="layout" source="#source-1099-1180" style="padding-inline-start: 4em">
          <div>
            <head n="1" source="#source-1120-1180"><seg source="#source-1141-1150">序の章</seg></head>
          </div>
        </div>
