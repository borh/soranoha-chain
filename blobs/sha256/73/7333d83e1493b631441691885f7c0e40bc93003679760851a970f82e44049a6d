    <body>
      <p><seg source="#source-27-53">いつしんなれば、</seg></p>
      <p><seg source="#source-53-91">あふむけに屍體ともなる、</seg></p>
      <p><seg source="#source-91-117">つめたく合掌し、</seg></p>
      <p><seg source="#source-117-146">いんよくいちねん、</seg></p>
      <p><seg source="#source-146-187">きりぎりす青らみ、もはら、</seg></p>
      <p><seg source="#source-187-214">雀みそらに殺さる。</seg></p>
    </body>
