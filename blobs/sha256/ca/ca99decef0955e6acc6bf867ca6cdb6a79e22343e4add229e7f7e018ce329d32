      <p style="text-indent: 1em" rend="first-line-indent(1)"><ruby type="furigana" rend="right" source="#source-26762-26777"><rb>天</rb><rt>てん</rt></ruby><seg source="#source-26777-26795">にでもいゝ、</seg><ruby type="furigana" rend="right" source="#source-26795-26807"><rb>地</rb><rt>ち</rt></ruby><seg source="#source-26807-26825">にでもいゝ、</seg><ruby type="furigana" rend="right" source="#source-26825-26840"><rb>縋</rb><rt>すが</rt></ruby><seg source="#source-26840-26855">らうとする</seg><ruby type="furigana" rend="right" source="#source-26855-26873"><rb>心</rb><rt>こゝろ</rt></ruby><seg source="#source-26873-26876">、</seg><ruby type="furigana" rend="right" source="#source-26876-26891"><rb>祈</rb><rt>いの</rt></ruby><seg source="#source-26891-26906">らうとする</seg><ruby type="furigana" rend="right" source="#source-26906-26921"><rb>希</rb><rt>ねが</rt></ruby><seg source="#source-26921-26930">ひが、</seg><ruby type="furigana" rend="right" source="#source-26930-26954"><rb>不純</rb><rt>ふじゆん</rt></ruby><seg source="#source-26954-26957">な</seg><ruby type="furigana" rend="right" source="#source-26957-26972"><rb>沙</rb><rt>すな</rt></ruby><seg source="#source-26972-26975">を</seg><ruby type="furigana" rend="right" source="#source-26975-26990"><rb>透</rb><rt>とほ</rt></ruby><seg source="#source-26990-26996">して</seg><ruby type="furigana" rend="right" source="#source-26996-27011"><rb>清</rb><rt>きよ</rt></ruby><seg source="#source-27011-27020">くとろ</seg><choice source="#source-27020-27026"><orig>／＼</orig><reg>〱</reg></choice><seg source="#source-27026-27029">と</seg><ruby type="furigana" rend="right" source="#source-27029-27053"><rb>彼女</rb><rt>かのぢよ</rt></ruby><seg source="#source-27053-27056">の</seg><ruby type="furigana" rend="right" source="#source-27056-27071"><rb>胸</rb><rt>むね</rt></ruby><seg source="#source-27071-27074">に</seg><ruby type="furigana" rend="right" source="#source-27074-27089"><rb>流</rb><rt>なが</rt></ruby><seg source="#source-27089-27092">れ</seg><ruby type="furigana" rend="right" source="#source-27092-27104"><r