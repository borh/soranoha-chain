uby><ruby type="furigana" rend="right" source="#source-234398-234425"><rb>徒然</rb><rt><seg source="#source-234407-234413">つれ</seg><choice source="#source-234413-234422"><orig>／″＼</orig><reg>〲</reg></choice></rt></ruby><seg source="#source-234425-234434">なるに</seg><ruby type="furigana" rend="right" source="#source-234434-234449"><rb>任</rb><rt>まか</rt></ruby><seg source="#source-234449-234458">せて、</seg><ruby type="furigana" rend="right" source="#source-234458-234482"><rb>書物</rb><rt>しよもつ</rt></ruby><seg source="#source-234482-234485">の</seg><ruby type="furigana" rend="right" source="#source-234485-234509"><rb>明細</rb><rt>めいさい</rt></ruby><seg source="#source-234509-234512">な</seg><ruby type="furigana" rend="right" source="#source-234512-234536"><rb>目録</rb><rt>もくろく</rt></ruby><seg source="#source-234536-234539">を</seg><ruby type="furigana" rend="right" source="#source-234539-234563"><rb>編成</rb><rt>へんせい</rt></ruby><seg source="#source-234563-234569">し、</seg><ruby type="furigana" rend="right" source="#source-234569-234593"><rb>書物</rb><rt>しよもつ</rt></ruby><seg source="#source-234593-234596">の</seg><ruby type="furigana" rend="right" source="#source-234596-234608"><rb>背</rb><rt>せ</rt></ruby><seg source="#source-234608-234614">には</seg><ruby type="furigana" rend="right" source="#source-234614-234629"><rb>札</rb><rt>ふだ</rt></ruby><seg source="#source-234629-234638">を一々</seg><ruby type="furigana" rend="right" source="#source-234638-234662"><rb>貼付</rb><rt>はりつ</rt></ruby><seg source="#source-234662-234674">けたが、</seg><ruby type="furigana" rend="right" source="#source-234674-234719"><rb>這麼機械的</rb><rt>こんなきかいてき</rt></ruby><seg source="#source-234719-234722">な</seg><ruby type="furigana" rend="right" source="#source-234722-234746"><rb>單調</rb><rt>たんてう</rt></ruby><seg source="#source-234746-234749">な</seg><ruby type="furigana" rend="right" source="#source-234749-234770"><rb>仕事</rb><rt>しごと</rt></ruby><seg source="#source-234770-234776">が、</seg><ruby type="furigana" rend="right" source="#source-234776-234791"><rb>却</rb><rt>かへ</rt></ruby><seg source="#source-234791-234797">つて</seg><ruby type="furigana" rend="right" source="#source-234797-234821"><rb>何故</rb><rt>なにゆゑ</rt></ruby><seg source="#source-234821-234824">か</seg><ruby type="furigana" rend="right" source="#source-234824-234845"><rb>奇妙</rb><rt>きめう</rt></ruby><seg source="#source-234845-234848">に</seg><ruby type="furigana" rend="right" source="#source-234848-234863"><rb>彼</rb><rt>かれ</rt></ruby><seg source="#source-234863-234866">の</seg><ruby type="furigana" rend="right" source="#source-234866-234887"><rb>思想</rb><rt>しさう</rt></ruby><seg source="#source-234887-234890">を</seg><ruby type="furigana" rend="right" source="#source-234890-234905"><rb>弄</rb><rt>ろう</rt></ruby><seg source="#source-234905-234914">して、</seg><ruby type="furigana" rend="right" source="#source-234914-234938"><rb>興味</rb><rt>きようみ</rt></ruby><seg source="#source-234938-234947">をさへ</seg><ruby type="furigana" rend="right" source="#source-234947-234959"><rb>添</rb><rt>そ</rt></ruby><seg source="#source-234959-234982">へしめてゐた。</seg></p>
