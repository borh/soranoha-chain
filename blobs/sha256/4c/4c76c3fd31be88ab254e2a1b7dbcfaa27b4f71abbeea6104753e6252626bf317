" rend="right" source="#source-218081-218093"><rb>其</rb><rt>そ</rt></ruby><seg source="#source-218093-218102">れから</seg><ruby type="furigana" rend="right" source="#source-218102-218123"><rb>二人</rb><rt>ふたり</rt></ruby><seg source="#source-218123-218126">は</seg><ruby type="furigana" rend="right" source="#source-218126-218144"><rb>其處</rb><rt>そこ</rt></ruby><seg source="#source-218144-218147">を</seg><ruby type="furigana" rend="right" source="#source-218147-218159"><rb>出</rb><rt>で</rt></ruby><seg source="#source-218159-218180">て、クレムリに</seg><ruby type="furigana" rend="right" source="#source-218180-218192"><rb>行</rb><rt>ゆ</rt></ruby><seg source="#source-218192-218198">き、</seg><ruby type="furigana" rend="right" source="#source-218198-218231"><rb>大砲王</rb><rt>たいはうわう</rt></ruby><seg source="#source-218231-218234">（</seg><seg type="warichu" rend="two-line" source="#source-218234-218291"><seg source="#source-218252-218264">巨大な砲</seg></seg><seg source="#source-218291-218297">）と</seg><ruby type="furigana" rend="right" source="#source-218297-218333"><rb>大鐘王</rb><rt>たいしようわう</rt></ruby><seg source="#source-218333-218336">（</seg><seg type="warichu" rend="two-line" source="#source-218336-218423"><seg source="#source-218354-218396">巨大な鐘、モスクワの二大名物</seg></seg><seg source="#source-218423-218432">）とを</seg><ruby type="furigana" rend="right" source="#source-218432-218456"><rb>見物</rb><rt>けんぶつ</rt></ruby><seg source="#source-218456-218462">し、</seg><ruby type="furigana" rend="right" source="#source-218462-218477"><rb>指</rb><rt>ゆび</rt></ruby><seg source="#source-218477-218480">で</seg><ruby type="furigana" rend="right" source="#source-218480-218495"><rb>觸</rb><rt>さは</rt></ruby><seg source="#source-218495-218501">つて</seg><ruby type="furigana" rend="right" source="#source-218501-218513"><rb>見</rb><rt>み</rt></ruby><seg source="#source-218513-218528">たりした。</seg><ruby type="furigana" rend="right" source="#source-218528-218540"><rb>其</rb><rt>そ</rt></ruby><seg source="#source-218540-218561">れよりモスクワ</seg><rub