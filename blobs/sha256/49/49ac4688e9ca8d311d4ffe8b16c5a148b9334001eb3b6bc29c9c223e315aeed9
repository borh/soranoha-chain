      <div type="layout" source="#source-5690-5814" style="padding-inline-start: 4em">
        <div>
          <head n="2" source="#source-5711-5810"><seg source="#source-5711-5720">第一　</seg><ruby type="furigana" rend="right" source="#source-5720-5747"><rb>腹中</rb><rt>ふくちゅう</rt></ruby><seg source="#source-5747-5756">の新年</seg></head>
