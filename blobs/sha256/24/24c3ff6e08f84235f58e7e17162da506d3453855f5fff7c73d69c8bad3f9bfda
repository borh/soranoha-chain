        <p><seg source="#source-16200-16223">さも乘りたそに</seg></p>
        <p><seg source="#source-16223-16243">のびあがる。</seg></p>
        <p><pb source="#source-16243-16264"/></p>
        <p style="text-indent: 3em" rend="first-line-indent(3)"><seg source="#source-16268-16293">五つの色</seg></p>
        <p><ruby type="furigana" rend="right" source="#source-16293-16311"><rb>今朝</rb><rt>けさ</rt></ruby><seg source="#source-16311-16317">のお</seg><ruby type="furigana" rend="right" source="#source-16317-16332"><rb>膳</rb><rt>ぜん</rt></ruby><seg source="#source-16332-16337">は</seg></p>
        <p><seg source="#source-16337-16354">きれいだな</seg></p>
        <p><seg source="#source-16354-16371">五つの色が</seg></p>
        <p><seg source="#source-16371-16393">ならんでる。</seg></p>
        <p><seg source="#source-16393-16410">赤い梅ぼし</seg></p>
        <p><seg source="#source-16410-16416">黒い</seg><ruby type="furigana" rend="right" source="#source-16416-16434"><rb>海苔</rb><rt>のり</rt></ruby></p>
        <p><seg source="#source-16436-16456">燒いた玉子は</seg></p>
        <p><seg source="#source-16456-16462">まつ</seg><ruby type="furigana" rend="right" source="#source-16462-16483"><rb>黄色</rb><rt>きいろ</rt></ruby><seg source="#source-16483-16490">。</seg></p>
        <p><ruby type="furigana" rend="right" source="#source-16490-16511"><rb>御飯</rb><rt>ごはん</rt></ruby><seg source="#source-16511-16522">は白く</seg></p>
        <p><seg source="#source-16522-16536">味噌汁に</seg></p>
        <p><ruby type="furigana" rend="right" source="#source-16536-16548"><rb>浮</rb><rt>う</rt></ruby><seg source="#source-16548-16565">いて青いは</seg></p>
        <p><seg source="#source-16565-16590">ほうれんさう。</seg></p>
        <p><seg source="#source-16590-16613">おとぎばなしの</seg></p>
