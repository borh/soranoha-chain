          <p><seg source="#source-119650-119667">六月十二日</seg></p>
        </div>
        <div type="layout" source="#source-119667-119711" style="padding-inline-end: 2em; text-align: right">
          <p><seg source="#source-119697-119711">沢崎　煕</seg></p>
        </div>
        <div>
          <p><seg source="#source-119711-119728">菅野やす様</seg></p>
        </div>
        <div type="layout" source="#source-119728-119757" style="padding-inline-start: 5em">
          <p><seg source="#source-119749-119757">侍女</seg></p>
