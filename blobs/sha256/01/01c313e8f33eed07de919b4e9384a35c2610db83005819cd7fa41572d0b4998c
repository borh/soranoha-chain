        <div>
          <head n="3" source="#source-215706-215787"><seg source="#source-215706-215721">六　重井と</seg><ruby type="furigana" rend="right" source="#source-215721-215733"><rb>絶</rb><rt>た</rt></ruby><seg source="#source-215733-215736">つ</seg></head>
