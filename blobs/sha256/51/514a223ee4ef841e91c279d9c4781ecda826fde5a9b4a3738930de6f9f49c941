      <p source="#source-33-50"><seg source="#source-33-50">うめのはな</seg></p>
      <p source="#source-50-70"><seg source="#source-50-70">うめのはな、</seg></p>
      <p source="#source-70-90"><seg source="#source-70-90">えだのうへで</seg></p>
      <p source="#source-90-113"><seg source="#source-90-113">あつたかいね。</seg></p>
      <p source="#source-113-130"><seg source="#source-113-130">ぽか　ぽか</seg></p>
      <p source="#source-130-153"><seg source="#source-130-153">あつたかいね。</seg></p>
      <p source="#source-153-176"><seg source="#source-153-176">しろいごはん、</seg></p>
      <p source="#source-176-196"><seg source="#source-176-196">しろいごはん</seg></p>
      <p source="#source-196-219"><seg source="#source-196-219">おかまのなかで</seg></p>
      <p source="#source-219-242"><seg source="#source-219-242">あつたかいね。</seg></p>
      <p source="#source-242-259"><seg source="#source-242-259">ぽか　ぽか</seg></p>
