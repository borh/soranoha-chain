      <div type="layout" source="#source-12467-12534" style="padding-inline-start: 2em">
        <div>
          <head n="2" source="#source-12488-12530"><seg source="#source-12488-12494">氣稟</seg></head>
        </div>
      </div>
      <div>
        <p source="#source-12534-12542"><seg source="#source-12534-12542">鴉は</seg></p>
        <p source="#source-12542-12558"><seg source="#source-12542-12558">木に眠り</seg></p>
