        <p source="#source-34327-34352"><pb source="#source-34327-34348"/></p>
      </div>
      <div type="layout" source="#source-34352-34475" style="padding-inline-start: 3em">
        <div>
          <head n="2" source="#source-34373-34475"><seg source="#source-34394-34445">夢　　　　　　　シュリ・プリュドン</seg></head>
        </div>
