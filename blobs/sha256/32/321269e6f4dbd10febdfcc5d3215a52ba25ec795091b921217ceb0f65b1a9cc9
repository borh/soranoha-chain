      <div type="layout" source="#source-475-574" rend="page-horizontal-center source-blank-lines-before(2) source-blank-lines-after(2)">
        <div type="layout" source="#source-514-574" style="padding-inline-end: 7em; text-align: right">
          <p source="#source-544-574"><seg source="#source-544-574">大正元年十月初版</seg></p>
