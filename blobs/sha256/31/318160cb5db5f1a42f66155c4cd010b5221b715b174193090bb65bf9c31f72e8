        <p style="text-indent: 1em" rend="first-line-indent(1)"><ruby type="furigana" rend="right" source="#source-2075-2090"><rb>道</rb><rt>みち</rt></ruby><seg source="#source-2090-2093">と</seg><ruby type="furigana" rend="right" source="#source-2093-2108"><rb>空</rb><rt>そら</rt></ruby><seg source="#source-2108-2114">との</seg><ruby type="furigana" rend="right" source="#source-2114-2132"><rb>間</rb><rt>あひだ</rt></ruby><seg source="#source-2132-2135">に</seg><ruby type="furigana" rend="right" source="#source-2135-2150"><rb>唯</rb><rt>たゞ</rt></ruby><ruby type="furigana" rend="right" source="#source-2150-2171"><rb>一人</rb><rt>ひとり</rt></ruby><ruby type="furigana" rend="right" source="#source-2171-2186"><rb>我</rb><rt>わし</rt></ruby><seg source="#source-2186-2198">ばかり、</seg><ruby type="furigana" rend="right" source="#source-2198-2213"><rb>凡</rb><rt>およ</rt></ruby><seg source="#source-2213-2216">そ</seg><ruby type="furigana" rend="right" source="#source-2216-2240"><rb>正午</rb><rt>しやうご</rt></ruby><seg source="#source-2240-2243">と</seg><ruby type="furigana" rend="right" source="#source-2243-2258"><rb>覚</rb><rt>おぼ</rt></ruby><seg source="#source-2258-2264">しい</seg><ruby type="furigana" rend="right" source="#source-2264-2288"><rb>極熱</rb><rt>ごくねつ</rt></ruby><seg source="#source-2288-2291">の</seg><ruby type="furigana" rend="right" source="#source-2291-2315"><rb>太陽</rb><rt>たいやう</rt></ruby><seg source="#source-2315-2318">の</seg><ruby type="furigana" rend="right" source="#source-2318-2333"><rb>色</rb><rt>いろ</rt></ruby><seg source="#source-2333-2336">も</seg><ruby type="furigana" rend="right" source="#source-2336-2351"><rb>白</rb><rt>しろ</rt></ruby><seg source="#source-2351-2363">いほどに</seg><ruby type="furigana" rend="right" source="#source-2363-2375"><rb>冴</rb><rt>さ</rt></ruby><seg source="#source-2375-2378">え</seg><ruby type="furigana" rend="right" source="#source-2378-2393"><rb>返</rb><rt>かへ</rt></ruby><seg source="#source-2393-2399">つた</seg><ruby type="furigana" rend="right" source="#source-2399-242