  <text>
    <body>
      <p><seg source="#source-33-53">すかんぽ原は</seg></p>
      <p><seg source="#source-53-73">夕やけしてた</seg></p>
      <p><seg source="#source-73-96">赤ん坊おぶつて</seg></p>
      <p><seg source="#source-96-118">探していつた</seg></p>
      <p><seg source="#source-118-138">すかんぽ原は</seg></p>
      <p><seg source="#source-138-161">つくしのにほひ</seg></p>
      <p><seg source="#source-161-184">どこかで子供の</seg></p>
      <p><seg source="#source-184-209">うたごゑしてた</seg></p>
      <p><seg source="#source-209-229">すかんぽ原は</seg></p>
      <p><seg source="#source-229-252">トンネルつづき</seg></p>
      <p><seg source="#source-252-275">こもつたおとで</seg></p>
      <p><seg source="#source-275-293">汽笛がしてた</seg></p>
    </body>
