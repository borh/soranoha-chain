また</rt></ruby><ruby type="furigana" rend="right" source="#source-2654-2666"><rb>此</rb><rt>こ</rt></ruby><seg source="#source-2666-2669">の</seg><ruby type="furigana" rend="right" source="#source-2669-2696"><rb>小田原</rb><rt>をだはら</rt></ruby><seg source="#source-2696-2699">と</seg><ruby type="furigana" rend="right" source="#source-2699-2711"><rb>來</rb><rt>き</rt></ruby><seg source="#source-2711-2714">た</seg><ruby type="furigana" rend="right" source="#source-2714-2726"><rb>日</rb><rt>ひ</rt></ruby><seg source="#source-2726-2735">には、</seg><ruby type="furigana" rend="right" source="#source-2735-2756"><rb>暖</rb><rt>あつたか</rt></ruby><seg source="#source-2756-2765">いこと</seg><ruby type="furigana" rend="right" source="#source-2765-2798"><rb>日本一</rb><rt>につぽんいち</rt></ruby><seg source="#source-2798-2804">だ、</seg><ruby type="furigana" rend="right" source="#source-2804-2819"><rb>喃</rb><rt>なあ</rt></ruby><seg source="#source-2819-2822">、</seg><ruby type="furigana" rend="right" source="#source-2822-2852"><rb>御亭主</rb><rt>ごていしゆ</rt></ruby><seg source="#source-2852-2855">。</seg><ruby type="furigana" rend="right" source="#source-2855-2867"><rb>然</rb><rt>さ</rt></ruby><seg source="#source-2867-2894">やうでござります。</seg><ruby type="furigana" rend="right" source="#source-2894-2921"><rb>喜多八</rb><rt>きたはち</rt></ruby><seg source="#source-2921-2933">、さあ、</seg><ruby type="furigana" rend="right" source="#source-2933-2945"><rb>其</rb><rt>そ</rt></ruby><seg source="#source-2945-2948">の</seg><ruby type="furigana" rend="right" source="#source-2948-2960"><rb>氣</rb><rt>き</rt></ruby><seg source="#source-2960-2963">で</seg><ruby type="furigana" rend="right" source="#source-2963-2978"><rb>歩</rb><rt>あゆ</rt></ruby><seg source="#source-2978-2993">ばつしと、</seg><ruby type="furigana" rend="right" source="#source-2993-3008"><rb>今</rb><rt>いま</rt></ruby><seg source="#source-3008-3014">こそ</seg><ruby type="furigana" rend="right" source="#source-3014-3038"><rb>着流</rb><rt>きながし</rt></ruby><seg source="#source-3038-3041">で</seg><ruby type="