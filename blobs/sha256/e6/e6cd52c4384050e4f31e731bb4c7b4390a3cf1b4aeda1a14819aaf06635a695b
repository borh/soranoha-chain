      <p style="text-indent: 1em" rend="first-line-indent(1)"><ruby type="furigana" rend="right" source="#source-552-567"><rb>同</rb><rt>おな</rt></ruby><seg source="#source-567-582">じことを、</seg><ruby type="furigana" rend="right" source="#source-582-609"><rb>東京</rb><rt>とうきやう</rt></ruby><seg source="#source-609-615">では</seg><ruby type="furigana" rend="right" source="#source-615-645"><rb>世界一</rb><rt>せかいいち</rt></ruby><seg source="#source-645-648">、</seg><ruby type="furigana" rend="right" source="#source-648-669"><rb>地方</rb><rt>ちはう</rt></ruby><seg source="#source-669-675">では</seg><ruby type="furigana" rend="right" source="#source-675-708"><rb>日本一</rb><rt>につぽんいち</rt></ruby><seg source="#source-708-711">と</seg><ruby type="furigana" rend="right" source="#source-711-726"><rb>誇</rb><rt>ほこ</rt></ruby><seg source="#source-726-732">る。</seg><ruby type="furigana" rend="right" source="#source-732-756"><rb>相州</rb><rt>さうしう</rt></ruby><ruby type="furigana" rend="right" source="#source-756-783"><rb>小田原</rb><rt>をだはら</rt></ruby><seg source="#source-783-786">の</seg><ruby type="furigana" rend="right" source="#source-786-801"><rb>町</rb><rt>まち</rt></ruby><seg source="#source-801-804">に</seg><ruby type="furigana" rend="right" source="#source-804-846"><rb>電車鐵道</rb><rt>でんしやてつだう</rt></ruby><ruby type="furigana" rend="right" source="#source-846-870"><rb>待合</rb><rt>まちあひ</rt></ruby><seg source="#source-870-876">の、</seg><ruby type="furigana" rend="right" source="#source-876-900"><rb>茶店</rb><rt>ちやみせ</rt></ruby><seg source="#source-900-903">の</seg><ruby type="furigana" rend="right" source="#source-903-927"><rb>亭主</rb><rt>ていしゆ</rt></ruby><seg source="#source-927-930">が</seg><ruby type="furigana" rend="right" source="#source-930-948"><rb>言</rb><rt>ことば</rt></ruby><seg source="#source-948-951">に</seg><ruby type="furigana" rend="right" source="#source-951-963"><rb>因</rb><rt>よ</rt></ruby><seg source="#source-963-972">れば、</seg><ruby type="furigana" rend="right" source="#source-972-990"><rb>土地</rb><rt>とち</rt></r