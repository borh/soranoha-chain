      <p style="text-indent: 1em" rend="first-line-indent(1)"><ruby type="furigana" rend="right" source="#source-41222-41240"><rb>瞬</rb><rt>またゝ</rt></ruby><seg source="#source-41240-41243">く</seg><ruby type="furigana" rend="right" source="#source-41243-41255"><rb>間</rb><rt>ま</rt></ruby><seg source="#source-41255-41261">に、</seg><ruby type="furigana" rend="right" source="#source-41261-41276"><rb>雁</rb><rt>かり</rt></ruby><seg source="#source-41276-41279">は</seg><ruby type="furigana" rend="right" source="#source-41279-41303"><rb>炭燒</rb><rt>すみやき</rt></ruby><seg source="#source-41303-41306">に</seg><ruby type="furigana" rend="right" source="#source-41306-41321"><rb>屠</rb><rt>ほふ</rt></ruby><seg source="#source-41321-41336">られたが、</seg><ruby type="furigana" rend="right" source="#source-41336-41357"><rb>民子</rb><rt>たみこ</rt></ruby><seg source="#source-41357-41360">は</seg><ruby type="furigana" rend="right" source="#source-41360-41387"><rb>微傷</rb><rt>かすりきず</rt></ruby><seg source="#source-41387-41390">も</seg><ruby type="furigana" rend="right" source="#source-41390-41402"><rb>受</rb><rt>う</rt></ruby><seg source="#source-41402-41417">けないで、</seg><ruby type="furigana" rend="right" source="#source-41417-41435"><rb>完</rb><rt>まつた</rt></ruby><seg source="#source-41435-41438">き</seg><ruby type="furigana" rend="right" source="#source-41438-41453"><rb>璧</rb><rt>たま</rt></ruby><seg source="#source-41453-41456">の</seg><ruby type="furigana" rend="right" source="#source-41456-41471"><rb>泰</rb><rt>やす</rt></ruby><seg source="#source-41471-41480">らかに</seg><ruby type="furigana" rend="right" source="#source-41480-41495"><rb>雪</rb><rt>ゆき</rt></ruby><seg source="#source-41495-41498">の</seg><ruby type="furigana" rend="right" source="#source-41498-41516"><rb>膚</rb><rt>はだへ</rt></ruby><seg source="#source-41516-41519">は</seg><ruby type="furigana" rend="right" source="#source-41519-41534"><rb>繩</rb><rt>なは</rt></ruby><seg source="#source-41534-41540">から</seg><ruby type="furigana" rend="right" source="#source-415