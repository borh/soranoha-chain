      <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-800-1765"><ruby type="furigana" rend="right" source="#source-803-818"><rb>久</rb><rt>ひさ</rt></ruby><seg source="#source-818-830">しぶりで</seg><ruby type="furigana" rend="right" source="#source-830-851"><rb>孤獨</rb><rt>こどく</rt></ruby><seg source="#source-851-854">の</seg><ruby type="furigana" rend="right" source="#source-854-881"><rb>生活</rb><rt>せいくわつ</rt></ruby><seg source="#source-881-884">を</seg><ruby type="furigana" rend="right" source="#source-884-896"><rb>行</rb><rt>や</rt></ruby><seg source="#source-896-902">つて</seg><ruby type="furigana" rend="right" source="#source-902-914"><rb>居</rb><rt>ゐ</rt></ruby><seg source="#source-914-929">る、これも</seg><ruby type="furigana" rend="right" source="#source-929-953"><rb>病氣</rb><rt>びやうき</rt></ruby><seg source="#source-953-959">のお</seg><ruby type="furigana" rend="right" source="#source-959-974"><rb>蔭</rb><rt>かげ</rt></ruby><seg source="#source-974-980">かも</seg><ruby type="furigana" rend="right" source="#source-980-992"><rb>知</rb><rt>し</rt></ruby><seg source="#source-992-1004">れない。</seg><ruby type="furigana" rend="right" source="#source-1004-1028"><rb>色々</rb><rt><seg source="#source-1013-1019">いろ</seg><choice source="#source-1019-1025"><orig>／＼</orig><reg>〱</reg></choice></rt></ruby><seg source="#source-1028-1040">なことを</seg><ruby type="furigana" rend="right" source="#source-1040-1058"><rb>考</rb><rt>かんが</rt></ruby><seg source="#source-1058-1064">へて</seg><ruby type="furigana" rend="right" source="#source-1064-1079"><rb>久</rb><rt>ひさ</rt></ruby><seg source="#source-1079-1091">しぶりで</seg><ruby type="furigana" rend="right" source="#source-1091-1109"><rb>自己</rb><rt>じこ</rt></ruby><seg source="#source-1109-1112">の</seg><ruby type="furigana" rend="right" source="#source-1112-1136"><rb>存在</rb><rt>そんざい</rt></ruby><seg source="#source-1136-1139">を</seg><ruby type="furigana" rend="right" source="#source-1139-1160"><rb>自覺</rb><rt>じかく</rt></ruby><seg source="#source-1160-1175">し