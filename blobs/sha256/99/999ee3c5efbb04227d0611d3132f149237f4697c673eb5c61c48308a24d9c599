ruby><seg source="#source-2212-2218">して</seg><ruby type="furigana" rend="right" source="#source-2218-2233"><rb>了</rb><rt>しま</rt></ruby><seg source="#source-2233-2239">ふ。</seg><ruby type="furigana" rend="right" source="#source-2239-2260"><rb>浴槽</rb><rt>ゆぶね</rt></ruby><seg source="#source-2260-2266">の一</seg><ruby type="furigana" rend="right" source="#source-2266-2284"><rb>端</rb><rt>たん</rt></ruby><seg source="#source-2284-2287">へ</seg><ruby type="furigana" rend="right" source="#source-2287-2311"><rb>後腦</rb><rt>こうなう</rt></ruby><seg source="#source-2311-2314">を</seg><ruby type="furigana" rend="right" source="#source-2314-2329"><rb>乘</rb><rt>のせ</rt></ruby><seg source="#source-2329-2335">て一</seg><ruby type="furigana" rend="right" source="#source-2335-2353"><rb>端</rb><rt>たん</rt></ruby><seg source="#source-2353-2356">へ</seg><ruby type="furigana" rend="right" source="#source-2356-2380"><rb>爪先</rb><rt>つまさき</rt></ruby><seg source="#source-2380-2383">を</seg><ruby type="furigana" rend="right" source="#source-2383-2398"><rb>掛</rb><rt>かけ</rt></ruby><seg source="#source-2398-2416">て、ふわりと</seg><ruby type="furigana" rend="right" source="#source-2416-2428"><rb>身</rb><rt>み</rt></ruby><seg source="#source-2428-2431">を</seg><ruby type="furigana" rend="right" source="#source-2431-2446"><rb>浮</rb><rt>うか</rt></ruby><seg source="#source-2446-2452">べて</seg><ruby type="furigana" rend="right" source="#source-2452-2464"><rb>眼</rb><rt>め</rt></ruby><seg source="#source-2464-2467">を</seg><ruby type="furigana" rend="right" source="#source-2467-2482"><rb>閉</rb><rt>つぶ</rt></ruby><seg source="#source-2482-2488">る。</seg><ruby type="furigana" rend="right" source="#source-2488-2503"><rb>時</rb><rt>とき</rt></ruby><seg source="#source-2503-2506">に</seg><ruby type="furigana" rend="right" source="#source-2506-2527"><rb>薄目</rb><rt>うすめ</rt></ruby><seg source="#source-2527-2530">を</seg><ruby type="furigana" rend="right" source="#source-2530-2545"><rb>開</rb><rt>あけ</rt></ruby><seg source="#source-2545-2548">て</seg><r