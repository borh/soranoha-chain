      <p source="#source-277-291"><seg source="#source-277-291">もぅりの</seg></p>
      <p source="#source-291-323"><seg source="#source-291-323">もぅりの木のかげで、</seg></p>
      <p source="#source-323-367"><seg source="#source-323-367">みゝながうさぎのくだものや。</seg></p>
      <p source="#source-367-390"><seg source="#source-367-390">つぶのそろつた</seg></p>
      <p source="#source-390-410"><seg source="#source-390-410">さくらんぼ、</seg></p>
      <p source="#source-410-433"><seg source="#source-410-433">まつかであまい</seg></p>
      <p source="#source-433-471"><ruby type="furigana" rend="right" source="#source-433-466"><rb>大西瓜</rb><rt>おほずいくわ</rt></ruby><seg source="#source-466-471">。</seg></p>
      <p source="#source-471-485"><seg source="#source-471-485">やすうり</seg></p>
      <p source="#source-485-499"><seg source="#source-485-499">なげうり</seg></p>
      <p source="#source-499-522"><seg source="#source-499-522">大べんきやう。</seg></p>
      <p source="#source-522-554"><seg source="#source-522-554">かわいいぼつちやんは</seg></p>
      <p source="#source-554-577"><seg source="#source-554-577">じてんしやで、</seg></p>
      <p source="#source-577-612"><seg source="#source-577-612">きれいなおぢやうさんは</seg></p>
      <p source="#source-612-632"><seg source="#source-612-632">かごもつて、</seg></p>
      <p source="#source-632-649"><seg source="#source-632-649">さあ　さあ</seg></p>
      <p source="#source-649-672"><seg source="#source-649-672">いらつしやい、</seg></p>
      <p source="#source-672-697"><seg source="#source-672-697">おほやすうり。</seg></p>
      <p source="#source-697-723"><seg source="#source-697-723">めかたはたつぷり</seg></p>
      <p source="#source-723-746"><seg source="#source-723-746">まちがひなし、</seg></p>
      <p source="#source-746-769"><seg source="#source-746-769">どこのみせより</seg></p>
      <p source="#source-769-790"><seg source="#source-769-790">おほやすうり。</seg></p>
    </body>
