      <p><ruby type="furigana" rend="right" source="#source-259-274"><rb>花</rb><rt>はな</rt></ruby><seg source="#source-274-283">によう</seg><ruby type="furigana" rend="right" source="#source-283-295"><rb>似</rb><rt>に</rt></ruby><seg source="#source-295-298">た</seg><ruby type="furigana" rend="right" source="#source-298-316"><rb>姿</rb><rt>すがた</rt></ruby><seg source="#source-316-327">をば、</seg></p>
      <p><seg source="#source-327-336">なんの</seg><ruby type="furigana" rend="right" source="#source-336-351"><rb>花</rb><rt>はな</rt></ruby><seg source="#source-351-357">かと</seg><ruby type="furigana" rend="right" source="#source-357-369"><rb>問</rb><rt>と</rt></ruby><seg source="#source-369-383">われると</seg></p>
      <p><seg source="#source-383-395">すぐには</seg><ruby type="furigana" rend="right" source="#source-395-416"><rb>返答</rb><rt>へんと</rt></ruby><seg source="#source-416-419">に</seg><ruby type="furigana" rend="right" source="#source-419-434"><rb>困</rb><rt>こま</rt></ruby><seg source="#source-434-450">るけど。</seg></p>
      <p><seg source="#source-450-456">ただ</seg><ruby type="furigana" rend="right" source="#source-456-477"><rb>微笑</rb><rt>ほほえ</rt></ruby><seg source="#source-477-503">みてものいわず、</seg></p>
      <p><seg source="#source-503-509">うす</seg><ruby type="furigana" rend="right" source="#source-509-533"><rb>青白</rb><rt>あおしろ</rt></ruby><seg source="#source-533-536">き</seg><ruby type="furigana" rend="right" source="#source-536-551"><rb>夢</rb><rt>ゆめ</rt></ruby><seg source="#source-551-554">の</seg><ruby type="furigana" rend="right" source="#source-554-566"><rb>世</rb><rt>よ</rt></ruby><seg source="#source-566-574">に、</seg></p>
      <p><seg source="#source-574-583">いまは</seg><ruby type="furigana" rend="right" source="#source-583-604"><rb>幻</rb><rt>まぼろし</rt></ruby><seg source="#source-604-607">と</seg><ruby type="furigana" rend="right" source="#source-607-619"><rb>浮</rb><rt>う</rt></ruby><seg source="#source-619-638">かぶかな。</seg></p>
      <p><ruby type="furigana" rend="right" source="#source-638-653"><rb>花</rb><rt>はな</rt></ruby><seg source="#source-653-688">にいろいろあるけれど、</seg></p>
      <p><ruby type="furigana" rend="right" source="#source-688-700"><rb>燃</rb><rt>も</rt></ruby><seg source="#source-700-706">える</seg><ruby type="furigana" rend="right" source="#source-706-721"><rb>紅</rb><rt>あか</rt></ruby><seg source="#source-721-724">い</seg><ruby type="furigana" rend="right" source="#source-724-739"><rb>花</rb><rt>はな</rt></ruby><seg source="#source-739-753">でない。</seg></p>
      <p><ruby type="furigana" rend="right" source="#source-753-768"><rb>冷</rb><rt>つめ</rt></ruby><seg source="#source-768-774">たい</seg><ruby type="furigana" rend="right" source="#source-774-789"><rb>白</rb><rt>しろ</rt></ruby><seg source="#source-789-792">い</seg><ruby type="furigana" rend="right" source="#source-792-807"><rb>花</rb><rt>はな</rt></ruby><seg source="#source-807-823">でない。</seg></p>
      <p><ruby type="furigana" rend="right" source="#source-823-838"><rb>夏</rb><rt>なつ</rt></ruby><seg source="#source-838-847">はまだ</seg><ruby type="furigana" rend="right" source="#source-847-862"><rb>浅</rb><rt>あさ</rt></ruby><seg source="#source-862-868">く、</seg><ruby type="furigana" rend="right" source="#source-868-883"><rb>色</rb><rt>いろ</rt></ruby><ruby type="furigana" rend="right" source="#source-883-898"><rb>淡</rb><rt>あわ</rt></ruby><seg source="#source-898-906">く、</seg></p>
      <p><ruby type="furigana" rend="right" source="#source-906-933"><rb>紫陽花</rb><rt>あじさい</rt></ruby><seg source="#source-933-936">の</seg><ruby type="furigana" rend="right" source="#source-936-948"><rb>咲</rb><rt>さ</rt></ruby><seg source="#source-948-965">くころに、</seg></p>
      <p><ruby type="furigana" rend="right" source="#source-965-983"><rb>私</rb><rt>わたし</rt></ruby><seg source="#source-983-986">は</seg><ruby type="furigana" rend="right" source="#source-986-1001"><rb>姉</rb><rt>ねえ</rt></ruby><seg source="#source-1001-1007">さん</seg><ruby type="furigana" rend="right" source="#source-1007-1022"><rb>思</rb><rt>おも</rt></ruby><seg source="#source-1022-1025">い</seg><ruby type="furigana" rend="right" source="#source-1025-1037"><rb>出</rb><rt>だ</rt></ruby><seg source="#source-1037-1043">す。</seg></p>
    </body>
