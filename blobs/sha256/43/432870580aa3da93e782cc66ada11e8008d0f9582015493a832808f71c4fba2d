      <div>
        <p source="#source-22527-22586"><ruby type="furigana" rend="right" source="#source-22527-22548"><rb>處女</rb><rt>をとめ</rt></ruby><seg source="#source-22548-22551">ぞ</seg><ruby type="furigana" rend="right" source="#source-22551-22563"><rb>經</rb><rt>へ</rt></ruby><seg source="#source-22563-22586">ぬるおほかたの</seg></p>
        <p source="#source-22586-22636"><seg source="#source-22586-22595">われは</seg><ruby type="furigana" rend="right" source="#source-22595-22616"><rb>夢路</rb><rt>ゆめぢ</rt></ruby><seg source="#source-22616-22636">を越えてけり</seg></p>
        <p source="#source-22636-22671"><seg source="#source-22636-22671">わが世の坂にふりかへり</seg></p>
        <p source="#source-22671-22723"><seg source="#source-22671-22677">いく</seg><ruby type="furigana" rend="right" source="#source-22677-22701"><rb>山河</rb><rt>やまかは</rt></ruby><seg source="#source-22701-22723">をながむれば</seg></p>
        <p source="#source-22723-22776"><ruby type="furigana" rend="right" source="#source-22723-22738"><rb>水</rb><rt>みづ</rt></ruby><ruby type="furigana" rend="right" source="#source-22738-22753"><rb>靜</rb><rt>しづ</rt></ruby><seg source="#source-22753-22776">かなる江戸川の</seg></p>
        <p source="#source-22776-22811"><seg source="#source-22776-22811">ながれの岸にうまれいで</seg></p>
        <p source="#source-22811-22852"><seg source="#source-22811-22823">岸の櫻の</seg><ruby type="furigana" rend="right" source="#source-22823-22847"><rb>花影</rb><rt>はなかげ</rt></ruby><seg source="#source-22847-22852">に</seg></p>
        <p source="#source-22852-22967"><seg source="#source-22852-22861">われは</seg><ruby type="furigana" rend="right" source="#source-22861-22882"><rb>處女</rb><rt><app type="base-text-variant" source="#source-22882-22945"><lem>をとめ</lem><rdg type="base-text"><seg source="#source-22930-22939">おとめ</seg></rdg></app></rt></ruby><seg source="#source-22945-22967">となりにけり</seg></p>
        <p source="#source-22967-23038"><ruby type="furigana" rend="right" source="#source-22967-22994"><rb>都鳥</rb><rt>みやこどり</rt></ruby><ruby type="furigana" rend="right" source="#source-22994-23006"><rb>浮</rb><rt>う</rt></ruby><seg source="#source-23006-23009">く</seg><ruby type="furigana" rend="right" source="#source-23009-23033"><rb>大川</rb><rt>おほかは</rt></ruby><seg source="#source-23033-23038">に</seg></p>
        <p source="#source-23038-23085"><seg source="#source-23038-23056">流れてそゝぐ</seg><ruby type="furigana" rend="right" source="#source-23056-23080"><rb>川添</rb><rt>かはぞひ</rt></ruby><seg source="#source-23080-23085">の</seg></p>
        <p source="#source-23085-23147"><ruby type="furigana" rend="right" source="#source-23085-23112"><rb>白菫</rb><rt>しろすみれ</rt></ruby><seg source="#source-23112-23118">さく</seg><ruby type="furigana" rend="right" source="#source-23118-23142"><rb>若草</rb><rt>わかぐさ</rt></ruby><seg source="#source-23142-23147">に</seg></p>
        <p source="#source-23147-23178"><seg source="#source-23147-23178">夢多かりし吾身かな</seg></p>
        <p source="#source-23178-23225"><seg source="#source-23178-23196">雲むらさきの</seg><ruby type="furigana" rend="right" source="#source-23196-23220"><rb>九重</rb><rt>こゝのへ</rt></ruby><seg source="#source-23220-23225">の</seg></p>
