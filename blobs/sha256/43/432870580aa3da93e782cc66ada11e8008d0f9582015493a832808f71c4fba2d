        <p source="#source-67431-67481"><seg source="#source-67431-67452">たがひに蹴合ふ</seg><ruby type="furigana" rend="right" source="#source-67452-67473"><rb>蹴爪</rb><rt>けづめ</rt></ruby><seg source="#source-67473-67481">には</seg></p>
        <p source="#source-67481-67533"><ruby type="furigana" rend="right" source="#source-67481-67502"><rb>火焔</rb><rt>ほのほ</rt></ruby><seg source="#source-67502-67533">もちるとうたがはる</seg></p>
        <p source="#source-67533-67592"><seg source="#source-67533-67542">蹴るや</seg><ruby type="furigana" rend="right" source="#source-67542-67563"><rb>左眼</rb><rt>さがん</rt></ruby><seg source="#source-67563-67566">の</seg><ruby type="furigana" rend="right" source="#source-67566-67581"><rb>的</rb><rt>まと</rt></ruby><seg source="#source-67581-67592">それて</seg></p>
        <p source="#source-67592-67651"><ruby type="furigana" rend="right" source="#source-67592-67607"><rb>羽</rb><rt>はね</rt></ruby><seg source="#source-67607-67622">に血しほの</seg><ruby type="furigana" rend="right" source="#source-67622-67646"><rb>夫鳥</rb><rt>つまどり</rt></ruby><seg source="#source-67646-67651">は</seg></p>
        <p source="#source-67651-67710"><ruby type="furigana" rend="right" source="#source-67651-67666"><rb>敵</rb><rt>てき</rt></ruby><seg source="#source-67666-67669">の</seg><ruby type="furigana" rend="right" source="#source-67669-67690"><rb>右眼</rb><rt>うがん</rt></ruby><seg source="#source-67690-67710">をめざしつゝ</seg></p>
        <p source="#source-67710-67744"><seg source="#source-67710-67744">爪も折れよと蹴返しぬ</seg></p>
        <p source="#source-67744-67782"><seg source="#source-67744-67782">蹴られて落つるくれなゐの</seg></p>
        <p source="#source-67782-67814"><seg source="#source-67782-67814">血汐の花も地に染みて</seg></p>
