        <div type="layout" source="#source-360228-360388" rend="font-size small(1)">
          <p><seg source="#source-360275-360293">わづかに残る</seg><ruby type="furigana" rend="right" source="#source-360293-360314"><rb>礎</rb><rt>いしずゑ</rt></ruby><seg source="#source-360314-360326">に寄せて</seg><ruby type="furigana" rend="right" source="#source-360326-360338"><rb>詠</rb><rt>よ</rt></ruby><seg source="#source-360338-360346">める</seg></p>
        </div>
