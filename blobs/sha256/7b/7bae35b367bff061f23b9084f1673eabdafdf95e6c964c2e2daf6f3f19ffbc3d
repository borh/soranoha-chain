寄屋</rb><rt>すきや</rt></ruby><seg source="#source-8578-8590">がかりの</seg><ruby type="furigana" rend="right" source="#source-8590-8611"><rb>座敷</rb><rt>ざしき</rt></ruby><seg source="#source-8611-8617">へ、</seg><ruby type="furigana" rend="right" source="#source-8617-8638"><rb>折目</rb><rt>をりめ</rt></ruby><seg source="#source-8638-8647">だかな</seg><ruby type="furigana" rend="right" source="#source-8647-8671"><rb>女中</rb><rt>ぢよちう</rt></ruby><seg source="#source-8671-8677">が、</seg><ruby type="furigana" rend="right" source="#source-8677-8701"><rb>何事</rb><rt>なにごと</rt></ruby><seg source="#source-8701-8719">ぞ、コーヒー</seg><ruby type="furigana" rend="right" source="#source-8719-8734"><rb>入</rb><rt>いり</rt></ruby><seg source="#source-8734-8737">の</seg><ruby type="furigana" rend="right" source="#source-8737-8767"><rb>角砂糖</rb><rt>かくざたう</rt></ruby><seg source="#source-8767-8770">を</seg><ruby type="furigana" rend="right" source="#source-8770-8785"><rb>捧</rb><rt>さゝ</rt></ruby><seg source="#source-8785-8791">げて</seg><ruby type="furigana" rend="right" source="#source-8791-8803"><rb>出</rb><rt>で</rt></ruby><seg source="#source-8803-8836">た。――シユウとあわが</seg><ruby type="furigana" rend="right" source="#source-8836-8848"><rb>立</rb><rt>た</rt></ruby><seg source="#source-8848-8857">つて、</seg><ruby type="furigana" rend="right" source="#source-8857-8872"><rb>黒</rb><rt>くろ</rt></ruby><seg source="#source-8872-8884">いしるの</seg><ruby type="furigana" rend="right" source="#source-8884-8899"><rb>溢</rb><rt>あふ</rt></ruby><seg source="#source-8899-8902">れ</seg><ruby type="furigana" rend="right" source="#source-8902-8914"><rb>出</rb><rt>で</rt></ruby><seg source="#source-8914-8923">るのを</seg><ruby type="furigana" rend="right" source="#source-8923-8938"><rb>匙</rb><rt>さぢ</rt></ruby><seg source="#source-8938-8956">でかきまはす</seg><ruby type="furigana" rend="right" source="#source-8956-8971"><rb>代</rb><rt>しろ</rt></ruby><seg source="#source-8971-8989">ものである。</seg><ruby type="furigana" rend="right" source="#source-8989-9010"><rb>以來</rb><rt>いらい</rt></ruby><seg source="#source-9010-9013">、</seg><hi rend="bouten 丸傍点 right" source="#source-9013-9058"><seg source="#source-9013-9022">ひこつ</seg></hi><seg source="#source-9058-9061">の</seg><ruby type="furigana" rend="right" source="#source-9061-9094"><rb>名古屋通</rb><rt>なごやつう</rt></ruby><seg source="#source-9094-9103">を、（</seg><ruby type="furigana" rend="right" source="#source-9103-9118"><rb>角</rb><rt>かく</rt></ruby><seg source="#source-9118-9130">はま）と</seg><ruby type="furigana" rend="right" source="#source-9130-9142"><rb>言</rb><rt>い</rt></ruby><seg source="#source-9142-9162">ふのである。</seg></p>
