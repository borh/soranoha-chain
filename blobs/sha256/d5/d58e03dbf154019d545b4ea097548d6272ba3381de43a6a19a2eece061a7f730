  <text>
    <body>
      <p><seg source="#source-355-396">かみのすくない　カテリーナ</seg></p>
      <p><seg source="#source-396-422">おもてにでたら、</seg></p>
      <p><seg source="#source-422-442">かぜがきて、</seg></p>
      <p><seg source="#source-442-492">だいじな　だいじな　かみのけを、</seg></p>
      <p><seg source="#source-492-506">いつぽん</seg></p>
      <p><seg source="#source-506-520">いつぽん</seg></p>
      <p><seg source="#source-520-540">ふいたので、</seg></p>
      <p><seg source="#source-540-563">かなしくなつて</seg></p>
      <p><seg source="#source-563-583">ないてたら、</seg></p>
      <p><seg source="#source-583-589">たう</seg><choice source="#source-589-595"><orig>／＼</orig><reg>〱</reg></choice><seg source="#source-595-606">かぜを</seg></p>
      <p><seg source="#source-606-624">ひきました。</seg></p>
    </body>
