by type="furigana" rend="right" source="#source-4201-4216"><rb>果</rb><rt>はた</rt></ruby><seg source="#source-4216-4234">さず。丁酉の</seg><ruby type="furigana" rend="right" source="#source-4234-4255"><rb>晩夏</rb><rt>ばんか</rt></ruby><ruby type="furigana" rend="right" source="#source-4255-4270"><rb>遂</rb><rt>つひ</rt></ruby><seg source="#source-4270-4273">に</seg><ruby type="furigana" rend="right" source="#source-4273-4294"><rb>豚児</rb><rt>せがれ</rt></ruby><seg source="#source-4294-4303">京水を</seg><ruby type="furigana" rend="right" source="#source-4303-4324"><rb>従</rb><rt>したがへ</rt></ruby><seg source="#source-4324-4327">て</seg><seg type="annotated-text" source="#source-4351-4408"><ruby type="furigana" rend="right" source="#source-4327-4351"><rb>啓行</rb><rt>けいかう</rt></ruby><note type="gloss" place="left"><seg source="#source-4381-4393">タビタチ</seg></note></seg><seg source="#source-4408-4414">す。</seg><ruby type="furigana" rend="right" source="#source-4414-4432"><rb>始</rb><rt>はじめ</rt></ruby><seg source="#source-4432-4447">には越後の</seg><seg type="annotated-text" source="#source-4474-4531"><ruby type="furigana" rend="right" source="#source-4447-4474"><rb>諸勝</rb><rt>しよしよう</rt></ruby><note type="gloss" place="left"><seg source="#source-4504-4516">メイシヨ</seg></note></seg><seg source="#source-4531-4534">を</seg><ruby type="furigana" rend="right" source="#source-4534-4549"><rb>尽</rb><rt>つく</rt></ruby><seg source="#source-4549-4573">さんと思ひしが、</seg><ruby type="furigana" rend="right" source="#source-4573-4594"><rb>越地</rb><rt>ゑつち</rt></ruby><seg source="#source-4594-4603">に入し</seg><ruby type="furigana" rend="right" source="#source-4603-4618"><rb>後</rb><rt>のち</rt></ruby><seg source="#source-4618-4621">、</seg><ruby type="furigana" rend="right" source="#source-4621-4636"><rb>年</rb><rt>とし</rt></ruby><ruby type="furigana" rend="right" source="#source-4636-4651"><rb>稍</rb><rt>やゝ</rt></ruby><seg type="annotated-text" source="#source-4666-4717"><ruby type="furigana" rend="right" source="#source-4651-4666"><rb>侵</r