by><seg source="#source-23928-23937">だな、</seg><ruby type="furigana" rend="right" source="#source-23937-23955"><rb>通夜</rb><rt>つや</rt></ruby><seg source="#source-23955-23958">の</seg><ruby type="furigana" rend="right" source="#source-23958-23973"><rb>坊</rb><rt>ばう</rt></ruby><seg source="#source-23973-23982">さんが</seg><ruby type="furigana" rend="right" source="#source-23982-23997"><rb>酒</rb><rt>さけ</rt></ruby><seg source="#source-23997-24000">に</seg><ruby type="furigana" rend="right" source="#source-24000-24024"><rb>酔倒</rb><rt>ゑひたふ</rt></ruby><seg source="#source-24024-24030">れて</seg><ruby type="furigana" rend="right" source="#source-24030-24042"><rb>居</rb><rt>ゐ</rt></ruby><seg source="#source-24042-24048">る、</seg><ruby type="furigana" rend="right" source="#source-24048-24072"><rb>炮砥</rb><rt>はうろく</rt></ruby><seg source="#source-24072-24075">に</seg><ruby type="furigana" rend="right" source="#source-24075-24099"><rb>線香</rb><rt>せんかう</rt></ruby><seg source="#source-24099-24114">をどつさり</seg><ruby type="furigana" rend="right" source="#source-24114-24126"><rb>差</rb><rt>さ</rt></ruby><seg source="#source-24126-24138">して、一</seg><ruby type="furigana" rend="right" source="#source-24138-24165"><rb>本花</rb><rt>ぽんばな</rt></ruby><seg source="#source-24165-24168">に</seg><ruby type="furigana" rend="right" source="#source-24168-24201"><rb>枕団子</rb><rt>まくらだんご</rt></ruby><ruby type="furigana" rend="right" source="#source-24201-24225"><rb>旧弊</rb><rt>きうへい</rt></ruby><seg source="#source-24225-24234">だね、</seg><ruby type="furigana" rend="right" source="#source-24234-24249"><rb>是</rb><rt>これ</rt></ruby><seg source="#source-24249-24264">から思ふと</seg><ruby type="furigana" rend="right" source="#source-24264-24285"><rb>地獄</rb><rt>ぢごく</rt></ruby><seg source="#source-24285-24288">の</seg><ruby type="furigana" rend="right" source="#source-24288-24303"><rb>方</rb><rt>はう</rt></ruby><seg source="#source-24303-24306">が</seg><ruby type="furigana" rend="right" source="#source-24306-24330"><rb>余程</rb><rt>よつぽど</rt></ruby><ruby type="furigana" rend="right" source="#source-24330-24345"><rb>開</rb><rt>ひら</rt></ruby><seg source="#source-24345-24357">けた。と</seg><ruby type="furigana" rend="right" source="#source-24357-24369"><rb>云</rb><rt>い</rt></ruby><seg source="#source-24369-24386">ふお話で。</seg></p>
      <div type="layout" source="#source-24386-24443" style="padding-inline-end: 1em; text-align: right">
        <p><seg source="#source-24416-24443">（拠酒井昇造速記）</seg></p>
      </div>
