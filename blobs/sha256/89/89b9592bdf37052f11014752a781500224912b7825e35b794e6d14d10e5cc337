  <text>
    <body>
      <p source="#source-247-276"><seg source="#source-247-276">ごろぜみ、ごつとん</seg></p>
      <p source="#source-276-292"><seg source="#source-276-292">でろよ。</seg></p>
      <p source="#source-292-318"><seg source="#source-292-318">月夜に、つちから</seg></p>
      <p source="#source-318-334"><seg source="#source-318-334">でろよ。</seg></p>
      <p source="#source-334-375"><ruby type="furigana" rend="right" source="#source-334-352"><rb>合歓</rb><rt>ねむ</rt></ruby><seg source="#source-352-375">の木、ねもとは</seg></p>
      <p source="#source-375-394"><seg source="#source-375-394">にほふよ、</seg></p>
      <p source="#source-394-417"><seg source="#source-394-417">花だか、土だか</seg></p>
      <p source="#source-417-436"><seg source="#source-417-436">にほふよ。</seg></p>
      <p source="#source-436-465"><seg source="#source-436-465">ごろぜみ、ころもを</seg></p>
      <p source="#source-465-481"><seg source="#source-465-481">ぬげよ。</seg></p>
      <p source="#source-481-507"><seg source="#source-481-507">月夜は、つーいと</seg></p>
      <p source="#source-507-519"><seg source="#source-507-519">なけよ。</seg></p>
    </body>
