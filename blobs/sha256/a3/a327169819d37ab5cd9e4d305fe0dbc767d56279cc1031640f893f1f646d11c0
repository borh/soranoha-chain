>せつしやうだうぐ</rt></ruby><seg source="#source-21767-21770">に</seg><ruby type="furigana" rend="right" source="#source-21770-21794"><rb>阿彌陀</rb><rt>あみだ</rt></ruby><seg source="#source-21794-21797">は</seg><ruby type="furigana" rend="right" source="#source-21797-21809"><rb>奇</rb><rt>き</rt></ruby><seg source="#source-21809-21824">なり。……</seg><ruby type="furigana" rend="right" source="#source-21824-21851"><rb>黒海老</rb><rt>くろえび</rt></ruby><seg source="#source-21851-21866">、むかで、</seg><ruby type="furigana" rend="right" source="#source-21866-21881"><rb>暗</rb><rt>やみ</rt></ruby><seg source="#source-21881-21896">がらす、と</seg><ruby type="furigana" rend="right" source="#source-21896-21920"><rb>不氣味</rb><rt>ぶきみ</rt></ruby><seg source="#source-21920-21932">になり、</seg><ruby type="furigana" rend="right" source="#source-21932-21956"><rb>黒虎</rb><rt>くろとら</rt></ruby><seg source="#source-21956-21959">、</seg><ruby type="furigana" rend="right" source="#source-21959-21986"><rb>青蜘蛛</rb><rt>あをぐも</rt></ruby><seg source="#source-21986-22007">とすごくなる。</seg><ruby type="furigana" rend="right" source="#source-22007-22034"><rb>就中</rb><rt>なかんづく</rt></ruby><seg source="#source-22034-22058">、ねうちものは、</seg><ruby type="furigana" rend="right" source="#source-22058-22079"><rb>毛卷</rb><rt>けまき</rt></ruby><seg source="#source-22079-22097">におしどりの</seg><ruby type="furigana" rend="right" source="#source-22097-22118"><rb>羽毛</rb><rt>うまう</rt></ruby><seg source="#source-22118-22121">を</seg><ruby type="furigana" rend="right" source="#source-22121-22142"><rb>加工</rb><rt>かこう</rt></ruby><seg source="#source-22142-22154">するが、</seg><ruby type="furigana" rend="right" source="#source-22154-22178"><rb>河蝉</rb><rt>かはせみ</rt></ruby><seg source="#source-22178-22181">の</seg><ruby type="furigana" rend="right" source="#source-22181-22196"><rb>羽</rb><rt>はね</rt></ruby><seg source="#source-22196-22202">は、</seg><ruby type="furigana" rend="right" source="#source-22202-22229"><rb>職人</rb><rt>しよくにん</rt></ruby><seg source="#source-22229-22244">のもつとも</seg><r