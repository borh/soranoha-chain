      <p><seg source="#source-379-385">一　</seg><ruby type="furigana" rend="right" source="#source-385-406"><rb>真白</rb><rt>ましろ</rt></ruby><seg source="#source-406-409">き</seg><ruby type="furigana" rend="right" source="#source-409-427"><rb>富士</rb><rt>ふじ</rt></ruby><seg source="#source-427-430">の</seg><ruby type="furigana" rend="right" source="#source-430-442"><rb>根</rb><rt>ね</rt></ruby><seg source="#source-442-445">　</seg><ruby type="furigana" rend="right" source="#source-445-463"><rb>緑</rb><rt>みどり</rt></ruby><seg source="#source-463-466">の</seg><ruby type="furigana" rend="right" source="#source-466-478"><rb>江</rb><rt>え</rt></ruby><seg source="#source-478-481">の</seg><ruby type="furigana" rend="right" source="#source-481-496"><rb>島</rb><rt>しま</rt></ruby></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)"><ruby type="furigana" rend="right" source="#source-504-519"><rb>仰</rb><rt>あお</rt></ruby><seg source="#source-519-534">ぎ見るも　</seg><ruby type="furigana" rend="right" source="#source-534-549"><rb>今</rb><rt>いま</rt></ruby><seg source="#source-549-552">は</seg><ruby type="furigana" rend="right" source="#source-552-570"><rb>涙</rb><rt>なみだ</rt></ruby></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)"><seg source="#source-572-599">帰らぬ十二の　</seg><ruby type="furigana" rend="right" source="#source-599-617"><rb>雄々</rb><rt>おお</rt></ruby><seg source="#source-617-637">しきみたまに</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)"><ruby type="furigana" rend="right" source="#source-643-658"><rb>捧</rb><rt>ささ</rt></ruby><seg source="#source-658-673">げまつる　</seg><ruby type="furigana" rend="right" source="#source-673-688"><rb>胸</rb><rt>むね</rt></ruby><seg source="#source-688-691">と</seg><ruby type="furigana" rend="right" source="#source-691-709"><rb>心</rb><rt>こころ</rt></ruby></p>
      <p><seg source="#source-713-731">二　ボートは</seg><ruby type="furigana" rend="right" source="#source-731-746"><rb>沈</rb><rt>しず</rt></ruby><seg source="#source-746-755">みぬ　</seg><ruby type="furigana" rend="right" source="#source-755-776"><rb>千尋</rb><rt>ちひろ</rt></ruby><seg source="#source-776-779">の</seg><ruby type="furigana" rend="right" source="#source-779-803"><rb>海原</rb><rt>うなばら</rt></ruby></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)"><seg source="#source-805-817">風も</seg><ruby type="furigana" rend="right" source="#source-817-832"><rb>浪</rb><rt>なみ</rt></ruby><seg source="#source-832-838">も　</seg><ruby type="furigana" rend="right" source="#source-838-850"><rb>小</rb><rt>ち</rt></ruby><seg source="#source-850-856">さき</seg><ruby type="furigana" rend="right" source="#source-856-871"><rb>腕</rb><rt>うで</rt></ruby><seg source="#source-871-876">に</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)"><seg source="#source-876-903">力もつきはて　</seg><ruby type="furigana" rend="right" source="#source-903-915"><rb>呼</rb><rt>よ</rt></ruby><seg source="#source-915-918">ぶ</seg><ruby type="furigana" rend="right" source="#source-918-930"><rb>名</rb><rt>な</rt></ruby><seg source="#source-930-933">は</seg><ruby type="furigana" rend="right" source="#source-933-957"><rb>父母</rb><rt>ちちはは</rt></ruby></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)"><ruby type="furigana" rend="right" source="#source-965-983"><rb>恨</rb><rt>うらみ</rt></ruby><seg source="#source-983-986">は</seg><ruby type="furigana" rend="right" source="#source-986-1001"><rb>深</rb><rt>ふか</rt></ruby><seg source="#source-1001-1007">し　</seg><ruby type="furigana" rend="right" source="#source-1007-1028"><rb>七里</rb><rt>しちり</rt></ruby><seg source="#source-1028-1031">が</seg><ruby type="furigana" rend="right" source="#source-1031-1052"><rb>浜辺</rb><rt>はまべ</rt></ruby></p>
      <p><seg source="#source-1056-1065">三　み</seg><ruby type="furigana" rend="right" source="#source-1065-1080"><rb>雪</rb><rt>ゆき</rt></ruby><seg source="#source-1080-1083">は</seg><ruby type="furigana" rend="right" source="#source-1083-1098"><rb>咽</rb><rt>むせ</rt></ruby><seg source="#source-1098-1116">びぬ　風さえ</seg><ruby type="furigana" rend="right" source="#source-1116-1131"><rb>騒</rb><rt>さわ</rt></ruby><seg source="#source-1131-1139">ぎて</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)"><seg source="#source-1139-1160">月も星も　</seg><ruby type="furigana" rend="right" source="#source-1160-1175"><rb>影</rb><rt>かげ</rt></ruby><seg source="#source-1175-1189">をひそめ</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)"><seg source="#source-1189-1207">みたまよ</seg><ruby type="furigana" rend="right" source="#source-1207-1228"><rb>何処</rb><rt>いずこ</rt></ruby><seg source="#source-1228-1234">に　</seg><ruby type="furigana" rend="right" source="#source-1234-1249"><rb>迷</rb><rt>まよ</rt></ruby><seg source="#source-1249-1269">いておわすか</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)"><seg source="#source-1269-1306">帰れ早く　母の胸に</seg></p>
      <p><seg source="#source-1306-1339">四　みそらにかがやく　</seg><ruby type="furigana" rend="right" source="#source-1339-1360"><rb>朝日</rb><rt>あさひ</rt></ruby><seg source="#source-1360-1366">のみ</seg><ruby type="furigana" rend="right" source="#source-1366-1381"><rb>光</rb><rt>ひか</rt></ruby><seg source="#source-1381-1386">り</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)"><ruby type="furigana" rend="right" source="#source-1392-1407"><rb>暗</rb><rt>やみ</rt></ruby><seg source="#source-1407-1433">にしずむ　親の心</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)"><ruby type="furigana" rend="right" source="#source-1439-1460"><rb>黄金</rb><rt>こがね</rt></ruby><seg source="#source-1460-1463">も</seg><ruby type="furigana" rend="right" source="#source-1463-1481"><rb>宝</rb><rt>たから</rt></ruby><seg source="#source-1481-1487">も　</seg><ruby type="furigana" rend="right" source="#source-1487-1502"><rb>何</rb><rt>なに</rt></ruby><seg source="#source-1502-1508">しに</seg><ruby type="furigana" rend="right" source="#source-1508-1523"><rb>集</rb><rt>あつ</rt></ruby><seg source="#source-1523-1531">めん</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)"><seg source="#source-1531-1552">神よ早く　</seg><ruby type="furigana" rend="right" source="#source-1552-1567"><rb>我</rb><rt>われ</rt></ruby><seg source="#source-1567-1570">も</seg><ruby type="furigana" rend="right" source="#source-1570-1582"><rb>召</rb><rt>め</rt></ruby><seg source="#source-1582-1592">せよ</seg></p>
      <p><seg source="#source-1592-1598">五　</seg><ruby type="furigana" rend="right" source="#source-1598-1619"><rb>雲間</rb><rt>くもま</rt></ruby><seg source="#source-1619-1622">に</seg><ruby type="furigana" rend="right" source="#source-1622-1637"><rb>昇</rb><rt>のぼ</rt></ruby><seg source="#source-1637-1646">りし　</seg><ruby type="furigana" rend="right" source="#source-1646-1667"><rb>昨日</rb><rt>きのう</rt></ruby><seg source="#source-1667-1670">の</seg><ruby type="furigana" rend="right" source="#source-1670-1694"><rb>月影</rb><rt>つきかげ</rt></ruby></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)"><seg source="#source-1696-1731">今は見えぬ　人の姿</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)"><seg source="#source-1731-1746">悲しさ</seg><ruby type="furigana" rend="right" source="#source-1746-1761"><rb>余</rb><rt>あま</rt></ruby><seg source="#source-1761-1770">りて　</seg><ruby type="furigana" rend="right" source="#source-1770-1782"><rb>寝</rb><rt>ね</rt></ruby><seg source="#source-1782-1791">られぬ</seg><ruby type="furigana" rend="right" source="#source-1791-1809"><rb>枕</rb><rt>まくら</rt></ruby><seg source="#source-1809-1814">に</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)"><ruby type="furigana" rend="right" source="#source-1820-1835"><rb>響</rb><rt>ひび</rt></ruby><seg source="#source-1835-1866">く波の　おとも高し</seg></p>
      <p><seg source="#source-1866-1881">六　帰らぬ</seg><ruby type="furigana" rend="right" source="#source-1881-1902"><rb>浪路</rb><rt>なみじ</rt></ruby><seg source="#source-1902-1908">に　</seg><ruby type="furigana" rend="right" source="#source-1908-1923"><rb>友</rb><rt>とも</rt></ruby><seg source="#source-1923-1929">よぶ</seg><ruby type="furigana" rend="right" source="#source-1929-1950"><rb>千鳥</rb><rt>ちどり</rt></ruby><seg source="#source-1950-1955">に</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)"><ruby type="furigana" rend="right" source="#source-1961-1976"><rb>我</rb><rt>われ</rt></ruby><seg source="#source-1976-1991">もこいし　</seg><ruby type="furigana" rend="right" source="#source-1991-2003"><rb>失</rb><rt>う</rt></ruby><seg source="#source-2003-2017">せし人よ</seg></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)"><ruby type="furigana" rend="right" source="#source-2023-2035"><rb>尽</rb><rt>つ</rt></ruby><seg source="#source-2035-2044">きせぬ</seg><ruby type="furigana" rend="right" source="#source-2044-2062"><rb>恨</rb><rt>うらみ</rt></ruby><seg source="#source-2062-2080">に　泣くねは</seg><ruby type="furigana" rend="right" source="#source-2080-2104"><rb>共々</rb><rt>ともども</rt></ruby></p>
      <p style="text-indent: 2em" rend="first-line-indent(2)"><ruby type="furigana" rend="right" source="#source-2112-2133"><rb>今日</rb><rt>きょう</rt></ruby><seg source="#source-2133-2148">もあすも　</seg><ruby type="furigana" rend="right" source="#source-2148-2160"><rb>斯</rb><rt>か</rt></ruby><seg source="#source-2160-2179">くてとわに</seg></p>
      <div type="layout" source="#source-2179-2321" style="padding-inline-start: 10em">
        <p><hi rend="font-size small(1)" snh:layout-kind="font-size" snh:layout-params="size-type=small;level=1" source="#source-2203-2321"><seg source="#source-2236-2245">――明</seg><hi rend="text-combine-upright" snh:layout-kind="tcy" source="#source-2245-2276"><seg source="#source-2245-2247">43</seg></hi><seg source="#source-2276-2288">・２発表</seg></hi></p>
      </div>
