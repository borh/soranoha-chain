  <text>
    <body>
      <p><seg source="#source-475-495">おかみさん。</seg></p>
      <p><seg source="#source-495-524">とりのおかみさん。</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)"><seg source="#source-524-550">ぼうしかぶつて</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)"><seg source="#source-550-559">ぶら</seg><choice source="#source-559-565"><orig>／＼</orig><reg>〱</reg></choice></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)"><seg source="#source-567-587">かごさげて</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)"><seg source="#source-587-610">なにをかひに</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)"><seg source="#source-610-639">どこへゆきます。</seg></p>
      <p><seg source="#source-639-656">坊ちやん。</seg></p>
      <p><seg source="#source-656-673">坊ちやん。</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)"><seg source="#source-673-699">ぼうしかぶつて</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)"><seg source="#source-699-708">ぶら</seg><choice source="#source-708-714"><orig>／＼</orig><reg>〱</reg></choice></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)"><seg source="#source-716-736">かごさげて</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)"><seg source="#source-736-762">むかふの市場へ</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)"><seg source="#source-762-794">卵かひにゆきます。</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)"><seg source="#source-794-800">自</seg><seg type="annotated-text" source="#source-803-845"><seg source="#source-800-803">働</seg><note type="gloss"><seg source="#source-824-830">ママ</seg></note></seg><seg source="#source-845-880">車の卵かひにゆきます。</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)"><seg source="#source-880-921">電車の卵かひにゆきます。</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)"><seg source="#source-921-965">飛行機の卵かひにゆきます。</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)"><seg source="#source-965-1012">おはなしの卵かひにゆきます。</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)"><seg source="#source-1012-1042">はい。さやうなら。</seg></p>
    </body>
