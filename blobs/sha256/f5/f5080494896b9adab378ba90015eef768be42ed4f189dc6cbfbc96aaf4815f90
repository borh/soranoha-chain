      <p source="#source-30-41"><seg source="#source-30-41">ふゆが</seg></p>
      <p source="#source-41-55"><seg source="#source-41-55">きたとて</seg></p>
      <p source="#source-55-68"><seg source="#source-55-68">木は裸</seg></p>
      <p source="#source-68-76"><seg source="#source-68-76">春に</seg></p>
      <p source="#source-76-90"><seg source="#source-76-90">なるまで</seg></p>
      <p source="#source-90-103"><seg source="#source-90-103">木は裸</seg></p>
      <p source="#source-103-117"><seg source="#source-103-117">ちらちら</seg></p>
      <p source="#source-117-125"><seg source="#source-117-125">雪が</seg></p>
      <p source="#source-125-144"><seg source="#source-125-144">ふつてきて</seg></p>
      <p source="#source-144-155"><seg source="#source-144-155">はなを</seg></p>
      <p source="#source-155-169"><seg source="#source-155-169">きものに</seg></p>
      <p source="#source-169-188"><seg source="#source-169-188">きるけれど</seg></p>
      <p source="#source-188-199"><seg source="#source-188-199">それが</seg></p>
      <p source="#source-199-213"><seg source="#source-199-213">消えると</seg></p>
      <p source="#source-213-225"><seg source="#source-213-225">また、裸</seg></p>
    </body>
