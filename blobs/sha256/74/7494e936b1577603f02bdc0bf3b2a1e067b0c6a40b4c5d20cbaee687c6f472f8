      <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-39791-40243"><seg source="#source-39791-39815">こういっている</seg><ruby type="furigana" rend="right" source="#source-39815-39830"><rb>時</rb><rt>とき</rt></ruby><seg source="#source-39830-39860">に、ひよどりのような</seg><ruby type="furigana" rend="right" source="#source-39860-39875"><rb>鳥</rb><rt>とり</rt></ruby><seg source="#source-39875-39890">がたくさん</seg><ruby type="furigana" rend="right" source="#source-39890-39905"><rb>空</rb><rt>そら</rt></ruby><seg source="#source-39905-39926">の上をかけって</seg><ruby type="furigana" rend="right" source="#source-39926-39938"><rb>来</rb><rt>き</rt></ruby><seg source="#source-39938-39950">ました。</seg><ruby type="furigana" rend="right" source="#source-39950-39974"><rb>為朝</rb><rt>ためとも</rt></ruby><seg source="#source-39974-39986">はもって</seg><ruby type="furigana" rend="right" source="#source-39986-39998"><rb>来</rb><rt>き</rt></ruby><seg source="#source-39998-40001">た</seg><ruby type="furigana" rend="right" source="#source-40001-40016"><rb>弓</rb><rt>ゆみ</rt></ruby><seg source="#source-40016-40019">に</seg><ruby type="furigana" rend="right" source="#source-40019-40031"><rb>矢</rb><rt>や</rt></ruby><seg source="#source-40031-40049">をつがえて、</seg><ruby type="furigana" rend="right" source="#source-40049-40064"><rb>鳥</rb><rt>とり</rt></ruby><seg source="#source-40064-40067">に</seg><ruby type="furigana" rend="right" source="#source-40067-40079"><rb>向</rb><rt>む</rt></ruby><seg source="#source-40079-40088">かって</seg><ruby type="furigana" rend="right" source="#source-40088-40100"><rb>射</rb><rt>い</rt></ruby><seg source="#source-40100-40130">かけますと、すぐ五六</seg><ruby type="furigana" rend="right" source="#source-40130-40145"><rb>羽</rb><rt>ぱ</rt></ruby><seg source="#source-40145-40160">ばたばたと</seg><ruby type="furigana" rend="right" source="#source-40160-40175"><rb>重</rb><rt>かさ</rt></ruby><seg source="#source-40175-40181">なり</seg><ruby type="furigana" rend="right" source="#source-40181-40193"><rb>合</rb><rt>あ</rt></ruby><seg source="#source-40193-40199">って</seg><ruby type="furigana" rend="right" source="#source-40199-40211"><rb>落</rb><rt>お</rt></ruby><seg source="#source-40211-40217">ちて</seg><ruby type="furigana" rend="right" source="#source-40217-40229"><rb>来</rb><rt>き</rt></ruby><seg source="#source-40229-40243">ました。</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-40243-40692"><ruby type="furigana" rend="right" source="#source-40246-40261"><rb>島</rb><rt>しま</rt></ruby><seg source="#source-40261-40264">の</seg><ruby type="furigana" rend="right" source="#source-40264-40291"><rb>大男</rb><rt>おおおとこ</rt></ruby><seg source="#source-40291-40294">は</seg><ruby type="furigana" rend="right" source="#source-40294-40315"><rb>弓矢</rb><rt>ゆみや</rt></ruby><seg source="#source-40315-40318">を</seg><ruby type="furigana" rend="right" source="#source-40318-40330"><rb>見</rb><rt>み</rt></ruby><seg source="#source-40330-40339">たのは</seg><ruby type="furigana" rend="right" source="#source-40339-40354"><rb>初</rb><rt>はじ</rt></ruby><seg source="#source-40354-40393">めてなので、目をまるくして</seg><ruby type="furigana" rend="right" source="#source-40393-40405"><rb>見</rb><rt>み</rt></ruby><seg source="#source-40405-40426">ていましたが、</seg><ruby type="furigana" rend="right" source="#source-40426-40441"><rb>空</rb><rt>そら</rt></ruby><seg source="#source-40441-40444">を</seg><ruby type="furigana" rend="right" source="#source-40444-40456"><rb>飛</rb><rt>と</rt></ruby><seg source="#source-40456-40480">んでいるものが、</seg><ruby type="furigana" rend="right" source="#source-40480-40498"><rb>射落</rb><rt>いお</rt></ruby><seg source="#source-40498-40516">とされたのを</seg><ruby type="furigana" rend="right" source="#source-40516-40528"><rb>見</rb><rt>み</rt></ruby><seg source="#source-40528-40534">て、</seg><ruby type="furigana" rend="right" source="#source-40534-40549"><rb>舌</rb><rt>した</rt></ruby><seg source="#source-40549-40597">をまいておじおそれました。そして</seg><ruby type="furigana" rend="right" source="#source-40597-40621"><rb>為朝</rb><rt>ためとも</rt></ruby><seg source="#source-40621-40624">を</seg><ruby type="furigana" rend="right" source="#source-40624-40639"><rb>神</rb><rt>かみ</rt></ruby><seg source="#source-40639-40657">さまのように</seg><ruby type="furigana" rend="right" source="#source-40657-40675"><rb>敬</rb><rt>うやま</rt></ruby><seg source="#source-40675-4