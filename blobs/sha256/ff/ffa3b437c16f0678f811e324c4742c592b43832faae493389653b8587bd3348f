      <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-49863-50544"><ruby type="furigana" rend="right" source="#source-49866-49878"><rb>日</rb><rt>ひ</rt></ruby><seg source="#source-49878-49881">は</seg><ruby type="furigana" rend="right" source="#source-49881-49893"><rb>暮</rb><rt>く</rt></ruby><seg source="#source-49893-49908">れかゝつて</seg><ruby type="furigana" rend="right" source="#source-49908-49923"><rb>雨</rb><rt>あめ</rt></ruby><seg source="#source-49923-49926">は</seg><ruby type="furigana" rend="right" source="#source-49926-49980"><rb><seg source="#source-49926-49929">益</seg><g ref="#gaiji-1-2-22" source="#source-49929-49962">〻</g></rb><rt><seg source="#source-49965-49971">ます</seg><choice source="#source-49971-49977"><orig>／＼</orig><reg>〱</reg></choice></rt></ruby><ruby type="furigana" rend="right" source="#source-49980-49995"><rb>強</rb><rt>つよ</rt></ruby><seg source="#source-49995-50010">くなつた。</seg><ruby type="furigana" rend="right" source="#source-50010-50034"><rb>山々</rb><rt><seg source="#source-50019-50025">やま</seg><choice source="#source-50025-50031"><orig>／＼</orig><reg>〱</reg></choice></rt></ruby><seg source="#source-50034-50037">は</seg><ruby type="furigana" rend="right" source="#source-50037-50061"><rb>悉</rb><rt><seg source="#source-50043-50049">こと</seg><choice source="#source-50049-50058"><orig>／″＼</orig><reg>〲</reg></choice></rt></ruby><seg source="#source-50061-50064">く</seg><ruby type="furigana" rend="right" source="#source-50064-50079"><rb>雲</rb><rt>くも</rt></ruby><seg source="#source-50079-50082">に</seg><ruby type="furigana" rend="right" source="#source-50082-50097"><rb>埋</rb><rt>うも</rt></ruby><seg source="#source-50097-50103">れて</seg><ruby type="furigana" rend="right" source="#source-50103-50118"><rb>僅</rb><rt>わづ</rt></ruby><seg source="#source-50118-50124">かに</seg><ruby type="furigana" rend="right" source="#source-50124-50151"><rb>其麓</rb><rt>そのふもと</rt></ruby><seg source="#source-50151-50154">を</seg><ruby type="furigana" rend="right" so