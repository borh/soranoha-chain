        <p><app type="base-text-variant" source="#source-767-815"><lem><ruby type="furigana" rend="right" source="#source-740-767"><rb>高粱</rb><rt>かうりゃう</rt></ruby></lem><rdg type="base-text"><seg source="#source-803-809">高梁</seg></rdg></app><seg source="#source-815-818">の</seg><ruby type="furigana" rend="right" source="#source-818-836"><rb>畠</rb><rt>はたけ</rt></ruby><seg source="#source-836-839">を</seg><ruby type="furigana" rend="right" source="#source-839-851"><rb>分</rb><rt>わ</rt></ruby><seg source="#source-851-857">けて</seg><ruby type="furigana" rend="right" source="#source-857-878"><rb>銃架</rb><rt>じうか</rt></ruby><seg source="#source-878-881">の</seg><ruby type="furigana" rend="right" source="#source-881-896"><rb>影</rb><rt>かげ</rt></ruby><seg source="#source-896-908">はけふも</seg><ruby type="furigana" rend="right" source="#source-908-923"><rb>続</rb><rt>つゞ</rt></ruby><seg source="#source-923-929">いて</seg><ruby type="furigana" rend="right" source="#source-929-941"><rb>行</rb><rt>ゆ</rt></ruby><seg source="#source-941-946">く</seg></p>
