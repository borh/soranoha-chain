><seg source="#source-28331-28334">の</seg><ruby type="furigana" rend="right" source="#source-28334-28349"><rb>棟</rb><rt>むね</rt></ruby><seg source="#source-28349-28352">は</seg><ruby type="furigana" rend="right" source="#source-28352-28370"><rb>櫻</rb><rt>さくら</rt></ruby><seg source="#source-28370-28373">の</seg><ruby type="furigana" rend="right" source="#source-28373-28385"><rb>葉</rb><rt>は</rt></ruby><seg source="#source-28385-28388">の</seg><ruby type="furigana" rend="right" source="#source-28388-28403"><rb>中</rb><rt>なか</rt></ruby><seg source="#source-28403-28406">に</seg><ruby type="furigana" rend="right" source="#source-28406-28421"><rb>顯</rb><rt>あら</rt></ruby><seg source="#source-28421-28433">はれて、</seg><ruby type="furigana" rend="right" source="#source-28433-28448"><rb>朱</rb><rt>しゆ</rt></ruby><seg source="#source-28448-28451">を</seg><ruby type="furigana" rend="right" source="#source-28451-28463"><rb>塗</rb><rt>ぬ</rt></ruby><seg source="#source-28463-28478">つたやうな</seg><ruby type="furigana" rend="right" source="#source-28478-28499"><rb>二階</rb><rt>にかい</rt></ruby><seg source="#source-28499-28502">の</seg><ruby type="furigana" rend="right" source="#source-28502-28526"><rb>障子</rb><rt>しやうじ</rt></ruby><seg source="#source-28526-28538">が、いま</seg><ruby type="furigana" rend="right" source="#source-28538-28550"><rb>其</rb><rt>そ</rt></ruby><seg source="#source-28550-28553">の</seg><ruby type="furigana" rend="right" source="#source-28553-28568"><rb>影</rb><rt>かげ</rt></ruby><seg source="#source-28568-28577">にやゝ</seg><ruby type="furigana" rend="right" source="#source-28577-28592"><rb>薄</rb><rt>うす</rt></ruby><seg source="#source-28592-28601">れて、</seg><ruby type="furigana" rend="right" source="#source-28601-28616"><rb>凄</rb><rt>すご</rt></ruby><seg source="#source-28616-28622">くも</seg><ruby type="furigana" rend="right" source="#source-28622-28637"><rb>優</rb><rt>やさ</rt></ruby><seg source="#source-28637-28646">しい、</seg><ruby type="furigana" rend="right" source="#source-28646-28658"><rb>威</rb><r