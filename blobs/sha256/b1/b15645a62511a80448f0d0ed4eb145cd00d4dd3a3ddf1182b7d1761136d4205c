rigana" rend="right" source="#source-45346-45361"><rb>唯</rb><rt>たゞ</rt></ruby><ruby type="furigana" rend="right" source="#source-45361-45385"><rb>此時</rb><rt>このとき</rt></ruby><seg source="#source-45385-45388">、</seg><ruby type="furigana" rend="right" source="#source-45388-45409"><rb>大路</rb><rt>おほぢ</rt></ruby><seg source="#source-45409-45412">を</seg><ruby type="furigana" rend="right" source="#source-45412-45427"><rb>時</rb><rt>とき</rt></ruby><seg source="#source-45427-45430">に</seg><ruby type="furigana" rend="right" source="#source-45430-45445"><rb>響</rb><rt>ひゞ</rt></ruby><seg source="#source-45445-45460">いたのは、</seg><ruby type="furigana" rend="right" source="#source-45460-45487"><rb>肅然</rb><rt>しゆくぜん</rt></ruby><seg source="#source-45487-45493">たる</seg><ruby type="furigana" rend="right" source="#source-45493-45511"><rb>騎馬</rb><rt>きば</rt></ruby><seg source="#source-45511-45526">のひづめの</seg><ruby type="furigana" rend="right" source="#source-45526-45541"><rb>音</rb><rt>おと</rt></ruby><seg source="#source-45541-45553">である。</seg><ruby type="furigana" rend="right" source="#source-45553-45565"><rb>火</rb><rt>ひ</rt></ruby><seg source="#source-45565-45580">のあかりに</seg><ruby type="furigana" rend="right" source="#source-45580-45595"><rb>映</rb><rt>うつ</rt></ruby><seg source="#source-45595-45604">るのは</seg><ruby type="furigana" rend="right" source="#source-45604-45622"><rb>騎士</rb><rt>きし</rt></ruby><seg source="#source-45622-45625">の</seg><ruby type="furigana" rend="right" source="#source-45625-45652"><rb>直劍</rb><rt>ちよくけん</rt></ruby><seg source="#source-45652-45655">の</seg><ruby type="furigana" rend="right" source="#source-45655-45670"><rb>影</rb><rt>かげ</rt></ruby><seg source="#source-45670-45682">である。</seg><ruby type="furigana" rend="right" source="#source-45682-45703"><rb>二人</rb><rt>ふたり</rt></ruby><ruby type="furigana" rend="right" source="#source-45703-45724"><rb>三人</rb><rt>みたり</rt></ruby><seg source="#source-45724-45745">づゝ、いづくへ</seg><ruby type="furigana" rend="right" source="#source-45745-45757"><rb>行</rb><rt>ゆ</rt></ruby><seg source="#source-45757-45766">くとも</seg><ruby type="furigana" rend="right" source="#source-45766-45778"><rb>知</rb><rt>し</rt></ruby><seg source="#source-45778-45802">らず、いづくから</seg><ruby type="furigana" rend="right" source="#source-45802-45814"><rb>來</rb><rt>く</rt></ruby><seg source="#source-45814-45823">るとも</seg><ruby type="furigana" rend="right" source="#source-45823-45835"><rb>分</rb><rt>わ</rt></ruby><seg source="#source-45835-45850">かず、とぼ</seg><choice source="#source-45850-45856"><orig>／＼</orig><reg>〱</reg></choice><seg source="#source-45856-45862">した</seg><ruby type="furigana" rend="right" source="#source-45862-45880"><rb>女</rb><rt>をんな</rt></ruby><seg source="#source-45880-45883">と</seg><ruby type="furigana" rend="right" source="#source-45883-45901"><rb>男</rb><rt>をとこ</rt></ruby><seg source="#source-45901-45907">と、</seg><ruby type="furigana" rend="right" source="#source-45907-45925"><rb>女</rb><rt>をんな</rt></ruby><seg source="#source-45925-45928">と</seg><ruby type="furigana" rend="right" source="#source-45928-45946"><rb>男</rb><rt>なとこ</rt></ruby><seg source="#source-45946-45952">と、</seg><ruby type="furigana" rend="right" source="#source-45952-45967"><rb>影</rb><rt>かげ</rt></ruby><seg source="#source-45967-45979">のやうに</seg><ruby type="furigana" rend="right" source="#source-45979-45997"><rb>辿</rb><rt>たゞよ</rt></ruby><seg source="#source-45997-46000">ひ</seg><ruby type="furigana" rend="right" source="#source-46000-46121"><rb><g ref="#gaiji-3-1-84-33" source="#source-46000-46059">徜</g><g ref="#gaiji-3-1-84-32" source="#source-46059-46106">徉</g></rb><rt>さまよ</rt></ruby><seg source="#source-46121-46129">ふ。</seg></p>
