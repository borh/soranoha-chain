      <p><ruby type="furigana" rend="right" source="#source-481-502"><rb>真夏</rb><rt>まなつ</rt></ruby><seg source="#source-502-505">の</seg><ruby type="furigana" rend="right" source="#source-505-520"><rb>午</rb><rt>ひる</rt></ruby><seg source="#source-520-523">の</seg><ruby type="furigana" rend="right" source="#source-523-553"><rb>片日向</rb><rt>かたひなた</rt></ruby><seg source="#source-553-558">、</seg></p>
      <p><seg source="#source-558-570">苔すこし</seg><ruby type="furigana" rend="right" source="#source-570-585"><rb>泥</rb><rt>ひぢ</rt></ruby><seg source="#source-585-597">ばみ青む</seg><ruby type="furigana" rend="right" source="#source-597-621"><rb>捨石</rb><rt>すていし</rt></ruby><seg source="#source-621-629">に、</seg></p>
      <p><ruby type="furigana" rend="right" source="#source-629-662"><rb>鳩酢草</rb><rt>はとかたばみ</rt></ruby><seg source="#source-662-665">は</seg><ruby type="furigana" rend="right" source="#source-665-683"><rb>呼吸</rb><rt>いき</rt></ruby><ruby type="furigana" rend="right" source="#source-683-698"><rb>細</rb><rt>ほそ</rt></ruby><seg source="#source-698-701">う</seg><ruby type="furigana" rend="right" source="#source-701-719"><rb>雫</rb><rt>しずく</rt></ruby><seg source="#source-719-722">に</seg><ruby type="furigana" rend="right" source="#source-722-737"><rb>湿</rb><rt>うる</rt></ruby><seg source="#source-737-742">ひ</seg></p>
      <p><ruby type="furigana" rend="right" source="#source-742-754"><rb>実</rb><rt>み</rt></ruby><seg source="#source-754-757">を</seg><ruby type="furigana" rend="right" source="#source-757-769"><rb>持</rb><rt>も</rt></ruby><seg source="#source-769-784">ちぬ、かつ</seg><ruby type="furigana" rend="right" source="#source-784-802"><rb>喘息</rb><rt>あへ</rt></ruby><seg source="#source-802-818">ぎつゝ。</seg></p>
      <p><seg source="#source-818-830">そのかみ</seg><ruby type="furigana" rend="right" source="#source-830-842"><rb>誰</rb><rt>た</rt></ruby><seg source="#source-842-848">れに</seg><ruby type="furigana" rend="right" source="#source-848-863"><rb>小</rb><rt>ちひ</rt></ruby><seg source="#source-863-874">さなる</seg></p>
      <p><ruby type="furigana" rend="right" source="#source-874-889"><rb>性</rb><rt>さが</rt></ruby><seg source="#source-889-892">は</seg><ruby type="furigana" rend="right" source="#source-892-904"><rb>得</rb><rt>え</rt></ruby><seg source="#source-904-916">て、また</seg><ruby type="furigana" rend="right" source="#source-916-931"><rb>誰</rb><rt>なれ</rt></ruby><ruby type="furigana" rend="right" source="#source-931-943"><rb>恋</rb><rt>こ</rt></ruby><seg source="#source-943-958">ひて、その</seg><ruby type="furigana" rend="right" source="#source-958-979"><rb>熟実</rb><rt>うみみ</rt></ruby><seg source="#source-979-984">、</seg></p>
      <p><seg source="#source-984-1008">かつこぼし、かつ</seg><ruby type="furigana" rend="right" source="#source-1008-1020"><rb>夜</rb><rt>よ</rt></ruby><seg source="#source-1020-1023">を</seg><ruby type="furigana" rend="right" source="#source-1023-1035"><rb>待</rb><rt>ま</rt></ruby><seg source="#source-1035-1046">ちて、</seg></p>
      <p><seg source="#source-1046-1052">いづ</seg><ruby type="furigana" rend="right" source="#source-1052-1067"><rb>方</rb><rt>かた</rt></ruby><seg source="#source-1067-1070">へ</seg><ruby type="furigana" rend="right" source="#source-1070-1091"><rb>精進</rb><rt>さうじ</rt></ruby><seg source="#source-1091-1094">の</seg><ruby type="furigana" rend="right" source="#source-1094-1109"><rb>魂</rb><rt>たま</rt></ruby><seg source="#source-1109-1119">ぞ。</seg></p>
      <p><ruby type="furigana" rend="right" source="#source-1119-1152"><rb>鳩酢草</rb><rt>はとかたばみ</rt></ruby><seg source="#source-1152-1175">はえも知らず、</seg></p>
      <p><ruby type="furigana" rend="right" source="#source-1175-1199"><rb>捨石</rb><rt>すていし</rt></ruby><seg source="#source-1199-1211">に。――</seg><ruby type="furigana" rend="right" source="#source-1211-1232"><rb>小雨</rb><rt>こさめ</rt></ruby><seg source="#source-1232-1244">のあとの</seg><ruby type="furigana" rend="right" source="#source-1244-1259"><rb>風</rb><rt>かぜ</rt></ruby><seg source="#source-1259-1273">いきれ、</seg></p>
      <p><ruby type="furigana" rend="right" source="#source-1273-1291"><rb>木々</rb><rt>きゞ</rt></ruby><seg source="#source-1291-1297">みな</seg><ruby type="furigana" rend="right" source="#source-1297-1309"><rb>死</rb><rt>し</rt></ruby><seg source="#source-1309-1315">ぬと</seg><ruby type="furigana" rend="right" source="#source-1315-1327"><rb>泣</rb><rt>な</rt></ruby><seg source="#source-1327-1330">く</seg><ruby type="furigana" rend="right" source="#source-1330-1345"><rb>庭</rb><rt>には</rt></ruby><seg source="#source-1345-1360">に、ひとり</seg><ruby type="furigana" rend="right" source="#source-1360-1378"><rb>静</rb><rt>しづか</rt></ruby><seg source="#source-1378-1383">に</seg></p>
      <p><seg source="#source-1383-1398">おほどかに</seg><ruby type="furigana" rend="right" source="#source-1398-1413"><rb>夢</rb><rt>ゆめ</rt></ruby><seg source="#source-1413-1435">に入るさま。</seg></p>
      <p><ruby type="furigana" rend="right" source="#source-1435-1453"><rb>蚊帳</rb><rt>かや</rt></ruby><seg source="#source-1453-1456">を</seg><ruby type="furigana" rend="right" source="#source-1456-1471"><rb>繞</rb><rt>めぐ</rt></ruby><seg source="#source-1471-1477">れる</seg><ruby type="furigana" rend="right" source="#source-1477-1504"><rb>名香</rb><rt>みやうかう</rt></ruby><seg source="#source-1504-1512">に、</seg></p>
      <p><ruby type="furigana" rend="right" source="#source-1512-1536"><rb>手枕</rb><rt>たまくら</rt></ruby><seg source="#source-1536-1539">も</seg><ruby type="furigana" rend="right" source="#source-1539-1551"><rb>頬</rb><rt>ほ</rt></ruby><seg source="#source-1551-1560">もひた</seg><ruby type="furigana" rend="right" source="#source-1560-1572"><rb>痩</rb><rt>や</rt></ruby><seg source="#source-1572-1595">せて病める身の</seg></p>
      <p><ruby type="furigana" rend="right" source="#source-1595-1607"><rb>予</rb><rt>よ</rt></ruby><seg source="#source-1607-1610">は</seg><ruby type="furigana" rend="right" source="#source-1610-1631"><rb>横臥</rb><rt>よこふ</rt></ruby><seg source="#source-1631-1652">しぬ。心こそ、</seg><ruby type="furigana" rend="right" source="#source-1652-1685"><rb>鳩酢草</rb><rt>はとかたばみ</rt></ruby><seg source="#source-1685-1690">の</seg></p>
      <p><ruby type="furigana" rend="right" source="#source-1690-1711"><rb>魂</rb><rt>たましひ</rt></ruby><seg source="#source-1711-1742">にさながら似たれ。</seg></p>
      <p><ruby type="furigana" rend="right" source="#source-1742-1757"><rb>風</rb><rt>かぜ</rt></ruby><seg source="#source-1757-1763">また</seg><ruby type="furigana" rend="right" source="#source-1763-1778"><rb>薫</rb><rt>くゆ</rt></ruby><seg source="#source-1778-1781">り</seg><ruby type="furigana" rend="right" source="#source-1781-1802"><rb>小雨</rb><rt>こさめ</rt></ruby><seg source="#source-1802-1813">しぬ。</seg></p>
      <p><ruby type="furigana" rend="right" source="#source-1813-1846"><rb>鳩酢草</rb><rt>はとかたばみ</rt></ruby><seg source="#source-1846-1852">も、</seg><ruby type="furigana" rend="right" source="#source-1852-1864"><rb>予</rb><rt>よ</rt></ruby><seg source="#source-1864-1867">も</seg><ruby type="furigana" rend="right" source="#source-1867-1888"><rb>一日</rb><rt>ひとひ</rt></ruby></p>
      <p><ruby type="furigana" rend="right" source="#source-1890-1914"><rb>天地</rb><rt>あめつち</rt></ruby><seg source="#source-1914-1917">に</seg><ruby type="furigana" rend="right" source="#source-1917-1941"><rb>幸福</rb><rt>さいはひ</rt></ruby><seg source="#source-1941-1953">ありき。</seg></p>
    </body>
