rce-213181-213196">であらうと</seg><ruby type="furigana" rend="right" source="#source-213196-213223"><rb>想像</rb><rt><seg source="#source-213205-213211">そう</seg><choice source="#source-213211-213220"><orig>／″＼</orig><reg>〲</reg></choice></rt></ruby><seg source="#source-213223-213241">されたから、</seg><ruby type="furigana" rend="right" source="#source-213241-213280"><rb>山崎博士</rb><rt>やまざきはかせ</rt></ruby><seg source="#source-213280-213283">を</seg><ruby type="furigana" rend="right" source="#source-213283-213298"><rb>初</rb><rt>はじ</rt></ruby><seg source="#source-213298-213301">め</seg><ruby type="furigana" rend="right" source="#source-213301-213325"><rb>一行</rb><rt>いつこう</rt></ruby><ruby type="furigana" rend="right" source="#source-213325-213346"><rb>四人</rb><rt>よにん</rt></ruby><seg source="#source-213346-213349">は</seg><ruby type="furigana" rend="right" source="#source-213349-213373"><rb>其家</rb><rt>そのいへ</rt></ruby><seg source="#source-213373-213376">の</seg><ruby type="furigana" rend="right" source="#source-213376-213403"><rb>樓上</rb><rt>ろうじよう</rt></ruby><seg source="#source-213403-213406">に</seg><ruby type="furigana" rend="right" source="#source-213406-213430"><rb>一泊</rb><rt>いつぱく</rt></ruby><seg source="#source-213430-213439">した。</seg><ruby type="furigana" rend="right" source="#source-213439-213460"><rb>其夜</rb><rt>そのよ</rt></ruby><ruby type="furigana" rend="right" source="#source-213460-213481"><rb>大雨</rb><rt>たいう</rt></ruby><seg source="#source-213481-213484">が</seg><ruby type="furigana" rend="right" source="#source-213484-213496"><rb>降</rb><rt>ふ</rt></ruby><seg source="#source-213496-213499">り</seg><ruby type="furigana" rend="right" source="#source-213499-213511"><rb>出</rb><rt>だ</rt></ruby><seg source="#source-213511-213532">したので、これ</seg><ruby type="furigana" rend="right" source="#source-213532-213547"><rb>迄</rb><rt>まで</rt></ruby><ruby type="furigana" rend="right" source="#source-213547-213568"><rb>野營</rb><rt>やえい</rt></ruby><seg source="#source-213568-213571">を</seg><ruby type="furigana" rend="right" source="#source-213571-213586"><rb>續</rb><rt>つゞ</rt></ruby><seg source="#source-213586-213598">けてゐた</seg><ruby type="furigana" rend="right" source="#source-213598-213619"><rb>附近</rb><rt>ふきん</rt></ruby><seg source="#source-213619-213622">の</seg><ruby type="furigana" rend="right" source="#source-213622-213652"><rb>被害民</rb><rt>ひがいみん</rt></ruby><seg source="#source-213652-213658">は、</seg><ruby type="furigana" rend="right" source="#source-213658-213673"><rb>皆</rb><rt>みな</rt></ruby><ruby type="furigana" rend="right" source="#source-213673-213685"><rb>此</rb><rt>こ</rt></ruby><seg source="#source-213685-213688">の</seg><ruby type="furigana" rend="right" source="#source-213688-213703"><rb>潰</rb><rt>つぶ</rt></ruby><seg source="#source-213703-213706">れ</seg><ruby type="furigana" rend="right" source="#source-213706-213721"><rb>殘</rb><rt>のこ</rt></ruby><seg source="#source-213721-213727">りの</seg><ruby type="furigana" rend="right" source="#source-213727-213742"><rb>家</rb><rt>いへ</rt></ruby><seg source="#source-213742-213745">に</seg><ruby type="furigana" rend="right" source="#source-213745-213760"><rb>集</rb><rt>あつ</rt></ruby><seg source="#source-213760-213769">まつて</seg><ruby type="furigana" rend="right" source="#source-213769-213781"><rb>來</rb><rt>き</rt></ruby><seg source="#source-213781-213784">て</seg><ruby type="furigana" rend="right" source="#source-213784-213799"><rb>餘</rb><rt>あま</rt></ruby><seg source="#source-213799-213802">り</seg><ruby type="furigana" rend="right" source="#source-213802-213826"><rb>大勢</rb><rt>おほぜい</rt></ruby><seg source="#source-213826-213838">でありし</seg><ruby type="furigana" rend="right" source="#source-213838-213853"><rb>爲</rb><rt>ため</rt></ruby><seg source="#source-213853-213856">、</seg><ruby type="furigana" rend="right" source="#source-213856-213880"><rb>混雜</rb><rt>こんざつ</rt></ruby><seg source="#source-213880-213904">はしたけれども、</seg><ruby type="furigana" rend="right" source="#source-213904-213919"><rb>皆</rb><rt>みな</rt></ruby><ruby type="furigana" ren