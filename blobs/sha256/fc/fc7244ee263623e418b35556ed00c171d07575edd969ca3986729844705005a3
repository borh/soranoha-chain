rb><rt>そろ</rt></ruby><ruby type="furigana" rend="right" source="#source-34771-34798"><rb>度々</rb><rt><seg source="#source-34780-34786">たび</seg><choice source="#source-34786-34795"><orig>／″＼</orig><reg>〲</reg></choice></rt></ruby><seg source="#source-34798-34801">の</seg><ruby type="furigana" rend="right" source="#source-34801-34825"><rb>実験</rb><rt>じつけん</rt></ruby><seg source="#source-34825-34834">なれば</seg><ruby type="furigana" rend="right" source="#source-34834-34855"><rb>理窟</rb><rt>りくつ</rt></ruby><seg source="#source-34855-34858">は</seg><ruby type="furigana" rend="right" source="#source-34858-34873"><rb>申</rb><rt>まう</rt></ruby><seg source="#source-34873-34888">さず、今も</seg><ruby type="furigana" rend="right" source="#source-34888-34903"><rb>然</rb><rt>しか</rt></ruby><seg source="#source-34903-34918">なるべくと</seg><ruby type="furigana" rend="right" source="#source-34918-34945"><rb>存候</rb><rt>ぞんじそろ</rt></ruby><ruby type="furigana" rend="right" source="#source-34945-34969"><rb>愈々</rb><rt><seg source="#source-34954-34960">いよ</seg><choice source="#source-34960-34966"><orig>／＼</orig><reg>〱</reg></choice></rt></ruby><ruby type="furigana" rend="right" source="#source-34969-34993"><rb>益々</rb><rt><seg source="#source-34978-34984">ます</seg><choice source="#source-34984-34990"><orig>／＼</orig><reg>〱</reg></choice></rt></ruby><ruby type="furigana" rend="right" source="#source-34993-35008"><rb>然</rb><rt>しか</rt></ruby><seg source="#source-35008-35023">なるべくと</seg><ruby type="furigana" rend="right" source="#source-35023-35050"><rb>存候</rb><rt>ぞんじそろ</rt></ruby><seg source="#source-35050-35053">。</seg><ruby type="furigana" rend="right" source="#source-35053-35071"><rb>認</rb><rt>したゝ</rt></ruby><seg source="#source-35071-35074">め</seg><ruby type="furigana" rend="right" source="#source-35074-35089"><rb>了</rb><rt>をは</rt></ruby><seg source="#source-35089-35095">りて</seg><ruby type="furigana" rend="right" source="#source-35095-35110"><rb>此</rb><rt>この</rt></ruby>一通の段落を見るに「と<ruby type="furigana" rend="right" source="#source-35143-35170"><rb>存候</rb><rt>ぞんじそろ</rt></ruby>」の<ruby type="furigana" rend="right" source="#source-35176-35212"><rb>行列也</rb><rt>ぎやうれつなり</rt></ruby><seg source="#source-35212-35215">、</seg><ruby type="furigana" rend="right" source="#source-35215-35230"><rb>更</rb><rt>さら</rt></ruby><seg source="#source-35230-35251">に一つを加へて</seg><ruby type="furigana" rend="right" source="#source-35251-35275"><rb>悪文</rb><rt>あくぶん</rt></ruby><seg source="#source-35275-35278">と</seg><ruby type="furigana" rend="right" source="#source-35278-35305"><rb>存候</rb><rt>ぞんじそろ</rt></ruby></p>
      <p style="text-indent: 6em" rend="first-line-indent(6)" source="#source-35307-35330"><seg source="#source-35307-35330">○</seg></p>
      <p source="#source-35330-35899"><ruby type="furigana" rend="right" source="#source-35330-35351"><rb>容易</rb><rt>ようい</rt></ruby><seg source="#source-35351-35354">に</seg><ruby type="furigana" rend="right" source="#source-35354-35381"><rb>胸隔</rb><rt>きようかく</rt></ruby><seg source="#source-35381-35384">を</seg><ruby type="furigana" rend="right" source="#source-35384-35399"><rb>開</rb><rt>ひら</rt></ruby><seg source="#source-35399-35405">かぬ</seg><ruby type="furigana" rend="right" source="#source-35405-35435"><rb>日本人</rb><rt>にほんじん</rt></ruby><seg source="#source-35435-35438">は</seg><ruby type="furigana" rend="right" source="#source-35438-35459"><rb>容易</rb><rt>ようい</rt></ruby><seg source="#source-35459-35462">に</seg><ruby type="furigana" rend="right" source="#source-35462-35489"><rb>胸隔</rb><rt>きようかく</rt></ruby><seg source="#source-35489-35492">を</seg><ruby type="furigana" rend="right" source="#source-35492-35504"><rb>閉</rb><rt>と</rt></ruby><seg source="#source-35504-35510">つる</seg><ruby type="furigana" rend="right" source="#source-35510-35540"><rb>日本人</rb><rt>にほんじん</rt></ruby><seg source="#source-35540-35543">に</seg><ruby type="furigana" rend="right" source="#source-35543-35558"><rb>候</rb><rt>そろ</rt></ruby><seg source="#source-35558-35561">、</seg><ruby type="furigana" rend="right" source="#source-35561-35585"><rb>失望</rb><rt>しつぼう</rt></ruby><seg source="#source-35585-35588">の</seg><ruby type="furigana" rend="right" source="#source-35588-35603"><rb>相</rb><rt>さう</rt></ruby><seg source="#source-35603-35627">ならざるなしと、</seg><ruby type="furigana" rend="right" source="#source-35627-35642"><rb>甞</rb><rt>かつ</rt></ruby><seg source="#source-35642-35645">て</seg><ruby type="furigana" rend="right" source="#source-35645-35669"><rb>内村</rb><rt>うちむら</rt></ruby><seg source="#source-35669-35684">先生申され</seg><ruby type="furigana" rend="right" source="#source-35684-35699"><rb>候</rb><rt>そろ</rt></ruby><seg source="#source-35699-35702">。</seg><ruby type="furigana" rend="right" source="#source-35702-35717"><rb>然</rb><rt>しか</rt></ruby><seg source="#source-35717-35720">り</seg><ruby type="furigana" rend="right" source="#source-35720-35744"><rb>小生</rb><rt>せうせい</rt></ruby><seg source="#source-35744-35747">も</seg><ruby type="furigana" rend="right" source="#source-35747-35777"><rb>日本人</rb><rt>にほんじん</rt></ruby><seg source="#source-35777-35780">に</seg><ruby type="furigana" rend="right" source="#source-35780-35795"><rb>候</rb><rt>そろ</rt></ruby><ruby type="furigana" rend="right" source="#source-35795-35810"><rb>拒</rb><rt>こば</rt></ruby><seg source="#source-35810-35822">まざるが</seg><ruby type="furigana" rend="right" source="#source-35822-35837"><rb>故</rb><rt>ゆゑ</rt></ruby><seg source="#source-35837-35840">に</seg><ruby type="furigana" rend="right" source="#source-35840-35864"><rb>此言</rb><rt>このげん</rt></ruby><seg source="#source-35864-35867">を</seg><ruby type="furigana" rend="right" source="#source-35867-35879"><rb>為</rb><rt>な</rt></ruby><seg source="#source-35879-35882">し</seg><ruby type="furigana" rend="right" source="#source-35882-35897"><rb>候</rb><rt>そろ</rt></ruby></p>
