      <p source="#source-4425-4466"><seg source="#source-4425-4466">ソコデ　オバシヤニノッテ、</seg></p>
      <p source="#source-4466-4515"><seg source="#source-4466-4515">オウチヘ　カヘッテ　キマシタ。</seg></p>
      <p source="#source-4515-4556"><seg source="#source-4515-4556">オトウサンモ　オカアサンモ</seg></p>
      <p source="#source-4556-4597"><seg source="#source-4556-4597">オゲンクワンノ　トコロデ、</seg></p>
      <p source="#source-4597-4643"><seg source="#source-4597-4643">マッテ　オイデニナリマシタ。</seg></p>
      <p source="#source-4643-4678"><seg source="#source-4643-4678">オトウサン　オカアサン</seg></p>
      <p source="#source-4678-4698"><seg source="#source-4678-4698">タダイマト、</seg></p>
      <p source="#source-4698-4718"><seg source="#source-4698-4718">タローサンモ</seg></p>
      <p source="#source-4718-4738"><seg source="#source-4718-4738">ハルコサンモ</seg></p>
      <p source="#source-4738-4749"><seg source="#source-4738-4749">トンデ</seg></p>
      <p source="#source-4749-4771"><seg source="#source-4749-4771">ユキマシタ。</seg></p>
      <p source="#source-4771-4800">「オホキナ　コヱデ</p>
      <p source="#source-4800-4826"><seg source="#source-4800-4826">ナニヲ　ネゴトヲ</seg></p>
      <p source="#source-4826-4849">イッテルノ」ト</p>
      <p source="#source-4849-4869"><seg source="#source-4849-4869">オカアサンニ</seg></p>
      <p source="#source-4869-4889"><seg source="#source-4869-4889">オコサレテ、</seg></p>
      <p source="#source-4889-4927"><seg source="#source-4889-4927">ハジメテ　ユメダッタ　ト</seg></p>
      <p source="#source-4927-4950"><seg source="#source-4927-4950">ワカリマシタ。</seg></p>
      <p style="text-indent: 3em" rend="first-line-indent(3)" source="#source-4950-4974"><seg source="#source-4950-4974">（ヲハリ）</seg></p>
