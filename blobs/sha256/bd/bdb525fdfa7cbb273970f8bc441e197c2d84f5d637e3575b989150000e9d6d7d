          <p><seg source="#source-154730-154736">亦無</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-154736-154754">ク</note><note type="kunten" subtype="return-mark" rend="subscript" source="#source-154754-154766">二</note><seg source="#source-154766-154772">無明</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-154772-154790">ノ</note><seg source="#source-154790-154793">尽</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-154793-154823">クルコトモ</note><note type="kunten" subtype="return-mark" rend="subscript" source="#source-154823-154835">一</note><seg source="#source-154835-154840">。</seg></p>
          <p><seg source="#source-154840-154849">乃至無</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-154849-154867">ク</note><note type="kunten" subtype="return-mark" rend="subscript" source="#source-154867-154879">二</note><seg source="#source-154879-154885">老死</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-154885-154903">モ</note><note type="kunten" subtype="return-mark" rend="subscript" source="#source-154903-154915">一</note><seg source="#source-154915-154920">。</seg></p>
          <p><seg source="#source-154920-154926">亦無</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-154926-154944">シ</note><note type="kunten" subtype="return-mark" rend="subscript" source="#source-154944-154956">二</note><seg source="#source-154956-154962">老死</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-154962-154980">ノ</note><seg source="#source-154980-154983">尽</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-154983-155013">クルコトモ</note><note type="kunten" subtype="return-mark" rend="subscript" source="#source-155013-155025">一</note><seg source="#source-155025-155030">。</seg></p>
