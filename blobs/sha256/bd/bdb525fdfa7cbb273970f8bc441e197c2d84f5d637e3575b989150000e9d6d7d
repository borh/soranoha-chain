        <div type="layout" source="#source-293478-293813" style="padding-inline-start: 9em">
          <p><seg source="#source-293513-293519">三世</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-293519-293537">ノ</note><seg source="#source-293537-293543">諸仏</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-293543-293561">モ</note><seg source="#source-293561-293566">。</seg></p>
          <p><seg source="#source-293566-293569">依</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-293569-293590">ルガ</note><note type="kunten" subtype="return-mark" rend="subscript" source="#source-293590-293602">二</note><seg source="#source-293602-293620">般若波羅蜜多</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-293620-293638">ニ</note><note type="kunten" subtype="return-mark" rend="subscript" source="#source-293638-293650">一</note><seg source="#source-293650-293653">故</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-293653-293671">ニ</note><seg source="#source-293671-293676">。</seg></p>
          <p><seg source="#source-293676-293679">得</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-293679-293703">タモウ</note><note type="kunten" subtype="return-mark" rend="subscript" source="#source-293703-293715">二</note><seg source="#source-293715-293742">阿耨多羅三藐三菩提</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-293742-293760">ヲ</note><note type="kunten" subtype="return-mark" rend="subscript" source="#source-293760-293772">一</note><seg source="#source-293772-293777">。</seg></p>
