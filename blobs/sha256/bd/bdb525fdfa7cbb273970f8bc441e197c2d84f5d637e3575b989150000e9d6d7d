        <div type="layout" source="#source-68929-69506" style="padding-inline-start: 9em">
          <p><seg source="#source-68964-68973">舎利子</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-68973-68991">ヨ</note><seg source="#source-68991-68996">。</seg></p>
          <p><seg source="#source-68996-68999">色</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-68999-69017">ハ</note><seg source="#source-69017-69020">不</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-69020-69032">レ</note><seg source="#source-69032-69035">異</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-69035-69053">ラ</note><note type="kunten" subtype="return-mark" rend="subscript" source="#source-69053-69065">レ</note><seg source="#source-69065-69068">空</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-69068-69086">ニ</note><seg source="#source-69086-69091">。</seg></p>
          <p><seg source="#source-69091-69094">空</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-69094-69112">ハ</note><seg source="#source-69112-69115">不</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-69115-69127">レ</note><seg source="#source-69127-69130">異</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-69130-69148">ラ</note><note type="kunten" subtype="return-mark" rend="subscript" source="#source-69148-69160">レ</note><seg source="#source-69160-69163">色</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-69163-69181">ニ</note><seg source="#source-69181-69186">。</seg></p>
          <p><seg source="#source-69186-69189">色</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-69189-69207">ハ</note><seg source="#source-69207-69210">即</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-69210-69228">チ</note><seg source="#source-69228-69231">是</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-69231-69249">レ</note><seg source="#source-69249-69252">空</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-69252-69273">ナリ</note><seg source="#source-69273-69278">。</seg></p>
          <p><seg source="#source-69278-69281">空</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-69281-69299">ハ</note><seg source="#source-69299-69302">即</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-69302-69320">チ</note><seg source="#source-69320-69323">是</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-69323-69341">レ</note><seg source="#source-69341-69344">色</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-69344-69365">ナリ</note><seg source="#source-69365-69370">。</seg></p>
          <p><seg source="#source-69370-69382">受想行識</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-69382-69400">モ</note><seg source="#source-69400-69405">。</seg></p>
          <p><seg source="#source-69405-69414">亦復如</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-69414-69432">シ</note><note type="kunten" subtype="return-mark" rend="subscript" source="#source-69432-69444">レ</note><seg source="#source-69444-69447">是</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-69447-69465">ノ</note><seg source="#source-69465-69470">。</seg></p>
