        <div type="layout" source="#source-251390-252172" style="padding-inline-start: 9em">
          <p><seg source="#source-251425-251434">菩提薩</seg><g ref="#gaiji-3-1-15-51" source="#source-251434-251487">埵</g><note type="kunten" subtype="okurigana" rend="superscript" source="#source-251487-251505">ノ</note><seg source="#source-251505-251510">。</seg></p>
          <p><seg source="#source-251510-251513">依</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-251513-251534">ルガ</note><note type="kunten" subtype="return-mark" rend="subscript" source="#source-251534-251546">二</note><seg source="#source-251546-251564">般若波羅蜜多</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-251564-251582">ニ</note><note type="kunten" subtype="return-mark" rend="subscript" source="#source-251582-251594">一</note><seg source="#source-251594-251597">故</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-251597-251615">ニ</note><seg source="#source-251615-251620">。</seg></p>
          <p><seg source="#source-251620-251623">心</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-251623-251641">ニ</note><seg source="#source-251641-251644">無</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-251644-251662">シ</note><note type="kunten" subtype="return-mark" rend="subscript" source="#source-251662-251674">二</note><g ref="#gaiji-4-2-84-77" source="#source-251674-251748">罣</g><seg source="#source-251748-251751">礙</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-251751-251763">一</note><seg source="#source-251763-251768">。</seg></p>
          <p><seg source="#source-251768-251771">無</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-251771-251792">キガ</note><note type="kunten" subtype="return-mark" rend="subscript" source="#source-251792-251804">二</note><g ref="#gaiji-4-2-84-77" source="#source-251804-251878">罣</g><seg source="#source-251878-251881">礙</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-251881-251893">一</note><seg source="#source-251893-251896">故</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-251896-251914">ニ</note><seg source="#source-251914-251919">。</seg></p>
          <p><seg source="#source-251919-251922">無</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-251922-251940">シ</note><note type="kunten" subtype="return-mark" rend="subscript" source="#source-251940-251952">レ</note><seg source="#source-251952-251955">有</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-251955-251979">ルコト</note><note type="kunten" subtype="return-mark" rend="subscript" source="#source-251979-251991">二</note><seg source="#source-251991-251997">恐怖</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-251997-252009">一</note><seg source="#source-252009-252014">。</seg></p>
          <p><seg source="#source-252014-252018">遠-</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-252018-252030">二</note><seg source="#source-252030-252033">離</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-252033-252054">シテ</note><seg source="#source-252054-252066">顛倒夢想</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-252066-252084">ヲ</note><note type="kunten" subtype="return-mark" rend="subscript" source="#source-252084-252096">一</note><seg source="#source-252096-252101">。</seg></p>
          <p><seg source="#source-252101-252113">究竟涅槃</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-252113-252131">ス</note><seg source="#source-252131-252136">。</seg></p>
