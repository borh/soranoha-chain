          <p><seg source="#source-36912-36932">観自在菩薩。</seg></p>
          <p><seg source="#source-36932-36935">行</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-36935-36956">ズル</note><note type="kunten" subtype="return-mark" rend="subscript" source="#source-36956-36968">二</note><seg source="#source-36968-36982">深般若波</seg></p>
          <p><seg source="#source-36982-36991">羅蜜多</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-36991-37009">ヲ</note><note type="kunten" subtype="return-mark" rend="subscript" source="#source-37009-37021">一</note><seg source="#source-37021-37029">時。</seg></p>
          <p><seg source="#source-37029-37032">照</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-37032-37044">二</note><seg source="#source-37044-37047">見</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-37047-37068">シテ</note><seg source="#source-37068-37080">五蘊皆空</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-37080-37104">ナリト</note><note type="kunten" subtype="return-mark" rend="subscript" source="#source-37104-37116">一</note><seg source="#source-37116-37121">。</seg></p>
          <p><seg source="#source-37121-37124">度</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-37124-37151">シタモウ</note><note type="kunten" subtype="return-mark" rend="subscript" source="#source-37151-37163">二</note><seg source="#source-37163-37169">一切</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-37169-37187">ノ</note><seg source="#source-37187-37193">苦厄</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-37193-37211">ヲ</note><note type="kunten" subtype="return-mark" rend="subscript" source="#source-37211-37223">一</note><seg source="#source-37223-37228">。</seg></p>
