      <div type="layout" source="#source-219256-219589" rend="page-horizontal-center">
        <div type="layout" source="#source-219295-219583" style="padding-inline-start: 9em">
          <p><seg source="#source-219330-219333">無</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-219333-219351">ク</note><note type="kunten" subtype="return-mark" rend="subscript" source="#source-219351-219363">レ</note><seg source="#source-219363-219366">智</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-219366-219384">モ</note><seg source="#source-219384-219390">亦無</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-219390-219408">シ</note><note type="kunten" subtype="return-mark" rend="subscript" source="#source-219408-219420">レ</note><seg source="#source-219420-219423">得</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-219423-219441">モ</note><seg source="#source-219441-219446">。</seg></p>
          <p><seg source="#source-219446-219449">以</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-219449-219470">テノ</note><note type="kunten" subtype="return-mark" rend="subscript" source="#source-219470-219482">二</note><seg source="#source-219482-219491">無所得</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-219491-219509">ヲ</note><note type="kunten" subtype="return-mark" rend="subscript" source="#source-219509-219521">一</note><seg source="#source-219521-219524">故</seg><note type="kunten" subtype="okurigana" rend="superscript" source="#source-219524-219542">ニ</note><seg source="#source-219542-219547">。</seg></p>
        </div>
