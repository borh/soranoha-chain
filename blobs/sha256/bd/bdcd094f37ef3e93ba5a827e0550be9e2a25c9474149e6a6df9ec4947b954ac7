          <p source="#source-39312-39569"><hi rend="fraction" snh:layout-kind="fraction" source="#source-39312-39342" corresp="#source-39315-39342"><seg source="#source-39312-39315">1/5</seg></hi><seg source="#source-39342-39354"> = 0.2; 1/52</seg><note type="formatting-instruction" source="#source-39354-39413"><snh:formatting-instruction original="［＃「2」は上付き小文字、「1/52」は分数］"><snh:formatting-operation source="#source-39360-39388"><snh:formatting-selector kind="quoted"><snh:formatting-operand source="#source-39363-39364">2</snh:formatting-operand></snh:formatting-selector><snh:formatting-effect style="superscript" layout-kind="emphasis" source-kind="aat-inline" kind="attribute"/><snh:formatting-selection source="#source-39350-39354"><snh:formatting-target source="#source-39353-39354"/></snh:formatting-selection></snh:formatting-operation><snh:formatting-operation source="#source-39391-39410"><snh:formatting-selector kind="quoted"><snh:formatting-operand source="#source-39394-39398">1/52</snh:formatting-operand></snh:formatting-selector><snh:formatting-effect layout-kind="fraction" source-kind="aat-inline" kind="attribute"/><snh:formatting-selection source="#source-39350-39354"><snh:formatting-target source="#source-39350-39354"/></snh:formatting-selection></snh:formatting-operation></snh:formatting-instruction></note><seg source="#source-39413-39426"> = 0.04; 1/53</seg><note type="formatting-instruction" source="#source-39426-39485"><snh:formatting-instruction original="［＃「3」は上付き小文字、「1/53」は分数］"><snh:formatting-operation source="#source-39432-39460"><snh:formatting-selector kind="quoted"><snh:formatting-operand source="#source-39435-39436">3</snh:formatting-operand></snh:formatting-selector><snh:formatting-effect style="superscript" layout-kind="emphasis" source-kind="aat-inline" kind="attribute"/><snh:formatting-selection source="#source-39422-39426"><snh:formatting-target source="#source-39425-39426"/></snh:formatting-selection></snh:formatting-operation><snh:formatting-operation source="#source-39463-39482"><snh:formatting-selector kind="quoted"><snh:formatting-operand source="#source-39466-39470">1/53</snh:formatting-operand></snh:formatting-selector><snh:formatting-effect layout-kind="fraction" source-kind="aat-inline" kind="attribute"/><snh:formatting-selection source="#source-39422-39426"><snh:formatting-target source="#source-39422-39426"/></snh:formatting-selection></snh:formatting-operation></snh:formatting-instruction></note><seg source="#source-39485-39499"> = 0.008; 1/54</seg><note type="formatting-instruction" source="#source-39499-39558"><snh:formatting-instruction original="［＃「4」は上付き小文字、「1/54」は分数］"><snh:formatting-operation source="#source-39505-39533"><snh:formatting-selector kind="quoted"><snh:formatting-operand source="#source-39508-39509">4</snh:formatting-operand></snh:formatting-selector><snh:formatting-effect style="superscript" layout-kind="emphasis" source-kind="aat-inline" kind="attribute"/><snh:formatting-selection source="#source-39495-39499"><snh:formatting-target source="#source-39498-39499"/></snh:formatting-selection></snh:formatting-operation><snh:formatting-operation source="#source-39536-39555"><snh:formatting-selector kind="quoted"><snh:formatting-operand source="#source-39539-39543">1/54</snh:formatting-operand></snh:formatting-selector><snh:formatting-effect layout-kind="fraction" source-kind="aat-inline" kind="attribute"/><snh:formatting-selection source="#source-39495-39499"><snh:formatting-target source="#source-39495-39499"/></snh:formatting-selection></snh:formatting-operation></snh:formatting-instruction></note><seg source="#source-39558-39569"> = 0.0016</seg></p>
        </div>
