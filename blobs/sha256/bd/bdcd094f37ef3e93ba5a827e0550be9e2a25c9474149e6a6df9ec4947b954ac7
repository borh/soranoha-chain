          <p source="#source-14237-14446"><seg source="#source-14237-14257">σ(r, t) = N/8π2Drt</seg><note type="formatting-instruction" source="#source-14257-14321"><snh:formatting-instruction original="［＃「2」は上付き小文字、「N/8π2Drt」は分数］"><snh:formatting-operation source="#source-14263-14291"><snh:formatting-selector kind="quoted"><snh:formatting-operand source="#source-14266-14267">2</snh:formatting-operand></snh:formatting-selector><snh:formatting-effect style="superscript" layout-kind="emphasis" source-kind="aat-inline" kind="attribute"/><snh:formatting-selection source="#source-14248-14257"><snh:formatting-target source="#source-14253-14254"/></snh:formatting-selection></snh:formatting-operation><snh:formatting-operation source="#source-14294-14318"><snh:formatting-selector kind="quoted"><snh:formatting-operand source="#source-14297-14306">N/8π2Drt</snh:formatting-operand></snh:formatting-selector><snh:formatting-effect layout-kind="fraction" source-kind="aat-inline" kind="attribute"/><snh:formatting-selection source="#source-14248-14257"><snh:formatting-target source="#source-14248-14257"/></snh:formatting-selection></snh:formatting-operation></snh:formatting-instruction></note><seg source="#source-14321-14330">e-(r2/4Dt</seg><note type="formatting-instruction" source="#source-14330-14391"><snh:formatting-instruction original="［＃「2」は上付き小文字、「r2/4Dt」は分数］"><snh:formatting-operation source="#source-14336-14364"><snh:formatting-selector kind="quoted"><snh:formatting-operand source="#source-14339-14340">2</snh:formatting-operand></snh:formatting-selector><snh:formatting-effect style="superscript" layout-kind="emphasis" source-kind="aat-inline" kind="attribute"/><snh:formatting-selection source="#source-14324-14330"><snh:formatting-target source="#source-14325-14326"/></snh:formatting-selection></snh:formatting-operation><snh:formatting-operation source="#source-14367-14388"><snh:formatting-selector kind="quoted"><snh:formatting-operand source="#source-14370-14376">r2/4Dt</snh:formatting-operand></snh:formatting-selector><snh:formatting-effect layout-kind="fraction" source-kind="aat-inline" kind="attribute"/><snh:formatting-selection source="#source-14324-14330"><snh:formatting-target source="#source-14324-14330"/></snh:formatting-selection></snh:formatting-operation></snh:formatting-instruction></note><seg source="#source-14391-14396">+λt)</seg><note type="formatting-instruction" source="#source-14396-14446"><snh:formatting-instruction original="［＃「-(r2/4Dt+λt)」は「e」の上付き］"><snh:formatting-operation source="#source-14402-14443"><snh:formatting-selector kind="quoted"><snh:formatting-operand source="#source-14405-14418">-(r2/4Dt+λt)</snh:formatting-operand></snh:formatting-selector><snh:formatting-effect kind="upper-relative"><snh:formatting-operand source="#source-14427-14428">e</snh:formatting-operand></snh:formatting-effect></snh:formatting-operation></snh:formatting-instruction></note></p>
