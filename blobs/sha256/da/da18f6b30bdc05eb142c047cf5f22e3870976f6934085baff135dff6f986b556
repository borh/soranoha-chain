  <text>
    <body>
      <p><seg source="#source-241-255">どんより</seg></p>
      <p><seg source="#source-255-263">雪空</seg></p>
      <p><seg source="#source-263-275">ピアノの</seg><ruby type="furigana" rend="right" source="#source-275-287"><rb>音</rb><rt>ね</rt></ruby><seg source="#source-287-297">……</seg></p>
      <p><seg source="#source-297-311">ふわふわ</seg></p>
      <p><seg source="#source-311-325">ふわふわ</seg></p>
      <p><ruby type="furigana" rend="right" source="#source-325-355"><rb>雪女郎</rb><rt>ゆきぢよろ</rt></ruby></p>
      <p><ruby type="furigana" rend="right" source="#source-357-384"><rb>小女郎</rb><rt>こぢよろ</rt></ruby></p>
      <p><seg source="#source-388-411">ピアノの音から</seg></p>
      <p><seg source="#source-411-428">まひだして</seg></p>
      <p><seg source="#source-428-454">ピアノがやんだら</seg></p>
      <p><seg source="#source-454-472">消えちやつた</seg></p>
    </body>
