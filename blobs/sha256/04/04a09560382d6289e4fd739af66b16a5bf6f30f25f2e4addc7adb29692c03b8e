      <p><seg source="#source-21-32">とんび</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)"><seg source="#source-32-52">ぴいひよろ</seg></p>
      <p><seg source="#source-52-78">輪をかいてみせろ</seg></p>
      <p><seg source="#source-78-104">泣く子はきらいだ</seg></p>
      <p><seg source="#source-104-127">泣く子のうへの</seg></p>
      <p><seg source="#source-127-147">たかいそらで</seg></p>
      <p><seg source="#source-147-158">とんび</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)"><seg source="#source-158-178">ぴいひよろ</seg></p>
      <p><seg source="#source-178-216">ぐるりと大きな輪をかいて</seg></p>
      <p><seg source="#source-216-237">泣く子にみせろ</seg></p>
    </body>
