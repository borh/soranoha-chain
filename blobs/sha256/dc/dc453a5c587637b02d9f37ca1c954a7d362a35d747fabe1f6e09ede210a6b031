      <div type="layout" source="#source-598-713" style="padding-inline-start: 5em">
        <p source="#source-619-713"><hi rend="font-size small(1)" snh:layout-kind="font-size" snh:layout-params="size-type=small;level=1" source="#source-619-709" corresp="#source-643-709"><seg source="#source-619-643">――汽車の窓にて</seg></hi></p>
      </div>
      <div>
        <p source="#source-713-754"><seg source="#source-713-725">夏の日の</seg><ruby type="furigana" rend="right" source="#source-725-740"><rb>午</rb><rt>ひる</rt></ruby><seg source="#source-740-754">さがり、</seg></p>
        <p source="#source-754-822"><ruby type="furigana" rend="right" source="#source-754-766"><rb>我</rb><rt>わ</rt></ruby><seg source="#source-766-769">が</seg><ruby type="furigana" rend="right" source="#source-769-790"><rb>汽車</rb><rt>きしや</rt></ruby><seg source="#source-790-793">は</seg><ruby type="furigana" rend="right" source="#source-793-814"><rb>物憂</rb><rt>ものう</rt></ruby><seg source="#source-814-822">げに</seg></p>
        <p source="#source-822-866"><seg source="#source-822-834">黒き煙を</seg><ruby type="furigana" rend="right" source="#source-834-852"><rb>息吹</rb><rt>いぶ</rt></ruby><seg source="#source-852-866">きつゝ、</seg></p>
        <p source="#source-866-946"><ruby type="furigana" rend="right" source="#source-866-890"><rb>炎天</rb><rt>えんてん</rt></ruby><seg source="#source-890-893">の</seg><ruby type="furigana" rend="right" source="#source-893-926"><rb>東海道</rb><rt>とうかいどう</rt></ruby><seg source="#source-926-946">を西へ馳す。</seg></p>
        <p source="#source-946-990"><ruby type="furigana" rend="right" source="#source-946-958"><rb>世</rb><rt>よ</rt></ruby><seg source="#source-958-990">ゆゑ、はたわれからの</seg></p>
        <p source="#source-990-1055"><ruby type="furigana" rend="right" source="#source-990-1014"><rb>黒熱</rb><rt>こくねつ</rt></ruby><seg source="#source-1014-1017">に</seg><ruby type="furigana" rend="right" source="#source-1017-1029"><rb>膿</rb><rt>う</rt></ruby><seg source="#source-1029-1032">み</seg><ruby type="furigana" rend="right" source="#source-1032-1047"><rb>爛</rb><rt>ただ</rt></ruby><seg source="#source-1047-1055">れ、</seg></p>
        <p source="#source-1055-1162"><ruby type="furigana" rend="right" source="#source-1055-1073"><rb>灰汗</rb><rt>あく</rt></ruby><seg source="#source-1073-1076">の</seg><note type="sic" source="#source-1076-1109" target="#source-1055-1076">「灰汗の」はママ</note><ruby type="furigana" rend="right" source="#source-1109-1130"><rb>洪水</rb><rt>でみず</rt></ruby><seg source="#source-1130-1133">の</seg><ruby type="furigana" rend="right" source="#source-1133-1157"><rb>胸底</rb><rt>むなぞこ</rt></ruby><seg source="#source-1157-1162">の</seg></p>
        <p source="#source-1162-1230"><ruby type="furigana" rend="right" source="#source-1162-1180"><rb>政</rb><rt>まつり</rt></ruby><seg source="#source-1180-1183">の</seg><ruby type="furigana" rend="right" source="#source-1183-1201"><rb>庁</rb><rt>ちやう</rt></ruby><seg source="#source-1201-1204">を</seg><ruby type="furigana" rend="right" source="#source-1204-1222"><rb>失</rb><rt>うしな</rt></ruby><seg source="#source-1222-1230">ひし</seg></p>
        <p source="#source-1230-1295"><ruby type="furigana" rend="right" source="#source-1230-1254"><rb>病人</rb><rt>やまうど</rt></ruby><seg source="#source-1254-1266">なれば、</seg><ruby type="furigana" rend="right" source="#source-1266-1290"><rb>天地</rb><rt>あめつち</rt></ruby><seg source="#source-1290-1295">の</seg></p>
        <p source="#source-1295-1366"><ruby type="furigana" rend="right" source="#source-1295-1316"><rb>眺望</rb><rt>ながめ</rt></ruby><seg source="#source-1316-1328">ことごと</seg><ruby type="furigana" rend="right" source="#source-1328-1343"><rb>灰</rb><rt>はひ</rt></ruby><ruby type="furigana" rend="right" source="#source-1343-1355"><rb>濁</rb><rt>た</rt></ruby><seg source="#source-1355-1366">みて、</seg></p>
        <p source="#source-1366-1443"><seg source="#source-1366-1408">あゝうたてしや、ひたぶるに、</seg><ruby type="furigana" rend="right" source="#source-1408-1426"><rb>涙</rb><rt>なみだ</rt></ruby><seg source="#source-1426-1443">ぞ落つる。</seg></p>
        <p source="#source-1443-1487"><seg source="#source-1443-1452">乗合は</seg><ruby type="furigana" rend="right" source="#source-1452-1467"><rb>背</rb><rt>せな</rt></ruby><seg source="#source-1467-1470">と</seg><ruby type="furigana" rend="right" source="#source-1470-1485"><rb>背</rb><rt>せな</rt></ruby></p>
        <p source="#source-1487-1549"><ruby type="furigana" rend="right" source="#source-1487-1502"><rb>肩</rb><rt>かた</rt></ruby><ruby type="furigana" rend="right" source="#source-1502-1526"><rb>犇々</rb><rt><seg source="#source-1511-1517">ひし</seg><choice source="#source-1517-1523"><orig>／＼</orig><reg>〱</reg></choice></rt></ruby><seg source="#source-1526-1549">とすりあひぬ。</seg></p>
        <p source="#source-1549-1581"><seg source="#source-1549-1581">近江を過ぎて京ちかき</seg></p>
        <p source="#source-1581-1658"><ruby type="furigana" rend="right" source="#source-1581-1605"><rb>山科</rb><rt>やましな</rt></ruby><seg source="#source-1605-1611">や、</seg><ruby type="furigana" rend="right" source="#source-1611-1626"><rb>竹</rb><rt>たけ</rt></ruby><seg source="#source-1626-1629">の</seg><ruby type="furigana" rend="right" source="#source-1629-1650"><rb>入日</rb><rt>いりひ</rt></ruby><seg source="#source-1650-1658">に、</seg></p>
        <p source="#source-1658-1720"><ruby type="furigana" rend="right" source="#source-1658-1682"><rb>鬱憂</rb><rt>うつゆう</rt></ruby><seg source="#source-1682-1697">のこゝろは</seg><ruby type="furigana" rend="right" source="#source-1697-1712"><rb>重</rb><rt>おも</rt></ruby><seg source="#source-1712-1720">く、</seg></p>
        <p source="#source-1720-1764"><ruby type="furigana" rend="right" source="#source-1720-1732"><rb>倦</rb><rt>う</rt></ruby><seg source="#source-1732-1764">じ疲れたる目はひと目</seg></p>
        <p source="#source-1764-1832"><ruby type="furigana" rend="right" source="#source-1764-1785"><rb>線路</rb><rt>せんろ</rt></ruby><seg source="#source-1785-1788">の</seg><ruby type="furigana" rend="right" source="#source-1788-1803"><rb>砂</rb><rt>すな</rt></ruby><seg source="#source-1803-1832">に――あゝこの時、</seg></p>
        <p source="#source-1832-1888"><seg source="#source-1832-1844">胸はまた</seg><ruby type="furigana" rend="right" source="#source-1844-1856"><rb>膿</rb><rt>う</rt></ruby><seg source="#source-1856-1862">みて</seg><ruby type="furigana" rend="right" source="#source-1862-1877"><rb>潰</rb><rt>つぶ</rt></ruby><seg source="#source-1877-1888">れぬ。</seg></p>
        <p source="#source-1888-1965"><ruby type="furigana" rend="right" source="#source-1888-1900"><rb>見</rb><rt>み</rt></ruby><seg source="#source-1900-1906">よ、</seg><ruby type="furigana" rend="right" source="#source-1906-1930"><rb>鉄道</rb><rt>てつだう</rt></ruby><seg source="#source-1930-1933">の</seg><ruby type="furigana" rend="right" source="#source-1933-1957"><rb>枕木</rb><rt>まくらぎ</rt></ruby><seg source="#source-1957-1965">は、</seg></p>
        <p source="#source-1965-2024"><ruby type="furigana" rend="right" source="#source-1965-1977"><rb>癒</rb><rt>い</rt></ruby><seg source="#source-1977-1995">ゆべからざる</seg><ruby type="furigana" rend="right" source="#source-1995-2019"><rb>病人</rb><rt>やまうど</rt></ruby><seg source="#source-2019-2024">の</seg></p>
        <p source="#source-2024-2089"><ruby type="furigana" rend="right" source="#source-2024-2042"><rb>素枯</rb><rt>すが</rt></ruby><seg source="#source-2042-2057">れはてたる</seg><ruby type="furigana" rend="right" source="#source-2057-2078"><rb>肋骨</rb><rt>あばら</rt></ruby><seg source="#source-2078-2089">なり。</seg></p>
        <p source="#source-2089-2154"><seg source="#source-2089-2107">と見る、また</seg><ruby type="furigana" rend="right" source="#source-2107-2119"><rb>我</rb><rt>わ</rt></ruby><seg source="#source-2119-2128">が乗る</seg><ruby type="furigana" rend="right" source="#source-2128-2149"><rb>汽車</rb><rt>きしや</rt></ruby><seg source="#source-2149-2154">は</seg></p>
        <p source="#source-2154-2213"><seg source="#source-2154-2163">痩せて</seg><ruby type="furigana" rend="right" source="#source-2163-2178"><rb>細</rb><rt>ほそ</rt></ruby><seg source="#source-2178-2184">れる</seg><ruby type="furigana" rend="right" source="#source-2184-2208"><rb>肋骨</rb><rt>ろくこつ</rt></ruby><seg source="#source-2208-2213">を</seg></p>
        <p source="#source-2213-2278"><ruby type="furigana" rend="right" source="#source-2213-2228"><rb>毒</rb><rt>どく</rt></ruby><seg source="#source-2228-2234">ある</seg><ruby type="furigana" rend="right" source="#source-2234-2249"><rb>牙</rb><rt>きば</rt></ruby><seg source="#source-2249-2252">に</seg><ruby type="furigana" rend="right" source="#source-2252-2264"><rb>噛</rb><rt>か</rt></ruby><seg source="#source-2264-2278">みてゆく</seg></p>
        <p source="#source-2278-2358"><ruby type="furigana" rend="right" source="#source-2278-2302"><rb>黒蛇</rb><rt>くろへび</rt></ruby><seg source="#source-2302-2314">よ、あゝ</seg><ruby type="furigana" rend="right" source="#source-2314-2326"><rb>死</rb><rt>し</rt></ruby><seg source="#source-2326-2329">の</seg><ruby type="furigana" rend="right" source="#source-2329-2344"><rb>使</rb><rt>つか</rt></ruby><seg source="#source-2344-2358">ひ。――</seg></p>
        <p source="#source-2358-2414">『無明』の子なる<ruby type="furigana" rend="right" source="#source-2382-2406"><rb>病人</rb><rt>やまうど</rt></ruby><seg source="#source-2406-2414">は、</seg></p>
        <p source="#source-2414-2446"><seg source="#source-2414-2446">をさな心にいとせめて</seg></p>
        <p source="#source-2446-2490"><ruby type="furigana" rend="right" source="#source-2446-2473"><rb>垂乳根</rb><rt>たらちね</rt></ruby><seg source="#source-2473-2490">の膝まくら</seg></p>
        <p source="#source-2490-2540"><seg source="#source-2490-2499">しばし</seg><ruby type="furigana" rend="right" source="#source-2499-2520"><rb>安睡</rb><rt>やすい</rt></ruby><seg source="#source-2520-2540">の夢見むと、</seg></p>
        <p source="#source-2540-2611"><ruby type="furigana" rend="right" source="#source-2540-2552"><rb>指</rb><rt>さ</rt></ruby><seg source="#source-2552-2555">す</seg><ruby type="furigana" rend="right" source="#source-2555-2579"><rb>故郷</rb><rt>ふるさと</rt></ruby><seg source="#source-2579-2582">の</seg><ruby type="furigana" rend="right" source="#source-2582-2606"><rb>琉球</rb><rt>りうきう</rt></ruby><seg source="#source-2606-2611">は</seg></p>
        <p source="#source-2611-2643"><seg source="#source-2611-2643">五百里さかる海の島、</seg></p>
        <p source="#source-2643-2693"><seg source="#source-2643-2664">われを載せたる</seg><ruby type="furigana" rend="right" source="#source-2664-2688"><rb>黒蛇</rb><rt>くろへび</rt></ruby><seg source="#source-2688-2693">は</seg></p>
        <p source="#source-2693-2755"><ruby type="furigana" rend="right" source="#source-2693-2711"><rb>勢</rb><rt>いきほ</rt></ruby><seg source="#source-2711-2714">ひ</seg><ruby type="furigana" rend="right" source="#source-2714-2729"><rb>猛</rb><rt>まう</rt></ruby><seg source="#source-2729-2755">に、こは如何に、</seg></p>
        <p source="#source-2755-2820"><seg source="#source-2755-2761">その</seg><ruby type="furigana" rend="right" source="#source-2761-2785"><rb>故郷</rb><rt>ふるさと</rt></ruby><seg source="#source-2785-2788">も</seg><ruby type="furigana" rend="right" source="#source-2788-2809"><rb>行過</rb><rt>ゆきす</rt></ruby><seg source="#source-2809-2820">ぎつ、</seg></p>
        <p source="#source-2820-2864"><seg source="#source-2820-2835">右に横たふ</seg><ruby type="furigana" rend="right" source="#source-2835-2859"><rb>山脈</rb><rt>やまなみ</rt></ruby><seg source="#source-2859-2864">は</seg></p>
        <p source="#source-2864-2926"><seg source="#source-2864-2870">はや</seg><ruby type="furigana" rend="right" source="#source-2870-2888"><rb>冥府</rb><rt>よみ</rt></ruby><seg source="#source-2888-2891">の</seg><ruby type="furigana" rend="right" source="#source-2891-2906"><rb>国</rb><rt>くに</rt></ruby><seg source="#source-2906-2926">、血に染めし</seg></p>
        <p source="#source-2926-2973"><ruby type="furigana" rend="right" source="#source-2926-2947"><rb>硫黄</rb><rt>いわう</rt></ruby><seg source="#source-2947-2973">の池も近づくよ、</seg></p>
        <p source="#source-2973-3023"><seg source="#source-2973-2994">あなゆるせやと</seg><ruby type="furigana" rend="right" source="#source-2994-3009"><rb>唸</rb><rt>うめ</rt></ruby><seg source="#source-3009-3023">き伏し、</seg></p>
        <p source="#source-3023-3073"><seg source="#source-3023-3038">やゝありて</seg><ruby type="furigana" rend="right" source="#source-3038-3053"><rb>我</rb><rt>われ</rt></ruby><seg source="#source-3053-3073">にかへれば、</seg></p>
        <p source="#source-3073-3156"><ruby type="furigana" rend="right" source="#source-3073-3091"><rb>京</rb><rt>きやう</rt></ruby><seg source="#source-3091-3094">は</seg><ruby type="furigana" rend="right" source="#source-3094-3121"><rb>水無月</rb><rt>みなづき</rt></ruby><seg source="#source-3121-3124">、</seg><ruby type="furigana" rend="right" source="#source-3124-3151"><rb>祇園会</rb><rt>ぎをんゑ</rt></ruby><seg source="#source-3151-3156">の</seg></p>
        <p source="#source-3156-3221"><ruby type="furigana" rend="right" source="#source-3156-3171"><rb>空</rb><rt>そら</rt></ruby><seg source="#source-3171-3186">うつくしき</seg><ruby type="furigana" rend="right" source="#source-3186-3216"><rb>星月夜</rb><rt>ほしづきよ</rt></ruby><seg source="#source-3216-3221">、</seg></p>
        <p source="#source-3221-3253"><seg source="#source-3221-3253">我が汽車はしづしづと</seg></p>
        <p source="#source-3253-3297"><seg source="#source-3253-3268">涙さしぐむ</seg><ruby type="furigana" rend="right" source="#source-3268-3292"><rb>哀音</rb><rt>あいおん</rt></ruby><seg source="#source-3292-3297">の</seg></p>
        <p source="#source-3297-3345"><seg source="#source-3297-3309">汽笛して</seg><ruby type="furigana" rend="right" source="#source-3309-3333"><rb>七条</rb><rt>しちぜう</rt></ruby><seg source="#source-3333-3345">出でぬ。</seg></p>
      </div>
