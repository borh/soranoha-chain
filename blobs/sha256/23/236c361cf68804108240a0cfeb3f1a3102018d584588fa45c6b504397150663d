        <p style="text-indent: 1em" rend="first-line-indent(1)"><seg source="#source-25482-25500">それでいろ</seg><choice source="#source-25500-25506"><orig>／＼</orig><reg>〱</reg></choice><ruby type="furigana" rend="right" source="#source-25506-25518"><rb>手</rb><rt>て</rt></ruby><seg source="#source-25518-25521">が</seg><ruby type="furigana" rend="right" source="#source-25521-25533"><rb>引</rb><rt>ひ</rt></ruby><seg source="#source-25533-25551">けなくつて、</seg><ruby type="furigana" rend="right" source="#source-25551-25569"><rb>漸</rb><rt>やうや</rt></ruby><seg source="#source-25569-25575">く七</seg><ruby type="furigana" rend="right" source="#source-25575-25596"><rb>月</rb><rt>ぐわつ</rt></ruby><seg source="#source-25596-25602">十一</seg><ruby type="furigana" rend="right" source="#source-25602-25620"><rb>日</rb><rt>にち</rt></ruby><seg source="#source-25620-25623">に</seg><ruby type="furigana" rend="right" source="#source-25623-25647"><rb>末吉</rb><rt>すゑよし</rt></ruby><seg source="#source-25647-25650">へ</seg><ruby type="furigana" rend="right" source="#source-25650-25671"><rb>駈付</rb><rt>かけつ</rt></ruby><seg source="#source-25671-25677">けて</seg><ruby type="furigana" rend="right" source="#source-25677-25689"><rb>見</rb><rt>み</rt></ruby><seg source="#source-25689-25698">ると、</seg><ruby type="furigana" rend="right" source="#source-25698-25722"><rb>貝殼</rb><rt>かひがら</rt></ruby><seg source="#source-25722-25725">の</seg><ruby type="furigana" rend="right" source="#source-25725-25740"><rb>山</rb><rt>やま</rt></ruby><seg source="#source-25740-25746">だけ</seg><ruby type="furigana" rend="right" source="#source-25746-25761"><rb>白</rb><rt>しろ</rt></ruby><seg source="#source-25761-25764">く</seg><ruby type="furigana" rend="right" source="#source-25764-25779"><rb>遺</rb><rt>のこ</rt></ruby><seg source="#source-25779-25794">つて、あゝ</seg><ruby type="furigana" rend="right" source="#source-25794-25818"><rb>因業</rb><rt>ゐんがう</rt></ruby><seg source="#source-25818-25821">な</seg><ruby type="furigana" rend="right" source="#source-25821-25851">