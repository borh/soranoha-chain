        </div>
      </div>
      <div type="layout" source="#source-141632-141885" style="padding-inline-start: 5em">
        <div type="layout" source="#source-141667-141847" rend="font-size small(1)">
          <p><seg source="#source-141714-141752">ひもじきかなひもじきかな</seg></p>
