ource-55477-55492"><rb>氷</rb><rt>こほ</rt></ruby><seg source="#source-55492-55585">りて氷の上に雪をつもらせ、つもる雪もおなじく氷りて岩のごとく、</seg><ruby type="furigana" rend="right" source="#source-55585-55600"><rb>岸</rb><rt>きし</rt></ruby><seg source="#source-55600-55615">の氷りたる</seg><ruby type="furigana" rend="right" source="#source-55615-55630"><rb>端</rb><rt>はし</rt></ruby><ruby type="furigana" rend="right" source="#source-55630-55651"><rb>次第</rb><rt>しだい</rt></ruby><seg source="#source-55651-55687">に雪ふりつもり、のちには</seg><ruby type="furigana" rend="right" source="#source-55687-55714"><rb>両岸</rb><rt>りやうがん</rt></ruby><seg source="#source-55714-55720">の雪</seg><ruby type="furigana" rend="right" source="#source-55720-55747"><rb>相合</rb><rt>あひがつ</rt></ruby><seg source="#source-55747-55753">して</seg><ruby type="furigana" rend="right" source="#source-55753-55774"><rb>陸地</rb><rt>りくち</rt></ruby><seg source="#source-55774-55819">とおなじ雪の地となる。さて春を</seg><ruby type="furigana" rend="right" source="#source-55819-55834"><rb>迎</rb><rt>むか</rt></ruby><seg source="#source-55834-55855">へて寒気次第に</seg><ruby type="furigana" rend="right" source="#source-55855-55870"><rb>和</rb><rt>やは</rt></ruby><seg source="#source-55870-55891">らぎ、その年の</seg><ruby type="furigana" rend="right" source="#source-55891-55912"><rb>暖気</rb><rt>だんき</rt></ruby><seg source="#source-55912-55930">につれて雪も</seg><ruby type="furigana" rend="right" source="#source-55930-55954"><rb>降止</rb><rt>ふりやみ</rt></ruby><seg source="#source-55954-55969">たる二月の</seg><ruby type="furigana" rend="right" source="#source-55969-55984"><rb>頃</rb><rt>ころ</rt></ruby><seg source="#source-55984-55987">、</seg><ruby type="furigana" rend="right" source="#source-55987-56008"><rb>水気</rb><rt>すゐき</rt></ruby><seg source="#source-56008-56011">は</seg><ruby type="furigana" rend="right" source="#source-56011-56029"><rb>地気</rb><rt>ちき</rt></ruby><seg source="#source-56029-56038">よりも</seg><ruby type="furigana" rend="right" source="#source-56038-56062"><rb>寒暖</rb><rt>かんだん</rt></ruby><seg source="#source-56062