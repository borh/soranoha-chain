          <div>
            <head n="2" source="#source-324972-325074"><seg source="#source-324972-324978">○　</seg><ruby type="furigana" rend="right" source="#source-324978-324996"><rb>童</rb><rt>わらべ</rt></ruby><seg source="#source-324996-325002">の雪</seg><ruby type="furigana" rend="right" source="#source-325002-325020"><rb>遊</rb><rt>あそ</rt></ruby><seg source="#source-325020-325023">び</seg></head>
          </div>
