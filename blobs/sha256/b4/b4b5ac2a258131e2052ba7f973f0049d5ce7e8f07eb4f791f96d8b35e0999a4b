きのね</rt></ruby><ruby type="furigana" rend="right" source="#source-58449-58473"><rb>岩窟</rb><rt>がんくつ</rt></ruby><seg source="#source-58473-58476">を</seg><ruby type="furigana" rend="right" source="#source-58476-58500"><rb>寝所</rb><rt>ねどころ</rt></ruby><seg source="#source-58500-58512">となし、</seg><ruby type="furigana" rend="right" source="#source-58512-58533"><rb>生木</rb><rt>なまき</rt></ruby><seg source="#source-58533-58536">を</seg><ruby type="furigana" rend="right" source="#source-58536-58551"><rb>焼</rb><rt>たい</rt></ruby><seg source="#source-58551-58554">て</seg><ruby type="furigana" rend="right" source="#source-58554-58572"><rb>寒</rb><rt>さむさ</rt></ruby><seg source="#source-58572-58575">を</seg><ruby type="furigana" rend="right" source="#source-58575-58593"><rb>凌</rb><rt>しのぎ</rt></ruby><ruby type="furigana" rend="right" source="#source-58593-58608"><rb>且</rb><rt>かつ</rt></ruby><ruby type="furigana" rend="right" source="#source-58608-58626"><rb>明</rb><rt>あかし</rt></ruby><seg source="#source-58626-58638">となし、</seg><ruby type="furigana" rend="right" source="#source-58638-58650"><rb>着</rb><rt>き</rt></ruby><seg source="#source-58650-58665">たまゝにて</seg><ruby type="furigana" rend="right" source="#source-58665-58686"><rb>寝臥</rb><rt>ねふし</rt></ruby><seg source="#source-58686-58698">をなす。</seg><ruby type="furigana" rend="right" source="#source-58698-58716"><rb>頭</rb><rt>かしら</rt></ruby><seg source="#source-58716-58722">より</seg><ruby type="furigana" rend="right" source="#source-58722-58737"><rb>足</rb><rt>あし</rt></ruby><seg source="#source-58737-58755">にいたるまで</seg><ruby type="furigana" rend="right" source="#source-58755-58767"><rb>身</rb><rt>み</rt></ruby><seg source="#source-58767-58770">に</seg><ruby type="furigana" rend="right" source="#source-58770-58782"><rb>着</rb><rt>き</rt></ruby><seg source="#source-58782-58785">る</seg><ruby type="furigana" rend="right" source="#source-58785-58800"><rb>物</rb><rt>もの</rt></ruby><ruby type="furigana" rend="right" source="#source-58800-58824"><rb>悉</rb><rt><seg 