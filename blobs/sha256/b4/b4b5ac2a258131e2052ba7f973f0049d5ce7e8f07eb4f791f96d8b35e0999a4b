          <div>
            <head n="2" source="#source-156596-156736"><seg source="#source-156617-156623">○　</seg><ruby type="furigana" rend="right" source="#source-156623-156641"><rb>縮</rb><rt>ちゞみ</rt></ruby><seg source="#source-156641-156644">を</seg><ruby type="furigana" rend="right" source="#source-156644-156703"><rb><g ref="#gaiji-4-2-14-21" source="#source-156644-156691">曬</g></rb><rt>さら</rt></ruby><seg source="#source-156703-156706">す</seg></head>
          </div>
