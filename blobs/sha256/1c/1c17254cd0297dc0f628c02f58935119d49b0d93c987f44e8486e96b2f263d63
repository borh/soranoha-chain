            <head n="1" source="#source-77057-77111"><seg source="#source-77057-77069">山岳美論</seg></head>
          </div>
        </div>
      </div>
      <div>
        <p source="#source-77117-77134"><pb rend="kaicho" source="#source-77117-77132"/></p>
        <p source="#source-77134-77231"><figure snh:figure-class="illustration" source="#source-77134-77229"><graphic url="fig59133_07.png" width="640px" height="445px"/><note type="caption-reference"><seg source="#source-77143-77146">虹</seg></note></figure></p>
        <p source="#source-77231-77277"><seg type="caption" source="#source-77231-77273"><seg source="#source-77231-77234">虹</seg></seg></p>
        <p source="#source-77277-77296"><pb rend="kaicho" source="#source-77277-77292"/></p>
