            <head n="1" source="#source-91315-91369"><seg source="#source-91315-91327">山頂の雲</seg></head>
          </div>
        </div>
      </div>
      <div>
        <p source="#source-91375-91392"><pb rend="kaicho" source="#source-91375-91390"/></p>
        <p source="#source-91392-91498"><figure snh:figure-class="illustration" source="#source-91392-91496"><graphic url="fig59133_08.png" width="640px" height="446px"/><note type="caption-reference"><seg source="#source-91401-91413">山頂の曉</seg></note></figure></p>
        <p source="#source-91498-91562"><seg type="caption" source="#source-91498-91558"><seg source="#source-91498-91510">山頂の曉</seg></seg></p>
        <p source="#source-91562-91581"><pb rend="kaicho" source="#source-91562-91577"/></p>
