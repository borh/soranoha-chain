      <div>
        <p source="#source-127948-127965"><pb rend="kaicho" source="#source-127948-127963"/></p>
        <p source="#source-127965-128077"><figure snh:figure-class="illustration" source="#source-127965-128075"><graphic url="fig59133_11.png" width="640px" height="441px"/><note type="caption-reference"><seg source="#source-127974-127992">御嶽頂上より</seg></note></figure></p>
        <p source="#source-128077-128153"><seg type="caption" source="#source-128077-128149"><seg source="#source-128077-128095">御嶽頂上より</seg></seg></p>
