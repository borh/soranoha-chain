        <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-35729-36958"><ruby type="furigana" rend="right" source="#source-35732-35747"><rb>僕</rb><rt>ぼく</rt></ruby><seg source="#source-35747-35750">の</seg><ruby type="furigana" rend="right" source="#source-35750-35762"><rb>知</rb><rt>し</rt></ruby><seg source="#source-35762-35765">る</seg><ruby type="furigana" rend="right" source="#source-35765-35780"><rb>限</rb><rt>かぎ</rt></ruby><seg source="#source-35780-35792">りでは、</seg><ruby type="furigana" rend="right" source="#source-35792-35813"><rb>日本</rb><rt>にほん</rt></ruby><seg source="#source-35813-35816">の</seg><ruby type="furigana" rend="right" source="#source-35816-35843"><rb>麻雀</rb><rt>マアジヤン</rt></ruby><seg source="#source-35843-35846">の</seg><ruby type="furigana" rend="right" source="#source-35846-35879"><rb>發祥地</rb><rt>はつしやうち</rt></ruby><seg source="#source-35879-35882">は</seg><ruby type="furigana" rend="right" source="#source-35882-35897"><rb>例</rb><rt>れい</rt></ruby><seg source="#source-35897-35900">の</seg><ruby type="furigana" rend="right" source="#source-35900-35939"><rb>大震災後</rb><rt>だいしんさいご</rt></ruby><seg source="#source-35939-35942">に</seg><ruby type="furigana" rend="right" source="#source-35942-35966"><rb>松山</rb><rt>まつやま</rt></ruby><ruby type="furigana" rend="right" source="#source-35966-35984"><rb>省</rb><rt>しやう</rt></ruby><seg source="#source-35984-35990">三が</seg><ruby type="furigana" rend="right" source="#source-35990-36020"><rb>銀座裏</rb><rt>ぎんざうら</rt></ruby><seg source="#source-36020-36026">から</seg><ruby type="furigana" rend="right" source="#source-36026-36041"><rb>移</rb><rt>うつ</rt></ruby><seg source="#source-36041-36050">つて一</seg><ruby type="furigana" rend="right" source="#source-36050-36065"><rb>時</rb><rt>じ</rt></ruby><ruby type="furigana" rend="right" source="#source-36065-36089"><rb>牛込</rb><rt>うしごめ</rt></ruby><seg source="#source-36089-36092">の</seg><ruby type="furigana" rend="right" source="#source-36092-36131"><rb>神樂坂上</rb><rt>かぐらざかうへ</