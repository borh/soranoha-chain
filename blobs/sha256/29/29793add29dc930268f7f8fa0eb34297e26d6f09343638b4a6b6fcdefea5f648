57"><rb>食</rb><rt>く</rt></ruby><seg source="#source-17257-17266">つても</seg><ruby type="furigana" rend="right" source="#source-17266-17281"><rb>腹</rb><rt>はら</rt></ruby><seg source="#source-17281-17293">がくちく</seg><ruby type="furigana" rend="right" source="#source-17293-17305"><rb>成</rb><rt>な</rt></ruby><seg source="#source-17305-17317">るのを、</seg><ruby type="furigana" rend="right" source="#source-17317-17332"><rb>赫</rb><rt>かつ</rt></ruby><seg source="#source-17332-17335">と</seg><ruby type="furigana" rend="right" source="#source-17335-17347"><rb>煮</rb><rt>に</rt></ruby><seg source="#source-17347-17356">ようと</seg><ruby type="furigana" rend="right" source="#source-17356-17368"><rb>云</rb><rt>い</rt></ruby><seg source="#source-17368-17371">ふ</seg><ruby type="furigana" rend="right" source="#source-17371-17395"><rb>腹案</rb><rt>ふくあん</rt></ruby><seg source="#source-17395-17398">。</seg><ruby type="furigana" rend="right" source="#source-17398-17431"><rb>六丁目</rb><rt>ろくちやうめ</rt></ruby><seg source="#source-17431-17434">を</seg><ruby type="furigana" rend="right" source="#source-17434-17455"><rb>乘出</rb><rt>のりだ</rt></ruby><seg source="#source-17455-17461">した</seg><ruby type="furigana" rend="right" source="#source-17461-17473"><rb>其</rb><rt>そ</rt></ruby><seg source="#source-17473-17476">の</seg><ruby type="furigana" rend="right" source="#source-17476-17506"><rb>自動車</rb><rt>じどうしや</rt></ruby><seg source="#source-17506-17512">で、</seg><ruby type="furigana" rend="right" source="#source-17512-17533"><rb>自分</rb><rt>じぶん</rt></ruby><ruby type="furigana" rend="right" source="#source-17533-17560"><rb>兩國</rb><rt>りやうごく</rt></ruby><seg source="#source-17560-17563">を</seg><ruby type="furigana" rend="right" source="#source-17563-17584"><rb>乘切</rb><rt>のりき</rt></ruby><seg source="#source-17584-17590">らう</seg><ruby type="furigana" rend="right" source="#source-17590-17617"><rb>意氣込</rb><rt>いきごみ</rt></ruby><seg source="#source-17617-17626">、が、</seg><ruby type="furigana" rend="right" source="#source-17626-17641"><rb>