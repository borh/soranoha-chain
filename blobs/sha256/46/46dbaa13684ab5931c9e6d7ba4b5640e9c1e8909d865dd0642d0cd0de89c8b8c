      <p style="text-indent: 6em" rend="first-line-indent(6)"><seg source="#source-248966-248999">ふるさとの</seg><ruby type="furigana" rend="right" source="#source-248999-249014"><rb>後</rb><rt>のち</rt></ruby><seg source="#source-249014-249021">に</seg></p>
      <p><seg source="#source-249021-249027">この</seg><ruby type="furigana" rend="right" source="#source-249027-249042"><rb>本</rb><rt>ほん</rt></ruby><seg source="#source-249042-249045">は</seg><ruby type="furigana" rend="right" source="#source-249045-249060"><rb>前</rb><rt>まへ</rt></ruby><seg source="#source-249060-249063">に</seg><ruby type="furigana" rend="right" source="#source-249063-249075"><rb>出</rb><rt>だ</rt></ruby>した『<ruby type="furigana" rend="right" source="#source-249084-249102"><rb>幼</rb><rt>をさな</rt></ruby>きものに』と<ruby type="furigana" rend="right" source="#source-249120-249141"><rb>姉妹</rb><rt>しまい</rt></ruby><seg source="#source-249141-249159">のやうにして</seg><ruby type="furigana" rend="right" source="#source-249159-249171"><rb>出</rb><rt>だ</rt></ruby><seg source="#source-249171-249189">します。あの</seg><ruby type="furigana" rend="right" source="#source-249189-249216"><rb>佛蘭西</rb><rt>ふらんす</rt></ruby><ruby type="furigana" rend="right" source="#source-249216-249237"><rb>土産</rb><rt>みやげ</rt></ruby><seg source="#source-249237-249246">には、</seg><ruby type="furigana" rend="right" source="#source-249246-249261"><rb>父</rb><rt>とう</rt></ruby><seg source="#source-249261-249273">さんのお</seg><ruby type="furigana" rend="right" source="#source-249273-249291"><rb>話</rb><rt>はなし</rt></ruby><seg source="#source-249291-249312">ばかりでなく、</seg><ruby type="furigana" rend="right" source="#source-249312-249339"><rb>佛蘭西</rb><rt>ふらんす</rt></ruby><seg source="#source-249339-249342">の</seg><ruby type="furigana" rend="right" source="#source-249342-249357"><rb>方</rb><rt>ほう</rt></ruby><seg source="#source-249357-249360">で</seg><ruby type="furigana" rend="right" source="#source-249360-249372"><rb>聞</rb><rt>き</rt></ruby><seg source="#source-249372-249378">いて</seg><ruby type="furigana" rend="right" source="#source-249378-249390"><rb>來</rb><rt>き</rt></ruby><seg source="#source-249390-249399">たいろ</seg><choice source="#source-249399-249405"><orig>／＼</orig><reg>〱</reg></choice><seg source="#source-249405-249411">なお</seg><ruby type="furigana" rend="right" source="#source-249411-249429"><rb>話</rb><rt>はなし</rt></ruby><seg source="#source-249429-249432">も</seg><ruby type="furigana" rend="right" source="#source-249432-249444"><rb>入</rb><rt>い</rt></ruby><seg source="#source-249444-249450">れて</seg><ruby type="furigana" rend="right" source="#source-249450-249462"><rb>置</rb><rt>お</rt></ruby>きましたが、この『ふるさと』には<ruby type="furigana" rend="right" source="#source-249510-249525"><rb>父</rb><rt>とう</rt></ruby><seg source="#source-249525-249537">さんのお</seg><ruby type="furigana" rend="right" source="#source-249537-249555"><rb>話</rb><rt>はなし</rt></ruby><seg source="#source-249555-249567">ばかりを</seg><ruby type="furigana" rend="right" source="#source-249567-249582"><rb>集</rb><rt>あつ</rt></ruby><seg source="#source-249582-249603">めました。この</seg><ruby type="furigana" rend="right" source="#source-249603-249618"><rb>本</rb><rt>ほん</rt></ruby><seg source="#source-249618-249621">が</seg><ruby type="furigana" rend="right" source="#source-249621-249639"><rb>出來</rb><rt>でき</rt></ruby><seg source="#source-249639-249654">ましたら、</seg><ruby type="furigana" rend="right" source="#source-249654-249672"><rb>木曾</rb><rt>きそ</rt></ruby><seg source="#source-249672-249675">の</seg><ruby type="furigana" rend="right" source="#source-249675-249693"><rb>伯父</rb><rt>をぢ</rt></ruby><seg source="#source-249693-249702">さんの</seg><ruby type="furigana" rend="right" source="#source-249702-249717"><rb>家</rb><rt>うち</rt></ruby><seg source="#source-249717-249720">に</seg><ruby type="furigana" rend="right" source="#source-249720-249747"><rb>勉強</rb><rt>べんきやう</rt></ruby><seg source="#source-249747-249753">して</seg><ruby type="furigana" rend="right" source="#source-249753-249765"><rb>居</rb><rt>ゐ</rt></ruby><seg source="#source-249765-249771">る三</seg><ruby type="furigana" rend="right" source="#source-249771-249789"><rb>郎</rb><rt>らう</rt></ruby><seg source="#source-249789-249810">のところへも一</seg><ruby type="furigana" rend="right" source="#source-249810-249828"><rb>册<