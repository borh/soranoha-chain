      <p><seg source="#source-234245-234257">として、</seg><ruby type="furigana" rend="right" source="#source-234257-234272"><rb>白</rb><rt>しろ</rt></ruby><seg source="#source-234272-234287">いところに</seg><ruby type="furigana" rend="right" source="#source-234287-234302"><rb>黒</rb><rt>くろ</rt></ruby><seg source="#source-234302-234305">い</seg><ruby type="furigana" rend="right" source="#source-234305-234320"><rb>太</rb><rt>ふと</rt></ruby><seg source="#source-234320-234323">い</seg><ruby type="furigana" rend="right" source="#source-234323-234335"><rb>字</rb><rt>じ</rt></ruby><seg source="#source-234335-234338">で</seg><ruby type="furigana" rend="right" source="#source-234338-234350"><rb>書</rb><rt>か</rt></ruby><seg source="#source-234350-234362">いてある</seg><ruby type="furigana" rend="right" source="#source-234362-234386"><rb>看板</rb><rt>かんばん</rt></ruby><seg source="#source-234386-234392">は、</seg><ruby type="furigana" rend="right" source="#source-234392-234407"><rb>父</rb><rt>とう</rt></ruby><seg source="#source-234407-234413">さん</seg><ruby type="furigana" rend="right" source="#source-234413-234428"><rb>達</rb><rt>たち</rt></ruby><seg source="#source-234428-234434">にも</seg><ruby type="furigana" rend="right" source="#source-234434-234446"><rb>寄</rb><rt>よ</rt></ruby><seg source="#source-234446-234452">つて</seg><ruby type="furigana" rend="right" source="#source-234452-234467"><rb>休</rb><rt>やす</rt></ruby><seg source="#source-234467-234473">んで</seg><ruby type="furigana" rend="right" source="#source-234473-234485"><rb>行</rb><rt>ゆ</rt></ruby><seg source="#source-234485-234491">けと</seg><ruby type="furigana" rend="right" source="#source-234491-234503"><rb>言</rb><rt>い</rt></ruby><seg source="#source-234503-234515">ふやうに</seg><ruby type="furigana" rend="right" source="#source-234515-234527"><rb>見</rb><rt>み</rt></ruby><seg source="#source-234527-234554">えました。さういふ</seg><ruby type="furigana" rend="right" source="#source-234554-234587"><rb>休茶屋</rb><rt>やすみぢやや</rt></ruby>には、きまりで『<ruby type="furigana" rend="right" 