      <p style="text-indent: 3em" rend="first-line-indent(3)"><seg source="#source-231961-231979">六三　</seg><ruby type="furigana" rend="right" source="#source-231979-232018"><rb>御休處</rb><rt>おんやすみどころ</rt></ruby></p>
      <p><ruby type="furigana" rend="right" source="#source-232022-232037"><rb>何</rb><rt>なん</rt></ruby><seg source="#source-232037-232046">といふ</seg><ruby type="furigana" rend="right" source="#source-232046-232061"><rb>深</rb><rt>ふか</rt></ruby><seg source="#source-232061-232064">い</seg><ruby type="furigana" rend="right" source="#source-232064-232079"><rb>山</rb><rt>やま</rt></ruby><seg source="#source-232079-232082">や</seg><ruby type="furigana" rend="right" source="#source-232082-232097"><rb>谷</rb><rt>たに</rt></ruby><seg source="#source-232097-232100">が</seg><ruby type="furigana" rend="right" source="#source-232100-232115"><rb>父</rb><rt>とう</rt></ruby><seg source="#source-232115-232124">さんの</seg><ruby type="furigana" rend="right" source="#source-232124-232136"><rb>行</rb><rt>ゆ</rt></ruby><seg source="#source-232136-232139">く</seg><ruby type="furigana" rend="right" source="#source-232139-232154"><rb>先</rb><rt>さき</rt></ruby><seg source="#source-232154-232181">にありましたらう。</seg><ruby type="furigana" rend="right" source="#source-232181-232196"><rb>父</rb><rt>とう</rt></ruby><seg source="#source-232196-232205">さんは</seg><ruby type="furigana" rend="right" source="#source-232205-232232"><rb>木曽川</rb><rt>きそがは</rt></ruby><seg source="#source-232232-232235">の</seg><ruby type="furigana" rend="right" source="#source-232235-232247"><rb>見</rb><rt>み</rt></ruby><seg source="#source-232247-232253">える</seg><ruby type="furigana" rend="right" source="#source-232253-232277"><rb>谷間</rb><rt>たにあひ</rt></ruby><seg source="#source-232277-232292">について、</seg><ruby type="furigana" rend="right" source="#source-232292-232310"><rb>林</rb><rt>はやし</rt></ruby><seg source="#source-232310-232313">の</seg><ruby type="furigana" rend="right" source="#source-232313-232328"><rb>中</rb><rt>なか</rt></ruby><seg source="#source-232328-232331">を</seg><ruby type="furigana" rend="right" source="#source-232331-232346"><rb>歩</rb><rt>ある</rt></ruby><seg source="#source-232346-232352">いて</seg><ruby type="furigana" rend="right" source="#sou