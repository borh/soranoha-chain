      <p><ruby type="furigana" rend="right" source="#source-63205-63217"><rb>斯</rb><rt>か</rt></ruby><seg source="#source-63217-63226">うした</seg><ruby type="furigana" rend="right" source="#source-63226-63247"><rb>言葉</rb><rt>ことば</rt></ruby><seg source="#source-63247-63250">の</seg><ruby type="furigana" rend="right" source="#source-63250-63265"><rb>通</rb><rt>つう</rt></ruby><seg source="#source-63265-63274">じない</seg><ruby type="furigana" rend="right" source="#source-63274-63292"><rb>燕</rb><rt>つばめ</rt></ruby><seg source="#source-63292-63298">も、</seg><ruby type="furigana" rend="right" source="#source-63298-63313"><rb>村</rb><rt>むら</rt></ruby><seg source="#source-63313-63316">に</seg><ruby type="furigana" rend="right" source="#source-63316-63328"><rb>住</rb><rt>す</rt></ruby><seg source="#source-63328-63331">み</seg><ruby type="furigana" rend="right" source="#source-63331-63343"><rb>慣</rb><rt>な</rt></ruby><seg source="#source-63343-63352">れて、</seg><ruby type="furigana" rend="right" source="#source-63352-63376"><rb>家々</rb><rt><seg source="#source-63361-63367">いへ</seg><choice source="#source-63367-63373"><orig>／＼</orig><reg>〱</reg></choice></rt></ruby><seg source="#source-63376-63379">の</seg><ruby type="furigana" rend="right" source="#source-63379-63394"><rb>軒</rb><rt>のき</rt></ruby><seg source="#source-63394-63397">に</seg><ruby type="furigana" rend="right" source="#source-63397-63409"><rb>巣</rb><rt>す</rt></ruby><seg source="#source-63409-63439">をつくり、くちばしの</seg><ruby type="furigana" rend="right" source="#source-63439-63460"><rb>黄色</rb><rt>きいろ</rt></ruby><seg source="#source-63460-63463">い</seg><ruby type="furigana" rend="right" source="#source-63463-63484"><rb>可愛</rb><rt>かあい</rt></ruby><seg source="#source-63484-63487">い</seg><ruby type="furigana" rend="right" source="#source-63487-63508"><rb>子供</rb><rt>こども</rt></ruby><seg source="#source-63508-63511">を</seg><ruby type="furigana" rend="right" source="#source-63511-63526"><rb>育</rb><rt>そだ</rt></ruby><seg source="#source-63526-63532">て