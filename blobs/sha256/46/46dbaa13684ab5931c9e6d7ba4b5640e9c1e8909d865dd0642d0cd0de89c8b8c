      <p><seg source="#source-67055-67058">『</seg><ruby type="furigana" rend="right" source="#source-67058-67082"><rb>和尚</rb><rt>をしやう</rt></ruby><seg source="#source-67082-67091">さん、</seg><ruby type="furigana" rend="right" source="#source-67091-67115"><rb>和尚</rb><rt>をしやう</rt></ruby><seg source="#source-67115-67136">さん、こちらは</seg><ruby type="furigana" rend="right" source="#source-67136-67160"><rb>大層</rb><rt>たいそう</rt></ruby><ruby type="furigana" rend="right" source="#source-67160-67172"><rb>好</rb><rt>よ</rt></ruby><seg source="#source-67172-67178">いお</seg><ruby type="furigana" rend="right" source="#source-67178-67199"><rb>住居</rb><rt>すまゐ</rt></ruby><seg source="#source-67199-67217">ですね。この</seg><ruby type="furigana" rend="right" source="#source-67217-67232"><rb>村</rb><rt>むら</rt></ruby><seg source="#source-67232-67235">に</seg><ruby type="furigana" rend="right" source="#source-67235-67259"><rb>澤山</rb><rt>たくさん</rt></ruby><seg source="#source-67259-67262">お</seg><ruby type="furigana" rend="right" source="#source-67262-67277"><rb>家</rb><rt>うち</rt></ruby><seg source="#source-67277-67352">がありましても、こちらにかなふところはありません。</seg><ruby type="furigana" rend="right" source="#source-67352-67376"><rb>村中</rb><rt>むらぢう</rt></ruby><ruby type="furigana" rend="right" source="#source-67376-67391"><rb>第</rb><rt>だい</rt></ruby><seg source="#source-67391-67397">一の</seg><ruby type="furigana" rend="right" source="#source-67397-67421"><rb>建物</rb><rt>たてもの</rt></ruby><seg source="#source-67421-67442">です。こんなお</seg><ruby type="furigana" rend="right" source="#source-67442-67463"><rb>住居</rb><rt>すまゐ</rt></ruby><seg source="#source-67463-67466">に</seg><ruby type="furigana" rend="right" source="#source-67466-67484"><rb>被入</rb><rt>いら</rt></ruby><seg source="#source-67484-67493">しやる</seg><ruby type="furigana" rend="right" source="#source-67493-67517"><rb>和尚</rb><rt>をしやう</rt></ruby><seg source="#source-67517-67526">さんは</seg><ruby type="furigana" rend="right" source="#source-67526-67547"><rb>仕合</rb><rt>しあは</rt></ruby><s