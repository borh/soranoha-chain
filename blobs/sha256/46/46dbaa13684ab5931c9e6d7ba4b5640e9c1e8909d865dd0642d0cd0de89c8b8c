      <p><seg source="#source-64879-64882">と</seg><ruby type="furigana" rend="right" source="#source-64882-64900"><rb>狐</rb><rt>きつね</rt></ruby><seg source="#source-64900-64903">が</seg><ruby type="furigana" rend="right" source="#source-64903-64936"><rb>永昌寺</rb><rt>えいしやうじ</rt></ruby><seg source="#source-64936-64939">の</seg><ruby type="furigana" rend="right" source="#source-64939-64954"><rb>庭</rb><rt>には</rt></ruby><seg source="#source-64954-64957">へ</seg><ruby type="furigana" rend="right" source="#source-64957-64969"><rb>來</rb><rt>き</rt></ruby><seg source="#source-64969-64972">て</seg><ruby type="furigana" rend="right" source="#source-64972-64984"><rb>言</rb><rt>い</rt></ruby><seg source="#source-64984-64999">ひました。</seg><ruby type="furigana" rend="right" source="#source-64999-65032"><rb>永昌寺</rb><rt>えいしやうじ</rt></ruby><seg source="#source-65032-65041">とは、</seg><ruby type="furigana" rend="right" source="#source-65041-65056"><rb>父</rb><rt>とう</rt></ruby><seg source="#source-65056-65065">さんの</seg><ruby type="furigana" rend="right" source="#source-65065-65080"><rb>村</rb><rt>むら</rt></ruby><seg source="#source-65080-65086">のお</seg><ruby type="furigana" rend="right" source="#source-65086-65101"><rb>寺</rb><rt>てら</rt></ruby><seg source="#source-65101-65119">です。そのお</seg><ruby type="furigana" rend="right" source="#source-65119-65134"><rb>寺</rb><rt>てら</rt></ruby><seg source="#source-65134-65140">に、</seg><ruby type="furigana" rend="right" source="#source-65140-65182"><rb>桃林和尚</rb><rt>たうりんをしやう</rt></ruby><seg source="#source-65182-65191">といふ</seg><ruby type="furigana" rend="right" source="#source-65191-65206"><rb>年</rb><rt>とし</rt></ruby><seg source="#source-65206-65215">とつた</seg><ruby type="furigana" rend="right" source="#source-65215-65239"><rb>和尚</rb><rt>をしやう</rt></ruby><seg source="#source-65239-65248">さんが</seg><ruby type="furigana" rend="right" source="#source-65248-65260"><rb>住</rb><rt>す</rt></ruby><seg source="#source-65260-65266">んで</seg><ruby type="furigana" rend="right" source="#