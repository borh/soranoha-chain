      <p><ruby type="furigana" rend="right" source="#source-237216-237234"><rb>木曾</rb><rt>きそ</rt></ruby><seg source="#source-237234-237237">の</seg><ruby type="furigana" rend="right" source="#source-237237-237252"><rb>人</rb><rt>ひと</rt></ruby><seg source="#source-237252-237255">は</seg><ruby type="furigana" rend="right" source="#source-237255-237273"><rb>昔</rb><rt>むかし</rt></ruby><seg source="#source-237273-237282">からお</seg><ruby type="furigana" rend="right" source="#source-237282-237309"><rb>伽話</rb><rt>とぎばなし</rt></ruby><seg source="#source-237309-237312">が</seg><ruby type="furigana" rend="right" source="#source-237312-237324"><rb>好</rb><rt>す</rt></ruby><seg source="#source-237324-237339">きだつたと</seg><ruby type="furigana" rend="right" source="#source-237339-237351"><rb>見</rb><rt>み</rt></ruby><seg source="#source-237351-237366">えますね。</seg><ruby type="furigana" rend="right" source="#source-237366-237381"><rb>岩</rb><rt>いは</rt></ruby><seg source="#source-237381-237390">にも、</seg><ruby type="furigana" rend="right" source="#source-237390-237405"><rb>池</rb><rt>いけ</rt></ruby><seg source="#source-237405-237414">にも、</seg><ruby type="furigana" rend="right" source="#source-237414-237438"><rb>釣竿</rb><rt>つりざを</rt></ruby><seg source="#source-237438-237459">にも、こんなお</seg><ruby type="furigana" rend="right" source="#source-237459-237486"><rb>伽話</rb><rt>とぎばなし</rt></ruby><seg source="#source-237486-237489">が</seg><ruby type="furigana" rend="right" source="#source-237489-237504"><rb>殘</rb><rt>のこ</rt></ruby><seg source="#source-237504-237522">つて、それを</seg><ruby type="furigana" rend="right" source="#source-237522-237540"><rb>昔</rb><rt>むかし</rt></ruby><seg source="#source-237540-237546">から</seg><ruby type="furigana" rend="right" source="#source-237546-237558"><rb>言</rb><rt>い</rt></ruby><seg source="#source-237558-237561">ひ</seg><ruby type="furigana" rend="right" source="#source-237561-237576"><rb>傳</rb><rt>つた</rt></ruby><seg source="#source-237576-237582">へて</seg><ruby type="furigana" rend="right" 