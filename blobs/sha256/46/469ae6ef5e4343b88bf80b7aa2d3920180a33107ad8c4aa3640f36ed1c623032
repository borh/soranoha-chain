end="subscript" source="#source-382800-382812">レ</note><seg source="#source-382812-382818">禹疏</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-382818-382830">レ</note><seg source="#source-382830-382836">川尊</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-382836-382848">レ</note><seg source="#source-382848-382854">岳済</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-382854-382866">二</note><seg source="#source-382866-382872">巨海</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-382872-382884">一</note><seg source="#source-382884-382890">、則</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-382890-382902">二</note><g ref="#gaiji-4-2-94-62" source="#source-382902-382949">黿</g><g ref="#gaiji-4-2-94-63" source="#source-382949-383023">鼂</g><note type="kunten" subtype="return-mark" rend="subscript" source="#source-383023-383035">一</note><seg source="#source-383035-383044">、而為</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-383044-383056">レ</note><seg source="#source-383056-383062">梁踰</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-383062-383074">二</note><seg source="#source-383074-383080">翠岑</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-383080-383092">一</note><seg source="#source-383092-383098">、則</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-383098-383110">二</note><seg source="#source-383110-383116">神龍</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-383116-383128">一</note><seg source="#source-383128-383134">而為</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-383134-383146">レ</note><seg source="#source-383146-383155">馭、行</seg><g ref="#gaiji-3-1-84-34" source="#source-383155-383256">徧</g><note type="kunten" subtype="return-mark" rend="subsc