rk" rend="subscript" source="#source-152157-152169">レ</note><seg source="#source-152169-152178">河、未</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-152178-152190">レ</note><seg source="#source-152190-152202">至何公及</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-152202-152214">レ</note><seg source="#source-152214-152226">牛、乃以</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-152226-152238">レ</note><seg source="#source-152238-152244">手抜</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-152244-152256">二</note><seg source="#source-152256-152265">牛左足</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-152265-152277">一</note><seg source="#source-152277-152286">脱、以</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-152286-152298">二</note><seg source="#source-152298-152304">右手</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-152304-152316">一</note><seg source="#source-152316-152319">持</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-152319-152331">レ</note><seg source="#source-152331-152340">斧、斫</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-152340-152352">二</note><seg source="#source-152352-152358">牛頭</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-152358-152370">一</note><seg source="#source-152370-152376">而殺</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-152376-152388">レ</note><seg source="#source-152388-152426">之、此青牛是万年木精也、</seg></p>
