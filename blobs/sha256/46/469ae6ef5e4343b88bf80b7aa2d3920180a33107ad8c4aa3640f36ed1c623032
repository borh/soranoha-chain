btype="return-mark" rend="subscript" source="#source-344268-344280">二</note><seg source="#source-344280-344286">其樹</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-344286-344298">一</note><seg source="#source-344298-344304">、可</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-344304-344316">レ</note><seg source="#source-344316-344325">食、可</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-344325-344337">レ</note><seg source="#source-344337-344349">観、又可</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-344349-344361">レ</note><seg source="#source-344361-344370">慕、以</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-344370-344382">三</note><seg source="#source-344382-344391">其能益</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-344391-344403">二</note><seg source="#source-344403-344409">智慧</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-344409-344421">一</note><seg source="#source-344421-344433">也、遂摘</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-344433-344445">レ</note><seg source="#source-344445-344451">果食</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-344451-344463">レ</note><seg source="#source-344463-344475">之、並給</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-344475-344487">二</note><seg source="#source-344487-344493">其夫</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-344493-344505">一</note><seg source="#source-344505-344547">、夫亦食之、二人目即明、始覚</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-344547-344559">一</note><seg source="#source-344559-344565">身裸</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-344565-344577">一</note><seg source="#source-344577-344586">、乃編</seg><note type="