        <p source="#source-24965-25039"><hi rend="bold" source="#source-24965-25013" corresp="#source-24965-24980 #source-24989-25013"><seg source="#source-24980-24989">接客業</seg></hi><seg source="#source-25013-25039">―給仕人、芸妓等</seg></p>
      </div>
      <div type="layout" source="#source-25077-25160" style="padding-inline-start: 1em">
        <p source="#source-25098-25158"><hi rend="bold" source="#source-25098-25158" corresp="#source-25098-25113 #source-25134-25158"><seg source="#source-25113-25134">情報宣伝技術者</seg></hi></p>
      </div>
