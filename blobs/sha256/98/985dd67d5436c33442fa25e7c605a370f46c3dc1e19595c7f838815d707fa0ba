pe="furigana" rend="right" source="#source-16971-16992"><rb>住居</rb><rt>すまひ</rt></ruby><seg source="#source-16992-16995">も</seg><ruby type="furigana" rend="right" source="#source-16995-17010"><rb>揃</rb><rt>そろ</rt></ruby><seg source="#source-17010-17025">ひ、それ、</seg><ruby type="furigana" rend="right" source="#source-17025-17055"><rb>問屋向</rb><rt>とんやむき</rt></ruby><seg source="#source-17055-17058">の</seg><ruby type="furigana" rend="right" source="#source-17058-17082"><rb>番頭</rb><rt>ばんとう</rt></ruby><seg source="#source-17082-17085">、</seg><ruby type="furigana" rend="right" source="#source-17085-17106"><rb>手代</rb><rt>てだい</rt></ruby><seg source="#source-17106-17121">、もうそれ</seg><ruby type="furigana" rend="right" source="#source-17121-17151"><rb>不心得</rb><rt>ふこゝろえ</rt></ruby><seg source="#source-17151-17163">なのが、</seg><ruby type="furigana" rend="right" source="#source-17163-17187"><rb>松村</rb><rt>まつむら</rt></ruby><seg source="#source-17187-17190">に</seg><ruby type="furigana" rend="right" source="#source-17190-17211"><rb>小松</rb><rt>こまつ</rt></ruby><seg source="#source-17211-17214">を</seg><ruby type="furigana" rend="right" source="#source-17214-17229"><rb>圍</rb><rt>かこ</rt></ruby><seg source="#source-17229-17238">つて、</seg><ruby type="furigana" rend="right" source="#source-17238-17271"><rb>松賀町</rb><rt>まつかちやう</rt></ruby><seg source="#source-17271-17274">で</seg><ruby type="furigana" rend="right" source="#source-17274-17304"><rb>淨瑠璃</rb><rt>じやうるり</rt></ruby><seg source="#source-17304-17331">をうならうといふ、</seg><ruby type="furigana" rend="right" source="#source-17331-17346"><rb>藏</rb><rt>くら</rt></ruby><seg source="#source-17346-17349">と</seg><ruby type="furigana" rend="right" source="#source-17349-17364"><rb>藏</rb><rt>くら</rt></ruby><seg source="#source-17364-17370">とは</seg><ruby type="furigana" rend="right" source="#source-17370-17385"><rb>並</rb><rt>なら</rt></ruby><seg source="#source-17385-17397">んだり、</seg><ruby type="furigana" rend="right" source="#source-17397-17412"><rb>中</rb><rt>なか</rt></r