pe="kunten" subtype="return-mark" rend="subscript" source="#source-76444-76456">二</note><seg source="#source-76456-76462">呉起</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-76462-76474">一</note><seg source="#source-76474-76489">。呉起走之</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-76489-76501">二</note><seg source="#source-76501-76507">王尸</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-76507-76519">一</note><seg source="#source-76519-76525">而伏</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-76525-76537">レ</note><seg source="#source-76537-76546">之。撃</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-76546-76558">レ</note><seg source="#source-76558-76573">起之徒。因</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-76573-76585">レ</note><seg source="#source-76585-76588">射</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-76588-76600">二</note><seg source="#source-76600-76609">刺呉起</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-76609-76621">一</note><seg source="#source-76621-76630">。并中</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-76630-76642">二</note><seg source="#source-76642-76648">悼王</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-76648-76660">一</note><seg source="#source-76660-76696">。悼王既葬。太子立。乃使</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-76696-76708">下</note><seg source="#source-76708-76720">令尹盡誅</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-76720-76732">中</note><seg source="#source-76732-76735">射</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-76735-76747">二</note><seg source="#source-76747-76753">呉起</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-76753-76765">一</note><seg source="#source-76765-76774">而并中</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-76774-76786">二</note><seg source="#source-76786-76792">王尸</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-76792-76804">一</note><seg source="#source-76804-76807">者</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-76807-76819">上</note><seg source="#source-76819-76825">。坐</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-76825-76837">レ</note><seg source="#source-76837-76840">射</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-76840-76852">レ</note><seg source="#source-76852-76861">起而夷</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-76861-76873">レ</note><seg source="#source-76873-76902">宗死者。七十餘家。</seg></p>
        <p source="#source-76902-77681"><seg source="#source-76902-76926">太史公曰。世俗所</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-76926-76938">レ</note><seg source="#source-76938-76956">稱師旅。皆道</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-76956-76968">二</note><seg source="#source-76968-76998">孫子十三篇。呉起兵法</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-76998-77010">一</note><seg source="#source-77010-77031">。世多有。故弗</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-77031-77043">レ</note><seg source="#source-77043-77052">論。論</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-77052-77064">下</note><seg source="#source-77064-77076">其行事所</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-77076-77088">二</note><seg source="#source-77088-77094">施設</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-77094-77106">一</note><seg source="#source-77106-77109">者</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-77109-77121">上</note><seg source="#source-77121-77139">。語曰。能行</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-77139-77151">レ</note><seg source="#source-77151-77160">之者未</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-77160-77172">二</note><seg source="#source-77172-77181">必能言</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-77181-77193">一</note><seg source="#source-77193-77202">。能言</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-77202-77214">レ</note><seg source="#source-77214-77223">之者未</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-77223-77235">二</note><seg source="#source-77235-77244">必能行</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-77244-77256">一</note><seg source="#source-77256-77268">。孫子籌</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-77268-77280">二</note><seg source="#source-77280-77283">策</seg><g ref="#gaiji-3-1-94-86" source="#source-77283-77330">龐</g><seg source="#source-77330-77333">涓</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-77333-77345">一</note><seg source="#source-77345-77363">。明矣。然不</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-77363-77375">レ</note><seg source="#source-77375-77378">能</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-77378-77390">三</note><seg source="#source-77390-77396">蚤救</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-77396-77408">二</note><seg source="#source-77408-77414">患於</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-77414-77429">一レ</note><seg source="#source-77429-77432">被</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-77432-77444">レ</note><seg source="#source-77444-77459">刑。呉起説</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-77459-77471">二</note><seg source="#source-77471-77477">武侯</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-77477-77489">一</note><seg source="#source-77489-77492">以</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-77492-77504">二</note><seg source="#source-77504-77513">形勢不</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-77513-77528">一レ</note><seg source="#source-77528-77531">如</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-77531-77543">レ</note><seg source="#source-77543-77555">徳。然行</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-77555-77567">二</note><seg source="#source-77567-77573">之於</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-77573-77588">一レ</note><seg source="#source-77588-77597">楚。以</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-77597-77609">二</note><seg source="#source-77609-77618">刻暴少</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-77618-77633">一レ</note><seg source="#source-77633-77639">恩亡</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-77639-77651">二</note><seg source="#source-77651-77657">其躯</seg><note type="kunten" subtype="return-mark" rend="subscript" source="#source-77657-77669">一</note><seg source="#source-77669-77681">。悲夫。</seg></p>
