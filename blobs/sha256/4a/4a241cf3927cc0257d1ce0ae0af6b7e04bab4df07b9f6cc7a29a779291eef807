rt></ruby>く、『<ruby type="furigana" rend="right" source="#source-1604-1616"><rb>可</rb><rt>か</rt></ruby>なり』と。<ruby type="furigana" rend="right" source="#source-1631-1646"><rb>是</rb><rt>ここ</rt></ruby><seg source="#source-1646-1649">に</seg><ruby type="furigana" rend="right" source="#source-1649-1664"><rb>於</rb><rt>おい</rt></ruby><seg source="#source-1664-1667">て</seg><ruby type="furigana" rend="right" source="#source-1667-1682"><rb>之</rb><rt>これ</rt></ruby><seg source="#source-1682-1685">を</seg><ruby type="furigana" rend="right" source="#source-1685-1700"><rb>許</rb><rt>ゆる</rt></ruby><seg source="#source-1700-1706">す。</seg><ruby type="furigana" rend="right" source="#source-1706-1730"><rb>宮中</rb><rt>きうちう</rt></ruby><seg source="#source-1730-1733">の</seg><ruby type="furigana" rend="right" source="#source-1733-1754"><rb>美女</rb><rt>びぢよ</rt></ruby><seg source="#source-1754-1757">を</seg><ruby type="furigana" rend="right" source="#source-1757-1772"><rb>出</rb><rt>いだ</rt></ruby><seg source="#source-1772-1787">し、百八十</seg><ruby type="furigana" rend="right" source="#source-1787-1805"><rb>人</rb><rt>にん</rt></ruby><seg source="#source-1805-1808">を</seg><ruby type="furigana" rend="right" source="#source-1808-1820"><rb>得</rb><rt>え</rt></ruby><seg source="#source-1820-1829">たり。</seg><ruby type="furigana" rend="right" source="#source-1829-1850"><rb>孫子</rb><rt>そんし</rt></ruby><ruby type="furigana" rend="right" source="#source-1850-1865"><rb>分</rb><rt>わか</rt></ruby><seg source="#source-1865-1874">つて二</seg><ruby type="furigana" rend="right" source="#source-1874-1892"><rb>隊</rb><rt>たい</rt></ruby><seg source="#source-1892-1895">と</seg><ruby type="furigana" rend="right" source="#source-1895-1907"><rb>爲</rb><rt>な</rt></ruby><seg source="#source-1907-1913">し、</seg><ruby type="furigana" rend="right" source="#source-1913-1928"><rb>王</rb><rt>わう</rt></ruby><seg source="#source-1928-1931">の</seg><ruby type="furigana" rend="right" source="#source-1931-1955"><rb>寵姫</rb><rt>ちようき</rt></ruby><seg source="#sour