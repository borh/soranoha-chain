      <div type="layout" source="#source-736-844" rend="page-horizontal-center source-blank-lines-before(2) source-blank-lines-after(2)">
        <div type="layout" source="#source-775-844" style="padding-inline-start: 2em">
          <div>
            <head n="1" source="#source-796-838"><seg source="#source-796-802">序章</seg></head>
          </div>
