    <body>
      <p><seg source="#source-472-492">吾老いぬれど</seg></p>
      <p><seg source="#source-492-512">仙家に入らず</seg></p>
      <p><seg source="#source-512-526">茶烟軽く</seg></p>
      <p><seg source="#source-526-535">紅塵の</seg><ruby type="furigana" rend="right" source="#source-535-550"><rb>裡</rb><rt>うち</rt></ruby><seg source="#source-550-563">に住む</seg></p>
      <p><ruby type="furigana" rend="right" source="#source-563-587"><rb>柴門</rb><rt>さいもん</rt></ruby><seg source="#source-587-601">を守るは</seg></p>
      <p><seg source="#source-601-615">吾家の月</seg></p>
      <p><seg source="#source-615-635">竹窓に吹くは</seg></p>
      <p><seg source="#source-635-651">隣家の風</seg></p>
      <p><seg source="#source-651-665">人来れば</seg></p>
      <p><seg source="#source-665-682">迎へて会ふ</seg></p>
      <p><seg source="#source-682-696">人去れば</seg></p>
      <p><ruby type="furigana" rend="right" source="#source-696-717"><rb>吾座</rb><rt>わがざ</rt></ruby><seg source="#source-717-733">にもどる</seg></p>
      <p><seg source="#source-733-750">眠り足りて</seg></p>
      <p><seg source="#source-750-761">夢なく</seg></p>
      <p><seg source="#source-761-772">起きて</seg></p>
      <p><ruby type="furigana" rend="right" source="#source-772-784"><rb>倦</rb><rt>う</rt></ruby><seg source="#source-784-803">むことなし</seg></p>
      <p><seg source="#source-803-814">昼には</seg></p>
      <p><seg source="#source-814-840">昼に書くことあり</seg></p>
      <p><seg source="#source-840-851">夜には</seg></p>
      <p><seg source="#source-851-879">夜に語ることあり</seg></p>
      <p><seg source="#source-879-902">世にあづけたる</seg></p>
      <p><seg source="#source-902-908">わが</seg><ruby type="furigana" rend="right" source="#source-908-926"><rb>寿</rb><rt>いのち</rt></ruby><seg source="#source-926-931">は</seg></p>
      <p><seg source="#source-931-945">時来らば</seg></p>
      <p><seg source="#source-945-964">世に返さむ</seg></p>
      <p><seg source="#source-964-981">草の生命は</seg></p>
      <p><seg source="#source-981-1007">わが生命より短く</seg></p>
      <p><seg source="#source-1007-1024">樹の年輪は</seg></p>
      <p><seg source="#source-1024-1052">わが年輪より多し</seg></p>
      <p><seg source="#source-1052-1075">わが生命の一瞬</seg></p>
      <p><seg source="#source-1075-1095">心眼明らかに</seg></p>
      <p><seg source="#source-1095-1115">天人の五衰は</seg></p>
      <p><seg source="#source-1115-1124">問はず</seg></p>
    </body>
