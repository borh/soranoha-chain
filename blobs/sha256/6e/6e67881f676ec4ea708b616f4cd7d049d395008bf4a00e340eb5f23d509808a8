ana" rend="right" source="#source-500827-500845"><rb>依</rb><rt>よつ</rt></ruby><seg source="#source-500845-500866">て兩人は是より</seg><ruby type="furigana" rend="right" source="#source-500866-500905"><rb>差控仕</rb><rt>さしひかへつかま</rt></ruby><seg source="#source-500905-500923">つる可と座を</seg><ruby type="furigana" rend="right" source="#source-500923-500941"><rb>退</rb><rt>しりぞ</rt></ruby><seg source="#source-500941-500968">かんとするを越前守</seg><ruby type="furigana" rend="right" source="#source-500968-500995"><rb>大音</rb><rt>だいおん</rt></ruby><ruby type="furigana" rend="right" source="#source-500995-501010"><rb>上</rb><rt>あげ</rt></ruby><seg source="#source-501010-501031">次右衞門三五郎</seg><ruby type="furigana" rend="right" source="#source-501031-501052"><rb>暫</rb><rt>しばし</rt></ruby><ruby type="furigana" rend="right" source="#source-501052-501067"><rb>待</rb><rt>まて</rt></ruby><seg source="#source-501067-501070">と</seg><ruby type="furigana" rend="right" source="#source-501070-501085"><rb>呼</rb><rt>よび</rt></ruby><seg source="#source-501085-501106">止れども兩士は</seg><ruby type="furigana" rend="right" source="#source-501106-501121"><rb>強</rb><rt>しひ</rt></ruby><seg source="#source-501121-501124">て</seg><ruby type="furigana" rend="right" source="#source-501124-501145"><rb>退座</rb><rt>たいざ</rt></ruby><seg source="#source-501145-501232">せんとするに兩人參らずんば越前守直に夫へ出向ぞと言に兩人は</seg><ruby type="furigana" rend="right" source="#source-501232-501250"><rb>是非</rb><rt>ぜひ</rt></ruby><seg source="#source-501250-501256">なく</seg><ruby type="furigana" rend="right" source="#source-501256-501280"><rb>立戻</rb><rt>たちもど</rt></ruby><seg source="#source-501280-501295">り越前守が</seg><ruby type="furigana" rend="right" source="#source-501295-501310"><rb>前</rb><rt>まへ</rt></ruby><seg source="#source-501310-501319">に出て</seg><ruby type="furigana" rend="right" source="#source-501319-501343"><rb>平伏</rb><rt>へいふく</rt></ruby><seg source="#source-501343-501397">す是時越前守には次右衞門三五郎の手を</seg><ruby type="furigana" rend="right" source="#source-501397-501409"><rb>取</rb><rt>