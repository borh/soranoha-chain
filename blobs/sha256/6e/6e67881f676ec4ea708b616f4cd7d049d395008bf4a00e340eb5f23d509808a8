type="furigana" rend="right" source="#source-2347823-2347841"><rb>智慧</rb><rt>ちゑ</rt></ruby><seg source="#source-2347841-2347865">此平左衞門左仲御</seg><ruby type="furigana" rend="right" source="#source-2347865-2347883"><rb>附</rb><rt>つき</rt></ruby><seg source="#source-2347883-2347889">申し</seg><ruby type="furigana" rend="right" source="#source-2347889-2347904"><rb>居</rb><rt>をる</rt></ruby><ruby type="furigana" rend="right" source="#source-2347904-2347919"><rb>中</rb><rt>うち</rt></ruby><seg source="#source-2347919-2347931">は御安心</seg><ruby type="furigana" rend="right" source="#source-2347931-2347949"><rb>成</rb><rt>なさ</rt></ruby><seg source="#source-2347949-2348000">れ能々御思案候べしと種々相談しける</seg><ruby type="furigana" rend="right" source="#source-2348000-2348015"><rb>中</rb><rt>うち</rt></ruby><ruby type="furigana" rend="right" source="#source-2348015-2348030"><rb>良</rb><rt>やゝ</rt></ruby><seg source="#source-2348030-2348063">半日餘りお島が雪の中に</seg><ruby type="furigana" rend="right" source="#source-2348063-2348081"><rb>縛</rb><rt>いまし</rt></ruby><seg source="#source-2348081-2348090">められ</seg><ruby type="furigana" rend="right" source="#source-2348090-2348114"><rb>身神</rb><rt>しんしん</rt></ruby><seg source="#source-2348114-2348123">ともに</seg><ruby type="furigana" rend="right" source="#source-2348123-2348147"><rb>冷凍</rb><rt>ひえこゞ</rt></ruby><seg source="#source-2348147-2348150">え</seg><ruby type="furigana" rend="right" source="#source-2348150-2348180"><rb>人心地</rb><rt>ひとごこち</rt></ruby><seg source="#source-2348180-2348189">もなき</seg><ruby type="furigana" rend="right" source="#source-2348189-2348204"><rb>體</rb><rt>てい</rt></ruby><seg source="#source-2348204-2348228">を見て平左衞門は</seg><ruby type="furigana" rend="right" source="#source-2348228-2348347"><rb><seg source="#source-2348228-2348231">差</seg><g ref="#gaiji-570-9" source="#source-2348231-2348332">圖󠄃</g></rb><rt>さしづ</rt></ruby><seg source="#source-2348347-2348368">をなし藤五郎を</seg><ruby type="furigana" rend="right" source="#source-2348368-2348392"><rb>押籠</rb><rt>おしこめ</rt></ruby><ruby type="furigana" rend="right" source="#source-2348392-2348407"><rb>置</rb><rt>おき</rt></ruby><seg source="#source-2348407-2348413">たる</seg><ruby type="furigana" rend="right" source="#source-2348413-2348428"><rb>牢</rb><rt>らう</rt></ruby><seg source="#source-2348428-2348464">の中へ入れさせ番をつけて</seg><ruby type="furigana" rend="right" source="#source-2348464-2348479"><rb>差</rb><rt>さし</rt></ruby><seg source="#source-2348479-2348495">おきたり</seg></p>
