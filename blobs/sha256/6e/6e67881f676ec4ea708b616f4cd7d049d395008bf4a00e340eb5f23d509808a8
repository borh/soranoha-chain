nd="right" source="#source-860365-860386"><rb>次第</rb><rt>しだい</rt></ruby><seg source="#source-860386-860389">を</seg><ruby type="furigana" rend="right" source="#source-860389-860404"><rb>咄</rb><rt>はな</rt></ruby><seg source="#source-860404-860419">し如何にも</seg><ruby type="furigana" rend="right" source="#source-860419-860443"><rb>差迫</rb><rt>さしせま</rt></ruby><seg source="#source-860443-860485">りたる體に見せければ兩人とも</seg><ruby type="furigana" rend="right" source="#source-860485-860506"><rb>流石</rb><rt>さすが</rt></ruby><seg source="#source-860506-860509">は</seg><ruby type="furigana" rend="right" source="#source-860509-860527"><rb>伯父</rb><rt>をぢ</rt></ruby><seg source="#source-860527-860542">のことゆゑ</seg><ruby type="furigana" rend="right" source="#source-860542-860566"><rb>兩親</rb><rt>ふたおや</rt></ruby><seg source="#source-860566-860575">とも此</seg><ruby type="furigana" rend="right" source="#source-860575-860596"><rb>叔父</rb><rt>をぢ</rt></ruby><seg source="#source-860596-860599">に</seg><ruby type="furigana" rend="right" source="#source-860599-860617"><rb>殺害</rb><rt>ころ</rt></ruby><seg source="#source-860617-860677">されしとは夢にも知らず特に母が病氣ときゝ</seg><ruby type="furigana" rend="right" source="#source-860677-860701"><rb>姉妹</rb><rt>はらから</rt></ruby><seg source="#source-860701-860719">二人にて心一</seg><ruby type="furigana" rend="right" source="#source-860719-860737"><rb>杯</rb><rt>ぱい</rt></ruby><ruby type="furigana" rend="right" source="#source-860737-860755"><rb>出來</rb><rt>でき</rt></ruby><seg source="#source-860755-860758">る</seg><ruby type="furigana" rend="right" source="#source-860758-860773"><rb>程</rb><rt>ほど</rt></ruby><ruby type="furigana" rend="right" source="#source-860773-860800"><rb>合力</rb><rt>がふりよく</rt></ruby><seg source="#source-860800-860818">に及びければ</seg><ruby type="furigana" rend="right" source="#source-860818-860842"><rb>強慾</rb><rt>がうよく</rt></ruby><ruby type="furigana" rend="right" source="#source-860842-860863"><rb>非道</rb><rt>ひだう</rt></ruby><seg source="#source-860863-860938">の長庵は能き事に思ひ毎日々々の樣に無心に行ける程に</