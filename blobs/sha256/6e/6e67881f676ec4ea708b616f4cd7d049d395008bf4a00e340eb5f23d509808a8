" rend="right" source="#source-2714754-2714772"><rb>窺</rb><rt>うかゞ</rt></ruby><seg source="#source-2714772-2714799">ひ居たり此三人の中</seg><ruby type="furigana" rend="right" source="#source-2714799-2714829"><rb>頭立</rb><rt>かしらたち</rt></ruby><seg source="#source-2714829-2714865">たる一人は甲州にて名高き</seg><ruby type="furigana" rend="right" source="#source-2714865-2714889"><rb>惡漢</rb><rt>わるもの</rt></ruby><ruby type="furigana" rend="right" source="#source-2714889-2714913"><rb>韮崎</rb><rt>にらさき</rt></ruby><ruby type="furigana" rend="right" source="#source-2714913-2714943"><rb>出生</rb><rt>しゆつしやう</rt></ruby><seg source="#source-2714943-2714982">の雲切仁左衞門といふ者なり</seg><ruby type="furigana" rend="right" source="#source-2714982-2715009"><rb>若年</rb><rt>じやくねん</rt></ruby><seg source="#source-2715009-2715012">の</seg><ruby type="furigana" rend="right" source="#source-2715012-2715027"><rb>頃</rb><rt>ころ</rt></ruby><seg source="#source-2715027-2715036">より心</seg><ruby type="furigana" rend="right" source="#source-2715036-2715054"><rb>剛</rb><rt>がう</rt></ruby><seg source="#source-2715054-2715063">にして</seg><ruby type="furigana" rend="right" source="#source-2715063-2715096"><rb>眞影流</rb><rt>しんかげりう</rt></ruby><seg source="#source-2715096-2715099">の</seg><ruby type="furigana" rend="right" source="#source-2715099-2715126"><rb>劔術</rb><rt>けんじゆつ</rt></ruby><seg source="#source-2715126-2715135">を好み</seg><ruby type="furigana" rend="right" source="#source-2715135-2715159"><rb>天晴</rb><rt>あつぱれ</rt></ruby><ruby type="furigana" rend="right" source="#source-2715159-2715183"><rb>遣人</rb><rt>つかひて</rt></ruby><seg source="#source-2715183-2715201">なりしが或時</seg><ruby type="furigana" rend="right" source="#source-2715201-2715219"><rb>雷</rb><rt>らい</rt></ruby><ruby type="furigana" rend="right" source="#source-2715219-2715234"><rb>落</rb><rt>おち</rt></ruby><seg source="#source-2715234-2715294">て四方眞暗となりしに仁左衞門は事ともせず</seg><ruby type="furigana" rend="right" source="#source-2715294-2715318"><rb>拔打</rb><rt>ぬきうち</rt></ruby><seg source="#source-2715318-2