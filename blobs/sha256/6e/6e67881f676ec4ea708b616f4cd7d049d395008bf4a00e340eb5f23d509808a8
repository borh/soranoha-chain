na" rend="right" source="#source-2050960-2050975"><rb>克</rb><rt>よく</rt></ruby><ruby type="furigana" rend="right" source="#source-2050975-2051002"><rb>恐悦</rb><rt>きようえつ</rt></ruby><seg source="#source-2051002-2051020">に存じ奉つる</seg><ruby type="furigana" rend="right" source="#source-2051020-2051041"><rb>道理</rb><rt>だうり</rt></ruby><seg source="#source-2051041-2051047">こそ</seg><ruby type="furigana" rend="right" source="#source-2051047-2051071"><rb>先程</rb><rt>さきほど</rt></ruby><seg source="#source-2051071-2051101">より一ト間の内にて御</seg><ruby type="furigana" rend="right" source="#source-2051101-2051119"><rb>咄</rb><rt>はな</rt></ruby><seg source="#source-2051119-2051125">しの</seg><ruby type="furigana" rend="right" source="#source-2051125-2051140"><rb>聲</rb><rt>こゑ</rt></ruby><seg source="#source-2051140-2051143">を</seg><ruby type="furigana" rend="right" source="#source-2051143-2051161"><rb>承</rb><rt>うけた</rt></ruby><seg source="#source-2051161-2051179">まはるに扨も</seg><ruby type="furigana" rend="right" source="#source-2051179-2051194"><rb>能</rb><rt>よく</rt></ruby><ruby type="furigana" rend="right" source="#source-2051194-2051206"><rb>似</rb><rt>に</rt></ruby><seg source="#source-2051206-2051215">たるお</seg><ruby type="furigana" rend="right" source="#source-2051215-2051230"><rb>聲</rb><rt>こゑ</rt></ruby><seg source="#source-2051230-2051308">なりと存ぜし處果たして後藤先生なりと云ば一同も是はと</seg><ruby type="furigana" rend="right" source="#source-2051308-2051326"><rb>驚</rb><rt>おどろ</rt></ruby><seg source="#source-2051326-2051368">き長兵衞は八五郎に向ひ貴樣は</seg><ruby type="furigana" rend="right" source="#source-2051368-2051395"><rb>何時頃</rb><rt>いつごろ</rt></ruby><ruby type="furigana" rend="right" source="#source-2051395-2051419"><rb>出府</rb><rt>しゆつぷ</rt></ruby><seg source="#source-2051419-2051467">したるや己は昨日歸つたばかりゆゑ</seg><ruby type="furigana" rend="right" source="#source-2051467-2051479"><rb>未</rb><rt>ま</rt></ruby><seg source="#source-2051479-2051482">だ</seg><ruby type="furigana" rend="right" source="#source-2051482-2051497"><rb>家</rb><rt>うち</r