seg source="#source-2983996-2983999">の</seg><ruby type="furigana" rend="right" source="#source-2983999-2984014"><rb>祝</rb><rt>いは</rt></ruby><seg source="#source-2984014-2984023">ひと申</seg><ruby type="furigana" rend="right" source="#source-2984023-2984050"><rb>振舞</rb><rt>ふるまひ</rt></ruby><seg source="#source-2984050-2984077">を致させ村中の者を</seg><ruby type="furigana" rend="right" source="#source-2984077-2984101"><rb>呼寄</rb><rt>よびよせ</rt></ruby><seg source="#source-2984101-2984107">私し</seg><ruby type="furigana" rend="right" source="#source-2984107-2984125"><rb>竊</rb><rt>ひそか</rt></ruby><seg source="#source-2984125-2984194">に參りて見まするに周藏と名乘りしは村の名主源藏</seg><note type="sic" source="#source-2984194-2984230" target="#source-2984182-2984194">「名主源藏」はママ</note><seg source="#source-2984230-2984296">又喜平次と申せしは右名主の手代源藏と申者にて</seg><ruby type="furigana" rend="right" source="#source-2984296-2984311"><rb>偖</rb><rt>さて</rt></ruby><seg source="#source-2984311-2984314">又</seg><ruby type="furigana" rend="right" source="#source-2984314-2984332"><rb>茲</rb><rt>こゝ</rt></ruby><seg source="#source-2984332-2984353">に不思議な事は</seg><ruby type="furigana" rend="right" source="#source-2984353-2984374"><rb>渠等</rb><rt>かれら</rt></ruby><seg source="#source-2984374-2984401">二人が戻りし後に三</seg><ruby type="furigana" rend="right" source="#source-2984401-2984419"><rb>徳</rb><rt>とく</rt></ruby><seg source="#source-2984419-2984422">が</seg><ruby type="furigana" rend="right" source="#source-2984422-2984437"><rb>落</rb><rt>おち</rt></ruby><seg source="#source-2984437-2984470">てありしが其中に九助の</seg><ruby type="furigana" rend="right" source="#source-2984470-2984485"><rb>妻</rb><rt>さい</rt></ruby><ruby type="furigana" rend="right" source="#source-2984485-2984500"><rb>里</rb><rt>さと</rt></ruby><seg source="#source-2984500-2984518">と申者九助が</seg><ruby type="furigana" rend="right" source="#source-2984518-2984545"><rb>留守中</rb><rt>るすちう</rt></ruby><seg source="#source-2984545-2984560">名主惣内と</seg><ruby type="furigana" rend="right" source="#source-2984560-298458