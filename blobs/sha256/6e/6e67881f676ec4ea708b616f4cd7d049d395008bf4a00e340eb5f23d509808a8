812"><rb>金儲</rb><rt>かねまう</rt></ruby><seg source="#source-1504812-1504845">けも無れば是非もなしと</seg><ruby type="furigana" rend="right" source="#source-1504845-1504863"><rb>斷</rb><rt>ことわ</rt></ruby><seg source="#source-1504863-1504881">るを三五郎は</seg><ruby type="furigana" rend="right" source="#source-1504881-1504905"><rb>否々</rb><rt><seg source="#source-1504890-1504896">いや</seg><choice source="#source-1504896-1504902"><orig>／＼</orig><reg>〱</reg></choice></rt></ruby><seg source="#source-1504905-1504929">何にしても此度は</seg><ruby type="furigana" rend="right" source="#source-1504929-1504956"><rb>是非共</rb><rt>ぜひとも</rt></ruby><ruby type="furigana" rend="right" source="#source-1504956-1504971"><rb>貸</rb><rt>かし</rt></ruby><seg source="#source-1504971-1504980">くれよ</seg><ruby type="furigana" rend="right" source="#source-1504980-1504998"><rb>翌日</rb><rt>あす</rt></ruby><seg source="#source-1504998-1505004">にも</seg><ruby type="furigana" rend="right" source="#source-1505004-1505028"><rb>仕合</rb><rt>しあはせ</rt></ruby><seg source="#source-1505028-1505031">が</seg><ruby type="furigana" rend="right" source="#source-1505031-1505046"><rb>好</rb><rt>よけ</rt></ruby><seg source="#source-1505046-1505130">れば返すべしとて何分承知せざれば段右衞門も心中に思ふやう</seg><ruby type="furigana" rend="right" source="#source-1505130-1505151"><rb>彼奴</rb><rt>かやつ</rt></ruby><ruby type="furigana" rend="right" source="#source-1505151-1505163"><rb>我</rb><rt>わ</rt></ruby><seg source="#source-1505163-1505190">が身に惡事のあるを</seg><ruby type="furigana" rend="right" source="#source-1505190-1505214"><rb>付込</rb><rt>つけこみ</rt></ruby><seg source="#source-1505214-1505241">度々無心に來れども</seg><ruby type="furigana" rend="right" source="#source-1505241-1505256"><rb>貸</rb><rt>かさ</rt></ruby><seg source="#source-1505256-1505265">ぬ時は</seg><ruby type="furigana" rend="right" source="#source-1505265-1505280"><rb>事</rb><rt>こと</rt></ruby><ruby type="furigana" rend="right" source="#source-1505280-1505304"><rb>面倒</rb><rt>めんだう</rt></ruby><seg source="#source-1505304-1505319">に成べしと</seg><ruby typ