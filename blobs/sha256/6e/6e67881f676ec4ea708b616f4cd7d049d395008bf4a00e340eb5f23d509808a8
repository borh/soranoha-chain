t></ruby><seg source="#source-1720574-1720610">り殺して呉んずと身構たれ</seg><ruby type="furigana" rend="right" source="#source-1720610-1720625"><rb>共</rb><rt>ども</rt></ruby><ruby type="furigana" rend="right" source="#source-1720625-1720646"><rb>手振</rb><rt>てぶら</rt></ruby><seg source="#source-1720646-1720658">にて何の</seg><ruby type="furigana" rend="right" source="#source-1720658-1720679"><rb>得物</rb><rt>えもの</rt></ruby><seg source="#source-1720679-1720772">のなきを付込惡者共は聲々に人の來ぬ間に打殺せと先に進みし一人が</seg><ruby type="furigana" rend="right" source="#source-1720772-1720796"><rb>振揚</rb><rt>ふりあげ</rt></ruby><seg source="#source-1720796-1720805">かゝる</seg><ruby type="furigana" rend="right" source="#source-1720805-1720829"><rb>息杖</rb><rt>いきづゑ</rt></ruby><seg source="#source-1720829-1720841">を飛違へ</seg><ruby type="furigana" rend="right" source="#source-1720841-1720856"><rb>樣</rb><rt>さま</rt></ruby><seg source="#source-1720856-1720877">もぎ取て手早く</seg><ruby type="furigana" rend="right" source="#source-1720877-1720898"><rb>腋腹</rb><rt>ひばら</rt></ruby><seg source="#source-1720898-1720901">を</seg><ruby type="furigana" rend="right" source="#source-1720901-1720916"><rb>突</rb><rt>つき</rt></ruby><seg source="#source-1720916-1720970">ければウンと計りに倒れたり續て懸るを</seg><ruby type="furigana" rend="right" source="#source-1720970-1720994"><rb>引外</rb><rt>ひつぱづ</rt></ruby><seg source="#source-1720994-1721012">し空を打せて</seg><ruby type="furigana" rend="right" source="#source-1721012-1721036"><rb>踉蹌</rb><rt>よろめく</rt></ruby><seg source="#source-1721036-1721042">所を</seg><ruby type="furigana" rend="right" source="#source-1721042-1721054"><rb>直</rb><rt>つ</rt></ruby><seg source="#source-1721054-1721066">と飛込で</seg><ruby type="furigana" rend="right" source="#source-1721066-1721090"><rb>襟元</rb><rt>えりもと</rt></ruby><ruby type="furigana" rend="right" source="#source-1721090-1721105"><rb>掴</rb><rt>つか</rt></ruby><seg source="#source-1721105-1721120">み遙か向へ</seg><ruby type="furigana" rend="right" source="#source-1721120-1721144"><rb>投退</rb><rt>なげのけ</rt></ruby