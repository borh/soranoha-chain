/seg><ruby type="furigana" rend="right" source="#source-8280-8298"><rb>戦</rb><rt>いくさ</rt></ruby><seg source="#source-8298-8319">はできません。</seg><ruby type="furigana" rend="right" source="#source-8319-8343"><rb>残念</rb><rt>ざんねん</rt></ruby><seg source="#source-8343-8352">ながら</seg><ruby type="furigana" rend="right" source="#source-8352-8373"><rb>味方</rb><rt>みかた</rt></ruby><seg source="#source-8373-8376">が</seg><ruby type="furigana" rend="right" source="#source-8376-8388"><rb>負</rb><rt>ま</rt></ruby><seg source="#source-8388-8406">けいくさかと</seg><ruby type="furigana" rend="right" source="#source-8406-8439"><rb>田村麻呂</rb><rt>たむらまろ</rt></ruby><seg source="#source-8439-8442">も</seg><ruby type="furigana" rend="right" source="#source-8442-8454"><rb>歯</rb><rt>は</rt></ruby><seg source="#source-8454-8532">ぎしりをしてくやしがりました。するといつどこから出て</seg><ruby type="furigana" rend="right" source="#source-8532-8544"><rb>来</rb><rt>き</rt></ruby><seg source="#source-8544-8553">たか、</seg><ruby type="furigana" rend="right" source="#source-8553-8568"><rb>大</rb><rt>おお</rt></ruby><seg source="#source-8568-8583">きなひげの</seg><ruby type="furigana" rend="right" source="#source-8583-8595"><rb>生</rb><rt>は</rt></ruby><seg source="#source-8595-8601">えた</seg><ruby type="furigana" rend="right" source="#source-8601-8619"><rb>男</rb><rt>おとこ</rt></ruby><seg source="#source-8619-8652">と、かわいらしい小さな</seg><ruby type="furigana" rend="right" source="#source-8652-8667"><rb>坊</rb><rt>ぼう</rt></ruby><seg source="#source-8667-8682">さんが出て</seg><ruby type="furigana" rend="right" source="#source-8682-8694"><rb>来</rb><rt>き</rt></ruby><seg source="#source-8694-8712">て、どんどん</seg><ruby type="furigana" rend="right" source="#source-8712-8727"><rb>雨</rb><rt>あめ</rt></ruby><seg source="#source-8727-8739">のように</seg><ruby type="furigana" rend="right" source="#source-8739-8757"><rb>射出</rb><rt>いだ</rt></ruby><seg source="#source-8757-8760">す</seg><ruby type="furigana" rend="right" source="#source-8760-8775"><rb>敵</rb><rt>てき</rt></ruby><seg source="#source-87