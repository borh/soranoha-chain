      <div type="layout" source="#source-439-512" style="padding-inline-start: 3em">
        <div>
          <head n="2" source="#source-460-508"><seg source="#source-460-469">（一）</seg></head>
        </div>
      </div>
      <div>
        <p><seg source="#source-512-535">都の花に魁けて</seg></p>
        <p><seg source="#source-535-564">春足日をけふこゝに</seg></p>
        <p><seg source="#source-564-590">明粧成りし水族館</seg></p>
        <p><seg source="#source-590-613">東洋一の水族館</seg></p>
        <p><seg source="#source-613-644">堺水族館は開かれぬ</seg></p>
      </div>
      <div type="layout" source="#source-644-717" style="padding-inline-start: 3em">
        <div>
          <head n="2" source="#source-665-713"><seg source="#source-665-674">（二）</seg></head>
        </div>
      </div>
      <div>
        <p><seg source="#source-717-743">明治の帝行幸して</seg></p>
        <p><seg source="#source-743-775">叡覧ありしあとゞころ</seg></p>
        <p><seg source="#source-775-801">由緒も深き水族館</seg></p>
        <p><seg source="#source-801-824">東洋一の水族館</seg></p>
        <p><seg source="#source-824-855">堺水族館は開かれぬ</seg></p>
      </div>
      <div type="layout" source="#source-855-928" style="padding-inline-start: 3em">
        <div>
          <head n="2" source="#source-876-924"><seg source="#source-876-885">（三）</seg></head>
        </div>
      </div>
      <div>
        <p><seg source="#source-928-951">大魚小魚鰭の数</seg></p>
        <p><seg source="#source-951-980">集めてこゝに海の幸</seg></p>
        <p><seg source="#source-980-1009">綾うるはしき水族館</seg></p>
        <p><seg source="#source-1009-1032">東洋一の水族館</seg></p>
        <p><seg source="#source-1032-1063">堺水族館は開かれぬ</seg></p>
      </div>
      <div type="layout" source="#source-1063-1136" style="padding-inline-start: 3em">
        <div>
          <head n="2" source="#source-1084-1132"><seg source="#source-1084-1093">（四）</seg></head>
        </div>
      </div>
      <div>
        <p><seg source="#source-1136-1165">造りなしたる海の宮</seg></p>
        <p><seg source="#source-1165-1194">竜宮城もよそならず</seg></p>
        <p><seg source="#source-1194-1220">雅び床しの水族館</seg></p>
        <p><seg source="#source-1220-1243">東洋一の水族館</seg></p>
        <p><seg source="#source-1243-1274">堺水族館は開かれぬ</seg></p>
      </div>
      <div type="layout" source="#source-1274-1347" style="padding-inline-start: 3em">
        <div>
          <head n="2" source="#source-1295-1343"><seg source="#source-1295-1304">（五）</seg></head>
        </div>
      </div>
      <div>
        <p><seg source="#source-1347-1376">水際にあそぶ魚類の</seg></p>
        <p><seg source="#source-1376-1405">ゆきゝ妙なる舞の袖</seg></p>
        <p><seg source="#source-1405-1434">眺め見飽かぬ水族館</seg></p>
        <p><seg source="#source-1434-1457">東洋一の水族館</seg></p>
        <p><seg source="#source-1457-1488">堺水族館は開かれぬ</seg></p>
      </div>
      <div type="layout" source="#source-1488-1561" style="padding-inline-start: 3em">
        <div>
          <head n="2" source="#source-1509-1557"><seg source="#source-1509-1518">（六）</seg></head>
        </div>
      </div>
      <div>
        <p><seg source="#source-1561-1590">けふしも和む春の色</seg></p>
        <p><seg source="#source-1590-1622">げに長閑なる茅渟の浦</seg></p>
        <p><seg source="#source-1622-1654">いざ来て見ませ水族館</seg></p>
        <p><seg source="#source-1654-1677">東洋一の水族館</seg></p>
        <p><seg source="#source-1677-1704">堺水族館は開かれぬ</seg></p>
      </div>
    </body>
