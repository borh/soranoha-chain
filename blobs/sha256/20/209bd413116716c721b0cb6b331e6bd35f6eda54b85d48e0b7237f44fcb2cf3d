  <text>
    <body>
      <p source="#source-33-56"><seg source="#source-33-56">りんごが三かご</seg></p>
      <p source="#source-56-76"><seg source="#source-56-76">のつてる車、</seg></p>
      <p source="#source-76-102"><seg source="#source-76-102">ころころいつた。</seg></p>
      <p source="#source-102-127"><seg source="#source-102-127">子供が押した。</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-127-156"><seg source="#source-127-156">（りんごが一かご</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-156-190"><seg source="#source-156-190">あちらで売れた。）</seg></p>
      <p source="#source-190-213"><seg source="#source-190-213">りんごが二かご</seg></p>
      <p source="#source-213-230"><seg source="#source-213-230">木箱の車、</seg></p>
      <p source="#source-230-256"><seg source="#source-230-256">ころころいつた。</seg></p>
      <p source="#source-256-281"><seg source="#source-256-281">子供が押した。</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-281-310"><seg source="#source-281-310">（りんごが一かご</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-310-344"><seg source="#source-310-344">こちらで売れた。）</seg></p>
      <p source="#source-344-367"><seg source="#source-344-367">りんごが一かご</seg></p>
      <p source="#source-367-387"><seg source="#source-367-387">のこつた車、</seg></p>
      <p source="#source-387-413"><seg source="#source-387-413">ころころいつた。</seg></p>
      <p source="#source-413-438"><seg source="#source-413-438">子供が押した。</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-438-467"><seg source="#source-438-467">（りんごが一かご</seg></p>
      <p style="text-indent: 1em" rend="first-line-indent(1)" source="#source-467-501"><seg source="#source-467-501">どこかで売れた。）</seg></p>
      <p source="#source-501-521"><seg source="#source-501-521">帰りは子供が</seg></p>
      <p source="#source-521-541"><seg source="#source-521-541">のつてる車、</seg></p>
      <p source="#source-541-567"><seg source="#source-541-567">ころころいつた、</seg></p>
      <p source="#source-567-585"><seg source="#source-567-585">お家の方へ。</seg></p>
    </body>
