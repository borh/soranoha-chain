</seg><ruby type="furigana" rend="right" source="#source-37883-37898"><rb>些</rb><rt>ちつ</rt></ruby><seg source="#source-37898-37901">と</seg><ruby type="furigana" rend="right" source="#source-37901-37913"><rb>待</rb><rt>ま</rt></ruby><seg source="#source-37913-37928">たないと、</seg><ruby type="furigana" rend="right" source="#source-37928-37946"><rb>東</rb><rt>ひがし</rt></ruby><seg source="#source-37946-37949">の</seg><ruby type="furigana" rend="right" source="#source-37949-37964"><rb>空</rb><rt>そら</rt></ruby><seg source="#source-37964-37985">がしらまない。</seg><ruby type="furigana" rend="right" source="#source-37985-38003"><rb>私</rb><rt>わたし</rt></ruby><seg source="#source-38003-38006">は</seg><ruby type="furigana" rend="right" source="#source-38006-38030"><rb>前年</rb><rt>ぜんねん</rt></ruby><seg source="#source-38030-38033">、</seg><ruby type="furigana" rend="right" source="#source-38033-38054"><rb>身延</rb><rt>みのぶ</rt></ruby><seg source="#source-38054-38057">へ</seg><ruby type="furigana" rend="right" source="#source-38057-38072"><rb>參</rb><rt>まゐ</rt></ruby><seg source="#source-38072-38084">つたので</seg><ruby type="furigana" rend="right" source="#source-38084-38096"><rb>知</rb><rt>し</rt></ruby><seg source="#source-38096-38102">つて</seg><ruby type="furigana" rend="right" source="#source-38102-38114"><rb>居</rb><rt>ゐ</rt></ruby><seg source="#source-38114-38124">る。</seg></p>
