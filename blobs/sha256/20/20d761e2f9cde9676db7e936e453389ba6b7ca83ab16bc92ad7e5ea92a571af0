" source="#source-49534-49555"><rb>一人</rb><rt>ひとり</rt></ruby><ruby type="furigana" rend="right" source="#source-49555-49567"><rb>起</rb><rt>お</rt></ruby><seg source="#source-49567-49573">き、</seg><ruby type="furigana" rend="right" source="#source-49573-49594"><rb>二人</rb><rt>ふたり</rt></ruby><seg source="#source-49594-49609">さめると、</seg><ruby type="furigana" rend="right" source="#source-49609-49621"><rb>起</rb><rt>お</rt></ruby><seg source="#source-49621-49636">きたのが、</seg><ruby type="furigana" rend="right" source="#source-49636-49648"><rb>覺</rb><rt>さ</rt></ruby><seg source="#source-49648-49696">めたのが、いづれもきよとんとして</seg><ruby type="furigana" rend="right" source="#source-49696-49717"><rb>四邊</rb><rt>あたり</rt></ruby><seg source="#source-49717-49720">を</seg><ruby type="furigana" rend="right" source="#source-49720-49732"><rb>見</rb><rt>み</rt></ruby><seg source="#source-49732-49744">ながら、</seg><ruby type="furigana" rend="right" source="#source-49744-49759"><rb>皆</rb><rt>みな</rt></ruby><ruby type="furigana" rend="right" source="#source-49759-49783"><rb>申合</rb><rt>まをしあ</rt></ruby><seg source="#source-49783-49819">はせたやうに、ハンケチで</seg><ruby type="furigana" rend="right" source="#source-49819-49834"><rb>口</rb><rt>くち</rt></ruby><seg source="#source-49834-49837">を</seg><ruby type="furigana" rend="right" source="#source-49837-49852"><rb>押</rb><rt>おさ</rt></ruby><seg source="#source-49852-49873">へて、げゞツと</seg><ruby type="furigana" rend="right" source="#source-49873-49885"><rb>咽</rb><rt>む</rt></ruby><seg source="#source-49885-49894">せる。</seg><ruby type="furigana" rend="right" source="#source-49894-49906"><rb>然</rb><rt>さ</rt></ruby><seg source="#source-49906-49924">もありなん。</seg><ruby type="furigana" rend="right" source="#source-49924-49957"><rb>大入道</rb><rt>おほにふだう</rt></ruby><seg source="#source-49957-49960">の</seg><ruby type="furigana" rend="right" source="#source-49960-49984"><rb>眞向</rb><rt>まむかう</rt></ruby><seg source="#source-49984-49987">に</seg><ruby type="furigana" rend="right" source="#source-49987-