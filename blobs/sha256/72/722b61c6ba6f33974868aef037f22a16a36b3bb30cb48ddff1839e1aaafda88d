        <p>『よし、<ruby type="furigana" rend="right" source="#source-9251-9266"><rb>此</rb><rt>この</rt></ruby><ruby type="furigana" rend="right" source="#source-9266-9281"><rb>流</rb><rt>なが</rt></ruby><seg source="#source-9281-9287">れに</seg><ruby type="furigana" rend="right" source="#source-9287-9299"><rb>隨</rb><rt>つ</rt></ruby><seg source="#source-9299-9305">いて</seg><ruby type="furigana" rend="right" source="#source-9305-9317"><rb>行</rb><rt>ゆ</rt></ruby><seg source="#source-9317-9326">けば、</seg><ruby type="furigana" rend="right" source="#source-9326-9356"><rb>梯子段</rb><rt>はしごだん</rt></ruby><seg source="#source-9356-9359">を</seg><ruby type="furigana" rend="right" source="#source-9359-9374"><rb>轉</rb><rt>ころ</rt></ruby><seg source="#source-9374-9380">がり</seg><ruby type="furigana" rend="right" source="#source-9380-9392"><rb>落</rb><rt>お</rt></ruby><seg source="#source-9392-9398">ちる</seg><ruby type="furigana" rend="right" source="#source-9398-9419"><rb>氣遣</rb><rt>きづか</rt></ruby><seg source="#source-9419-9434">ひもなし！</seg><ruby type="furigana" rend="right" source="#source-9434-9449"><rb>家</rb><rt>うち</rt></ruby><seg source="#source-9449-9452">に</seg><ruby type="furigana" rend="right" source="#source-9452-9464"><rb>居</rb><rt>ゐ</rt></ruby><seg source="#source-9464-9467">る</seg><ruby type="furigana" rend="right" source="#source-9467-9485"><rb>皆</rb><rt>みンな</rt></ruby><seg source="#source-9485-9494">がどの</seg><ruby type="furigana" rend="right" source="#source-9494-9512"><rb>位</rb><rt>くらゐ</rt></ruby><ruby type="furigana" rend="right" source="#source-9512-9530"><rb>私</rb><rt>わたし</rt></ruby><seg source="#source-9530-9533">を</seg><ruby type="furigana" rend="right" source="#source-9533-9557"><rb>大膽</rb><rt>だいたん</rt></ruby><seg source="#source-9557-9563">だと</seg><ruby type="furigana" rend="right" source="#source-9563-9578"><rb>思</rb><rt>おも</rt></ruby><seg source="#source-9578-9605">ふでせう！さうだ、</seg><ruby type="furigana" rend="right" source="#source-9605-9724"><rb><seg source="#source-9605-9608">