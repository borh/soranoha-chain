          <p source="#source-70137-70211"><ruby type="furigana" rend="right" source="#source-70137-70158"><rb>一人</rb><rt>ひとり</rt></ruby><seg source="#source-70158-70161">は</seg><ruby type="furigana" rend="right" source="#source-70161-70179"><rb>薔薇</rb><rt>ばら</rt></ruby><seg source="#source-70179-70182">と</seg><ruby type="furigana" rend="right" source="#source-70182-70206"><rb>睡蓮</rb><rt>すいれん</rt></ruby><seg source="#source-70206-70211">の</seg></p>
          <p source="#source-70211-70245"><seg source="#source-70211-70245">ふくいくと香る花束。</seg></p>
          <p source="#source-70245-70295"><ruby type="furigana" rend="right" source="#source-70245-70266"><rb>一人</rb><rt>ひとり</rt></ruby><seg source="#source-70266-70275">は左の</seg><ruby type="furigana" rend="right" source="#source-70275-70290"><rb>腋</rb><rt>わき</rt></ruby><seg source="#source-70290-70295">に</seg></p>
          <p source="#source-70295-70363"><ruby type="furigana" rend="right" source="#source-70295-70325"><rb>革表紙</rb><rt>かはべうし</rt></ruby><seg source="#source-70325-70328">の</seg><ruby type="furigana" rend="right" source="#source-70328-70349"><rb>金字</rb><rt>きんじ</rt></ruby><seg source="#source-70349-70363">の書物。</seg></p>
          <p source="#source-70363-70413"><ruby type="furigana" rend="right" source="#source-70363-70384"><rb>一人</rb><rt>ひとり</rt></ruby><seg source="#source-70384-70413">は肩の上に地球儀。</seg></p>
          <p source="#source-70413-70486"><ruby type="furigana" rend="right" source="#source-70413-70434"><rb>一人</rb><rt>ひとり</rt></ruby><seg source="#source-70434-70455">は両手に大きな</seg><ruby type="furigana" rend="right" source="#source-70455-70479"><rb>竪琴</rb><rt>たてごと</rt></ruby><seg source="#source-70479-70486">。</seg></p>
          <p source="#source-70486-70530"><seg source="#source-70486-70501">わたしには</seg><ruby type="furigana" rend="right" source="#source-70501-70513"><rb>何</rb><rt>な</rt></ruby><seg source="#source-70513-70530">んにも無い</seg></p>
          <p source="#source-70530-70577"><seg source="#source-70530-70545">わたしには</seg><ruby type="furigana" rend="right" source="#source-70545-70557"><rb>何</rb><rt>な</rt></ruby><seg source="#source-70557-70577">んにも無い。</seg></p>
          <p source="#source-70577-70621"><seg source="#source-70577-70601">身一つで踊るより</seg><ruby type="furigana" rend="right" source="#source-70601-70616"><rb>外</rb><rt>ほか</rt></ruby><seg source="#source-70616-70621">に</seg></p>
          <p source="#source-70621-70672"><seg source="#source-70621-70636">わたしには</seg><ruby type="furigana" rend="right" source="#source-70636-70648"><rb>何</rb><rt>な</rt></ruby><seg source="#source-70648-70672">んにも無い。</seg></p>
