          <p source="#source-105099-105137"><seg source="#source-105099-105114">独り在るは</seg><ruby type="furigana" rend="right" source="#source-105114-105129"><rb>寂</rb><rt>さび</rt></ruby><seg source="#source-105129-105137">し、</seg></p>
          <p source="#source-105137-105202"><ruby type="furigana" rend="right" source="#source-105137-105155"><rb>薔薇</rb><rt>ばら</rt></ruby><seg source="#source-105155-105158">を</seg><ruby type="furigana" rend="right" source="#source-105158-105170"><rb>嗅</rb><rt>か</rt></ruby><seg source="#source-105170-105179">げども</seg><ruby type="furigana" rend="right" source="#source-105179-105194"><rb>寂</rb><rt>さび</rt></ruby><seg source="#source-105194-105202">し、</seg></p>
          <p source="#source-105202-105243"><seg source="#source-105202-105220">君と語れども</seg><ruby type="furigana" rend="right" source="#source-105220-105235"><rb>寂</rb><rt>さび</rt></ruby><seg source="#source-105235-105243">し、</seg></p>
          <p source="#source-105243-105302"><seg source="#source-105243-105246">筆</seg><ruby type="furigana" rend="right" source="#source-105246-105261"><rb>執</rb><rt>と</rt></ruby><seg source="#source-105261-105279">りて書けども</seg><ruby type="furigana" rend="right" source="#source-105279-105294"><rb>寂</rb><rt>さび</rt></ruby><seg source="#source-105294-105302">し、</seg></p>
          <p source="#source-105302-105350"><seg source="#source-105302-105323">高く歌へば更に</seg><ruby type="furigana" rend="right" source="#source-105323-105338"><rb>寂</rb><rt>さび</rt></ruby><seg source="#source-105338-105350">し。</seg></p>
