          <div>
            <head n="2" source="#source-9132-9204"><ruby type="furigana" rend="right" source="#source-9132-9147"><rb>己</rb><rt>おの</rt></ruby><seg source="#source-9147-9150">が</seg><ruby type="furigana" rend="right" source="#source-9150-9165"><rb>路</rb><rt>みち</rt></ruby></head>
