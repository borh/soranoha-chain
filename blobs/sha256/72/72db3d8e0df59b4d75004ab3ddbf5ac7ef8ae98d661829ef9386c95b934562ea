          <p source="#source-199529-199573"><ruby type="furigana" rend="right" source="#source-199529-199544"><rb>天</rb><rt>あま</rt></ruby><seg source="#source-199544-199553">つ日の</seg><ruby type="furigana" rend="right" source="#source-199553-199568"><rb>如</rb><rt>ごと</rt></ruby><seg source="#source-199568-199573">き</seg></p>
          <p source="#source-199573-199605"><seg source="#source-199573-199582">盛りの</seg><ruby type="furigana" rend="right" source="#source-199582-199600"><rb>薔薇</rb><rt>ばら</rt></ruby><seg source="#source-199600-199605">、</seg></p>
          <p source="#source-199605-199664"><seg source="#source-199605-199617">恋知らぬ</seg><ruby type="furigana" rend="right" source="#source-199617-199641"><rb>天童</rb><rt>てんどう</rt></ruby><seg source="#source-199641-199644">の</seg><ruby type="furigana" rend="right" source="#source-199644-199659"><rb>如</rb><rt>ごと</rt></ruby><seg source="#source-199659-199664">き</seg></p>
          <p source="#source-199664-199699"><seg source="#source-199664-199676">清らなる</seg><ruby type="furigana" rend="right" source="#source-199676-199694"><rb>薔薇</rb><rt>ばら</rt></ruby><seg source="#source-199694-199699">、</seg></p>
          <p source="#source-199699-199722"><seg source="#source-199699-199722">これらの花よ、</seg></p>
          <p source="#source-199722-199739"><seg source="#source-199722-199739">人間の身の</seg></p>
          <p source="#source-199739-199759"><seg source="#source-199739-199759">われ知りぬ、</seg></p>
          <p source="#source-199759-199793"><seg source="#source-199759-199765">及び</seg><ruby type="furigana" rend="right" source="#source-199765-199780"><rb>難</rb><rt>がた</rt></ruby><seg source="#source-199780-199793">しと。</seg></p>
