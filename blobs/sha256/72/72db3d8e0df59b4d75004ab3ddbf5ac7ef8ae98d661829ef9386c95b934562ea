          <p source="#source-215448-215471"><ruby type="furigana" rend="right" source="#source-215448-215460"><rb>行</rb><rt>ゆ</rt></ruby><seg source="#source-215460-215471">く人は</seg></p>
          <p source="#source-215471-215491"><seg source="#source-215471-215491">悪を離れず、</seg></p>
          <p source="#source-215491-215514"><ruby type="furigana" rend="right" source="#source-215491-215503"><rb>行</rb><rt>ゆ</rt></ruby><seg source="#source-215503-215514">く水は</seg></p>
          <p source="#source-215514-215534"><seg source="#source-215514-215534">土を離れず。</seg></p>
          <p source="#source-215534-215548"><seg source="#source-215534-215548">隅田川、</seg></p>
          <p source="#source-215548-215566"><seg source="#source-215548-215566">隅田川。</seg></p>
        </div>
        <div type="layout" source="#source-215566-215645" style="padding-inline-start: 4em">
          <div>
            <head n="2" source="#source-215587-215641"><seg source="#source-215587-215599">朝日の前</seg></head>
          </div>
        </div>
        <div>
          <p source="#source-215645-215671"><seg source="#source-215645-215671">あはれ、日の出、</seg></p>
          <p source="#source-215671-215739"><ruby type="furigana" rend="right" source="#source-215671-215695"><rb>山山</rb><rt>やまやま</rt></ruby><seg source="#source-215695-215698">は</seg><ruby type="furigana" rend="right" source="#source-215698-215710"><rb>酔</rb><rt>ゑ</rt></ruby><seg source="#source-215710-215716">へる</seg><ruby type="furigana" rend="right" source="#source-215716-215731"><rb>如</rb><rt>ごと</rt></ruby><seg source="#source-215731-215739">く、</seg></p>
          <p source="#source-215739-215786"><seg source="#source-215739-215760">みな喜びに身を</seg><ruby type="furigana" rend="right" source="#source-215760-215775"><rb>揺</rb><rt>ゆす</rt></ruby><seg source="#source-215775-215786">りて、</seg></p>
          <p source="#source-215786-215869"><ruby type="furigana" rend="right" source="#source-215786-215804"><rb>黄金</rb><rt>きん</rt></ruby><seg source="#source-215804-215807">と</seg><ruby type="furigana" rend="right" source="#source-215807-215822"><rb>朱</rb><rt>しゆ</rt></ruby><seg source="#source-215822-215825">の</seg><ruby type="furigana" rend="right" source="#source-215825-215837"><rb>笑</rb><rt>ゑ</rt></ruby><seg source="#source-215837-215846">まひを</seg><ruby type="furigana" rend="right" source="#source-215846-215861"><rb>交</rb><rt>かは</rt></ruby><seg source="#source-215861-215869">し、</seg></p>
          <p source="#source-215869-215904"><seg source="#source-215869-215875">海と</seg><ruby type="furigana" rend="right" source="#source-215875-215887"><rb>云</rb><rt>い</rt></ruby><seg source="#source-215887-215904">ふ海は皆、</seg></p>
