          <p source="#source-200365-200397"><seg source="#source-200365-200397">ほろりと、秋の真昼、</seg></p>
          <p source="#source-200397-200435"><seg source="#source-200397-200412">緑の四角な</seg><ruby type="furigana" rend="right" source="#source-200412-200427"><rb>瓶</rb><rt>かめ</rt></ruby><seg source="#source-200427-200435">から</seg></p>
          <p source="#source-200435-200473"><seg source="#source-200435-200473">卓の上へ静かにこぼれる。</seg></p>
          <p source="#source-200473-200514"><seg source="#source-200473-200488">泡のやうな</seg><ruby type="furigana" rend="right" source="#source-200488-200509"><rb>塊</rb><rt>かたまり</rt></ruby><seg source="#source-200509-200514">、</seg></p>
          <p source="#source-200514-200543"><seg source="#source-200514-200543">月の光のやうな線、</seg></p>
          <p source="#source-200543-200620"><seg source="#source-200543-200561">ラフワエルの</seg><ruby type="furigana" rend="right" source="#source-200561-200582"><rb>花神</rb><rt>フロラ</rt></ruby><seg source="#source-200582-200591">の絵の</seg><ruby type="furigana" rend="right" source="#source-200591-200615"><rb>肉色</rb><rt>にくいろ</rt></ruby><seg source="#source-200615-200620">。</seg></p>
          <p source="#source-200620-200664"><seg source="#source-200620-200641">つつましやかな</seg><ruby type="furigana" rend="right" source="#source-200641-200659"><rb>薔薇</rb><rt>ばら</rt></ruby><seg source="#source-200659-200664">は</seg></p>
          <p source="#source-200664-200705"><seg source="#source-200664-200705">散る日にも悲しみを秘めて、</seg></p>
          <p source="#source-200705-200740"><seg source="#source-200705-200723">修道院の壁に</seg><ruby type="furigana" rend="right" source="#source-200723-200735"><rb>凭</rb><rt>よ</rt></ruby><seg source="#source-200735-200740">る</seg></p>
          <p source="#source-200740-200778"><seg source="#source-200740-200778">尼達のやうには青ざめず、</seg></p>
          <p source="#source-200778-200819"><seg source="#source-200778-200784">清く</seg><ruby type="furigana" rend="right" source="#source-200784-200799"><rb>貴</rb><rt>あて</rt></ruby><seg source="#source-200799-200819">やかな処女の</seg></p>
          <p source="#source-200819-200866"><seg source="#source-200819-200837">高い、温かい</seg><ruby type="furigana" rend="right" source="#source-200837-200852"><rb>寂</rb><rt>さび</rt></ruby><seg source="#source-200852-200866">しさと、</seg></p>
          <p source="#source-200866-200934"><seg source="#source-200866-200878">みづから</seg><ruby type="furigana" rend="right" source="#source-200878-200893"><rb>抑</rb><rt>おさ</rt></ruby><seg source="#source-200893-200905">へかねた</seg><ruby type="furigana" rend="right" source="#source-200905-200929"><rb>妙香</rb><rt>めうかう</rt></ruby><seg source="#source-200929-200934">の</seg></p>
          <p source="#source-200934-201023"><ruby type="furigana" rend="right" source="#source-200934-200958"><rb>金色</rb><rt>こんじき</rt></ruby><seg source="#source-200958-200967">をした</seg><ruby type="furigana" rend="right" source="#source-200967-201006"><rb>雰囲気</rb><rt>アトモスフエエル</rt></ruby><seg source="#source-201006-201023">との中に、</seg></p>
          <p source="#source-201023-201064"><seg source="#source-201023-201064">わたしの書斎を浸してゐる。</seg></p>
          <p style="text-indent: 4em" rend="first-line-indent(4)" source="#source-201064-201080"><seg source="#source-201064-201080">×</seg></p>
          <p source="#source-201080-201103"><seg source="#source-201080-201103">まあ華やかな、</seg></p>
          <p source="#source-201103-201138"><seg source="#source-201103-201138">けだかい、燃え輝いた、</seg></p>
          <p source="#source-201138-201206"><seg source="#source-201138-201156">咲きの盛りの</seg><ruby type="furigana" rend="right" source="#source-201156-201180"><rb>五月</rb><rt>ごぐわつ</rt></ruby><seg source="#source-201180-201183">の</seg><ruby type="furigana" rend="right" source="#source-201183-201201"><rb>薔薇</rb><rt>ばら</rt></ruby><seg source="#source-201201-201206">。</seg></p>
          <p source="#source-201206-201241"><seg source="#source-201206-201241">どうして来てくれたの、</seg></p>
          <p source="#source-201241-201279"><seg source="#source-201241-201279">このみすぼらしい部屋へ、</seg></p>
          <p source="#source-201279-201347"><seg source="#source-201279-201285">この</seg><ruby type="furigana" rend="right" source="#source-201285-201300"><rb>疵</rb><rt>きず</rt></ruby><seg source="#source-201300-201312">だらけの</seg><ruby type="furigana" rend="right" source="#source-201312-201333"><rb>卓</rb><rt>テエブル</rt></ruby><seg source="#source-201333-201347">の上へ、</seg></p>
