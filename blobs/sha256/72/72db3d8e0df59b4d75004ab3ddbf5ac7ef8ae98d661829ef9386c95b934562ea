        </div>
        <div>
          <p source="#source-215198-215212"><seg source="#source-215198-215212">隅田川、</seg></p>
          <p source="#source-215212-215226"><seg source="#source-215212-215226">隅田川、</seg></p>
          <p source="#source-215226-215243"><seg source="#source-215226-215243">いつ見ても</seg></p>
          <p source="#source-215243-215260"><seg source="#source-215243-215260">土の色して</seg></p>
          <p source="#source-215260-215277"><seg source="#source-215260-215277">かき濁り、</seg></p>
          <p source="#source-215277-215323"><ruby type="furigana" rend="right" source="#source-215277-215292"><rb>黙</rb><rt>もく</rt></ruby><seg source="#source-215292-215298">して</seg><ruby type="furigana" rend="right" source="#source-215298-215313"><rb>流</rb><rt>なが</rt></ruby><seg source="#source-215313-215323">る。</seg></p>
          <p source="#source-215323-215355"><seg source="#source-215323-215329">今は</seg><ruby type="furigana" rend="right" source="#source-215329-215350"><rb>我身</rb><rt>わがみ</rt></ruby><seg source="#source-215350-215355">に</seg></p>
          <p source="#source-215355-215375"><seg source="#source-215355-215375">引きくらべ、</seg></p>
          <p source="#source-215375-215395"><seg source="#source-215375-215395">土より出たる</seg></p>
          <p source="#source-215395-215409"><seg source="#source-215395-215409">隅田川、</seg></p>
          <p source="#source-215409-215423"><seg source="#source-215409-215423">隅田川、</seg></p>
